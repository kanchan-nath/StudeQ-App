<file path="src/app/(public)/features/flashcard/page.module.css">
/* ============================================================
   FlashcardFeaturePage.module.css
   All tokens from global.css — zero hardcoded colors
   Mobile-first → tablet 768px → desktop 1024px
   Accent: --theme-teal (distinct from quiz yellow, notebook purple)
   ============================================================ */

/* ── SKIP LINK ─────────────────────────────────────────────── */
.skipLink {
    position: absolute;
    top: -100%;
    left: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    background: var(--clr-teal);
    color: #fff;
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    z-index: 9999;
    transition: top var(--t-fast);
}

.skipLink:focus {
    top: var(--sp-4);
}

/* ── MAIN ──────────────────────────────────────────────────── */
.main {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-body);
    overflow-x: hidden;
}

/* ── SHARED ────────────────────────────────────────────────── */
.sectionLabel {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clr-teal);
    margin-bottom: var(--sp-3);
}

.sectionTitle {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.2;
    margin-bottom: var(--sp-4);
}

.sectionSub {
    font-size: 1rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin-bottom: var(--sp-8);
}

/* ── BUTTONS ───────────────────────────────────────────────── */
.btnPrimary {
    display: inline-block;
    padding: var(--sp-3) var(--sp-6);
    background: var(--clr-teal);
    color: #fff;
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
    box-shadow: 0 4px 20px rgba(14, 165, 233, 0.3);
}

.btnPrimary:hover,
.btnPrimary:focus-visible {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: 0 6px 28px rgba(14, 165, 233, 0.45);
}

.btnPrimary:focus-visible {
    outline: 2px solid var(--clr-teal);
    outline-offset: 3px;
}

.btnGhost {
    display: inline-block;
    padding: var(--sp-3) var(--sp-6);
    background: transparent;
    color: var(--theme-text-secondary);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--t-fast), color var(--t-fast);
}

.btnGhost:hover,
.btnGhost:focus-visible {
    border-color: var(--theme-border-hover);
    color: var(--theme-text);
}

.btnGhost:focus-visible {
    outline: 2px solid var(--theme-border-hover);
    outline-offset: 3px;
}

/* ══════════════════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════════════════ */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: calc(var(--topbar-h) + var(--sp-8)) var(--sp-4) var(--sp-8);
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 120vw);
    height: 420px;
    background: radial-gradient(ellipse at center, rgba(14, 165, 233, 0.14) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
}

.hero>* {
    position: relative;
    z-index: 1;
}

.heroBadge {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-teal);
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: var(--r-full);
    padding: var(--sp-1) var(--sp-4);
    margin-bottom: var(--sp-5);
}

.badgeDot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--clr-teal);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.45;
        transform: scale(0.75);
    }
}

@media (prefers-reduced-motion: reduce) {
    .badgeDot {
        animation: none;
    }
}

.heroTitle {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.6rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.1;
    margin-bottom: var(--sp-5);
}

.heroAccent {
    color: var(--clr-teal);
}

.heroSub {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--theme-text-secondary);
    max-width: 54ch;
    line-height: 1.7;
    margin-bottom: var(--sp-6);
}

.heroCta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    margin-bottom: var(--sp-8);
}

.heroStats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    margin-bottom: var(--sp-8);
}

.statPill {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--sp-3) var(--sp-5);
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-md);
    min-width: 90px;
}

.statNum {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--clr-teal);
    line-height: 1;
}

.statLabel {
    font-size: 0.7rem;
    color: var(--theme-text-muted);
    margin-top: var(--sp-1);
    text-align: center;
}

/* ── CARD STACK VISUAL ─────────────────────────────────────── */
.heroCardStack {
    position: relative;
    width: 100%;
    max-width: 380px;
    height: 220px;
    margin-top: var(--sp-6);
}

.stackCard {
    position: absolute;
    left: 50%;
    width: 320px;
    border-radius: var(--r-lg);
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    padding: var(--sp-5);
