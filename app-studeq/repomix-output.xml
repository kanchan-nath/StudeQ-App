        cta: 'Go Premium',
        ctaVariant: 'outline',
        isCurrent: false,
        isPopular: false,
        features: [
            'Everything in Pro',
            'Advanced AI models',
            'Custom study scheduler',
            'Early access features',
        ],
    },
];

const ALL_FEATURES = [
