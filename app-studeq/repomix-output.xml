                    {/* Billing toggle */}
                    <div className={styles.toggleWrap} role="group" aria-label="Billing frequency">
                        <button
                            className={`${styles.toggleBtn} ${billing === 'monthly' ? styles.toggleActive : ''}`}
                            onClick={() => toggleBilling('monthly')}
