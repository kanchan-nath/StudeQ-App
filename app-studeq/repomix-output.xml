<file path="src/app/(public)/PublicLayout.module.css">
/* PublicLayout.module.css */

.layout {
    background: var(--theme-bg, rgba(10, 12, 20, 1));
    color: var(--theme-text);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
}

/* ── NAVBAR ── */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--navbar-h, 64px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    transition:
        background var(--t-slow),
        backdrop-filter var(--t-slow),
        box-shadow var(--t-slow);
}

.navbarScrolled {
    background: var(--theme-navbar-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--theme-border);
}

.navInner {
    width: 100%;
    max-width: var(--max-w, 1200px);
    margin: 0 auto;
    padding: 0 24px;
    height: var(--navbar-h, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.navLeft {
    display: flex;
    align-items: center;
    gap: 32px;
}

.navLogo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text);
    text-decoration: none;
    white-space: nowrap;
}

.navLogo span {
    color: var(--theme-accent);
}

.navLinks {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.navLink {
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    transition: color var(--t-fast);
    position: relative;
    padding-bottom: 2px;
}

.navLink::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--theme-accent);
    width: 0;
    transition: width 0.2s ease;
}

.navLink:hover {
    color: var(--theme-text);
}

.navLinkActive {
    color: var(--theme-text);
}

.navLinkActive::after {
    width: 100%;
}

.navRight {
    display: flex;
    align-items: center;
    gap: 12px;
}

.navLoginBtn {
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: var(--r-full);
    transition: color var(--t-fast);
}

.navLoginBtn:hover {
    color: var(--theme-text);
}

.navCta {
    background: var(--theme-accent);
    color: var(--theme-bg);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: var(--r-full);
    text-decoration: none;
    transition:
        transform var(--t-fast),
        box-shadow var(--t-fast);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
}

.navCta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--theme-accent-glow);
}

/* ── HAMBURGER ── */
.hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
}

.hamburgerLine {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--theme-text-muted);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
}

.hamburgerOpen1 {
    transform: translateY(7px) rotate(45deg);
}

.hamburgerOpen2 {
    opacity: 0;
}

.hamburgerOpen3 {
    transform: translateY(-7px) rotate(-45deg);
}

/* ── MOBILE MENU ── */
.mobileMenu {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--theme-border);
    padding: 16px 24px 24px;
    gap: 4px;
}

.mobileMenuLink {
    font-size: 15px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--theme-border);
    transition: color var(--t-fast);
}

.mobileMenuLink:hover {
    color: var(--theme-text);
}

.mobileMenuActions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
}

.mobileLoginBtn {
    flex: 1;
    text-align: center;
