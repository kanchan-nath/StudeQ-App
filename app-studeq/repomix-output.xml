/* ============================================================
   PricingPage.module.css
   Mobile-first · CSS vars from global.css only · No hardcoded colors
   ============================================================ */

/* ── SKIP LINK ─────────────────────────────────────────────── */
.skipLink {
    position: absolute;
    top: -100%;
    left: var(--sp-4);
    z-index: 9999;
    padding: var(--sp-2) var(--sp-4);
    background: var(--theme-purple);
    color: var(--clr-text-on-dark);
    border-radius: var(--r-md);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    transition: top var(--t-fast);
}

.skipLink:focus {
    top: var(--sp-4);
}

/* ── MAIN ───────────────────────────────────────────────────── */
.main {
    width: 100%;
    min-height: 100vh;
    background: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-body);
}

/* ── HERO ───────────────────────────────────────────────────── */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem var(--sp-4) 2rem;
    text-align: center;
}

.heroTitle {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--theme-text);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--sp-3);
}

.heroSub {
    font-size: 1rem;
    color: var(--theme-text-secondary);
    margin-bottom: 1.75rem;
}

/* ── BILLING TOGGLE ─────────────────────────────────────────── */
.toggleWrap {
    display: flex;
    align-items: center;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
    padding: 4px;
    gap: 2px;
}

.toggleBtn {
    padding: 0.5rem 1.25rem;
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--theme-text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background var(--t-base), color var(--t-base);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.toggleActive {
    background: var(--theme-surface-2);
    color: var(--theme-text);
    box-shadow: var(--shadow-xs);
}

.saveBadge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--theme-green);
}

/* ── CARDS SECTION ──────────────────────────────────────────── */
.cardsSection {
    padding: 2rem var(--sp-4) 1rem;
}

.cardsGrid {
    display: grid;
    gap: 1.25rem;
    max-width: 1100px;
    margin: 0 auto;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .cardsGrid {
        grid-template-columns: repeat(3, 1fr);
        align-items: start;
    }
}

/* ── CARD ───────────────────────────────────────────────────── */
.card {
    position: relative;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color var(--t-base), box-shadow var(--t-base);
}

.card:hover {
    border-color: var(--theme-border-hover);
    box-shadow: var(--theme-card-shadow);
}

.cardPopular {
    border-color: var(--theme-purple);
    box-shadow: 0 0 0 1px var(--theme-purple), var(--theme-card-shadow);
}

.popularBadge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--r-full);
    border: 1px solid var(--theme-green);
    color: var(--theme-green);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
}

/* ── CARD HEADER ────────────────────────────────────────────── */
.cardHeader {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.planMeta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.planIcon {
    font-size: 1rem;
    color: var(--theme-purple);
}

.planName {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1;
}

.planDash {
    font-size: 0.875rem;
    color: var(--theme-text-muted);
    letter-spacing: 0.05em;
}

.planTagline {
    font-size: 0.875rem;
    color: var(--theme-text-secondary);
}

/* ── PRICE ROW ──────────────────────────────────────────────── */
.priceRow {
    display: flex;
    align-items: flex-end;
    gap: 0.625rem;
}

.priceAmount {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1;
}

.cardPopular .priceAmount {
    color: var(--theme-purple-light);
}

.priceDetail {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.375rem;
}

.pricePer {
    font-size: 0.8125rem;
    color: var(--theme-text-secondary);
    font-weight: 500;
}

.priceBilling {
    font-size: 0.75rem;
    color: var(--theme-text-muted);
}

/* ── CTA BUTTONS ────────────────────────────────────────────── */
.ctaBtn {
    width: 100%;
    padding: 0.8125rem 1.25rem;
    border-radius: var(--r-md);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity var(--t-base), box-shadow var(--t-base), transform var(--t-fast);
}

.ctaBtn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
}

.ctaBtn:active {
    transform: translateY(0);
}

.ctaBtn:focus-visible {
    outline: 2px solid var(--theme-purple);
    outline-offset: 2px;
}

.cta_ghost {
    background: var(--theme-surface-2);
    color: var(--theme-text-secondary);
    border: 1px solid var(--theme-border);
}

.cta_current {
    background: linear-gradient(135deg, var(--theme-purple) 0%, var(--theme-purple-light) 100%);
