/* ============================================================
   QuizFeaturePage.module.css
   All tokens from global.css — zero hardcoded colors
   Mobile-first → tablet 768px → desktop 1024px
   ============================================================ */

/* ── SKIP LINK ─────────────────────────────────────────────── */
.skipLink {
    position: absolute;
    top: -100%;
    left: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    background: var(--theme-accent);
    color: var(--theme-bg);
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    z-index: 9999;
    transition: top var(--t-fast);
}

.skipLink:focus {
    top: var(--sp-4);
}

/* ── MAIN WRAPPER ──────────────────────────────────────────── */
.main {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-body);
    overflow-x: hidden;
}

/* ── SHARED SECTION LABELS / TITLES ───────────────────────── */
.sectionLabel {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--theme-accent);
    margin-bottom: var(--sp-3);
}

.sectionTitle {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.2;
    margin-bottom: var(--sp-4);
}

.sectionSub {
    font-size: 1rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin-bottom: var(--sp-8);
}

/* ── BUTTONS ───────────────────────────────────────────────── */
.btnPrimary {
    display: inline-block;
    padding: var(--sp-3) var(--sp-6);
    background: var(--theme-accent);
    color: var(--theme-bg);
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
    box-shadow: 0 4px 20px var(--theme-accent-glow);
}

.btnPrimary:hover,
.btnPrimary:focus-visible {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: 0 6px 28px var(--theme-accent-glow);
}

.btnPrimary:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
}

.btnGhost {
    display: inline-block;
    padding: var(--sp-3) var(--sp-6);
    background: transparent;
    color: var(--theme-text-secondary);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--t-fast), color var(--t-fast);
}

.btnGhost:hover,
.btnGhost:focus-visible {
    border-color: var(--theme-border-hover);
    color: var(--theme-text);
}

.btnGhost:focus-visible {
    outline: 2px solid var(--theme-border-hover);
    outline-offset: 3px;
}

/* ══════════════════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════════════════ */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: calc(var(--topbar-h) + var(--sp-8)) var(--sp-4) var(--sp-8);
    position: relative;
    overflow: hidden;
}

/* Radial glow behind hero */
.hero::before {
    content: '';
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 120vw);
    height: 400px;
    background: radial-gradient(ellipse at center,
            var(--theme-accent-glow) 0%,
            transparent 70%);
    pointer-events: none;
    z-index: 0;
}

.hero>* {
    position: relative;
    z-index: 1;
}

.heroBadge {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-accent);
    background: var(--theme-accent-dim);
    border: 1px solid var(--theme-accent-glow);
    border-radius: var(--r-full);
    padding: var(--sp-1) var(--sp-4);
    margin-bottom: var(--sp-5);
}

.badgeDot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--theme-accent);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.5;
        transform: scale(0.8);
    }
}

@media (prefers-reduced-motion: reduce) {
    .badgeDot {
        animation: none;
    }
}

.heroTitle {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.1;
    max-width: 14ch;
    margin-bottom: var(--sp-5);
}

.heroAccent {
    color: var(--theme-accent);
}

.heroSub {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--theme-text-secondary);
