<file path="src/app/page.module.css">
/*
  LandingPage.module.css
  CSS Modules — all class names scoped, no bare element selectors outside :root
  Fusion: turbo.ai dark starfield base + penseum.com timeline/comparison cards
  Updated: all hardcoded colors → global.css vars; light-mode overrides added
*/

/* ── GLOBAL PAGE ─────────────────────────────────────────────────────────── */
.page {
  background: var(--theme-bg);
  color: var(--theme-text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  min-height: 100vh;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

/* ── STAR FIELD ──────────────────────────────────────────────────────────── */
.stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star {
  position: absolute;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background: var(--star-color, rgba(255, 255, 255, 0.6));
  animation: starTwinkle var(--dur, 3s) ease-in-out infinite;
  animation-delay: var(--delay, 0s);
}

/* light: stars are subtle dark specks */
:global([data-theme="light"]) .star {
  background: rgba(0, 0, 0, 0.12);
}

@keyframes starTwinkle {

  0%,
  100% {
    opacity: 0.2;
    transform: scale(1);
  }

  50% {
    opacity: 0.9;
    transform: scale(1.4);
  }
}

/* ── LIVE TICKER ─────────────────────────────────────────────────────────── */
.ticker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 30px;
  background: transparent;
  /* border-bottom: 1px solid var(--theme-purple-dim); */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  font-size: 14px;
  font-weight: 900;
  color: var(--theme-purple-light);
  font-family: var(--font-body);
  letter-spacing: 0.02em;
  gap: 8px;
  transition: opacity 0.4s ease;
}

.tickerDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--theme-accent);
  box-shadow: 0 0 6px var(--theme-green);
  flex-shrink: 0;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {

  0%,
  100% {
    box-shadow: 0 0 6px var(--theme-accent);
  }

  50% {
    box-shadow: 0 0 14px var(--theme-accent);
  }
}

/* ── NAVBAR ──────────────────────────────────────────────────────────────── */
.navbar {
  position: fixed;
  top: 25px;
  left: 100px;
  right: 100px;
  z-index: 100;
  display: flex;
  height: var(--navbar-h);
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  transition:
    background var(--t-slow),
    backdrop-filter var(--t-slow),
    box-shadow var(--t-slow);
}

.ctaWrapper {
  display: flex;
  align-items: center;
  /* Vertical alignment */
  gap: 16px;
  /* Space between toggle and button */
}

.navbarScrolled {
  background: transparent;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1px 0 var(--theme-border);
}

.navInner {
  width: 100%;
  max-width: var(--max-w);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.navPill {
  background: var(--theme-navbar-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  height: 48px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 32px;
}

.navLogo {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--theme-text);
  text-decoration: none;
  white-space: nowrap;
}

.navLogo span {
  color: var(--theme-accent);
}

.navLinks {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.navLink {
  font-size: 14px;
  font-weight: 600;
  color: var(--theme-text-muted);
  text-decoration: none;
  transition: color var(--t-fast);
}

.navLink:hover {
  color: var(--theme-text);
}

.navCta {
  background: var(--theme-accent);
  color: var(--theme-bg);
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: var(--r-full);
  text-decoration: none;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast),
    background var(--t-fast);
  white-space: nowrap;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.navCta:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px var(--theme-accent-glow);
}

/* ── HERO ────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(var(--navbar-h) + 32px + 32px) 24px 80px;
  overflow: hidden;
  z-index: 1;
}

.beam1 {
  position: absolute;
  top: -20%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle,
      var(--beam-purple-strong, rgba(124, 95, 245, 0.4)) 0%,
      transparent 70%);
  filter: blur(80px);
  pointer-events: none;
}

.beam2 {
  position: absolute;
  top: 30%;
  left: -15%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,
      var(--beam-purple-light, rgba(192, 132, 252, 0.3)) 0%,
      transparent 70%);
  filter: blur(60px);
  pointer-events: none;
}

.beam3 {
  position: absolute;
  bottom: -10%;
  right: 20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle,
      var(--beam-accent, rgba(255, 209, 102, 0.15)) 0%,
      transparent 70%);
  filter: blur(80px);
  pointer-events: none;
}

.beam4 {
  position: absolute;
  top: 50%;
  left: 30%;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle,
      var(--beam-purple-soft, rgba(124, 95, 245, 0.2)) 0%,
      transparent 70%);
  filter: blur(40px);
  pointer-events: none;
}

/* beam vars — light mode tones them down */
:global([data-theme="light"]) .beam1 {
  --beam-purple-strong: rgba(124, 95, 245, 0.12);
}

:global([data-theme="light"]) .beam2 {
  --beam-purple-light: rgba(192, 132, 252, 0.1);
}

:global([data-theme="light"]) .beam3 {
  --beam-accent: rgba(196, 154, 0, 0.08);
}

:global([data-theme="light"]) .beam4 {
  --beam-purple-soft: rgba(124, 95, 245, 0.07);
}

.heroContent {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 780px;
  gap: 20px;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 500;
  color: var(--theme-purple-light);
  animation: fadeDown 0.6s ease both;
}

.heroBadgeArrow {
  opacity: 0.7;
}

.heroH1 {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: var(--theme-text);
  margin: 0;
  animation: fadeDown 0.6s 0.1s ease both;
}

.heroSub {
  font-size: clamp(1rem, 2vw, 1.2rem);
  color: var(--theme-text-muted);
  max-width: 520px;
  margin: 0;
  animation: fadeDown 0.6s 0.2s ease both;
}

.heroActions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  animation: fadeDown 0.6s 0.3s ease both;
}

.heroCta {
  background: var(--theme-accent);
  color: var(--theme-bg);
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  padding: 14px 32px;
  border-radius: var(--r-full);
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast);
}

.heroCta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--theme-accent-glow);
}

.heroSubjectRow {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.subjectChip {
  background: var(--theme-navbar-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 13px;
  color: var(--theme-text-muted);
  cursor: pointer;
  transition:
    background var(--t-fast),
    border-color var(--t-fast),
    color var(--t-fast);
  font-family: var(--font-body);
}

.subjectChip:hover {
  background: var(--theme-accent-dim);
  border-color: var(--theme-accent-dim);
  color: var(--theme-accent);
}

.dropZone {
  position: relative;
  z-index: 2;
  margin-top: 32px;
  width: 100%;
  max-width: 480px;
  border: 2px dashed var(--theme-border-hover);
  border-radius: var(--r-xl);
  padding: 28px 24px;
  text-align: center;
  cursor: pointer;
  transition:
    border-color var(--t-base),
    background var(--t-base);
  animation: fadeDown 0.6s 0.4s ease both;
  background: var(--theme-input-bg);
}

.dropZone:hover {
  border-color: var(--theme-purple-dim);
  background: var(--theme-purple-dim);
}

.dropIcon {
  font-size: 2rem;
  margin-bottom: 8px;
  display: block;
}

.dropText {
  font-size: 15px;
  color: var(--theme-text-muted);
  margin: 0;
}

.dropSub {
  font-size: 12px;
  color: var(--theme-text-secondary);
  margin: 6px 0 0;
}

.sparkMeter {
  position: absolute;
  bottom: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--theme-accent-dim);
  border: 1px solid var(--theme-accent-glow);
  border-radius: var(--r-full);
  padding: 6px 14px;
  font-size: 12px;
  color: var(--theme-accent);
  font-weight: 600;
  z-index: 3;
}

/* ── MARQUEE ─────────────────────────────────────────────────────────────── */
.marqueeSection {
  position: relative;
  z-index: 1;
  padding: 20px 0 48px;
  overflow: hidden;
}

.marqueeLabel {
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--theme-text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.marqueeTrack {
  display: flex;
  width: max-content;
  animation: marqueeScroll 22s linear infinite;
}

.marqueeTrack:hover {
  animation-play-state: paused;
}

.marqueeList {
  display: flex;
  align-items: center;
  gap: 64px;
  list-style: none;
  margin: 0;
  padding: 0 32px;
}

.marqueeItem {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--theme-text-secondary);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: color var(--t-fast);
  opacity: 0.4;
}

.marqueeItem:hover {
  opacity: 1;
  color: var(--theme-text);
}

@keyframes marqueeScroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

/* ── SECTION COMMON ──────────────────────────────────────────────────────── */
.section {
  position: relative;
  z-index: 1;
  padding: 80px 24px;
}

.sectionInner {
  max-width: var(--max-w);
  margin: 0 auto;
}

.sectionBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-purple-light);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.sectionH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--theme-text);
  margin: 0 0 16px;
}

.sectionSub {
  font-size: 17px;
  color: var(--theme-text-muted);
  max-width: 540px;
  line-height: 1.65;
  margin: 0;
}

.centered {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── REVEAL ANIMATION ────────────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s ease-out,
    transform 0.6s ease-out;
}

.revealed {
  opacity: 1;
  transform: translateY(0);
}

