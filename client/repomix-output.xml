        </button>
    );
}

function SearchBar({ onSearch, loading, initialQuery = "", activeTab, onTabChange }) {
    const [input, setInput] = useState(initialQuery);

    useEffect(() => setInput(initialQuery), [initialQuery]);

    function handleSubmit(e) {
        e.preventDefault();
