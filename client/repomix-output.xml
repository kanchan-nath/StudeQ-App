<file path="src/pages/styles/notes.module.css">
/* notes.module.css — Notes page (scoped) */

/* ── NOTES-SPECIFIC CSS VARS (keep here, --n- prefix = no conflict) ── */
/* notes.module.css — Notes page (scoped) */

/* ── NOTES-SPECIFIC CSS VARS (--n- prefix) ── */
[data-theme="light"] {
  --n-bg: #f0f2f8;
  --n-surface: #ffffff;
  --n-surface-raised: #f8faff;
  --n-border: #e2e8f0;
  --n-border-subtle: #eef2f8;
  --n-primary: #3b5bdb;
  --n-primary-dark: #2f4ac4;
  --n-primary-light: #eef2ff;
  --n-primary-glow: rgba(59, 91, 219, 0.15);
  --n-accent: #22c55e;
  --n-accent-light: #dcfce7;
  --n-purple: #7c3aed;
  --n-teal: #0ea5e9;
  --n-danger: #ef4444;
  --n-danger-light: #fef2f2;
  --n-warning: #f97316;
  --n-pin: #f59e0b;
  --n-text-primary: #0f172a;
  --n-text-secondary: #475569;
  --n-text-muted: #94a3b8;
  --n-text-inverse: #ffffff;
  --n-sidebar-w: 260px;
  --n-r-sm: 6px;
  --n-r-md: 12px;
  --n-r-lg: 16px;
  --n-r-xl: 24px;
  --n-r-full: 9999px;
  --n-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
  --n-shadow-card: 0 4px 20px rgba(59, 91, 219, 0.08), 0 1px 4px rgba(0, 0, 0, 0.05);
  --n-shadow-lift: 0 8px 32px rgba(59, 91, 219, 0.14), 0 2px 8px rgba(0, 0, 0, 0.06);
  --n-t-fast: 150ms ease;
  --n-t-base: 220ms ease;
  --n-t-slow: 380ms cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="dark"] {
  /* Backgrounds — aligned with global --theme-bg / --theme-surface */
  --n-bg: #0a0c14;
  --n-surface: #1c1c1f;
  --n-surface-raised: #242428;

  /* Borders — aligned with global --theme-border */
  --n-border: rgba(255, 255, 255, 0.08);
  --n-border-subtle: rgba(255, 255, 255, 0.04);

  /* Primary — slightly softened blue for dark bg */
  --n-primary: #6b8eff;
  --n-primary-dark: #4f6fe0;
  --n-primary-light: rgba(107, 142, 255, 0.12);
  --n-primary-glow: rgba(107, 142, 255, 0.2);

  /* Accent / status */
  --n-accent: #34d399;
  --n-accent-light: rgba(52, 211, 153, 0.12);
  --n-purple: #a78bfa;
  --n-teal: #38bdf8;
  --n-danger: #f87171;
  --n-danger-light: rgba(248, 113, 113, 0.12);
  --n-warning: #fb923c;
  --n-pin: #fbbf24;

  /* Text — aligned with global --theme-text / --theme-text-secondary */
  --n-text-primary: #f0f0f0;
  --n-text-secondary: #8a8a9a;
  --n-text-muted: #5a5a6a;
  --n-text-inverse: #0a0c14;

  /* Shadows — heavier on dark */
  --n-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
  --n-shadow-card: 0 4px 24px rgba(0, 0, 0, 0.45);
  --n-shadow-lift: 0 8px 40px rgba(0, 0, 0, 0.6);
}

/* ── PAGE LAYOUT ─────────────────────────────────────────────── */
.notes-page {
  display: grid;
  grid-template-columns: 1fr var(--n-sidebar-w);
  grid-template-rows: 1fr;
  height: 100%;
  overflow: hidden;
  background: var(--n-bg);
  animation: fadeIn var(--n-t-slow) both;
  transition: grid-template-columns var(--n-t-base);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── NOTES SIDEBAR (RIGHT) ───────────────────────────────────── */
.sidebar-wrapper {
  position: relative;
  display: flex;
  grid-column: 2;
  grid-row: 1;
  overflow: hidden;
}

.notes-sidebar {
  /* grid-column: 2; */
  /* grid-row: 1; */
  /* width: 220px; */
  /* transition: width var(--n-t-base), opacity var(--n-t-base); */
  background: var(--n-surface);
  border-left: 1px solid var(--n-border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  gap: 0;
}

/* .notes-sidebar--collapsed {
    width: 0;
    opacity: 0;
    pointer-events: none;
    border-left: none;
    overflow: hidden;
} */

.sidebar-toggle {
  width: 28px;
  height: 28px;
  background: var(--n-primary-light);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-sm);
  color: var(--n-primary);
  font-size: 0.85rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast);
  position: static;
  transform: none;
}

.sidebar-toggle:hover {
  background: var(--n-primary);
  color: var(--n-text-inverse);
}

.sidebar-toggle__arrow {
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  color: inherit;
}

.notes-sidebar::-webkit-scrollbar {
  width: 4px;
}

.notes-sidebar::-webkit-scrollbar-track {
  background: transparent;
}

.notes-sidebar::-webkit-scrollbar-thumb {
  background: var(--n-border);
  border-radius: var(--n-r-full);
}

.notes-sidebar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px 14px;
  border-bottom: 1px solid var(--n-border-subtle);
  position: sticky;
  top: 0;
  background: var(--n-surface);
  z-index: 2;
}

.notes-sidebar__title {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--n-text-muted);
}

.notes-sidebar__new-btn {
  width: 28px;
  height: 28px;
  border-radius: var(--n-r-sm);
  background: var(--n-primary-light);
  color: var(--n-primary);
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background var(--n-t-fast),
    transform var(--n-t-fast),
    box-shadow var(--n-t-fast);
  flex-shrink: 0;
}

.notes-sidebar__new-btn:hover {
  background: var(--n-primary);
  color: var(--n-text-inverse);
  transform: rotate(90deg);
  box-shadow: 0 2px 8px var(--n-primary-glow);
}

.notes-sidebar__loading {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 16px;
  font-size: 0.82rem;
  color: var(--n-text-muted);
}

.notes-sidebar__error {
  padding: 12px 16px;
  font-size: 0.8rem;
  color: var(--n-danger);
  background: var(--n-danger-light);
  margin: 8px;
  border-radius: var(--n-r-md);
}

.notes-sidebar__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 40px 16px;
  text-align: center;
  font-size: 0.82rem;
  color: var(--n-text-muted);
  line-height: 1.6;
}

.notes-sidebar__empty span {
  font-size: 2rem;
}

.notes-sidebar__group {
  padding: 8px 8px 4px;
}

.notes-sidebar__group-label {
  display: block;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--n-text-muted);
  padding: 6px 8px 4px;
}

.notes-sidebar__item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: var(--n-r-md);
  background: transparent;
  color: var(--n-text-secondary);
  font-family: var(--font-body);
  font-size: 0.84rem;
  font-weight: 400;
  text-align: left;
  cursor: pointer;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    padding-left var(--n-t-base);
  position: relative;
  border: none;
  outline: none;
}

.notes-sidebar__item:hover {
  background: var(--n-primary-light);
  color: var(--n-primary);
  padding-left: 14px;
}

.active {
  background: var(--n-primary-light) !important;
  color: var(--n-primary) !important;
  font-weight: 600;
}

.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 3px;
  background: var(--n-primary);
  border-radius: 0 var(--n-r-full) var(--n-r-full) 0;
}

.notes-sidebar__item-icon {
  font-size: 0.9rem;
  flex-shrink: 0;
  opacity: 0.7;
  transition: opacity var(--n-t-fast);
}

.notes-sidebar__item:hover .notes-sidebar__item-icon,
.active .notes-sidebar__item-icon {
  opacity: 1;
}

.notes-sidebar__item-title {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 180px;
}

/* ── MAIN PANEL (LEFT) ───────────────────────────────────────── */
.notes-main {
  grid-column: 1;
  grid-row: 1;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--n-bg);
  position: relative;
}

.notes-main::-webkit-scrollbar {
  width: 5px;
}

.notes-main::-webkit-scrollbar-track {
  background: transparent;
}

.notes-main::-webkit-scrollbar-thumb {
  background: var(--n-border);
  border-radius: var(--n-r-full);
}

.notes-error {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid var(--n-danger);
  border-radius: var(--n-r-lg);
  font-size: 0.85rem;
  box-shadow: var(--n-shadow-lift);
  z-index: 100;
  animation: slideUp 0.25s ease both;
}

.notes-error button {
  background: none;
  color: var(--n-danger);
  font-size: 1rem;
  padding: 0 4px;
  opacity: 0.7;
  transition: opacity var(--n-t-fast);
}

.notes-error button:hover {
  opacity: 1;
}

/* ── WELCOME PANEL ───────────────────────────────────────────── */
.welcome-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding: 48px 24px;
  animation: fadeIn var(--n-t-slow) both;
}

.welcome-panel__inner {
  max-width: 580px;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.welcome-panel__icon-wrap {
  width: 72px;
  height: 72px;
  border-radius: var(--n-r-xl);
  background: linear-gradient(135deg, var(--n-primary), var(--n-purple));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 32px var(--n-primary-glow);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow: 0 8px 32px var(--n-primary-glow);
  }

  50% {
    box-shadow: 0 12px 40px rgba(124, 58, 237, 0.3);
  }
}

.welcome-panel__sparkle {
  font-size: 2rem;
  color: #fff;
}

.welcome-panel__heading {
  font-family: var(--font-display);
  font-size: 1.9rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.welcome-panel__sub {
  font-size: 0.95rem;
  color: var(--n-text-secondary);
  max-width: 420px;
  line-height: 1.7;
}

.welcome-panel__features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  width: 100%;
  text-align: left;
  margin: 8px 0;
}

.welcome-feature {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-lg);
  transition:
    box-shadow var(--n-t-base),
    transform var(--n-t-base),
    border-color var(--n-t-base);
}

.welcome-feature:hover {
  box-shadow: var(--n-shadow-card);
  border-color: var(--n-primary);
  transform: translateY(-2px);
}

.welcome-feature__icon {
  font-size: 1.4rem;
  flex-shrink: 0;
  margin-top: 2px;
}

.welcome-feature strong {
  display: block;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--n-text-primary);
  margin-bottom: 2px;
}

.welcome-feature p {
  font-size: 0.77rem;
  color: var(--n-text-muted);
  line-height: 1.5;
  margin: 0;
}

.welcome-panel__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 28px;
  background: linear-gradient(135deg, var(--n-primary), var(--n-purple));
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  border-radius: var(--n-r-full);
  box-shadow: 0 4px 18px var(--n-primary-glow);
  transition:
    transform var(--n-t-fast),
    box-shadow var(--n-t-fast),
    filter var(--n-t-fast);
  letter-spacing: 0.01em;
}

.welcome-panel__cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--n-primary-glow);
  filter: brightness(1.08);
}

.welcome-panel__cta:active {
  transform: translateY(0);
}

/* ── INPUT FORM CARD ─────────────────────────────────────────── */
.note-input-wrap {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 100%;
  padding: 40px 24px;
  animation: fadeIn var(--n-t-slow) both;
}

.note-input-card {
  width: 100%;
  max-width: 680px;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-xl);
  box-shadow: var(--n-shadow-card);
  overflow: hidden;
  transition: box-shadow var(--n-t-base);
}

.note-input-card:focus-within {
  box-shadow: var(--n-shadow-lift);
  border-color: var(--n-primary);
}

.note-input-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 14px;
  border-bottom: 1px solid var(--n-border-subtle);
}

.note-input-card__label {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--n-primary);
}

.note-input-card__cancel {
  font-size: 0.8rem;
  color: var(--n-text-muted);
  background: transparent;
  padding: 4px 10px;
  border-radius: var(--n-r-full);
  border: 1px solid var(--n-border);
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast);
}

.note-input-card__cancel:hover {
  background: var(--n-surface-raised);
  color: var(--n-text-secondary);
}

.note-input-card__form {
  display: flex;
  flex-direction: column;
}

.note-input-card__textarea {
  width: 100%;
  padding: 20px;
  background: transparent;
  border: none;
  outline: none;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.92rem;
  color: var(--n-text-primary);
  line-height: 1.7;
  min-height: 180px;
}

.note-input-card__textarea::placeholder {
  color: var(--n-text-muted);
}

.note-input-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-top: 1px solid var(--n-border-subtle);
  background: var(--n-surface-raised);
}

.note-input-card__hint {
  font-size: 0.75rem;
  color: var(--n-text-muted);
}

.note-input-card__submit {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  background: var(--n-primary);
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.84rem;
  font-weight: 700;
  border-radius: var(--n-r-full);
  transition:
    background var(--n-t-fast),
    transform var(--n-t-fast),
    box-shadow var(--n-t-fast),
    opacity var(--n-t-fast);
  box-shadow: 0 2px 10px var(--n-primary-glow);
  letter-spacing: 0.01em;
}

.note-input-card__submit:hover:not(:disabled) {
  background: var(--n-primary-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px var(--n-primary-glow);
}

.note-input-card__submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.note-input-card__submit.loading {
  background: var(--n-primary-dark);
}

/* ── NOTE DOCUMENT ───────────────────────────────────────────── */
/* ── STYLED SUMMARY BODY ─────────────────────────────────────── */
.sum-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sum-h1 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.01em;
  margin: 18px 0 6px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--n-primary-light);
  display: flex;
  align-items: center;
  gap: 8px;
}

.sum-h1::before {
  content: "";
  display: inline-block;
  width: 4px;
  height: 18px;
  background: linear-gradient(135deg, var(--n-primary), var(--n-purple));
  border-radius: 99px;
  flex-shrink: 0;
}

.sum-h2 {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--n-primary);
  letter-spacing: 0.02em;
  text-transform: uppercase;
  font-size: 0.78rem;
  margin: 16px 0 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.sum-h2::before {
  content: "◆";
  font-size: 0.55rem;
  opacity: 0.7;
}

.sum-h3 {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--n-text-secondary);
  margin: 12px 0 2px;
}

.sum-para {
  font-size: 0.93rem;
  color: var(--n-text-secondary);
  line-height: 1.85;
  margin: 0;
}

.sum-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 0;
  margin: 4px 0;
  list-style: none;
}

.sum-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.88rem;
  color: var(--n-text-secondary);
  line-height: 1.7;
  padding: 8px 12px;
  background: var(--n-surface-raised);
  border-radius: var(--n-r-md);
  border-left: 3px solid var(--n-primary);
  transition:
    background var(--n-t-fast),
    border-color var(--n-t-fast);
}

.sum-list li:hover {
  background: var(--n-primary-light);
  border-color: var(--n-purple);
}

.sum-list li p {
  margin: 0;
}

.note-doc {
  max-width: 760px;
  margin: 0 auto;
  padding: 36px 32px 64px;
  animation: fadeIn var(--n-t-slow) both;
}

.note-doc__header {
  margin-bottom: 28px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--n-border);
}

.note-doc__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.note-doc__badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  background: var(--n-primary-light);
  color: var(--n-primary);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  border-radius: var(--n-r-full);
  border: 1px solid rgba(59, 91, 219, 0.15);
}

.note-doc__badge--pinned {
  background: rgba(245, 158, 11, 0.1);
  color: var(--n-pin);
  border-color: rgba(245, 158, 11, 0.2);
}

.note-doc__title {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.25;
  margin-bottom: 20px;
}

.note-doc__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.note-doc__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--n-r-md);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    transform var(--n-t-fast),
    box-shadow var(--n-t-fast);
  white-space: nowrap;
}

.note-doc__btn:hover {
  transform: translateY(-1px);
}

.note-doc__btn:active {
  transform: translateY(0);
}

.note-doc__btn--ghost {
  background: var(--n-surface-raised);
  color: var(--n-text-secondary);
  border: 1px solid var(--n-border);
}

.note-doc__btn--ghost:hover {
  background: var(--n-primary-light);
  color: var(--n-primary);
  border-color: var(--n-primary);
}

.note-doc__btn--primary {
  background: var(--n-primary);
  color: #fff;
  box-shadow: 0 2px 8px var(--n-primary-glow);
}

.note-doc__btn--primary:hover {
  background: var(--n-primary-dark);
  box-shadow: 0 4px 14px var(--n-primary-glow);
}

.note-doc__btn--danger {
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.note-doc__btn--danger:hover {
  background: var(--n-danger);
  color: #fff;
  border-color: var(--n-danger);
}

.note-doc__body {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.note-doc__section {
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-xl);
  padding: 24px 28px;
  box-shadow: var(--n-shadow-sm);
  transition: box-shadow var(--n-t-base);
}

.note-doc__section:hover {
  box-shadow: var(--n-shadow-card);
}

.note-doc__section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--n-text-muted);
  margin-bottom: 16px;
}

.note-doc__section-icon {
  color: var(--n-primary);
  font-size: 1rem;
}

.note-doc__summary-text {
  font-size: 0.96rem;
  color: var(--n-text-secondary);
  line-height: 1.9;
  letter-spacing: 0.01em;
  padding: 4px 0;
}

.note-doc__keypoints {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.note-doc__keypoint {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 12px 16px;
  background: var(--n-surface-raised);
  border-radius: var(--n-r-md);
  border: 1px solid var(--n-border-subtle);
  transition:
    border-color var(--n-t-fast),
    background var(--n-t-fast);
}

.note-doc__keypoint:hover {
  border-color: var(--n-primary);
  background: var(--n-primary-light);
}

.note-doc__keypoint-num {
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--n-primary);
  background: var(--n-primary-light);
  border-radius: var(--n-r-sm);
  padding: 2px 6px;
  flex-shrink: 0;
  margin-top: 1px;
  letter-spacing: 0.04em;
  min-width: 28px;
  text-align: center;
}

.note-doc__keypoint span:last-child {
  font-size: 0.88rem;
  color: var(--n-text-secondary);
  line-height: 1.65;
}

/* ── TOAST ───────────────────────────────────────────────────── */
.toast {
  position: fixed;
  top: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  border-radius: var(--n-r-lg);
  font-size: 0.85rem;
  font-weight: 500;
  box-shadow: var(--n-shadow-lift);
  z-index: 200;
  animation: slideDown 0.25s cubic-bezier(0.4, 0, 0.2, 1) both;
  max-width: 340px;
}

.toast--success {
  background: var(--n-accent-light);
  color: #166534;
  border: 1px solid rgba(34, 197, 94, 0.25);
}

.toast--error {
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid rgba(239, 68, 68, 0.25);
}

[data-theme="dark"] .toast--success {
  color: var(--n-accent);
  border-color: rgba(52, 211, 153, 0.25);
}

.toast__icon {
  font-size: 0.9rem;
  flex-shrink: 0;
}

.toast__msg {
  flex: 1;
}

.toast__close {
  background: none;
  color: inherit;
  font-size: 0.85rem;
  opacity: 0.6;
  padding: 0 2px;
  transition: opacity var(--n-t-fast);
  flex-shrink: 0;
}

.toast__close:hover {
  opacity: 1;
}

/* ── SPINNER ─────────────────────────────────────────────────── */
.spinner {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.65s linear infinite;
  flex-shrink: 0;
}

.spinner--sm {
  width: 12px;
  height: 12px;
  border-color: rgba(100, 116, 139, 0.25);
  border-top-color: var(--n-text-muted);
}

/* ── ANIMATIONS ──────────────────────────────────────────────── */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  :root {
    --n-sidebar-w: 220px;
  }

  .note-doc {
    padding: 28px 20px 48px;
  }

  .welcome-panel__features {
    grid-template-columns: 1fr;
  }

  .welcome-panel__heading {
    font-size: 1.55rem;
  }
}

@media (max-width: 640px) {
  .notes-page {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr auto;
    height: auto;
    min-height: 100%;
    overflow: visible;
  }

  .notes-main {
    grid-column: 1;
    grid-row: 1;
    overflow-y: visible;
    min-height: calc(100dvh - 256px);
  }

  .notes-sidebar {
    grid-column: 1;
    grid-row: 2;
    border-left: none;
    border-top: 1px solid var(--n-border);
    max-height: 200px;
  }

  .note-doc {
    padding: 20px 16px 48px;
  }

  .note-doc__title {
    font-size: 1.3rem;
  }

  .note-doc__actions {
    gap: 6px;
  }

  .note-doc__btn {
    padding: 6px 10px;
    font-size: 0.75rem;
  }

  .note-doc__section {
    padding: 18px 16px;
  }

  .welcome-panel {
    padding: 32px 16px;
  }

  .welcome-panel__heading {
    font-size: 1.35rem;
  }

  .welcome-panel__features {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .note-input-wrap {
    padding: 20px 16px;
  }

  .toast {
    top: 12px;
    right: 12px;
    left: 12px;
    max-width: none;
  }
}
</file>

<file path="src/pages/styles/ProjectSubmissions.module.css">
/* ─── Design Tokens ──────────────────────────────────────────────────────────── */
:root {
    --clr-sidebar: #1e2040;
    --clr-bg: #f4f5f9;
    --clr-surface: #ffffff;
    --clr-border: #e5e7ef;
    --clr-text-primary: #111827;
    --clr-text-secondary: #6b7280;
    --clr-text-muted: #9ca3af;
    --clr-purple: #7c3aed;
    --clr-purple-light: #ede9fe;
    --clr-blue: #3b82f6;
    --clr-blue-light: #dbeafe;
    --clr-green: #10b981;
    --clr-green-light: #d1fae5;
    --clr-orange: #f97316;
    --clr-red: #ef4444;
    --clr-red-light: #fee2e2;
    --clr-gray: #9ca3af;
    --clr-card-shadow: 0 1px 4px rgba(0, 0, 0, .08), 0 4px 16px rgba(0, 0, 0, .04);
    --clr-card-active: #7c3aed;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --font-main: 'DM Sans', 'Outfit', system-ui, sans-serif;
    --transition: 0.18s cubic-bezier(.4, 0, .2, 1);
}

[data-theme="dark"] {
    --clr-bg: #0f1124;
    --clr-surface: #1a1d35;
    --clr-border: #2a2d4a;
    --clr-text-primary: #f1f5f9;
    --clr-text-secondary: #94a3b8;
    --clr-text-muted: #64748b;
    --clr-purple-light: #2d1f5e;
    --clr-blue-light: #1e3a5f;
    --clr-green-light: #064e3b;
    --clr-red-light: #450a0a;
    --clr-card-shadow: 0 2px 8px rgba(0, 0, 0, .4);
}

/* ─── Layout ─────────────────────────────────────────────────────────────────── */
.wrapper {
    display: flex;
    height: 100%;
    min-height: 0;
    background: var(--clr-bg);
    font-family: var(--font-main);
    overflow: hidden;
}

.wrapperSplit .main {
    flex: 1 1 0;
    min-width: 0;
}

.main {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
}

/* ─── Top Bar ─────────────────────────────────────────────────────────────────── */
.topBar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 28px 32px 20px;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 16px;
}

.pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: var(--clr-text-primary);
    margin: 0 0 6px;
    letter-spacing: -0.5px;
}

.pageSubtitle {
    font-size: 13.5px;
    color: var(--clr-text-secondary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}

.subtitleIcon {
    font-size: 15px;
    opacity: .7;
}

.topRight {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* ─── View Toggle ─────────────────────────────────────────────────────────────── */
.viewToggle {
    display: flex;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.viewBtn {
    background: none;
    border: none;
    padding: 7px 14px;
    font-size: 13px;
    font-family: var(--font-main);
    color: var(--clr-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: background var(--transition), color var(--transition);
}

.viewBtn:hover {
    background: var(--clr-bg);
    color: var(--clr-text-primary);
}

.viewBtnActive {
    background: var(--clr-purple);
    color: #fff;
    font-weight: 600;
}

.viewBtnActive:hover {
    background: var(--clr-purple);
    color: #fff;
}

/* ─── New Project Button ──────────────────────────────────────────────────────── */
.btnNew {
    background: var(--clr-purple);
    color: #fff;
    border: none;
    padding: 9px 18px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background var(--transition), transform var(--transition);
}

.btnNew:hover {
    background: #6d28d9;
    transform: translateY(-1px);
}

/* ─── Kanban Board ────────────────────────────────────────────────────────────── */
.board {
    display: grid;
    grid-template-columns: repeat(4, minmax(240px, 1fr));
    gap: 18px;
    padding: 0 32px 32px;
    overflow-x: auto;
    flex: 1 1 0;
    min-height: 0;
    align-items: start;
}

/* ─── Column ──────────────────────────────────────────────────────────────────── */
.column {
    background: var(--clr-bg);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 220px;
}

.columnHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 12px;
}

.columnLeft {
    display: flex;
    align-items: center;
    gap: 7px;
}

.dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
}

.dotGray {
    background: var(--clr-gray);
}

.dotBlue {
    background: var(--clr-blue);
}

.dotGreen {
    background: var(--clr-green);
}

.columnTitle {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--clr-text-primary);
}

.columnCount {
    font-size: 12px;
    background: var(--clr-border);
    color: var(--clr-text-secondary);
    border-radius: 99px;
    padding: 1px 8px;
    font-weight: 500;
}

.columnMenu {
    background: none;
    border: none;
    color: var(--clr-text-muted);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 4px;
}

.columnMenu:hover {
    background: var(--clr-border);
}

.cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* ─── Add Card ────────────────────────────────────────────────────────────────── */
.addCard {
    margin-top: 10px;
    width: 100%;
    border: 2px dashed var(--clr-border);
    background: none;
    border-radius: var(--radius-sm);
    padding: 12px;
    font-size: 13px;
    color: var(--clr-text-muted);
    cursor: pointer;
    font-family: var(--font-main);
    text-align: center;
    transition: border-color var(--transition), color var(--transition);
}

.addCard:hover {
    border-color: var(--clr-purple);
    color: var(--clr-purple);
}

/* ─── Card ────────────────────────────────────────────────────────────────────── */
.card {
    background: var(--clr-surface);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--radius-md);
    padding: 14px;
    cursor: pointer;
    box-shadow: var(--clr-card-shadow);
    transition: box-shadow var(--transition), border-color var(--transition), transform var(--transition);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.card:hover {
    box-shadow: 0 4px 20px rgba(124, 58, 237, .12);
    transform: translateY(-1px);
}

.cardActive {
    border-color: var(--clr-card-active);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, .15), var(--clr-card-shadow);
}

.cardTitle {
    font-size: 14px;
    font-weight: 600;
    color: var(--clr-text-primary);
    line-height: 1.35;
}

.cardContent {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.cardCourse {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--clr-purple);
    background: var(--clr-purple-light);
    padding: 2px 8px;
    border-radius: 99px;
    align-self: flex-start;
}

.cardAvatars {
    display: flex;
    gap: -4px;
}

.avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--clr-surface);
    flex-shrink: 0;
}

.cardDate {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 500;
}

.dateOrange {
    color: var(--clr-orange);
}

.dateRed {
    color: var(--clr-red);
}

.dateBlue {
    color: var(--clr-blue);
}

.dateGreen {
    color: var(--clr-green);
}

.progressBar {
    height: 4px;
    background: var(--clr-border);
    border-radius: 99px;
    overflow: hidden;
}

.progressFill {
    height: 100%;
    border-radius: 99px;
    transition: width 0.4s ease;
}

.barPurple {
    background: var(--clr-purple);
}

.barBlue {
    background: var(--clr-blue);
}

.barGreen {
    background: var(--clr-green);
}

.cardBadge {
    font-size: 11px;
    color: var(--clr-text-muted);
    background: var(--clr-bg);
    border-radius: 4px;
    padding: 2px 7px;
    align-self: flex-start;
    border: 1px solid var(--clr-border);
}

/* ─── Detail Panel ────────────────────────────────────────────────────────────── */
.detailPanel {
    width: 320px;
    min-width: 300px;
    max-width: 340px;
    background: var(--clr-surface);
    border-left: 1px solid var(--clr-border);
    padding: 24px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: slideIn 0.2s ease;
}

@keyframes slideIn {
    from {
        transform: translateX(24px);
        opacity: 0;
    }

    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.detailHeader {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.detailMeta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.detailCourse {
    font-size: 12px;
    font-weight: 700;
    color: var(--clr-purple);
    background: var(--clr-purple-light);
    padding: 3px 10px;
    border-radius: 99px;
}

.detailStatusBadge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 99px;
}

.badgeNotStarted {
    background: #f3f4f6;
    color: #6b7280;
}

.badgeInProgress {
    background: var(--clr-blue-light);
    color: var(--clr-blue);
}

.badgeSubmitted {
    background: var(--clr-blue-light);
    color: var(--clr-blue);
}

.badgeGraded {
    background: var(--clr-green-light);
    color: var(--clr-green);
}

.detailTitle {
    font-size: 20px;
    font-weight: 700;
    color: var(--clr-text-primary);
    margin: 0;
    line-height: 1.3;
}

.detailSection {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.detailSectionTitle {
    font-size: 13px;
    font-weight: 700;
    color: var(--clr-text-primary);
}

.detailDeadline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--clr-text-secondary);
    flex-wrap: wrap;
}

.detailDeadlineIcon {
    font-size: 16px;
}

.daysLeftBadge {
    background: #fef9c3;
    color: #92400e;
    font-size: 11.5px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 99px;
}

.detailLink {
    font-size: 13px;
    color: var(--clr-purple);
    text-decoration: none;
    word-break: break-all;
}

.detailLink:hover {
    text-decoration: underline;
}

.detailPhaseTag {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--clr-text-secondary);
    background: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: 99px;
    padding: 3px 12px;
    align-self: flex-start;
}

.detailActions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
}

.btnSubmitProject {
    background: var(--clr-purple);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 11px;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-main);
    cursor: pointer;
    transition: background var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.btnSubmitProject:hover {
    background: #6d28d9;
}

.btnDeleteProject {
    background: none;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    padding: 9px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--clr-red);
    font-family: var(--font-main);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.btnDeleteProject:hover {
    background: var(--clr-red-light);
    border-color: var(--clr-red);
}

.editForm {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* ─── Modal ───────────────────────────────────────────────────────────────────── */
.modalOverlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
    animation: fadeIn 0.15s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.modal {
    background: var(--clr-surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 540px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
    animation: modalIn 0.2s cubic-bezier(.34, 1.56, .64, 1);
    overflow: hidden;
}

@keyframes modalIn {
    from {
        transform: scale(.96) translateY(12px);
        opacity: 0;
    }

    to {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
}

.modalHeader {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 24px 0;
}

.modalTitle {
    font-size: 20px;
    font-weight: 700;
    color: var(--clr-text-primary);
    margin: 0 0 4px;
}

.modalSub {
    font-size: 13.5px;
    color: var(--clr-text-secondary);
    margin: 0;
}

.modalClose {
    background: none;
    border: none;
    font-size: 18px;
    color: var(--clr-text-muted);
    cursor: pointer;
    padding: 4px;
    line-height: 1;
    border-radius: 4px;
    transition: background var(--transition);
}

.modalClose:hover {
    background: var(--clr-bg);
    color: var(--clr-text-primary);
}

.modalForm {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.modalFooter {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 4px;
}

/* ─── Form Controls ───────────────────────────────────────────────────────────── */
.formRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.formGroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.formLabel {
    font-size: 13px;
    font-weight: 600;
    color: var(--clr-text-primary);
}

.formInput {
    padding: 9px 12px;
    border: 1.5px solid var(--clr-border);
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    font-family: var(--font-main);
    color: var(--clr-text-primary);
    background: var(--clr-surface);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
    width: 100%;
    box-sizing: border-box;
}

.formInput:focus {
    border-color: var(--clr-purple);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, .1);
}

.formInput::placeholder {
    color: var(--clr-text-muted);
}

.formError {
    background: var(--clr-red-light);
    color: var(--clr-red);
    font-size: 13px;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid #fca5a5;
}

/* ─── Radio Pills ─────────────────────────────────────────────────────────────── */
.radioGroup {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.radioPill {
    padding: 6px 14px;
    border: 1.5px solid var(--clr-border);
    border-radius: 99px;
    font-size: 13px;
    font-weight: 500;
    color: var(--clr-text-secondary);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition), color var(--transition);
    background: var(--clr-surface);
    user-select: none;
}

.radioPill:hover {
    border-color: var(--clr-purple);
    color: var(--clr-purple);
}

.radioPillActive {
    border-color: var(--clr-purple);
    background: var(--clr-purple-light);
    color: var(--clr-purple);
    font-weight: 600;
}

/* ─── Buttons ─────────────────────────────────────────────────────────────────── */
.btnCancel {
    background: none;
    border: 1.5px solid var(--clr-border);
    border-radius: var(--radius-sm);
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--clr-text-secondary);
    cursor: pointer;
    font-family: var(--font-main);
    transition: border-color var(--transition), color var(--transition);
}

.btnCancel:hover {
    border-color: var(--clr-text-secondary);
    color: var(--clr-text-primary);
}

.btnSave {
    background: var(--clr-purple);
    color: #fff;
    border: none;
    padding: 9px 20px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-main);
    cursor: pointer;
    transition: background var(--transition), opacity var(--transition);
}

.btnSave:hover {
    background: #6d28d9;
}

.btnSave:disabled {
    opacity: .6;
    cursor: not-allowed;
}

/* ─── List View ───────────────────────────────────────────────────────────────── */
.listView {
    padding: 0 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow-y: auto;
    flex: 1 1 0;
}

.listHeader {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    font-size: 12px;
    font-weight: 700;
    color: var(--clr-text-muted);
    text-transform: uppercase;
    letter-spacing: .5px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--clr-border);
}

.listRow {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    align-items: center;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 13.5px;
    color: var(--clr-text-secondary);
    transition: background var(--transition);
}

.listRow:hover {
    background: var(--clr-bg);
}

.listTitle {
    font-weight: 600;
    color: var(--clr-text-primary);
}

.listActions {
    display: flex;
    gap: 6px;
}

.listBtn {
    background: none;
    border: 1px solid var(--clr-border);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    color: var(--clr-text-secondary);
    cursor: pointer;
    font-family: var(--font-main);
    transition: background var(--transition);
}

.listBtn:hover {
    background: var(--clr-bg);
}

.listBtnDanger {
    color: var(--clr-red);
}

.listBtnDanger:hover {
    background: var(--clr-red-light);
    border-color: var(--clr-red);
}

/* ─── Loading Skeleton ────────────────────────────────────────────────────────── */
.loadingState {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding: 0 32px 32px;
}

.skeletonCol {
    height: 400px;
    background: var(--clr-surface);
    border-radius: var(--radius-md);
    animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: .5;
    }
}

/* ─── Empty State ─────────────────────────────────────────────────────────────── */
.emptyState {
    padding: 40px;
    text-align: center;
    color: var(--clr-text-muted);
    font-size: 14px;
}

/* ─── Responsive ──────────────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
    .board {
        grid-template-columns: repeat(2, 1fr);
    }

    .detailPanel {
        width: 280px;
    }
}

@media (max-width: 768px) {
    .topBar {
        padding: 20px 16px 16px;
    }

    .board {
        grid-template-columns: 1fr;
        padding: 0 16px 24px;
    }

    .listView {
        padding: 0 16px 24px;
    }

    .listHeader,
    .listRow {
        grid-template-columns: 1fr 1fr;
    }

    .listHeader span:nth-child(n+3),
    .listRow span:nth-child(n+3) {
        display: none;
    }

    .detailPanel {
        width: 100%;
        min-width: unset;
        max-width: unset;
        border-left: none;
        border-top: 1px solid var(--clr-border);
    }

    .wrapper {
        flex-direction: column;
    }

    .formRow {
        grid-template-columns: 1fr;
    }
}
</file>

<file path="src/pages/styles/Quiz.module.css">
/* Quiz.module.css — CSS Modules, theme via data-theme on <html> */
/* Colors now sourced from global.css --theme-* vars */

/* ─── LOCAL ALIASES (map Quiz's old internal vars → theme vars) ─ */
/* These override the old :root block; no hardcoded colors remain  */

.app {
  --bg: var(--theme-bg);
  --surface: var(--theme-surface);
  --surface2: var(--theme-surface-2);
  --border: var(--theme-border);
  --text: var(--theme-text);
  --text2: var(--theme-text-secondary);
  --text3: var(--theme-text-muted);
  --accent: var(--theme-purple);
  --accent-light: var(--theme-purple-dim);
  --accent-mid: var(--theme-purple-light);
  --success: var(--theme-green);
  --error: var(--theme-red);
  --radius: 14px;
  --radius-sm: 8px;
  --shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.28);
}

/* ─── BASE ──────────────────────────────────────────── */
.app {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  transition: background var(--t-slow), color var(--t-slow);
}

.screen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ─── SPLIT LAYOUT ──────────────────────────────────── */
.split {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.splitLeft {
  flex: 1;
  overflow-y: auto;
  padding: 40px 48px;
  min-height: 0;
}

.splitRight {
  width: 420px;
  background: var(--surface2);
  border-left: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
  flex-shrink: 0;
  transition: background var(--t-slow), border-color var(--t-slow);
}

/* ─── HOME ──────────────────────────────────────────── */

.homeCenter {
  max-width: 600px;
  padding: 80px 32px;
  text-align: center;
}

.homeIcon {
  width: 64px;
  height: 64px;
  background: linear-gradient(135deg, var(--theme-purple), var(--theme-purple-light));
  border-radius: 18px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  box-shadow: 0 8px 24px rgba(124, 95, 245, 0.3);
}

.homeH1 {
  font-family: "Lora", serif;
  font-size: 44px;
  line-height: 1.2;
  margin-bottom: 14px;
  color: var(--text);
}

.homeSub {
  font-size: 17px;
  color: var(--text2);
  margin-bottom: 40px;
  line-height: 1.65;
}

.homeCards {
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 20px;
}

.homeCard {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background var(--t-slow), border-color var(--t-slow);
}

.homeCard:hover {
  border-color: var(--accent-mid);
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.homeCard h3 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.homeCard p {
  font-size: 13px;
  color: var(--text2);
  margin: 0;
}

.homeCardIcon {
  font-size: 32px;
  margin-bottom: 12px;
}

.historyBtn {
  width: 100%;
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background var(--t-slow), border-color var(--t-slow), color var(--t-base);
  margin-top: 12px;
}

.historyBtn:hover {
  background: var(--surface2);
  border-color: var(--text3);
}

/* ─── METHOD CARDS ──────────────────────────────────── */
.methodGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 32px;
}

.methodCard {
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 20px;
  background: var(--surface);
  text-align: center;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background var(--t-slow), border-color var(--t-slow);
}

.methodCard:hover {
  border-color: var(--accent-mid);
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}

.methodCard.selected {
  border-color: var(--accent);
  background: var(--accent-light);
}

.methodCard h3 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.methodCard p {
  font-size: 13px;
  color: var(--text2);
  margin: 0;
}

.methodIcon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  margin: 0 auto 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

/* ─── FORMAT PILLS ──────────────────────────────────── */
.formatPills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.pill {
  border: 1px solid var(--border);
  border-radius: 40px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 500;
  background: var(--surface);
  color: var(--text2);
  transition: background var(--t-slow), border-color var(--t-slow);
}

/* ─── DROPZONE ──────────────────────────────────────── */
.dropzone {
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  padding: 56px 32px;
  text-align: center;
  cursor: pointer;
  background: var(--surface);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.dropzone:hover,
.dragover {
  border-color: var(--accent);
  background: var(--accent-light);
}

.uploaded {
  border-color: var(--success);
  background: var(--theme-purple-dim);
  /* repurposed: a subtle tint; swap to a green-dim if you add one */
}

.dropIcon {
  font-size: 36px;
  display: block;
  margin-bottom: 12px;
}

.dropText {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 6px;
}

.dropSub {
  font-size: 13px;
  color: var(--text3);
  margin: 0;
}

.browseLink {
  color: var(--accent);
  text-decoration: underline;
}

/* ─── FORM ──────────────────────────────────────────── */
.formGroup {
  margin-bottom: 20px;
}

.formLabel {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 7px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.formInput {
  width: 100%;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 11px 14px;
  font-size: 14px;
  color: var(--text);
  background: var(--surface);
  transition: border-color var(--t-base), background var(--t-slow);
  outline: none;
  font-family: "DM Sans", sans-serif;
}

.formInput:focus {
  border-color: var(--accent);
}

.formTextarea {
  resize: vertical;
  min-height: 120px;
  line-height: 1.6;
}

.charCount {
  font-size: 12px;
  color: var(--text3);
  text-align: right;
  margin-top: 4px;
}

.segControl {
  display: flex;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--surface);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.segBtn {
  flex: 1;
  padding: 10px;
  font-size: 13px;
  font-weight: 500;
  border: none;
  background: none;
  color: var(--text2);
  cursor: pointer;
  transition: background var(--t-base), color var(--t-base);
}

.segActive {
  background: var(--accent);
  color: var(--theme-text);
}

/* ─── QUESTION TYPES (STEP 3) ───────────────────────── */
.totalBar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  font-size: 14px;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.mutedText {
  font-size: 12px;
  color: var(--text3);
}

.qtypeList {
  display: flex;
  flex-direction: column;
}

.qtypeRow {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-top: none;
  background: var(--surface);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.qtypeRow:last-child {
  border-radius: 0 0 var(--radius) var(--radius);
}

.qtypeRow:hover {
  background: var(--surface2);
}

.qtypeIcon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-right: 14px;
  flex-shrink: 0;
}

.qtypeInfo {
  flex: 1;
}

.qtypeName {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}

.qtypeDesc {
  font-size: 12px;
  color: var(--text2);
  margin-top: 2px;
}

.counter {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cntBtn {
  width: 30px;
  height: 30px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text2);
  transition: background var(--t-base), color var(--t-base), border-color var(--t-base);
  line-height: 1;
}

.cntBtn:hover {
  background: var(--accent);
  color: var(--theme-text);
  border-color: var(--accent);
}

.cntVal {
  width: 44px;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px;
  font-size: 14px;
  font-weight: 500;
  background: var(--surface);
  color: var(--text);
  outline: none;
  transition: background var(--t-slow), border-color var(--t-slow);
}

/* ─── PREVIEW CARD (STEP 3 RIGHT PANEL) ─────────────── */
.quizPreviewCard {
  background: var(--surface);
  border: 2px solid var(--accent);
  border-radius: 14px;
  padding: 18px;
  width: 200px;
  box-shadow:
    0 0 0 6px var(--accent-light),
    var(--shadow-lg);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.pcHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.pcTitle {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
}

.pcBadge {
  width: 22px;
  height: 22px;
  background: var(--accent);
  color: var(--theme-text);
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pcLine {
  height: 7px;
  border-radius: 4px;
  background: var(--border);
  margin-bottom: 7px;
  width: 90%;
}

.pcOpt {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px 8px;
  font-size: 11px;
  color: var(--text3);
  margin-bottom: 4px;
}

/* ─── LOADING ───────────────────────────────────────── */
.loadingScreen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  padding: 60px;
  background: var(--bg);
  height: 100%;
  transition: background var(--t-slow);
}

.loaderCard {
  width: 200px;
  background: var(--surface);
  border-radius: var(--radius);
  border: 2px solid var(--accent);
  padding: 18px;
  box-shadow:
    0 0 0 6px var(--accent-light),
    var(--shadow-lg);
  animation: cardFloat 2s ease-in-out infinite;
  transition: background var(--t-slow), border-color var(--t-slow);
}

@keyframes cardFloat {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

.loaderLines {
  margin: 10px 0;
}

.loaderLine {
  height: 7px;
  border-radius: 4px;
  background: var(--border);
  margin-bottom: 7px;
  animation: shimmer 1.5s ease-in-out infinite;
}

.loaderLine:nth-child(1) {
  width: 80%;
  animation-delay: 0s;
}

.loaderLine:nth-child(2) {
  width: 60%;
  animation-delay: 0.2s;
}

.loaderLine:nth-child(3) {
  width: 70%;
  animation-delay: 0.4s;
}

@keyframes shimmer {

  0%,
  100% {
    opacity: 0.4;
  }

  50% {
    opacity: 1;
  }
}

.loaderHeading {
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.loaderStatus {
  font-size: 15px;
  color: var(--text2);
  animation: fadeStatus 3s ease-in-out infinite;
}

@keyframes fadeStatus {

  0%,
  100% {
    opacity: 0.5;
  }

  50% {
    opacity: 1;
  }
}

/* ─── QUIZ SCREEN ───────────────────────────────────── */
.quizScreen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.quizTopbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0 40px;
  height: 60px;
  display: flex;
  align-items: center;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 50;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.quizTitleBar {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.quizProgress {
  flex: 1;
  height: 6px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
  max-width: 300px;
}

.quizProgressFill {
  height: 100%;
  background: var(--accent);
  border-radius: 3px;
  transition: width 0.4s ease;
}

.quizQnum {
  font-size: 13px;
  color: var(--text2);
  white-space: nowrap;
}

.quizTimer {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  color: var(--text2);
  background: var(--surface2);
  padding: 5px 10px;
  border-radius: 20px;
  border: 1px solid var(--border);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.quizBody {
  max-width: 720px;
  margin: 0 auto;
  padding: 56px 32px;
  width: 100%;
  flex: 1;
  overflow-y: auto;
}

.quizQText {
  font-size: 22px;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 32px;
  font-family: "Lora", serif;
  color: var(--text);
}

.optionList {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.optionCard {
  border: 2px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 18px;
  cursor: pointer;
  background: var(--surface);
  font-size: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  transition: background var(--t-base), border-color var(--t-base);
}

.optionCard:hover {
  border-color: var(--accent-mid);
  background: var(--accent-light);
}

.optionSelected {
  border-color: var(--accent) !important;
  background: var(--accent-light) !important;
}

.optionLetter {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
  transition: background var(--t-base), border-color var(--t-base), color var(--t-base);
  color: var(--text2);
}

.optionLetterActive {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--theme-text);
}

.quizNav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}

.btnNav {
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 11px 24px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--t-base), border-color var(--t-base);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.btnNav:hover {
  background: var(--surface2);
}

.btnSubmit {
  background: var(--accent);
  color: var(--theme-text);
  border: none;
  padding: 12px 32px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--t-base);
  font-family: "DM Sans", sans-serif;
}

.btnSubmit:hover {
  background: var(--theme-purple-light);
}

/* ─── RESULTS ───────────────────────────────────────── */
.resultsScreen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.resultsTop {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 24px 32px;
  display: flex;
  align-items: center;
  gap: 24px;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.scoreRing {
  position: relative;
  width: 90px;
  height: 90px;
  flex-shrink: 0;
}

.scoreRingText {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scorePct {
  font-size: 22px;
  font-weight: 700;
  line-height: 1;
  color: var(--text);
}

.scoreLabel {
  font-size: 12px;
  color: var(--text3);
}

.scoreInfo h2 {
  font-size: 18px;
  margin-bottom: 4px;
  color: var(--text);
}

.scoreGrade {
  display: inline-block;
  padding: 4px 14px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 10px;
  background: var(--accent-light);
  color: var(--accent);
}

.scoreStats {
  display: flex;
  gap: 20px;
  font-size: 13px;
  color: var(--text2);
}

.resultsBody {
  max-width: 800px;
  margin: 0 auto;
  padding: 32px;
  flex: 1;
  overflow-y: auto;
  width: 100%;
}

.filterTabs {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
}

.tabBtn {
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 7px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--t-base), border-color var(--t-base), color var(--t-base);
  color: var(--text2);
  font-family: "DM Sans", sans-serif;
}

.tabActive {
  background: var(--accent);
  color: var(--theme-text);
  border-color: var(--accent);
}

.reviewList {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reviewCard {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.correctCard {
  border-left: 4px solid var(--success);
}

.wrongCard {
  border-left: 4px solid var(--error);
}

.reviewQ {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 8px;
  color: var(--text);
}

.reviewAns {
  font-size: 13px;
  padding: 6px 10px;
  border-radius: 6px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Review answer states — use rgba overlays so they work in both themes */
.userCorrect {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.userWrong {
  background: rgba(239, 68, 68, 0.12);
  color: var(--error);
}

.correctAns {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.resultActions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  padding: 24px 32px;
  border-top: 1px solid var(--border);
  background: var(--surface);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.btnAction {
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 10px 20px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--t-base), border-color var(--t-base);
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: "DM Sans", sans-serif;
}

.btnAction:hover {
  background: var(--surface2);
}

.btnPrimary {
  background: var(--accent);
  color: var(--theme-text);
  border-color: var(--accent);
}

.btnPrimary:hover {
  background: var(--theme-purple-light);
}

/* ─── RIGHT PANEL ───────────────────────────────────── */
.rpanelInfo {
  text-align: center;
  padding: 0 20px;
}

.rpanelInfo h3 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text);
}

.rpanelInfo p {
  font-size: 13px;
  color: var(--text2);
  line-height: 1.6;
}

/* ─── SHARED ─────────────────────────────────────────── */
.accent {
  color: var(--accent);
}

.errorMsg {
  color: var(--error);
  font-size: 13px;
  margin-bottom: 12px;
  padding: 10px 14px;
  background: rgba(239, 68, 68, 0.1);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(239, 68, 68, 0.25);
}

/* ─── HOME WRAPPER (sidebar layout) ─────────────────── */
.homeWrapper {
  display: flex;
  height: 100%;
  overflow: hidden;
}

.homeScreen {
  flex: 1;
  height: 100%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  transition: background var(--t-slow), flex var(--t-slow);
  scrollbar-width: thin;
  scrollbar-color: var(--accent-mid) var(--bg);
}

.homeScreen::-webkit-scrollbar {
  width: 6px;
}

.homeScreen::-webkit-scrollbar-track {
  background: var(--bg);
}

.homeScreen::-webkit-scrollbar-thumb {
  background: var(--accent-mid);
  border-radius: 999px;
}

.homeScreen::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* ─── HISTORY SIDEBAR ────────────────────────────────── */
.historySidebar {
  position: relative;
  height: 100%;
  background: var(--surface);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: row;
  transition: width var(--t-slow), background var(--t-slow), border-color var(--t-slow);
  flex-shrink: 0;
  overflow: hidden;
}

.sidebarOpen {
  width: 300px;
}

.sidebarClosed {
  width: 36px;
}

.sidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background var(--t-base), color var(--t-base), border-color var(--t-slow);
}

.sidebarToggleBtn:hover {
  background: var(--accent-light);
  color: var(--accent);
}

.sidebarContent {
  padding: 24px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--border) var(--surface2);
}

.sidebarContent::-webkit-scrollbar {
  width: 4px;
}

.sidebarContent::-webkit-scrollbar-track {
  background: var(--surface2);
}

.sidebarContent::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

.sidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--text3);
}

.sidebarTitle {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--text);
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--text3);
}

.sidebarItem {
  padding: 12px 14px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 10px;
  cursor: pointer;
  background: var(--surface2);
  transition: background var(--t-base), border-color var(--t-base);
}

.sidebarItem:hover {
  border-color: var(--accent-mid);
  background: var(--accent-light);
}

.sidebarItemTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 3px;
}

.sidebarItemMeta {
  font-size: 11px;
  color: var(--text3);
}

/* ─── ITEM ROW / THREE-DOT MENU ─────────────────────── */
.sidebarItemRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.sidebarItemText {
  flex: 1;
  overflow: hidden;
}

.sidebarItemMenuWrapper {
  position: relative;
  flex-shrink: 0;
}

.threeDotBtn {
  width: 26px;
  height: 26px;
  border: none;
  background: transparent;
  color: var(--text3);
  font-size: 16px;
  cursor: pointer;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  letter-spacing: -1px;
  transition: background var(--t-base), color var(--t-base);
}

.threeDotBtn:hover {
  background: var(--border);
  color: var(--text);
}

.dotMenu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  z-index: 50;
  min-width: 110px;
  overflow: hidden;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.dotMenuDelete {
  width: 100%;
  padding: 9px 14px;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  color: var(--error);
  cursor: pointer;
  transition: background var(--t-base);
}

.dotMenuDelete:hover {
  background: rgba(239, 68, 68, 0.1);
}

/* ─── RESPONSIVE ─────────────────────────────────────── */
@media (max-width: 768px) {
  .splitRight {
    display: none;
  }

  .splitLeft {
    padding: 24px 20px;
  }

  .homeCards,
  .methodGrid {
    grid-template-columns: 1fr;
  }

  .homeH1 {
    font-size: 32px;
  }

  .quizBody {
    padding: 32px 20px;
  }

  .resultsTop {
    flex-direction: column;
    gap: 20px;
  }
}
</file>

<file path="src/pages/styles/register.module.css">
/* register.module.css — Register page (scoped) */
/* Same design system as login.module.css + .auth-tip */

/* ── STAR FIELD ──────────────────────────────────────────────────────────── */
.stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star {
  position: absolute;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  animation: starTwinkle var(--dur, 3s) ease-in-out infinite;
  animation-delay: var(--delay, 0s);
}

@keyframes starTwinkle {
  0%,
  100% {
    opacity: 0.2;
    transform: scale(1);
  }

  50% {
    opacity: 0.9;
    transform: scale(1.4);
  }
}

.auth-toast {
  position: fixed;
  top: 20px;
  right: 20px;
  background: #1a1a1a;
  color: #fff;
  padding: 14px 20px 10px;
  border-radius: 10px;
  min-width: 300px;
  z-index: 9999;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  animation: toast-in 0.3s ease;
}

.auth-toast-text {
  display: block;
  font-size: 0.9rem;
  margin-bottom: 10px;
}

.auth-toast-bar {
  height: 3px;
  background: #22c55e;
  border-radius: 2px;
  animation: slide-bar 6s linear forwards;
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-bar {
  from {
    width: 100%;
  }

  to {
    width: 0%;
  }
}

.auth-root {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  min-height: 100dvh;
}

.auth-left {
  display: flex;
  flex-direction: column;
  /* background: var(--color-bg-left); */
  background: transparent;
  padding: var(--space-6) var(--space-8);
  animation: fadeInLeft var(--dur-slow) var(--ease-out) both;
}

.auth-header {
  flex-shrink: 0;
  margin-bottom: var(--space-6);
}

.navLogo {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: white;
  text-decoration: none;
  white-space: nowrap;
}

.navLogo span {
  color: var(--yellow);
}

.auth-form-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-form-container {
  width: 100%;
  max-width: 26rem;

  /* glassmorphism */
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 1.5rem;
  padding: 2.5rem 2rem;
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.auth-heading-group {
  margin-bottom: var(--space-6);
  animation: slideUp var(--dur-slow) var(--ease-out) 80ms both;
}

.auth-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 2.8vw, 2.1rem);
  font-weight: 700;
  color: white;
  letter-spacing: -0.04em;
  line-height: 1.1;
  margin-bottom: var(--space-2);
}

.auth-subtitle {
  font-size: 0.9375rem;
  color: var(--color-text-muted);
}

.auth-social-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  animation: slideUp var(--dur-slow) var(--ease-out) 100ms both;
}

.auth-social-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-left);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text-heading);
  cursor: pointer;
  box-shadow: var(--shadow-input);
  transition:
    border-color var(--dur-fast),
    background var(--dur-fast),
    box-shadow var(--dur-fast),
    transform var(--dur-fast);
}

.auth-social-btn:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transform: translateY(-1px);
}

.auth-social-btn:active {
  transform: translateY(0);
}

/* ── DIVIDER ──────────────────────────────────────────────── */
.auth-divider {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  animation: slideUp var(--dur-slow) var(--ease-out) 110ms both;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--color-border);
}

.auth-divider-text {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  white-space: nowrap;
}

.auth-error {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  background: var(--color-error-bg);
  border: 1px solid var(--color-error-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  animation: shake 400ms var(--ease-out);
}

.auth-error-icon {
  flex-shrink: 0;
  width: 1.125rem;
  height: 1.125rem;
  border-radius: var(--radius-full);
  background: var(--color-error-text);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  display: grid;
  place-items: center;
  margin-top: 1px;
}

.auth-error-text {
  font-size: 0.875rem;
  color: var(--color-error-text);
  font-weight: 500;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  animation: slideUp var(--dur-slow) var(--ease-out) 120ms both;
}

.auth-field-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.auth-label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text-heading);
  letter-spacing: 0.01em;
}

.auth-input-wrapper {
  position: relative;
}

.auth-input-icon {
  position: absolute;
  left: var(--space-4);
  top: 50%;
  transform: translateY(-50%);
  color: rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  pointer-events: none;
  transition: color var(--dur-fast);
}

.auth-input {
  width: 100%;
  padding: var(--space-3) var(--space-4) var(--space-3)
    calc(var(--space-4) + 1.25rem + var(--space-3));
  background: rgba(255, 255, 255, 0.07);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 0.75rem;
  font-family: var(--font-body);
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.85);
  box-shadow: var(--shadow-input);
  outline: none;
  transition:
    border-color var(--dur-fast),
    background var(--dur-fast),
    box-shadow var(--dur-fast);
}

.auth-input::placeholder {
  color: rgba(255, 255, 255, 0.35);
  font-weight: 300;
}

.auth-input:hover {
  border-color: rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.1);
}

.auth-input:focus {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}

.auth-input-wrapper:focus-within .auth-input-icon {
  color: var(--color-primary);
}

/* ── TIP BANNER (register-only) ───────────────────────────── */
.auth-tip {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  background: rgba(37, 99, 235, 0.12);
  border: 1px solid rgba(37, 99, 235, 0.25);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
}

.auth-tip-icon {
  flex-shrink: 0;
  color: #93c5fd;
  margin-top: 1px;
}

.auth-tip-text {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
}

.auth-tip-text strong {
  font-weight: 700;
  color: #93c5fd;
}
/* Submit button */
.auth-submit-btn {
  width: 100%;
  padding: var(--space-4) var(--space-6);
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 0.01em;
  box-shadow: var(--shadow-btn);
  transition:
    background var(--dur-fast),
    box-shadow var(--dur-fast),
    transform var(--dur-fast);
  position: relative;
  overflow: hidden;
}

.auth-submit-btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.15) 0%,
    transparent 60%
  );
  pointer-events: none;
}

.auth-submit-btn:hover:not(:disabled) {
  background: var(--color-primary-hover);
  box-shadow: var(--shadow-btn-hover);
  transform: translateY(-1px);
}

.auth-submit-btn:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: var(--shadow-btn);
}

.auth-submit-btn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.auth-btn-label,
.auth-btn-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

.auth-btn-arrow {
  transition: transform var(--dur-fast);
}

.auth-submit-btn:hover:not(:disabled) .auth-btn-arrow {
  transform: translateX(3px);
}

.auth-spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 600ms linear infinite;
}

.auth-form-footer {
  margin-top: var(--space-5);
  text-align: center;
  animation: slideUp var(--dur-slow) var(--ease-out) 180ms both;
}

.auth-footer-text {
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

.auth-link {
  color: var(--color-link);
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid transparent;
  transition: border-color var(--dur-fast);
}

.auth-link:hover {
  border-color: var(--color-link);
}

.auth-divider-line {
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(255, 255, 255, 0.15) 20%,
    rgba(255, 255, 255, 0.25) 50%,
    rgba(255, 255, 255, 0.15) 80%,
    transparent 100%
  );
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  align-self: stretch;
}

/* ── RIGHT PANEL ──────────────────────────────────────────── */
.auth-right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  overflow: hidden;
  padding: var(--space-10) var(--space-8);
  animation: fadeInRight var(--dur-slow) var(--ease-out) both;
}

.auth-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.25;
  pointer-events: none;
}

.auth-blob--1 {
  width: 28rem;
  height: 28rem;
  background: #6366f1;
  top: -8rem;
  right: -8rem;
  animation: blobFloat 8s ease-in-out infinite alternate;
}

.auth-blob--2 {
  width: 20rem;
  height: 20rem;
  background: #ec4899;
  bottom: -6rem;
  left: -4rem;
  animation: blobFloat 10s ease-in-out infinite alternate-reverse;
}

.auth-blob--3 {
  width: 14rem;
  height: 14rem;
  background: #0ea5e9;
  top: 40%;
  left: 30%;
  animation: blobFloat 12s ease-in-out infinite alternate;
}

.auth-right-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 28rem;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  animation: slideUp var(--dur-slow) var(--ease-out) 160ms both;
}

.auth-stat-banner {
  background: var(--color-stat-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.auth-stat-number {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
  background: linear-gradient(135deg, #fff 0%, #bfdbfe 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.auth-stat-label {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
}

.auth-showcase-card {
  background: var(--color-glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--color-glass-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
}

.auth-showcase-header {
  margin-bottom: var(--space-5);
}

.auth-showcase-tag {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: var(--space-2);
}

.auth-showcase-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}

.auth-showcase-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

.auth-showcase-item {
  border-radius: var(--radius-md);
  padding: var(--space-4);
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  transition:
    transform var(--dur-fast),
    opacity var(--dur-fast);
  cursor: default;
}

.auth-showcase-item:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

.auth-showcase-item--blue {
  background: rgba(59, 130, 246, 0.5);
}

.auth-showcase-item--purple {
  background: rgba(139, 92, 246, 0.5);
}

.auth-showcase-item--teal {
  background: rgba(20, 184, 166, 0.5);
}

.auth-showcase-item--orange {
  background: rgba(249, 115, 22, 0.5);
}

.auth-tagline {
  text-align: center;
}

.auth-tagline-main {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-3);
}

.auth-tagline-sub {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: var(--space-4);
}

.auth-trust-logos {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-6);
}

.auth-trust-logo {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.55);
  text-transform: uppercase;
  transition: color var(--dur-fast);
}

.auth-trust-logo--lg {
  font-size: 1.25rem;
  letter-spacing: 0.02em;
  color: rgba(255, 255, 255, 0.8);
}

.auth-trust-logo:hover {
  color: #fff;
}

/* ── FOCUS + ANIMATIONS + RESPONSIVE ─────────────────────── */
.auth-submit-btn:focus-visible,
.auth-input:focus-visible,
.auth-link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }

  20% {
    transform: translateX(-6px);
  }

  40% {
    transform: translateX(6px);
  }

  60% {
    transform: translateX(-4px);
  }

  80% {
    transform: translateX(4px);
  }
}

@keyframes blobFloat {
  from {
    transform: scale(1) translate(0, 0);
  }

  to {
    transform: scale(1.15) translate(20px, -20px);
  }
}

@media (max-width: 1024px) {
  .auth-root {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .auth-right {
    order: -1;
    min-height: 38vh;
    padding: var(--space-8) var(--space-6);
  }

  .auth-showcase-card {
    display: none;
  }

  .auth-right-inner {
    gap: var(--space-4);
  }

  .auth-left {
    padding: var(--space-6);
  }
}

@media (max-width: 640px) {
  .auth-left {
    padding: var(--space-5) var(--space-4);
  }

  .auth-right {
    min-height: 30vh;
    padding: var(--space-6) var(--space-4);
  }

  .auth-stat-banner {
    flex-direction: column;
    text-align: center;
    gap: var(--space-2);
  }

  .auth-stat-number {
    font-size: 1.5rem;
  }

  .auth-trust-logos {
    gap: var(--space-4);
  }

  .auth-blob--1 {
    width: 14rem;
    height: 14rem;
  }

  .auth-blob--2 {
    width: 10rem;
    height: 10rem;
  }

  .auth-blob--3 {
    display: none;
  }
}

@media (min-width: 1440px) {
  .auth-form-container {
    max-width: 28rem;
  }

  .auth-right-inner {
    max-width: 32rem;
  }
}

@media (max-width: 1024px) {
  .auth-root {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .auth-divider-line {
    display: none;
  }
}
