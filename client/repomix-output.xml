<file path="src/components/layouts/appShell.module.css">
/* appShell.module.css — App shell layout (scoped) */

/* ── APP SHELL GRID ─────────────────────────────────────────── */
.app-shell {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr 0px;
  transition: grid-template-columns 500ms cubic-bezier(0.4, 0, 0.2, 1);
  grid-template-rows: var(--topbar-h) 1fr;
  grid-template-areas:
    "sidebar topbar    topbar"
    "sidebar main      rightpanel";
  height: 100vh;
  overflow: hidden;
}

.app-shell--panel-open {
  grid-template-columns: var(--sidebar-w) 1fr var(--rightpanel-w);
}

/* ── TOP BAR ────────────────────────────────────────────────── */
.topbar {
  grid-area: topbar;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-3);
  padding: 0 var(--sp-6);
  background: var(--theme-navbar-bg);
  backdrop-filter: var(--theme-navbar-blur);
  border-bottom: 1px solid var(--theme-border);
  box-shadow:
    0 1px 0 rgba(0, 0, 0, 0.15),
    inset 0 -1px 0 var(--theme-border);
  position: sticky;
  top: 0;
  z-index: 40;
  transition: background var(--t-slow), border-color var(--t-slow);
}

.topbar__left {
  margin-right: auto;
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}

.topbar__icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text-secondary);
  transition:
    background var(--t-fast),
    color var(--t-fast);
}

.topbar__icon-btn:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-text);
}

.topbar__upgrade-btn {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 7px 16px;
  background: var(--clr-accent);
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 600;
  border-radius: var(--r-full);
  transition:
    background var(--t-fast),
    transform var(--t-fast),
    box-shadow var(--t-fast);
  box-shadow: 0 2px 8px rgba(34, 197, 94, 0.3);
}

.topbar__upgrade-btn:hover {
  background: var(--clr-accent-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(34, 197, 94, 0.4);
}

.topbar__avatar {
  width: 34px;
  height: 34px;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--clr-primary), var(--clr-purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  flex-shrink: 0;
  transition: box-shadow var(--t-fast);
  box-shadow: 0 2px 8px rgba(124, 111, 224, 0.25);
}

.topbar__avatar:hover {
  box-shadow:
    0 0 0 3px var(--theme-purple-dim),
    0 2px 12px rgba(124, 111, 224, 0.3);
}

/* ── SIDEBAR ────────────────────────────────────────────────── */
.sidebar {
  grid-area: sidebar;
  background: var(--theme-bg);
  border-right: 1px solid var(--theme-border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  z-index: 50;
  position: relative;
  transition: background var(--t-slow), border-color var(--t-slow);
}

/* glowing right edge line */
.sidebar::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(180deg,
      transparent 0%,
      var(--theme-border-hover) 30%,
      var(--theme-border-hover) 70%,
      transparent 100%);
  pointer-events: none;
}

.sidebar__logo {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-5) var(--sp-5) var(--sp-4);
  border-bottom: 1px solid var(--theme-border);
  text-decoration: none;
}

.sidebar__logo-text {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 1.15rem;
  color: var(--theme-text);
  line-height: 1.2;
}

.sidebar__logo-text span {
  color: var(--theme-accent);
}

.sidebar__nav {
  padding: var(--sp-4) var(--sp-3);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.sidebar__section-label {
  font-size: 0.67rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
  padding: var(--sp-4) var(--sp-3) var(--sp-2);
}

.sidebar__link {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 9px var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  transition:
    background var(--t-fast),
    color var(--t-fast),
    padding-left var(--t-base),
    box-shadow var(--t-fast),
    border-color var(--t-fast);
  position: relative;
  white-space: nowrap;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid transparent;
}

.sidebar__link:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  padding-left: 18px;
}

.active {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  font-weight: 600;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 2px 8px var(--theme-purple-dim);
}

.sidebar__link.active::before,
.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 3px;
  background: var(--theme-accent);
  border-radius: 0 var(--r-full) var(--r-full) 0;
  box-shadow: 0 0 8px var(--theme-accent-glow);
}

.sidebar__link-icon {
  color: var(--theme-text-secondary);
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition:
    opacity var(--t-fast),
    color var(--t-fast);
}

.sidebar__link:hover .sidebar__link-icon {
  opacity: 1;
  color: var(--theme-text);
}

.sidebar__link.active .sidebar__link-icon {
  opacity: 1;
}

/* colored icon overrides */
.sidebar__link[data-color="teal"] .sidebar__link-icon {
  color: var(--clr-teal);
}

.sidebar__link[data-color="purple"] .sidebar__link-icon {
  color: var(--theme-purple);
}

.sidebar__link[data-color="pink"] .sidebar__link-icon {
  color: var(--clr-pink);
}

.sidebar__link[data-color="orange"] .sidebar__link-icon {
  color: var(--clr-orange);
}

.sidebar__link[data-color="green"] .sidebar__link-icon {
  color: var(--theme-green);
}

.sidebar__link[data-color="blue"] .sidebar__link-icon {
  color: var(--clr-primary);
}

.sidebar__footer {
  padding: var(--sp-4) var(--sp-3);
  border-top: 1px solid var(--theme-border);
}

.sidebar__logout-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 9px var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--theme-red);
  background: transparent;
  transition:
    background var(--t-fast),
    color var(--t-fast);
  border: 1px solid transparent;
  opacity: 0.75;
}

.sidebar__logout-btn:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.18);
  color: var(--theme-red);
  opacity: 1;
}

/* ── MAIN CONTENT SLOT ──────────────────────────────────────── */
.main-content {
  grid-area: main;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--theme-bg);
  transition: background var(--t-slow);
}

/* ── RIGHT PANEL ────────────────────────────────────────────── */
.right-panel {
  grid-area: rightpanel;
  background: var(--theme-bg);
  border-left: 1px solid var(--theme-border);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  padding: var(--sp-6) var(--sp-5);
  position: relative;
  width: 0;
  min-width: 0;
  opacity: 0;
  transform: translateX(40px);
  pointer-events: none;
  transition:
    opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
    transform 500ms cubic-bezier(0.4, 0, 0.2, 1),
    background var(--t-slow),
    border-color var(--t-slow);
}

.right-panel--open {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
  width: var(--rightpanel-w);
}

/* ── PANEL CLOSE BUTTON ─────────────────────────────────────── */
.panel-close-btn {
  position: absolute;
  top: var(--sp-3);
  right: var(--sp-3);
  width: 26px;
  height: 26px;
  border-radius: var(--r-full);
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-border-hover);
  color: var(--theme-text-secondary);
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition:
    background var(--t-fast),
    color var(--t-fast),
    transform var(--t-fast),
    border-color var(--t-fast);
  z-index: 10;
}

.panel-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.3);
  color: var(--theme-red);
  transform: scale(1.1);
}

/* ── UPGRADE CARD ───────────────────────────────────────────── */
.upgrade-card {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  color: var(--theme-text);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: var(--theme-card-shadow);
  transition: background var(--t-slow), border-color var(--t-slow);
}

.upgrade-card::before {
  content: "";
  position: absolute;
  top: -30px;
  right: -30px;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: radial-gradient(circle,
      var(--theme-purple-dim) 0%,
      transparent 70%);
  pointer-events: none;
}

/* shimmer top edge */
.upgrade-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg,
      transparent,
      var(--theme-border-hover),
      transparent);
}

.upgrade-card__header {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.upgrade-card__badge {
  width: 28px;
  height: 28px;
  border-radius: var(--r-sm);
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-border-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
}

.upgrade-card__title {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--theme-text);
}

.upgrade-card__desc {
  font-size: 0.78rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--sp-4);
}

.upgrade-card__btn {
  width: 100%;
  padding: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--clr-accent);
  color: white;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: var(--r-md);
  transition:
    background var(--t-fast),
    transform var(--t-fast),
    box-shadow var(--t-fast);
  box-shadow: 0 2px 10px rgba(34, 197, 94, 0.25);
}

.upgrade-card__btn:hover {
  background: var(--clr-accent-dark);
  transform: scale(1.01);
  box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);
}

/* ── PANEL WIDGETS ──────────────────────────────────────────── */
.panel-widget {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  padding: var(--sp-4) var(--sp-5);
  flex-shrink: 0;
  transition:
    border-color var(--t-base),
    box-shadow var(--t-base),
    background var(--t-slow);
}

.panel-widget:hover {
  border-color: var(--theme-border-hover);
  box-shadow: 0 4px 16px var(--theme-purple-dim);
}

.panel-widget__title {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--theme-text);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.panel-widget__body {
  font-size: 0.78rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
}

.panel-widget__link {
  display: inline-block;
  margin-top: var(--sp-2);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--theme-accent);
  transition:
    opacity var(--t-fast),
    color var(--t-fast);
}

.panel-widget__link:hover {
  opacity: 0.85;
  color: var(--theme-accent);
}

.streak-widget {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-widget__left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--theme-text);
}

.streak-widget__link {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--theme-accent);
}

/* ── UTILITY ────────────────────────────────────────────────── */
.text-primary {
  color: var(--theme-accent);
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar topbar" "sidebar main";
  }

  .right-panel {
    display: none;
  }
}

@media (max-width: 720px) {
  .app-shell {
    grid-template-columns: 1fr;
    grid-template-rows: var(--topbar-h) 1fr auto;
    grid-template-areas: "topbar" "main" "sidebar";
    height: 100dvh;
  }

  .sidebar {
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
    border-right: none;
    border-top: 1px solid var(--theme-border);
    padding: var(--sp-2) var(--sp-3);
    height: 58px;
  }

  .sidebar__logo,
  .sidebar__section-label,
  .sidebar__footer,
  .sidebar__logo-text {
    display: none;
  }

  .sidebar__nav {
    flex-direction: row;
    align-items: center;
    gap: var(--sp-1);
    padding: 0;
    overflow-x: auto;
  }

  .sidebar__link {
    flex-direction: column;
    gap: 2px;
    padding: 6px 10px;
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .sidebar__link.active::before,
  .active::before {
    display: none;
  }
}
</file>

