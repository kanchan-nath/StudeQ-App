                        {loading ? (
                            <div className={styles.emptyState}>Loading activity…</div>
                        ) : activityRows.length === 0 ? (
                            <div className={styles.emptyState}>No recent activity</div>
                        ) : (
                            <table className={styles.activityTable}>
