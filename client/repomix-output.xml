// ─── Nav Items ────────────────────────────────────────────────────────────────
const NAV_ITEMS = [
    { label: "Dashboard", icon: "grid" },
    { label: "Exams", icon: "file-text" },
    { label: "Projects", icon: "folder" },
    { label: "Assignments", icon: "book-open", active: true },
    { label: "Calendar", icon: "calendar" },
    { label: "Settings", icon: "settings" },
];

const NavIcon = ({ type }) => {
    const icons = {
        grid: <><rect x="3" y="3" width="4" height="4" rx="1" /><rect x="9" y="3" width="4" height="4" rx="1" /><rect x="3" y="9" width="4" height="4" rx="1" /><rect x="9" y="9" width="4" height="4" rx="1" /></>,
        "file-text": <><path d="M14 2H6a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></>,
        folder: <><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></>,
        "book-open": <><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z" /><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" /></>,
        calendar: <><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></>,
        settings: <><circle cx="12" cy="12" r="3" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" /></>,
    };
    return (
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            {icons[type]}
        </svg>
    );
};

// ─── FILTER TABS ──────────────────────────────────────────────────────────────
const FILTERS = ["All", "Today", "This Week", "Overdue", "Completed"];

// ─── Main Assignments Component ───────────────────────────────────────────────
const Assignments = () => {
    const token = localStorage.getItem("token");

    // ── State ──
    const [allAssignments, setAllAssignments] = useState([]);
    const [loading, setLoading] = useState(true);
    const [activeFilter, setActiveFilter] = useState("All");
    const [selectedIds, setSelectedIds] = useState([]);
    const [expandedIds, setExpandedIds] = useState([]);
    const [showModal, setShowModal] = useState(false);
    const [modalLoading, setModalLoading] = useState(false);
    const [form, setForm] = useState({
        title: "",
        subject: "",
        dueDate: "",
        priority: "High",
        assignedBy: "",
        points: "",
        instructions: "",
        notifyStudents: true,
        allowLateSubmission: false,
        linkedAssignmentId: "",
    });
    const [updateId, setUpdateId] = useState(null);
    const [updateForm, setUpdateForm] = useState({});

    // ── Fetch ──
    const fetchAll = async () => {
        setLoading(true);
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/assignment-submission`, {
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            if (!res.ok) throw new Error("Fetch failed");
            const data = await res.json();
            const enriched = (data.data || []).map((item) => ({
                ...item,
                title: item.title || item.linkedAssignmentId || "Untitled Assignment",
                subject: item.subject || "General",
                priority: item.priority || "High",
                initials: item.initials || "DR",
                subjectColor: item.subjectColor || "orange",
            }));
            setAllAssignments(enriched);
        } catch (err) {
            console.error(err);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => { fetchAll(); }, []);

    // ── Helpers ──
    const isOverdue = (item) => {
        if (item.submissionStatus === "submitted") return false;
        if (!item.dueDate) return false;
        return new Date(item.dueDate) < new Date();
    };

    const formatDate = (d) => {
        if (!d) return "";
        const date = new Date(d);
        return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    };

    const filteredAssignments = allAssignments.filter((a) => {
        if (activeFilter === "All") return true;
        if (activeFilter === "Overdue") return isOverdue(a);
        if (activeFilter === "Completed") return a.submissionStatus === "submitted";
        if (activeFilter === "Today") {
            const today = new Date().toDateString();
            return new Date(a.dueDate).toDateString() === today;
        }
        if (activeFilter === "This Week") {
            const now = new Date();
            const end = new Date(now); end.setDate(now.getDate() + 7);
            const due = new Date(a.dueDate);
            return due >= now && due <= end;
        }
        return true;
    });

    const highPriority = filteredAssignments.filter((a) => a.priority === "High");

    // Group by subject
    const grouped = highPriority.reduce((acc, item) => {
        const key = item.subject || "General";
        if (!acc[key]) acc[key] = [];
        acc[key].push(item);
        return acc;
    }, {});

    const subjectColors = ["orange", "teal", "blue", "purple"];
    const subjectColorMap = {};
    Object.keys(grouped).forEach((s, i) => {
        subjectColorMap[s] = subjectColors[i % subjectColors.length];
    });

    // ── Selection ──
    const toggleSelect = (id) => {
        setSelectedIds((prev) =>
            prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]
        );
    };

    const toggleExpand = (id) => {
        setExpandedIds((prev) =>
            prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]
        );
    };

    // ── Create ──
    const handleCreate = async (e) => {
        e.preventDefault();
        setModalLoading(true);
        try {
            const payload = {
                dueDate: form.dueDate,
                allowLateSubmission: form.allowLateSubmission,
                linkedAssignmentId: form.title,
                title: form.title,
                subject: form.subject,
                priority: form.priority,
                assignedBy: form.assignedBy,
                points: form.points,
                instructions: form.instructions,
            };
            const res = await fetch(`${BASE_URL}/api/scheduler/assignment-submission`, {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error("Create failed");
            setShowModal(false);
            resetForm();
            fetchAll();
        } catch (err) {
            console.error(err);
        } finally {
            setModalLoading(false);
        }
    };

    const resetForm = () => {
        setForm({ title: "", subject: "", dueDate: "", priority: "High", assignedBy: "", points: "", instructions: "", notifyStudents: true, allowLateSubmission: false, linkedAssignmentId: "" });
    };

    // ── Delete ──
    const handleDelete = async (id) => {
        try {
            await fetch(`${BASE_URL}/api/scheduler/assignment-submission/${id}`, {
                method: "DELETE",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            fetchAll();
        } catch (err) { console.error(err); }
    };

    // ── Bulk delete ──
    const handleBulkDelete = async () => {
        for (const id of selectedIds) { await handleDelete(id); }
        setSelectedIds([]);
    };

    // ── Mark complete ──
    const handleMarkComplete = async () => {
        for (const id of selectedIds) {
            try {
                await fetch(`${BASE_URL}/api/scheduler/assignment-submission/${id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                    body: JSON.stringify({ submissionStatus: "submitted", submittedAt: new Date().toISOString() }),
                });
            } catch (err) { console.error(err); }
        }
        setSelectedIds([]);
        fetchAll();
    };

    // ── Update ──
    const handleUpdate = async (e) => {
        e.preventDefault();
        try {
            await fetch(`${BASE_URL}/api/scheduler/assignment-submission/${updateId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                body: JSON.stringify(updateForm),
            });
            setUpdateId(null);
            fetchAll();
        } catch (err) { console.error(err); }
    };

    return (
        <div className={styles.layout}>
            {/* ── Sidebar ── */}
            <aside className={styles.sidebar}>
                <div className={styles.sidebarTop}>
                    <div className={styles.logo}>
                        <div className={styles.logoIcon}>S</div>
                        <div>
                            <p className={styles.logoName}>Scholaris</p>
                            <p className={styles.logoSub}>Academic Suite</p>
                        </div>
                    </div>

                    <nav className={styles.nav}>
                        {NAV_ITEMS.map((item) => (
                            <div key={item.label} className={`${styles.navItem} ${item.active ? styles.navActive : ""}`}>
                                <NavIcon type={item.icon} />
                                <span>{item.label}</span>
                            </div>
                        ))}
                    </nav>
                </div>

                <div className={styles.sidebarUser}>
                    <div className={styles.userAvatar}>EM</div>
                    <div>
                        <p className={styles.userName}>Emma Morgan</p>
                        <p className={styles.userRole}>Senior · CS Major</p>
                    </div>
                </div>
            </aside>

            {/* ── Main ── */}
            <main className={styles.main}>
                {/* Header */}
                <div className={styles.header}>
                    <h1 className={styles.pageTitle}>Assignments</h1>
                    <button className={styles.newBtn} onClick={() => setShowModal(true)}>
                        <span>+</span> New Assignment
                    </button>
                </div>

                {/* Filter Tabs */}
                <div className={styles.filters}>
                    {FILTERS.map((f) => (
                        <button
                            key={f}
                            className={`${styles.filterTab} ${activeFilter === f ? styles.filterActive : ""}`}
                            onClick={() => setActiveFilter(f)}
                        >
                            {f}
                        </button>
                    ))}
                </div>

                {/* Assignment List */}
                <div className={styles.listArea}>
