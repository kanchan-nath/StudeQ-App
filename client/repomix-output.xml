                            <div className={styles.resultActions}>
                                <button
                                    className={`${styles.bookmarkBtn} ${saved ? styles.bookmarkActive : ""}`}
                                    onClick={() => onToggleSave(r.link)}
                                    title={saved ? "Unsave" : "Save"}
                                >
                                    {saved ? "★" : "☆"}
                                </button>
                                <button
                                    className={styles.copyBtn}
                                    onClick={(e) => handleCopy(e, r.link, i)}
                                    title="Copy link"
                                >
                                    {copiedIdx === i ? "✓" : "⎘"}
