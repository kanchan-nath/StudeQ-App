<file path="src/pages/styles/Notebook.module.css">
/* ═══════════════════════════════════════════════════════════════════
   Notebook.module.css
   EdTech palette · dark/light · CSS Modules · fully scoped
   ═══════════════════════════════════════════════════════════════════ */

/* ── Design tokens ──────────────────────────────────────────────────
   Light mode (default)
   ─────────────────────────────────────────────────────────────────── */
.root {
  --bg: #f5f6fa;
  --bg-surface: #ffffff;
  --bg-input: #f0f1f7;
  --border: #e2e4ef;
  --text: #1a1d2e;
  --text-muted: #6b7193;
  --text-faint: #a0a4bc;
  --accent: #5b5fef;
  --accent-hover: #4749d4;
  --accent-glow: rgba(91, 95, 239, 0.22);
  --bubble-user-bg: #5b5fef;
  --bubble-user-fg: #ffffff;
  --bubble-ai-bg: #eef0fb;
  --bubble-ai-fg: #1a1d2e;
  --sidebar-bg: #ffffff;
  --sidebar-active: #ededfd;
  --sidebar-hover: #f4f4fd;
  --toast-success-bg: #e6f9f0;
  --toast-success-fg: #1a7a4a;
  --toast-error-bg: #fdecea;
  --toast-error-fg: #b0190e;
  --shadow-sm: 0 1px 4px rgba(30, 32, 60, 0.07);
  --shadow-md: 0 4px 20px rgba(30, 32, 60, 0.1);
  --shadow-lg: 0 8px 40px rgba(30, 32, 60, 0.14);
  --radius: 14px;
  --radius-sm: 8px;
  --radius-pill: 999px;
  --font-display: "DM Serif Display", "Georgia", serif;
  --font-body: "DM Sans", "Helvetica Neue", sans-serif;
  --sidebar-w: 260px;
  --transition: 0.2s ease;
}

/* ── Dark mode ────────────────────────────────────────────────────── */
[data-theme="dark"] {
  --bg: #0f1017;
  --bg-surface: #181924;
  --bg-input: #232536;
  --border: #2a2d42;
  --text: #e8eaf5;
  --text-muted: #8d90b0;
  --text-faint: #555874;
  --accent: #7b80ff;
  --accent-hover: #9195ff;
  --accent-glow: rgba(123, 128, 255, 0.28);
  --bubble-user-bg: #7b80ff;
  --bubble-user-fg: #ffffff;
  --bubble-ai-bg: #1e2035;
  --bubble-ai-fg: #e8eaf5;
  --sidebar-bg: #13141f;
  --sidebar-active: #23254a;
  --sidebar-hover: #1c1e31;
  --toast-success-bg: #0d2a1e;
  --toast-success-fg: #4ade80;
  --toast-error-bg: #2a0f0c;
  --toast-error-fg: #f87171;
  --shadow-sm: 0 1px 4px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.55);
}

/* ══════════════════════════════════════════════════════════════════
   FIX 1 & 2: Root shell — flex row, fixed 100vh, no overflow
   This is the key structural fix for both bugs.
══════════════════════════════════════════════════════════════════ */
.root {
  height: 100%;
  overflow: hidden;
  /* FIX: no page-level scroll */
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  position: relative;
  display: flex;
  /* FIX: flex row — appShell + rightSidebar side by side */
  flex-direction: row;
  transition:
    background var(--transition),
    color var(--transition);
}

/* ══════════════════════════════════════════════════════════════════
   FIX: appShell — takes all remaining width, full height, clips overflow
   Wraps both upload page and chatroom view.
══════════════════════════════════════════════════════════════════ */
.appShell {
  flex: 1;
  min-width: 0;
  /* prevent flex blowout */
  height: 100%;
  overflow: hidden;
  /* children manage their own scroll */
  display: flex;
  flex-direction: column;
}

/* ── Theme toggle ─────────────────────────────────────────────────── */
.themeToggle {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 200;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  background: var(--bg-surface);
  box-shadow: var(--shadow-sm);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    transform 0.2s,
    box-shadow 0.2s;
}

.themeToggle:hover {
  transform: scale(1.1);
  box-shadow: var(--shadow-md);
}

/* ══════════════════════════════════════════════════════════════════
   FIX: RIGHT SIDEBAR — always visible, full height, independent scroll
══════════════════════════════════════════════════════════════════ */
.rightSidebar {
  height: 100%;
  /* FIX: always full viewport height */
  background: var(--bg-surface);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  overflow: hidden;
  transition: width 0.3s ease;
  position: relative;
}

.rightSidebarOpen {
  width: 280px;
}

.rightSidebarClosed {
  width: 36px;
}

.rightSidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background 0.2s;
}

.rightSidebarToggleBtn:hover {
  background: var(--accent-glow);
  color: var(--accent);
}

.rightSidebarContent {
  padding: 24px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  /* FIX: independent scroll */
  scrollbar-width: thin;
  scrollbar-color: var(--border) var(--bg-input);
}

.rightSidebarContent::-webkit-scrollbar {
  width: 4px;
}

.rightSidebarContent::-webkit-scrollbar-track {
  background: var(--bg-input);
}

.rightSidebarContent::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

.rightSidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--text-faint);
}

.rightSidebarTitle {
  font-size: 15px;
  font-weight: 700;
  /* text-transform: capitalize; */
  margin-bottom: 16px;
  color: var(--text);
}

/* ══════════════════════════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════════════════════════ */
.toastStack {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.toast {
  pointer-events: all;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  box-shadow: var(--shadow-md);
  max-width: 340px;
  animation-duration: 0.32s;
  animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  animation-fill-mode: both;
}

.toastEnter {
  animation-name: toastSlideIn;
}

.toastExit {
  animation-name: toastSlideOut;
  animation-timing-function: ease-in;
}

@keyframes toastSlideIn {
  from {
    transform: translateX(110%);
    opacity: 0;
  }

  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes toastSlideOut {
  from {
    transform: translateX(0);
    opacity: 1;
  }

  to {
    transform: translateX(110%);
    opacity: 0;
  }
}

.toast_success {
  background: var(--toast-success-bg);
  color: var(--toast-success-fg);
  border-left: 3px solid currentColor;
}

.toast_error {
  background: var(--toast-error-bg);
  color: var(--toast-error-fg);
  border-left: 3px solid currentColor;
}

.toastIcon {
  font-size: 16px;
  flex-shrink: 0;
}

.toastMsg {
  flex: 1;
}

.toastClose {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
  color: inherit;
  opacity: 0.6;
  line-height: 1;
  padding: 0;
  transition: opacity 0.15s;
}

.toastClose:hover {
  opacity: 1;
}

/* ══════════════════════════════════════════════════════════════════
   VIEW 1 — UPLOAD PAGE
   FIX: flex:1 + overflow-y:auto = fills appShell, scrolls independently
══════════════════════════════════════════════════════════════════ */
.uploadPage {
  flex: 1;
  /* FIX: fill appShell height */
  overflow-y: auto;
  /* FIX: upload page scrolls independently */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 24px 60px;
  gap: 32px;
}

/* Header */
.uploadHeader {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.logoMark {
  margin-bottom: 8px;
  filter: drop-shadow(0 4px 12px var(--accent-glow));
}

.uploadTitle {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 400;
  line-height: 1.2;
  color: var(--text);
  margin: 0;
}

.uploadTitle em {
  font-style: italic;
  color: var(--accent);
}

.uploadSubtitle {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 480px;
  margin: 0;
  line-height: 1.6;
}

/* Format chips */
.formatGrid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
  justify-content: center;
  max-width: 520px;
}

.formatChip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  background: var(--bg-surface);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  box-shadow: var(--shadow-sm);
  transition:
    border-color 0.2s,
    color 0.2s,
    transform 0.15s;
}

.formatChip:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-1px);
}

/* Drop zone */
.dropZone {
  width: 100%;
  max-width: 540px;
  min-height: 200px;
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  background: var(--bg-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    border-color 0.2s,
    background 0.2s,
    box-shadow 0.2s;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.dropZone:hover,
.dropZoneActive {
  border-color: var(--accent);
  background: var(--accent-glow);
  box-shadow:
    0 0 0 4px var(--accent-glow),
    var(--shadow-md);
}

.dropZoneHasFile {
  border-style: solid;
  border-color: var(--accent);
}

.hiddenInput {
  display: none;
}

.dropHint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
  padding: 32px;
  color: var(--text-muted);
}

.dropIcon {
  font-size: 2.2rem;
  display: block;
  margin-bottom: 4px;
  animation: floatUp 2.4s ease-in-out infinite;
}

@keyframes floatUp {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }
}

.dropHint p {
  margin: 0;
  font-size: 14px;
  line-height: 1.5;
}

.dropMeta {
  font-size: 12px !important;
  color: var(--text-faint) !important;
}

.filePreview {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px;
}

.fileIcon {
  font-size: 1.6rem;
}

.fileName {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fileRemove {
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  color: var(--text-muted);
  line-height: 1;
  padding: 0;
  transition: color 0.15s;
}

.fileRemove:hover {
  color: var(--toast-error-fg);
}

/* Upload loader */
.uploadLoader {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 8px 0;
}

.morphBlob {
  width: 52px;
  height: 52px;
  background: var(--accent);
  border-radius: 50%;
  animation: morphBlob 1.8s ease-in-out infinite;
  box-shadow: 0 0 0 0 var(--accent-glow);
}

@keyframes morphBlob {
  0% {
    border-radius: 50%;
    transform: scale(1);
    box-shadow: 0 0 0 0 var(--accent-glow);
  }

  30% {
    border-radius: 40% 60% 60% 40% / 50% 40% 60% 50%;
    transform: scale(1.08);
  }

  60% {
    border-radius: 60% 40% 40% 60% / 40% 60% 50% 40%;
    transform: scale(0.96);
    box-shadow: 0 0 0 14px transparent;
  }

  100% {
    border-radius: 50%;
    transform: scale(1);
    box-shadow: 0 0 0 0 var(--accent-glow);
  }
}

.uploadLoaderText {
  font-size: 14px;
  color: var(--text-muted);
  margin: 0;
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}

/* Submit button */
.submitBtn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  border-radius: var(--radius-pill);
  border: none;
  background: var(--border);
  color: var(--text-faint);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  cursor: not-allowed;
  transition:
    background 0.2s,
    color 0.2s,
    box-shadow 0.2s,
    transform 0.15s;
}

.submitBtnActive {
  background: var(--accent);
  color: #fff;
  cursor: pointer;
  box-shadow: 0 4px 20px var(--accent-glow);
}

.submitBtnActive:hover {
  background: var(--accent-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--accent-glow);
}

.submitBtnActive:active {
  transform: translateY(0);
}

/* ══════════════════════════════════════════════════════════════════
   VIEW 2 — CHATROOM
   FIX: height:100% (inherits from appShell), not 100vh
══════════════════════════════════════════════════════════════════ */
.chatroomShell {
  display: flex;
  height: 100%;
  /* FIX: was 100vh — now fills appShell */
  overflow: hidden;
}

/* ── Left Sidebar ───────────────────────────────────────────────── */
.sidebar {
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  position: relative;
}

.sidebarOpen {
  width: var(--sidebar-w);
}

.sidebarClosed {
  width: 44px;
}

.sidebarHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 14px 12px;
  flex-shrink: 0;
  gap: 8px;
}

.sidebarHeading {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 400;
  color: var(--text-muted);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
}

.sidebarToggle {
  background: none;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text-muted);
  font-size: 12px;
  flex-shrink: 0;
  transition:
    background 0.15s,
    color 0.15s;
}

.sidebarToggle:hover {
  background: var(--sidebar-hover);
  color: var(--text);
}

.sidebarList {
  list-style: none;
  padding: 0 8px;
  margin: 0;
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--text-faint);
  padding: 12px 8px;
  text-align: center;
}

.sidebarItem {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 9px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background 0.15s;
  position: relative;
}

.sidebarItem:hover {
  background: var(--sidebar-hover);
}

.sidebarItemActive {
  background: var(--sidebar-active) !important;
}

.sidebarItemActive .sidebarTitle {
  color: var(--accent);
  font-weight: 600;
}

.sidebarTitle {
  font-size: 13px;
  color: var(--text);
  white-space: nowrap;
  text-transform: capitalize;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  line-height: 1.4;
}

.sidebarDots {
  background: none;
  border: none;
  font-size: 16px;
  color: var(--text-faint);
  cursor: pointer;
  padding: 2px 4px;
  border-radius: 4px;
  opacity: 0;
  transition:
    opacity 0.15s,
    background 0.15s;
  line-height: 1;
}

.sidebarItem:hover .sidebarDots {
  opacity: 1;
}

.sidebarDots:hover {
  background: var(--border);
  color: var(--text);
}

.sidebarMenu {
  position: absolute;
  right: 8px;
  top: 100%;
  z-index: 50;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  padding: 4px;
  animation: menuPop 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes menuPop {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(-4px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.sidebarMenuDelete {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 7px 12px;
  background: none;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  color: var(--toast-error-fg);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s;
}

.sidebarMenuDelete:hover {
  background: var(--toast-error-bg);
}

.newChatBtn {
  margin: 8px;
  padding: 10px;
  border-radius: var(--radius-sm);
  border: 1px dashed var(--border);
  background: none;
  color: var(--text-muted);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition:
    border-color 0.2s,
    color 0.2s,
    background 0.2s;
}

.newChatBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-glow);
}

/* ── Chat main ──────────────────────────────────────────────────── */
.chatroomMain {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  min-width: 0;
  min-height: 0; 
}

/* Chat header */
.chatHeader {
  padding: 18px 28px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-surface);
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.chatHeaderInner {
  display: flex;
  align-items: center;
  gap: 10px;
}

.chatHeaderDot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  flex-shrink: 0;
  animation: dotPulse 2s ease-in-out infinite;
}

@keyframes dotPulse {

  0%,
  100% {
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  }

  50% {
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1);
  }
}

.chatTitle {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 400;
  text-transform: capitalize;
  margin: 0;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Messages area — FIX: flex:1 + overflow-y:auto = independent scroll */
.messagesArea {
  flex: 1;
  overflow-y: auto;
  /* FIX: independent scroll */
  padding: 28px 28px 8px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  scroll-behavior: smooth;
  min-height: 0;
}

/* Message rows */
.messageRow {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  animation: msgFadeUp 0.28s ease both;
}

@keyframes msgFadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.messageRowUser {
  flex-direction: row-reverse;
}

.messageRowAI {
  flex-direction: row;
}

/* Avatars */
.aiAvatar,
.userAvatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.aiAvatar {
  background: var(--accent);
  color: #fff;
  letter-spacing: 0.02em;
}

.userAvatar {
  background: var(--bg-input);
  color: var(--text-muted);
}

/* Bubbles */
.messageBubble {
  max-width: min(520px, 72%);
  padding: 12px 16px;
  border-radius: 16px;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s;
}

.bubbleUser {
  background: var(--bubble-user-bg);
  color: var(--bubble-user-fg);
  border-bottom-right-radius: 4px;
}

/* AI bubble — no background, wider, document-like */
.bubbleAI {
  background: transparent;
  color: var(--bubble-ai-fg);
  border-bottom-left-radius: 4px;
  box-shadow: none;
  max-width: 100%;
  /* much wider */
  padding: 4px 0;
}

/* AI content typography */
.aiContent {
  font-size: 15px;
  line-height: 1.75;
  color: var(--text);
}

.aiContent p {
  margin: 0 0 12px;
}

.aiContent p:last-child {
  margin-bottom: 0;
}

/* Step headings — bold + accent color like Claude */
.aiContent h1,
.aiContent h2,
.aiContent h3 {
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--text);
  margin: 20px 0 8px;
  line-height: 1.35;
}

.aiContent h1 {
  font-size: 1.2rem;
}

.aiContent h2 {
  font-size: 1.08rem;
}

.aiContent h3 {
  font-size: 0.98rem;
  color: var(--accent);
}

.aiContent ul,
.aiContent ol {
  padding-left: 1.5em;
  margin: 8px 0 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.aiContent li {
  font-size: 15px;
  line-height: 1.7;
}

.aiContent code {
  background: rgba(91, 95, 239, 0.12);
  color: var(--accent);
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 13px;
  font-family: "Fira Code", monospace;
}

.aiContent pre {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  overflow-x: auto;
  margin: 12px 0;
}

.aiContent pre code {
  background: none;
  color: var(--text);
  padding: 0;
}

/* Math blocks — distinct card with accent border */
.aiContent .katex-display {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 14px 18px;
  margin: 14px 0;
  overflow-x: auto;
  box-shadow: var(--shadow-sm);
}

/* Inline math */
.aiContent .katex {
  font-size: 1em;
}

.aiContent blockquote {
  border-left: 3px solid var(--accent);
  padding: 8px 16px;
  margin: 12px 0;
  background: var(--accent-glow);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-muted);
  font-style: italic;
}

.aiContent table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 12px 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.aiContent th {
  background: var(--accent);
  color: #fff;
  padding: 9px 14px;
  text-align: left;
  font-weight: 600;
}

.aiContent td {
  padding: 8px 14px;
  border-bottom: 1px solid var(--border);
}

.aiContent tr:nth-child(even) td {
  background: var(--bg-input);
}

.aiContent strong {
  font-weight: 700;
}

.aiContent em {
  font-style: italic;
  opacity: 0.88;
}

.aiContent hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 16px 0;
}

.aiContent a {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.bubbleEditing {
  box-shadow:
    0 0 0 2px var(--accent),
    var(--shadow-sm);
}

.messageContent {
  margin: 0 0 4px;
  font-size: 14px;
  line-height: 1.65;
  word-break: break-word;
}
/* ── Markdown inside AI bubble ───────────────────────────────────── */
.messageContent p {
  margin: 0 0 8px;
  line-height: 1.7;
}

.messageContent p:last-child {
  margin-bottom: 0;
}

.messageContent h1,
.messageContent h2,
.messageContent h3 {
  font-family: var(--font-display);
  font-weight: 600;
  margin: 14px 0 6px;
  color: var(--text);
  line-height: 1.3;
}

.messageContent h1 {
  font-size: 1.15rem;
}

.messageContent h2 {
  font-size: 1.05rem;
}

.messageContent h3 {
  font-size: 0.95rem;
}

.messageContent ul,
.messageContent ol {
  padding-left: 1.4em;
  margin: 6px 0 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.messageContent li {
  font-size: 14px;
  line-height: 1.6;
}

.messageContent code {
  background: rgba(91, 95, 239, 0.12);
  color: var(--accent);
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 13px;
  font-family: "Fira Code", "Cascadia Code", monospace;
}

.messageContent pre {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  overflow-x: auto;
  margin: 10px 0;
  box-shadow: var(--shadow-sm);
}

.messageContent pre code {
  background: none;
  color: var(--text);
  padding: 0;
  font-size: 13px;
}

.messageContent blockquote {
  border-left: 3px solid var(--accent);
  padding: 6px 14px;
  margin: 10px 0;
  background: var(--accent-glow);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-muted);
  font-style: italic;
}

.messageContent table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin: 10px 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.messageContent th {
  background: var(--accent);
  color: #fff;
  padding: 8px 12px;
  text-align: left;
  font-weight: 600;
}

.messageContent td {
  padding: 7px 12px;
  border-bottom: 1px solid var(--border);
}

.messageContent tr:nth-child(even) td {
  background: var(--bg-input);
}

.messageContent a {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.messageContent a:hover {
  color: var(--accent-hover);
}

.messageContent hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 12px 0;
}

.messageContent strong {
  font-weight: 700;
}

.messageContent em {
  font-style: italic;
  opacity: 0.9;
}

.messageTime {
  font-size: 11px;
  opacity: 0.55;
  display: block;
  margin-top: 2px;
}

/* Edit button */
.editBtn {
  position: absolute;
  bottom: -30px;
  right: 0;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 12px;
  padding: 4px 10px;
  cursor: pointer;
  color: var(--accent);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
  white-space: nowrap;
  animation: menuPop 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 10;
  transition: background 0.15s;
}

.editBtn:hover {
  background: var(--sidebar-active);
}

/* ── Thinking bubble ──────────────────────────────────────────── */
.thinkingBubble {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bubble-ai-bg);
  padding: 12px 18px;
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  box-shadow: var(--shadow-sm);
}

.thinkingLabel {
  font-size: 13px;
  color: var(--text-muted);
  font-style: italic;
}

.dots {
  display: flex;
  gap: 4px;
  align-items: center;
}

.dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: dotBounce 1.2s ease-in-out infinite;
  display: block;
}

.dots span:nth-child(2) {
  animation-delay: 0.18s;
}

.dots span:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes dotBounce {

  0%,
  80%,
  100% {
    transform: translateY(0) scale(1);
    opacity: 0.5;
  }

  40% {
    transform: translateY(-7px) scale(1.1);
    opacity: 1;
  }
}

/* ── Input bar — flex-shrink:0 keeps it pinned at bottom ─────── */
.inputBar {
  padding: 16px 28px 20px;
  background: var(--bg-surface);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}

.editBanner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--accent-glow);
  border-radius: var(--radius-sm);
  padding: 6px 12px;
  font-size: 12px;
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 10px;
}

.editBanner button {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  padding: 0;
  transition: opacity 0.15s;
}

.editBanner button:hover {
  opacity: 0.7;
}

.inputForm {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 6px 6px 6px 18px;
  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.inputForm:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}

.queryInput {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--text);
  min-width: 0;
}

.queryInput::placeholder {
  color: var(--text-faint);
}

.sendBtn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: var(--border);
  color: var(--text-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: not-allowed;
  flex-shrink: 0;
  transition:
    background 0.2s,
    color 0.2s,
    transform 0.15s,
    box-shadow 0.2s;
}

.sendBtnActive {
  background: var(--accent);
  color: #fff;
  cursor: pointer;
  box-shadow: 0 2px 12px var(--accent-glow);
}

.sendBtnActive:hover {
  background: var(--accent-hover);
  transform: scale(1.07);
}

.sendBtnActive:active {
  transform: scale(0.96);
}

/* ══════════════════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .uploadPage {
    padding: 48px 16px 40px;
    gap: 24px;
  }

  .messagesArea {
    padding: 16px 16px 8px;
  }

  .chatHeader {
    padding: 14px 16px;
  }

  .inputBar {
    padding: 12px 16px 16px;
  }

  .messageBubble {
    max-width: 100%;
  }

  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 100;
    box-shadow: var(--shadow-lg);
  }

  .sidebarClosed {
    width: 0;
    padding: 0;
    border: none;
  }

  /* Hide right sidebar on small screens */
  .rightSidebar {
    display: none;
  }
}

@media (max-width: 480px) {
  .uploadTitle {
    font-size: 1.7rem;
  }

  .formatGrid {
    gap: 7px;
  }

  .formatChip {
    font-size: 12px;
    padding: 5px 10px;
  }

  .toastStack {
    right: 12px;
    bottom: 12px;
  }

  .toast {
    font-size: 13px;
  }
}

/* ── Scrollbar styling ───────────────────────────────────────────── */
.messagesArea::-webkit-scrollbar,
.sidebarList::-webkit-scrollbar {
  width: 4px;
}

.messagesArea::-webkit-scrollbar-thumb,
.sidebarList::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}

.messagesArea::-webkit-scrollbar-track,
.sidebarList::-webkit-scrollbar-track {
  background: transparent;
}
