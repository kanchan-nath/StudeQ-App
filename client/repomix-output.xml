// ─── Main Component ───────────────────────────────────────────────────────────

const ExamSchedule = () => {
    const [exams, setExams] = useState([])
    const [loading, setLoading] = useState(true)

    // Filters
    const [search, setSearch] = useState("")
    const [filterStatus, setFilterStatus] = useState("")
    const [filterSubject, setFilterSubject] = useState("")

    // Sort
    const [sortField, setSortField] = useState("examDate")
    const [sortDir, setSortDir] = useState("asc")

    // Pagination
    const [page, setPage] = useState(1)

    // UI state
    const [selectedExam, setSelectedExam] = useState(null)
    const [modalMode, setModalMode] = useState(null) // "add" | "edit" | null
    const [editTarget, setEditTarget] = useState(null)
    const [deleteTarget, setDeleteTarget] = useState(null)

    // ── Fetch ──────────────────────────────────────────────────────────────────
    const fetchExams = useCallback(async () => {
        setLoading(true)
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/exam-dates`, { headers: authHeaders() })
            if (!res.ok) throw new Error("Fetch failed")
            const data = await res.json()
            setExams(data.data || [])
        } catch (err) {
            console.error(err)
        } finally {
            setLoading(false)
        }
    }, [])

    useEffect(() => { fetchExams() }, [fetchExams])

    // ── Delete ─────────────────────────────────────────────────────────────────
    const handleDelete = async () => {
        if (!deleteTarget) return
        try {
            await fetch(`${BASE_URL}/api/scheduler/exam-dates/${deleteTarget._id}`, {
                method: "DELETE", headers: authHeaders(),
            })
            setDeleteTarget(null)
            if (selectedExam?._id === deleteTarget._id) setSelectedExam(null)
            fetchExams()
        } catch (err) { console.error(err) }
    }

    // ── Sort toggle ────────────────────────────────────────────────────────────
    const handleSort = (field) => {
        if (sortField === field) setSortDir((d) => (d === "asc" ? "desc" : "asc"))
        else { setSortField(field); setSortDir("asc") }
        setPage(1)
    }

    // ── Derived: subjects list ─────────────────────────────────────────────────
    const subjectOptions = useMemo(
        () => [...new Set(exams.map((e) => e.subjectName).filter(Boolean))],
        [exams]
    )

    // ── Filtered + sorted list ─────────────────────────────────────────────────
    const filtered = useMemo(() => {
        let list = [...exams]
        if (search) {
            const q = search.toLowerCase()
            list = list.filter(
                (e) =>
                    (e.subjectName || "").toLowerCase().includes(q) ||
                    (e.venue || "").toLowerCase().includes(q) ||
                    (e.subjectCode || "").toLowerCase().includes(q)
            )
        }
        if (filterStatus) list = list.filter((e) => deriveStatus(e) === filterStatus)
        if (filterSubject) list = list.filter((e) => e.subjectName === filterSubject)

        list.sort((a, b) => {
            let av, bv
            if (sortField === "examDate") {
                av = new Date(`${a.examDate}T${a.examTime || "00:00"}`)
                bv = new Date(`${b.examDate}T${b.examTime || "00:00"}`)
            } else if (sortField === "subjectName") {
                av = (a.subjectName || "").toLowerCase()
                bv = (b.subjectName || "").toLowerCase()
            } else if (sortField === "examType") {
                av = (a.examType || "").toLowerCase()
                bv = (b.examType || "").toLowerCase()
            }
            if (av < bv) return sortDir === "asc" ? -1 : 1
            if (av > bv) return sortDir === "asc" ? 1 : -1
            return 0
        })
        return list
    }, [exams, search, filterStatus, filterSubject, sortField, sortDir])

    const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE))
    const paginated = filtered.slice((page - 1) * ITEMS_PER_PAGE, page * ITEMS_PER_PAGE)

    const handlePageChange = (p) => {
        if (p < 1 || p > totalPages) return
        setPage(p)
    }

    // Pagination buttons: show prev, up to 3 pages, next
    const pageNumbers = useMemo(() => {
        const nums = []
        const start = Math.max(1, Math.min(page - 1, totalPages - 2))
        const end = Math.min(totalPages, start + 2)
        for (let i = start; i <= end; i++) nums.push(i)
        return nums
    }, [page, totalPages])

    return (
        <div className={styles.page}>
            {/* ── Header ── */}
            <div className={styles.header}>
                <h1 className={styles.pageTitle}>Exam Schedule</h1>
                <button className={styles.addBtn} onClick={() => { setEditTarget(null); setModalMode("add") }}>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add Exam
                </button>
            </div>

            {/* ── Filter Bar ── */}
            <div className={styles.filterBar}>
                <div className={styles.searchWrap}>
                    <svg className={styles.searchIcon} width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input
                        className={styles.searchInput}
                        placeholder="Search exams..."
                        value={search}
                        onChange={(e) => { setSearch(e.target.value); setPage(1) }}
                    />
                </div>

                <div className={styles.filterSep} />

                <select className={styles.filterSelect} value={filterSubject} onChange={(e) => { setFilterSubject(e.target.value); setPage(1) }}>
                    <option value="">Subject</option>
                    {subjectOptions.map((s) => <option key={s} value={s}>{s}</option>)}
                </select>

                <select className={styles.filterSelect} value={filterStatus} onChange={(e) => { setFilterStatus(e.target.value); setPage(1) }}>
                    <option value="">Status</option>
                    <option value="upcoming">Upcoming</option>
                    <option value="urgent">Urgent</option>
                    <option value="completed">Completed</option>
                </select>

                <button className={styles.dateRangeBtn}>
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    Date Range
                </button>
            </div>

            {/* ── Table ── */}
            <div className={styles.tablePanel}>
                <div className={styles.tableScroll}>
                    <table className={styles.table}>
                        <thead>
                            <tr>
                                <th
                                    className={`${styles.sortable} ${sortField === "subjectName" ? styles.sortActive : ""}`}
                                    onClick={() => handleSort("subjectName")}
                                >
                                    <div className={styles.thInner}>
                                        Subject
                                        <SortIcon field="subjectName" sortField={sortField} sortDir={sortDir} />
                                    </div>
                                </th>
                                <th
                                    className={`${styles.sortable} ${sortField === "examType" ? styles.sortActive : ""}`}
                                    onClick={() => handleSort("examType")}
                                >
                                    <div className={styles.thInner}>
                                        Exam Type
                                        <SortIcon field="examType" sortField={sortField} sortDir={sortDir} />
                                    </div>
                                </th>
                                <th
                                    className={`${styles.sortable} ${sortField === "examDate" ? styles.sortActive : ""}`}
                                    onClick={() => handleSort("examDate")}
                                >
                                    <div className={styles.thInner}>
                                        Date & Time
                                        <SortIcon field="examDate" sortField={sortField} sortDir={sortDir} />
                                    </div>
                                </th>
                                <th>Venue / Room</th>
                                <th>Duration</th>
                                <th>Invigilator</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {loading ? (
                                <SkeletonRows />
                            ) : paginated.length === 0 ? (
                                <tr>
                                    <td colSpan={8}>
                                        <div className={styles.emptyState}>
                                            <div className={styles.emptyIcon}>📋</div>
                                            <div className={styles.emptyText}>
                                                {search || filterStatus || filterSubject
                                                    ? "No exams match your filters"
                                                    : "No exams scheduled yet"}
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            ) : (
                                paginated.map((exam) => {
                                    const status = deriveStatus(exam)
                                    const isSelected = selectedExam?._id === exam._id
                                    return (
                                        <tr
                                            key={exam._id}
                                            className={isSelected ? styles.rowSelected : ""}
                                            onClick={() => setSelectedExam(isSelected ? null : exam)}
                                        >
                                            <td className={styles.tdSubject}>{exam.subjectName || "—"}</td>
                                            <td className={styles.tdMeta}>{exam.examType || "—"}</td>
                                            <td className={styles.tdDateTime}>
                                                <div className={styles.dateMain}>{formatDate(exam.examDate)}</div>
                                                {exam.examTime && (
                                                    <div className={styles.dateTime}>{formatTime(exam.examTime)}</div>
                                                )}
                                            </td>
                                            <td className={styles.tdMeta}>{exam.venue || (exam.onlineLink ? "Online" : "—")}</td>
                                            <td className={styles.tdMeta}>{exam.duration ? `${exam.duration} min` : "—"}</td>
                                            <td className={styles.tdMeta}>{exam.invigilator || "—"}</td>
                                            <td><StatusBadge status={status} /></td>
                                            <td>
                                                <div className={styles.actions} onClick={(e) => e.stopPropagation()}>
                                                    <button
                                                        className={`${styles.iconBtn} ${styles.editBtn}`}
                                                        aria-label="Edit exam"
                                                        onClick={() => { setEditTarget(exam); setModalMode("edit") }}
                                                    >
                                                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                    </button>
                                                    <button
                                                        className={`${styles.iconBtn} ${styles.deleteBtn}`}
                                                        aria-label="Delete exam"
                                                        onClick={() => setDeleteTarget(exam)}
                                                    >
                                                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" /></svg>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    )
                                })
                            )}
                        </tbody>
                    </table>
                </div>

                {/* ── Footer ── */}
                <div className={styles.tableFooter}>
                    <span className={styles.footerText}>
                        {loading
                            ? "Loading…"
                            : `Showing ${filtered.length === 0 ? 0 : (page - 1) * ITEMS_PER_PAGE + 1}–${Math.min(page * ITEMS_PER_PAGE, filtered.length)} of ${filtered.length} exam${filtered.length !== 1 ? "s" : ""}`}
                    </span>
                    <div className={styles.pagination}>
                        <button
                            className={styles.pageBtn}
                            onClick={() => handlePageChange(page - 1)}
                            disabled={page === 1}
                            aria-label="Previous page"
                        >
                            ‹
                        </button>
                        {pageNumbers.map((n) => (
                            <button
                                key={n}
                                className={`${styles.pageBtn} ${n === page ? styles.pageBtnActive : ""}`}
                                onClick={() => handlePageChange(n)}
                            >
                                {n}
                            </button>
                        ))}
                        <button
                            className={styles.pageBtn}
                            onClick={() => handlePageChange(page + 1)}
                            disabled={page === totalPages}
                            aria-label="Next page"
                        >
                            ›
                        </button>
                    </div>
                </div>
            </div>

            {/* ── Detail Drawer ── */}
            {selectedExam && (
                <DetailDrawer
                    exam={selectedExam}
                    onClose={() => setSelectedExam(null)}
                    onEdit={(exam) => { setEditTarget(exam); setModalMode("edit") }}
                />
            )}

            {/* ── Add / Edit Modal ── */}
            {modalMode && (
                <ExamModal
                    mode={modalMode}
                    initial={modalMode === "edit" ? editTarget : null}
                    onClose={() => { setModalMode(null); setEditTarget(null) }}
                    onSuccess={fetchExams}
                />
            )}

            {/* ── Delete Confirm ── */}
            {deleteTarget && (
                <DeleteConfirm
                    exam={deleteTarget}
                    onClose={() => setDeleteTarget(null)}
                    onConfirm={handleDelete}
                />
            )}
        </div>
    )
}

export default ExamSchedule
