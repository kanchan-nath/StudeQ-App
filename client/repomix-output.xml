import styles from "./styles/ExamSchedule.module.css"
import BASE_URL from "../lib/api.js"

// ─── Constants ────────────────────────────────────────────────────────────────

const ITEMS_PER_PAGE = 7

const EMPTY_FORM = {
    subjectName: "",
    examDate: "",
    examTime: "",
    duration: "",
    venue: "",
    onlineLink: "",
    subjectCode: "",
    notes: "",
