<file path="src/pages/styles/Home.module.css">
/*
  LandingPage.module.css
  CSS Modules — all class names scoped, no bare element selectors outside :root
  Fusion: turbo.ai dark starfield base + penseum.com timeline/comparison cards
*/

/* ── DESIGN TOKENS ───────────────────────────────────────────────────────── */
:root {
  --bg: rgba(10, 12, 20, 1);
  --card: #1c1c1f;
  --card2: #242428;
  --border: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(255, 255, 255, 0.16);
  --text: #f0f0f0;
  --muted: #8a8a9a;
  --yellow: #ffd166;
  --yellow-dim: rgba(255, 209, 102, 0.12);
  --yellow-glow: rgba(255, 209, 102, 0.25);
  --purple: #7c5ff5;
  --purple-light: #c084fc;
  --purple-dim: rgba(124, 95, 245, 0.15);
  --green: #22c55e;
  --red: #ef4444;
  --font-display:
    "Syne", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body:
    "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-xl: 24px;
  --r-2xl: 32px;
  --r-full: 9999px;
  --max-w: 1200px;
  --navbar-h: 64px;
  --t-fast: 150ms ease;
  --t-base: 240ms ease;
  --t-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);
  --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.4);
  --shadow-glow: 0 0 32px rgba(124, 95, 245, 0.2);
}

/* ── GLOBAL PAGE ─────────────────────────────────────────────────────────── */
.page {
  background: rgba(10, 12, 20, 1);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  min-height: 100vh;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

/* ── STAR FIELD ──────────────────────────────────────────────────────────── */
.stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star {
  position: absolute;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  animation: starTwinkle var(--dur, 3s) ease-in-out infinite;
  animation-delay: var(--delay, 0s);
}

@keyframes starTwinkle {
  0%,
  100% {
    opacity: 0.2;
    transform: scale(1);
  }

  50% {
    opacity: 0.9;
    transform: scale(1.4);
  }
}

/* ── LIVE TICKER ─────────────────────────────────────────────────────────── */
.ticker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 40px;
  background: transparent;
  border-bottom: 1px solid rgba(124, 95, 245, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  font-size: 14px;
  font-weight: 900;
  color: var(--purple-light);
  font-family: var(--font-body);
  letter-spacing: 0.02em;
  gap: 8px;
  transition: opacity 0.4s ease;
}

.tickerDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--yellow);
  box-shadow: 0 0 6px var(--green);
  flex-shrink: 0;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow: 0 0 6px var(--yellow);
  }

  50% {
    box-shadow: 0 0 14px var(--yellow);
  }
}

/* ── NAVBAR ──────────────────────────────────────────────────────────────── */
.navbar {
  position: fixed;
  top: 32px;
  left: 100px;
  right: 100px;
  z-index: 100;
  height: var(--navbar-h);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  transition:
    background var(--t-slow),
    backdrop-filter var(--t-slow),
    box-shadow var(--t-slow);
}

.navbarScrolled {
  background: transparent;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1px 0 var(--border);
}

.navInner {
  width: 100%;
  max-width: var(--max-w);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.navPill {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  height: 48px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 32px;
}

.navLogo {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: white;
  text-decoration: none;
  white-space: nowrap;
}

.navLogo span {
  color: var(--yellow);
}

.navLinks {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.navLink {
  font-size: 14px;
  font-weight: 600;
  color: var(--muted);
  text-decoration: none;
  transition: color var(--t-fast);
}

.navLink:hover {
  color: white;
}

.navCta {
  background: var(--yellow);
  color: #000;
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: var(--r-full);
  text-decoration: none;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast),
    background var(--t-fast);
  white-space: nowrap;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.navCta:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px var(--yellow-glow);
}

/* ── HERO ────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(var(--navbar-h) + 32px + 32px) 24px 80px;
  overflow: hidden;
  z-index: 1;
}

.beam1 {
  position: absolute;
  top: -20%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(
    circle,
    rgba(124, 95, 245, 0.4) 0%,
    transparent 70%
  );
  filter: blur(80px);
  pointer-events: none;
}

.beam2 {
  position: absolute;
  top: 30%;
  left: -15%;
  width: 500px;
  height: 500px;
  background: radial-gradient(
    circle,
    rgba(192, 132, 252, 0.3) 0%,
    transparent 70%
  );
  filter: blur(60px);
  pointer-events: none;
}

.beam3 {
  position: absolute;
  bottom: -10%;
  right: 20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(
    circle,
    rgba(255, 209, 102, 0.15) 0%,
    transparent 70%
  );
  filter: blur(80px);
  pointer-events: none;
}

.beam4 {
  position: absolute;
  top: 50%;
  left: 30%;
  width: 300px;
  height: 300px;
  background: radial-gradient(
    circle,
    rgba(124, 95, 245, 0.2) 0%,
    transparent 70%
  );
  filter: blur(40px);
  pointer-events: none;
}

.heroContent {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 780px;
  gap: 20px;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(124, 95, 245, 0.15);
  border: 1px solid rgba(124, 95, 245, 0.3);
  border-radius: var(--r-full);
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 500;
  color: var(--purple-light);
  animation: fadeDown 0.6s ease both;
}

.heroBadgeArrow {
  opacity: 0.7;
}

.heroH1 {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: white;
  margin: 0;
  animation: fadeDown 0.6s 0.1s ease both;
}

.heroSub {
  font-size: clamp(1rem, 2vw, 1.2rem);
  color: var(--muted);
  max-width: 520px;
  margin: 0;
  animation: fadeDown 0.6s 0.2s ease both;
}

.heroActions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  animation: fadeDown 0.6s 0.3s ease both;
}

.heroCta {
  background: var(--yellow);
  color: #000;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  padding: 14px 32px;
  border-radius: var(--r-full);
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast);
}

.heroCta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--yellow-glow);
}

.heroSubjectRow {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.subjectChip {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 13px;
  color: var(--muted);
  cursor: pointer;
  transition:
    background var(--t-fast),
    border-color var(--t-fast),
    color var(--t-fast);
  font-family: var(--font-body);
}

.subjectChip:hover {
  background: var(--yellow-dim);
  border-color: rgba(255, 209, 102, 0.3);
  color: var(--yellow);
}

.dropZone {
  position: relative;
  z-index: 2;
  margin-top: 32px;
  width: 100%;
  max-width: 480px;
  border: 2px dashed rgba(255, 255, 255, 0.12);
  border-radius: var(--r-xl);
  padding: 28px 24px;
  text-align: center;
  cursor: pointer;
  transition:
    border-color var(--t-base),
    background var(--t-base);
  animation: fadeDown 0.6s 0.4s ease both;
  background: rgba(255, 255, 255, 0.02);
}

.dropZone:hover {
  border-color: rgba(124, 95, 245, 0.4);
  background: rgba(124, 95, 245, 0.05);
}

.dropIcon {
  font-size: 2rem;
  margin-bottom: 8px;
  display: block;
}

.dropText {
  font-size: 15px;
  color: var(--muted);
  margin: 0;
}

.dropSub {
  font-size: 12px;
  color: rgba(138, 138, 154, 0.6);
  margin: 6px 0 0;
}

.sparkMeter {
  position: absolute;
  bottom: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 209, 102, 0.08);
  border: 1px solid rgba(255, 209, 102, 0.2);
  border-radius: var(--r-full);
  padding: 6px 14px;
  font-size: 12px;
  color: var(--yellow);
  font-weight: 600;
  z-index: 3;
}

/* ── MARQUEE ─────────────────────────────────────────────────────────────── */
.marqueeSection {
  position: relative;
  z-index: 1;
  padding: 20px 0 48px;
  overflow: hidden;
}

.marqueeLabel {
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.marqueeTrack {
  display: flex;
  width: max-content;
  animation: marqueeScroll 22s linear infinite;
}

.marqueeTrack:hover {
  animation-play-state: paused;
}

.marqueeList {
  display: flex;
  align-items: center;
  gap: 64px;
  list-style: none;
  margin: 0;
  padding: 0 32px;
}

.marqueeItem {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: rgba(240, 240, 240, 0.25);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: color var(--t-fast);
}

.marqueeItem:hover {
  color: rgba(240, 240, 240, 0.6);
}

@keyframes marqueeScroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

/* ── SECTION COMMON ──────────────────────────────────────────────────────── */
.section {
  position: relative;
  z-index: 1;
  padding: 80px 24px;
}

.sectionInner {
  max-width: var(--max-w);
  margin: 0 auto;
}

.sectionBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 95, 245, 0.15);
  border: 1px solid rgba(124, 95, 245, 0.25);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--purple-light);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.sectionH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: white;
  margin: 0 0 16px;
}

.sectionSub {
  font-size: 17px;
  color: var(--muted);
  max-width: 540px;
  line-height: 1.65;
  margin: 0;
}

.centered {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── REVEAL ANIMATION ────────────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s ease-out,
    transform 0.6s ease-out;
}

.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* ── FEATURE TABS ────────────────────────────────────────────────────────── */
.tabsWrap {
  margin-top: 40px;
}

.tabNav {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0;
  list-style: none;
  padding: 0;
}

.tabBtn {
  position: relative;
  padding: 12px 28px;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--muted);
  background: none;
  border: none;
  cursor: pointer;
  transition: color var(--t-fast);
}

.tabBtn::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--yellow);
  width: 0;
  transition: width 0.25s ease-out;
}

.tabBtnActive {
  color: white;
}

.tabBtnActive::after {
  width: 100%;
}

.tabPanel {
  background: var(--card);
  border: 1px solid var(--border);
  border-top: none;
  border-radius: 0 0 var(--r-lg) var(--r-lg);
  padding: 36px;
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
  pointer-events: none;
  position: absolute;
  width: 100%;
}

.tabPanelActive {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
  position: relative;
}

.tabPanelContainer {
  position: relative;
}

.tabPanelText {
  font-size: 16px;
  color: var(--muted);
  line-height: 1.8;
  max-width: 640px;
  margin: 0;
}

.tabFeatureList {
  list-style: none;
  padding: 0;
  margin: 20px 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tabFeatureItem {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 15px;
  color: var(--muted);
}

.tabCheckIcon {
  color: var(--green);
  font-size: 16px;
  margin-top: 2px;
  flex-shrink: 0;
}

/* ── DEVICES MOCKUP ──────────────────────────────────────────────────────── */
.devicesWrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48px;
  margin-top: 48px;
  flex-wrap: wrap;
}

.deviceLaptop {
  position: relative;
}

.laptopScreen {
  width: 420px;
  height: 260px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.laptopScreenGlow {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at 30% 40%,
    rgba(124, 95, 245, 0.12) 0%,
    transparent 60%
  );
}

.laptopScreenContent {
  position: relative;
  z-index: 1;
  padding: 20px;
  width: 100%;
}

.mockNoteTitle {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.mockNoteLine {
  height: 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 6px;
}

.mockNoteLineShort {
  width: 55%;
}

.laptopBase {
  width: 460px;
  height: 12px;
  background: var(--card2);
  border: 1px solid var(--border);
  border-top: none;
  border-radius: 0 0 4px 4px;
}

.laptopFoot {
  width: 200px;
  height: 6px;
  background: var(--card2);
  border-radius: 0 0 var(--r-sm) var(--r-sm);
  margin: 0 auto;
  border: 1px solid var(--border);
  border-top: none;
}

.devicePhone {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phoneFrame {
  width: 110px;
  height: 200px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
  gap: 6px;
}

.phoneNotch {
  width: 40px;
  height: 8px;
  background: var(--bg);
  border-radius: var(--r-full);
  flex-shrink: 0;
}

.phoneLine {
  height: 5px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.07);
  width: 80%;
}

.phoneSyncBadge {
  position: absolute;
  bottom: 12px;
  background: rgba(34, 197, 94, 0.15);
  border: 1px solid rgba(34, 197, 94, 0.3);
  border-radius: var(--r-full);
  padding: 3px 8px;
  font-size: 9px;
  color: var(--green);
  font-weight: 600;
}

.devicesCaption {
  text-align: center;
  margin-top: 28px;
  font-size: 15px;
  color: var(--muted);
}

/* ── COMPARISON ──────────────────────────────────────────────────────────── */
.comparisonSection {
  background: transparent;
  /* border-top: 1px solid var(--border); */
  /* border-bottom: 1px solid var(--border); */
}

.comparisonGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 40px;
}

.compCol {
  background: #1c1c1f;
  border: 1px solid #ff0000;
  border-radius: var(--r-xl);
  padding: 28px 32px;
}

.compColLeft {
  border-color: #22c55e;
  box-shadow:
    0 0 0 1px rgba(124, 95, 245, 0.1),
    0 4px 32px rgba(124, 95, 245, 0.08);
  /* background: linear-gradient(160deg, #ff0000 0%, var(--bg) 50%); */
}

.compHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.compLogo {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: white;
}

.compLogoAccent {
  color: var(--yellow);
}

.compLogoMuted {
  color: var(--muted);
  font-weight: 500;
  font-size: 0.9rem;
  letter-spacing: 0;
  text-transform: none;
}

.compList {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.compItem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
  line-height: 1.55;
}

.compItem:last-child {
  border-bottom: none;
}

.compDotGreen span {
  /* width: 8px;
    height: 8px;
    border-radius: 50%; */
  /* background: var(--green); */
  /* margin-top: 5px; */
  flex-shrink: 0;
  align-self: center;
  /* box-shadow: 0 0 6px rgba(34, 197, 94, 0.5); */
  color: rgb(4, 255, 4);
}

.compDotRed span {
  /* width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    margin-top: 5px; */
  flex-shrink: 0;
  color: red;
  align-self: center;
}

.compTextGood {
  /* color: white; */
  color: var(--muted);
}

.compTextBad {
  color: var(--muted);
  font-style: italic;
}

.compFeatureLabel {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--purple-light);
  display: block;
  margin-bottom: 2px;
}

/* ── TIMELINE ────────────────────────────────────────────────────────────── */
.timelineSection {
  background: transparent;
}

.timelineH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: white;
  margin: 0 0 16px;
  text-align: center;
}

.timelineSub {
  font-size: 16px;
  color: #6b6b80;
  text-align: center;
  margin: 0 0 56px;
}

.timelineBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 95, 245, 0.1);
  border: 1px solid rgba(124, 95, 245, 0.2);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--purple);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.timelineWrap {
  position: relative;
  max-width: 680px;
  margin: 0 auto;
}

.timelineLine {
  position: absolute;
  left: 42px;
  top: 0;
  width: 2px;
  height: 0;
  background: linear-gradient(to bottom, var(--purple), var(--purple-light));
  /* transition: height 1.2s cubic-bezier(.4, 0, .2, 1); */
  z-index: 0;
}

.timelineLineGrown {
  height: 100%;
}

.timelineItem {
  display: flex;
  gap: 24px;
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s ease-out,
    transform 0.6s ease-out;
}

.timelineItemVisible {
  opacity: 1;
  transform: translateY(0);
}

.timelineLeft {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
}

.timelineNum {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--bg);
  border: 2px solid rgba(124, 95, 245, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 800;
  color: var(--purple);
  flex-shrink: 0;
  box-shadow: 0 0 0 4px rgba(124, 95, 245, 0.08);
  position: relative;
  z-index: 1;
}

.timelineRight {
  padding-top: 10px;
  padding-bottom: 8px;
}

.timelinePill {
  display: inline-flex;
  background: rgba(124, 95, 245, 0.12);
  border: 1px solid rgba(124, 95, 245, 0.2);
  border-radius: var(--r-full);
  padding: 3px 12px;
  font-size: 11px;
  font-weight: 700;
  color: var(--purple);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
}

.timelineTitle {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  color: white;
  line-height: 1.25;
  margin: 0 0 6px;
}

.timelineDesc {
  font-size: 15px;
  color: #6b6b80;
  line-height: 1.65;
  margin: 0;
}

/* ── STATS BAR ───────────────────────────────────────────────────────────── */
.statsBar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.02);
}

.statItem {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 24px;
  border-right: 1px solid var(--border);
}

.statItem:last-child {
  border-right: none;
}

.statNum {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: white;
  line-height: 1;
  margin-bottom: 6px;
}

.statLabel {
  font-size: 14px;
  color: var(--muted);
  text-align: center;
}

/* ── TESTIMONIALS ────────────────────────────────────────────────────────── */
.testimonialsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 40px;
}

.testimonialCard {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: 24px;
  transition:
    border-color var(--t-base),
    box-shadow var(--t-base),
    transform var(--t-base);
}

.testimonialCard:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

.testimonialHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.testimonialName {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}

.testimonialRole {
  font-size: 12px;
  color: var(--muted);
  margin-top: 2px;
}

.testimonialQuote {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.7;
  margin: 0 0 14px;
}

.testimonialHighlight {
  color: var(--purple-light);
  font-weight: 500;
}

.testimonialAttrib {
  font-size: 13px;
  color: rgba(138, 138, 154, 0.7);
  font-weight: 500;
}

/* ── FAQ ─────────────────────────────────────────────────────────────────── */
.faqList {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 40px;
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

.faqItem {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  transition: border-color var(--t-fast);
}

.faqItem:hover {
  border-color: var(--border-hover);
}

.faqQ {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  gap: 16px;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  color: rgba(138, 138, 154, 0.7);
  transition: color var(--t-fast);
}

.faqQ:hover {
  color: var(--yellow);
}

.faqIcon {
  font-size: 20px;
  color: var(--muted);
  flex-shrink: 0;
  transition:
    transform var(--t-base),
    color var(--t-base);
}

.faqIconOpen {
  transform: rotate(45deg);
  color: var(--yellow);
}

.faqAnswer {
  max-height: 0;
  overflow: hidden;
  transition:
    max-height 0.35s ease,
    padding 0.35s ease;
  padding: 0 22px;
}

.faqAnswerOpen {
  max-height: 400px;
  padding: 0 22px 18px;
}

.faqAnswerText {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.75;
  margin: 0;
  border-top: 1px solid var(--border);
  padding-top: 14px;
}

/* ── CTA BANNER ──────────────────────────────────────────────────────────── */
.ctaBanner {
  position: relative;
  z-index: 1;
  overflow: hidden;
  background: transparent;
  /* border-top: 1px solid var(--border); */
  /* border-bottom: 1px solid var(--border); */
  text-align: center;
  padding: 80px 24px;
}

.ctaBannerBeam {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 300px;
  background: radial-gradient(
    ellipse,
    rgba(124, 95, 245, 0.2) 0%,
    transparent 70%
  );
  filter: blur(40px);
  pointer-events: none;
}

.ctaBannerH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  color: white;
  margin: 0 0 12px;
  position: relative;
  z-index: 1;
}

.ctaBannerSub {
  font-size: 17px;
  color: var(--muted);
  margin: 0 0 28px;
  position: relative;
  z-index: 1;
}

.ctaBannerBtn {
  background: var(--yellow);
  color: #000;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  padding: 14px 36px;
  border-radius: var(--r-full);
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  position: relative;
  z-index: 1;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast);
}

.ctaBannerBtn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--yellow-glow);
}

/* ── FOOTER ──────────────────────────────────────────────────────────────── */
.footer {
  position: relative;
  z-index: 1;
  background: transparent;
  /* border-top: 1px solid var(--border); */
  overflow: hidden;
}

.footerTop {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 56px 24px 40px;
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 48px;
}

.footerLogoBlock {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footerLogo {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: white;
  text-decoration: none;
}

.footerLogo span {
  color: var(--yellow);
}

.footerTagline {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.55;
  margin: 0;
}

.footerCopyright {
  font-size: 13px;
  color: rgba(138, 138, 154, 0.6);
  margin: 0;
}

.footerSocials {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.socialBtn {
  width: 34px;
  height: 34px;
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 14px;
  text-decoration: none;
  transition:
    background var(--t-fast),
    color var(--t-fast),
    border-color var(--t-fast);
}

.socialBtn:hover {
  background: var(--purple-dim);
  border-color: rgba(124, 95, 245, 0.3);
  color: var(--purple-light);
}

.footerLinks {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.footerLinkCol {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footerLinkHeading {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--purple-light);
  margin-bottom: 4px;
}

.footerLink {
  font-size: 14px;
  color: var(--muted);
  text-decoration: none;
  transition: color var(--t-fast);
}

.footerLink:hover {
  color: white;
}

.footerWordmark {
  text-align: center;
  padding: 0 24px 0;
  overflow: hidden;
  pointer-events: none;
  user-select: none;
  position: relative;
}

.footerWordmark::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(
    to top,
    rgba(124, 95, 245, 0.4) 0%,
    transparent 100%
  );
  pointer-events: none;
}

.footerWordmarkText {
  font-family: var(--font-display);
  font-size: clamp(4rem, 12vw, 10rem);
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  background: linear-gradient(
    to bottom,
    var(--purple-light) 0%,
    transparent 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  display: block;
  transform: perspective(400px) rotateX(20deg);
  transform-origin: bottom center;
}

.footerBottom {
  /* border-top: 1px solid var(--border); */
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footerBottomText {
  font-size: 13px;
  color: rgba(138, 138, 154, 0.5);
}

/* ── FADE ANIMATIONS ─────────────────────────────────────────────────────── */
@keyframes fadeDown {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── RESPONSIVE ──────────────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .comparisonGrid {
    grid-template-columns: 1fr;
  }

  .testimonialsGrid {
    grid-template-columns: 1fr;
  }

  .footerTop {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footerLinks {
    grid-template-columns: repeat(2, 1fr);
  }

  .laptopScreen {
    width: 300px;
    height: 190px;
  }

  .laptopBase {
    width: 330px;
  }
}

@media (max-width: 680px) {
  .navLinks {
    display: none;
  }

  .navPill {
    gap: 16px;
    padding: 0 16px;
  }

  .statsBar {
    flex-direction: column;
  }

  .statItem {
    border-right: none;
    border-bottom: 1px solid var(--border);
    padding: 28px 24px;
  }

  .statItem:last-child {
    border-bottom: none;
  }

  .devicesWrap {
    flex-direction: column;
    gap: 24px;
  }

  .footerLinks {
    grid-template-columns: repeat(2, 1fr);
  }

  .tabBtn {
    padding: 10px 16px;
    font-size: 13px;
  }

  .timelineNum {
    width: 44px;
    height: 44px;
    font-size: 13px;
  }

  .timelineLine {
    left: 34px;
  }
}

@media (max-width: 480px) {
  .heroH1 {
    font-size: 2.2rem;
  }

  .footerLinks {
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .section {
    padding: 56px 16px;
  }
}
