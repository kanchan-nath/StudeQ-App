<file path="src/pages/styles/Flashcards.module.css">
/* ─── Flashcards.module.css ─────────────────────────────────────────────── */

:root {
  --bg-page: #f0f2f8;
  --bg-card: #ffffff;
  --bg-sidebar: #ffffff;
  --bg-headbar: #ffffff;
  --bg-tile: #ffffff;
  --bg-input: #ffffff;
  --bg-dropdown: #ffffff;

  --text-primary: #1e2440;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --text-label: #475569;

  --accent: #6366f1;
  --accent-light: #ede9fe;
  --accent-hover: #4f46e5;

  --border: #e2e8f0;
  --border-card: #e8eaf0;
  --shadow-sm:
    0 1px 3px rgba(99, 102, 241, 0.07), 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-md:
    0 4px 16px rgba(99, 102, 241, 0.1), 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-card:
    0 8px 32px rgba(99, 102, 241, 0.1), 0 2px 8px rgba(0, 0, 0, 0.05);
  --shadow-hover:
    0 16px 48px rgba(99, 102, 241, 0.18), 0 4px 16px rgba(0, 0, 0, 0.08);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;

  --sidebar-width: 220px;
  --headbar-height: 60px;

  --font-body: "DM Sans", "Nunito", system-ui, sans-serif;
  --font-display: "DM Sans", sans-serif;

  --transition-fast: 0.18s ease;
  --transition-mid: 0.3s ease;
}

[data-theme="dark"] {
  --bg-page: #0f172a;
  --bg-card: #1e293b;
  --bg-sidebar: #1e293b;
  --bg-headbar: #1e293b;
  --bg-tile: #1e293b;
  --bg-input: #0f172a;
  --bg-dropdown: #1e293b;
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-label: #cbd5e1;
  --accent: #818cf8;
  --accent-light: #1e1b4b;
  --accent-hover: #6366f1;
  --border: #334155;
  --border-card: #334155;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.4);
  --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.4);
  --shadow-hover: 0 16px 48px rgba(0, 0, 0, 0.5);
}

/* ── App Shell ───────────────────────────────────────────────────────────── */
/* height:100% fills AppShell main-content slot exactly; overflow:hidden kills page scroll */

/* ── Flashcard Homepage ──────────────────────────────────────────────────── */
.flashHomeWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 60px 24px;
  text-align: center;
  min-height: 100%;
}

.flashHomeIcon {
  font-size: 3.5rem;
  width: 80px;
  height: 80px;
  background: var(--accent);
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28px;
}

.flashHomeHeading {
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 14px;
  letter-spacing: -0.03em;
  max-width: 600px;
}

.flashHomeSub {
  font-size: 1rem;
  color: var(--text-secondary);
  margin: 0 0 40px;
  max-width: 480px;
  line-height: 1.6;
}

.flashHomeCard {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 28px 36px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: all var(--transition-mid);
  text-align: left;
  max-width: 480px;
  width: 100%;
}

.flashHomeCard:hover {
  border-color: var(--accent);
  box-shadow: var(--shadow-hover);
  transform: translateY(-4px);
}

.flashHomeCardIcon {
  width: 52px;
  height: 52px;
  background: var(--accent-light);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  flex-shrink: 0;
}

.flashHomeCardTitle {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 4px;
}

.flashHomeCardSub {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin: 0;
}

.appShell {
  display: flex;
  flex-direction: row;
  height: 100%;
  overflow: hidden;
  background: var(--bg-page);
  font-family: var(--font-body);
  color: var(--text-primary);
}

/* Only this region scrolls for page content */
.mainContent {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

/* ── RIGHT Sidebar ───────────────────────────────────────────────────────── */
/* Static: full height, never scrolls itself */

.sidebarExpanded {
  width: var(--sidebar-width);
}

.sidebarCollapsed {
  width: 40px;
}

/* Toggle — left edge of sidebar */
/* ── RIGHT Sidebar ───────────────────────────────────────────────────────── */
.historySidebar {
  position: relative;
  height: 100%;
  background: var(--bg-sidebar);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: row;
  transition: width 0.3s ease;
  flex-shrink: 0;
  overflow: hidden;
  z-index: 20;
}

.sidebarOpen {
  width: 260px;
}

.sidebarClosed {
  width: 36px;
}

.sidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background 0.2s;
}

.sidebarToggleBtn:hover {
  background: var(--accent-light);
  color: var(--accent);
}

.sidebarContent {
  padding: 20px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--border) var(--bg-card);
  display: flex;
  flex-direction: column;
}

.sidebarContent::-webkit-scrollbar {
  width: 4px;
}

.sidebarContent::-webkit-scrollbar-track {
  background: var(--bg-card);
}

.sidebarContent::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

.sidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

.uploadBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 10px;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transition-fast), transform var(--transition-fast);
  margin-bottom: 20px;
  white-space: nowrap;
}

.uploadBtn:hover {
  background: var(--accent-hover);
  transform: translateY(-1px);
}

.sidebarTitle {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--text-primary);
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--text-muted);
}

.sidebarItem {
  padding: 12px 14px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 10px;
  cursor: pointer;
  background: var(--bg-card);
  transition: all 0.2s;
  flex-shrink: 0;
}

.sidebarItem:hover {
  border-color: var(--accent);
  background: var(--accent-light);
}

.sidebarItemTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebarItemMeta {
  font-size: 11px;
  color: var(--text-muted);
}

.uploadBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 10px;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    background var(--transition-fast),
    transform var(--transition-fast);
  white-space: nowrap;
}

.uploadBtn:hover {
  background: var(--accent-hover);
  transform: translateY(-1px);
}

/*  */

.sidebarItemRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.sidebarItemText {
  flex: 1;
  overflow: hidden;
}

.sidebarItemMenuWrapper {
  position: relative;
  flex-shrink: 0;
}

.threeDotBtn {
  width: 26px;
  height: 26px;
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-size: 16px;
  cursor: pointer;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  letter-spacing: -1px;
  transition: background 0.15s, color 0.15s;
}

.threeDotBtn:hover {
  background: var(--border);
  color: var(--text-primary);
}

.dotMenu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  z-index: 50;
  min-width: 110px;
  overflow: hidden;
}

.dotMenuDelete {
  width: 100%;
  padding: 9px 14px;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  color: #ef4444;
  cursor: pointer;
  transition: background 0.15s;
}

.dotMenuDelete:hover {
  background: #fee2e2;
}

/* ── Viewer Layout ───────────────────────────────────────────────────────── */
.viewerLayout {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* ── Headbar ─────────────────────────────────────────────────────────────── */
.headbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: var(--headbar-height);
  padding: 0 20px;
  background: var(--bg-headbar);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.headbarLeft {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.headbarRight {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.modeDropdownWrapper {
  position: relative;
}

.modeBtn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.modeBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.modeDropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  background: var(--bg-dropdown);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  z-index: 50;
  min-width: 200px;
  animation: dropIn 0.15s ease;
}

@keyframes dropIn {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modeOption {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 16px;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-size: 0.875rem;
  cursor: pointer;
  transition: background var(--transition-fast);
  text-align: left;
}

.modeOption:hover {
  background: var(--accent-light);
  color: var(--accent);
}

.modeOptionActive {
  color: var(--accent);
  font-weight: 600;
}

.progressDots {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  justify-content: center;
  overflow: hidden;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 2px solid var(--border);
  background: transparent;
  cursor: pointer;
  transition:
    background var(--transition-fast),
    border-color var(--transition-fast),
    transform var(--transition-fast);
  padding: 0;
  flex-shrink: 0;
}

.dot:hover {
  border-color: var(--accent);
  transform: scale(1.2);
}

.dotActive {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.dotsMore {
  color: var(--text-muted);
  font-size: 1rem;
}

.shuffleBtn {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.shuffleBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.cardCounter {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
  padding: 0 4px;
}

.navArrow {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-primary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.navArrow:hover:not(:disabled) {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.navArrow:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

/* ── Card Area ───────────────────────────────────────────────────────────── */
.cardArea {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 32px;
  gap: 20px;
}

.cardMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 720px;
}

.cardSideLabel {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.ratingBtns {
  display: flex;
  gap: 8px;
}

.ratingBtn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.ratingBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.ratingBtnActive {
  background: #dcfce7;
  border-color: #22c55e;
  color: #16a34a;
}

.ratingBtnDown {
  background: #fee2e2;
  border-color: #ef4444;
  color: #dc2626;
}

.ratingBtnBookmark {
  background: var(--accent-light);
  border-color: var(--accent);
  color: var(--accent);
}

/* ── 3D Card Flip ────────────────────────────────────────────────────────── */
.cardScene {
  width: 100%;
  max-width: 720px;
  height: 380px;
  perspective: 1200px;
  cursor: pointer;
  flex-shrink: 0;
}

.card3d {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
}

.cardFlipped {
  transform: rotateX(180deg);
}

.cardFront,
.cardBack {
  position: absolute;
  inset: 0;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.cardBack {
  transform: rotateX(180deg);
  background: linear-gradient(135deg,
      var(--bg-card) 0%,
      var(--accent-light) 100%);
}

.cardText {
  font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  font-weight: 500;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.5;
  margin: 0;
}

/* ── Bottom Bar ──────────────────────────────────────────────────────────── */
.bottomBar {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
  padding-bottom: 24px;
}

.bottomNavBtn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 22px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.bottomNavBtn:hover:not(:disabled) {
  border-color: var(--accent);
  color: var(--accent);
  box-shadow: var(--shadow-sm);
}

.bottomNavBtn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.flipBtn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 28px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.flipBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-light);
}

.kbd {
  display: inline-flex;
  align-items: center;
  padding: 2px 6px;
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: 4px;
  font-size: 0.7rem;
  font-family: monospace;
  color: var(--text-muted);
}

/* ── Create Layout ───────────────────────────────────────────────────────── */
.createLayout {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  background: var(--bg-page);
}

.createHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  height: var(--headbar-height);
  background: var(--bg-headbar);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.createTitle {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
}

.exitBtn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.exitBtn:hover {
  border-color: #ef4444;
  color: #ef4444;
}

.createBody {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.createLeft {
  flex: 1;
  padding: 36px 40px;
  overflow-y: auto;
  border-right: 1px solid var(--border);
}

.stepIndicator {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 10px;
}

.createHeading {
  font-size: clamp(1.3rem, 2vw, 1.8rem);
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 6px;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.createSubheading {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 0 0 28px;
}

/* ── Tiles ───────────────────────────────────────────────────────────────── */
.tilesGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-width: 560px;
}

.tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 28px 20px;
  background: var(--bg-tile);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition:
    transform 0.35s ease-out,
    box-shadow 0.35s ease-out,
    border-color 0.2s ease;
  position: relative;
  text-align: center;
}

.tile:hover:not(.tileDisabled) {
  transform: translateY(-10px) rotate(var(--tile-rotate));
  box-shadow: var(--shadow-hover);
  border-color: var(--accent);
}

.tileDisabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.tileIcon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-light);
  color: var(--accent);
}

.tileColorIndigo .tileIcon {
  background: #ede9fe;
  color: #6366f1;
}

.tileColorAmber .tileIcon {
  background: #fef3c7;
  color: #f59e0b;
}

.tileColorViolet .tileIcon {
  background: #f3e8ff;
  color: #a855f7;
}

.tileColorSky .tileIcon {
  background: #e0f2fe;
  color: #0284c7;
}

.tileColorTeal .tileIcon {
  background: #ccfbf1;
  color: #0d9488;
}

.tileLabel {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-primary);
}

.tileBadge {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 0.65rem;
  font-weight: 600;
  padding: 2px 6px;
  background: var(--bg-page);
  border: 1px solid var(--border);
  border-radius: 99px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ── Create Right Panel ──────────────────────────────────────────────────── */
.createRight {
  width: 44%;
  background: var(--accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  overflow: hidden;
}

[data-theme="dark"] .createRight {
  background: #1a1f35;
}

.previewPanel {
  text-align: center;
  max-width: 360px;
  width: 100%;
}

.previewTitle {
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 8px;
  letter-spacing: -0.03em;
}

.accent {
  color: var(--accent);
}

.previewSub {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 0 0 32px;
}

/* ── Fan Cards ───────────────────────────────────────────────────────────── */
.cardFanWrapper {
  position: relative;
  height: 260px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fanCard {
  position: absolute;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16px 14px;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 130px;
  font-size: 0.8rem;
  color: var(--text-primary);
  font-weight: 600;
}

.fanCard1 {
  transform: rotate(-18deg) translateX(-90px) translateY(20px);
  z-index: 1;
  opacity: 0.7;
}

.fanCard2 {
  transform: rotate(-8deg) translateX(-40px) translateY(10px);
  z-index: 2;
  opacity: 0.85;
}

.fanCard3 {
  transform: rotate(0deg);
  z-index: 3;
  min-width: 160px;
}

.fanCard4 {
  transform: rotate(12deg) translateX(70px) translateY(10px);
  z-index: 2;
  opacity: 0.7;
}

.fanCardIcon {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  font-weight: 700;
}

.fanCardSection {
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-top: 4px;
}

.fanLine {
  height: 6px;
  background: var(--bg-page);
  border-radius: 99px;
  width: 100%;
}

/* ── Form Fields ─────────────────────────────────────────────────────────── */
.fieldGroup {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 20px;
}

.fieldLabel {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-label);
}

.fieldInput {
  width: 100%;
  max-width: 480px;
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 0.9rem;
  font-family: var(--font-body);
  transition:
    border-color var(--transition-fast),
    box-shadow var(--transition-fast);
  outline: none;
}

.fieldInput::placeholder {
  color: var(--text-muted);
}

.fieldInput:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.fieldHint {
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
  max-width: 480px;
}

/* ── Step Nav ────────────────────────────────────────────────────────────── */
.stepNav {
  display: flex;
  gap: 12px;
  margin-top: 32px;
}

.backBtn {
  padding: 11px 28px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.backBtn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.nextBtn {
  padding: 11px 32px;
  border: none;
  border-radius: var(--radius-md);
  background: var(--accent);
  color: white;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.nextBtn:hover:not(:disabled) {
  background: var(--accent-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.nextBtn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* ── Topic Preview ───────────────────────────────────────────────────────── */
.topicPreview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 36px 24px;
  margin-bottom: 28px;
  box-shadow: var(--shadow-sm);
}

.topicPreviewIcon {
  color: var(--accent);
  display: flex;
}

.topicPreviewText {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin: 0;
  text-align: center;
}

/* ── PDF Dropzone ────────────────────────────────────────────────────────── */
.dropzone {
  position: relative;
  max-width: 480px;
  border: 2px dashed var(--border);
  border-radius: var(--radius-md);
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition:
    border-color var(--transition-fast),
    background var(--transition-fast);
  color: var(--text-secondary);
  text-align: center;
  font-size: 0.875rem;
}

.dropzone:hover {
  border-color: var(--accent);
  background: var(--accent-light);
}

.fileInput {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}

.fileName {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-light);
  padding: 4px 10px;
  border-radius: 99px;
}

/* ── Scratch Preview ─────────────────────────────────────────────────────── */
.scratchPreview {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 24px;
}

.scratchCard {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
}

.noteItem {
  cursor: pointer;
  /* keep existing styles */
  transition: background 0.15s;
}

.noteItem:hover {
  background: rgba(99, 102, 241, 0.08);
  border-radius: 8px;
}

.noteItemText {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}

.noteTopic {
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.noteSubject {
  font-size: 11px;
  opacity: 0.55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.emptyRecent {
  font-size: 12px;
  opacity: 0.4;
  padding: 8px 4px;
}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .createRight {
    width: 40%;
  }

  .tilesGrid {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .rightSidebar {
    display: none;
  }

  .createBody {
    flex-direction: column;
  }

  .createRight {
    width: 100%;
    min-height: 240px;
  }

  .tilesGrid {
    grid-template-columns: 1fr 1fr;
  }

  .cardScene {
    height: 260px;
  }

  .headbar {
    padding: 0 12px;
    gap: 8px;
  }

  .progressDots {
    gap: 4px;
  }

  .dot {
    width: 8px;
    height: 8px;
  }

  .cardArea {
    padding: 16px;
  }
}

@media (max-width: 480px) {
  .tilesGrid {
    grid-template-columns: 1fr;
  }

  .createLeft {
    padding: 24px 20px;
  }

  .bottomBar {
    gap: 8px;
  }

  .bottomNavBtn,
  .flipBtn {
    padding: 9px 14px;
    font-size: 0.8rem;
  }
}
</file>

<file path="src/pages/styles/global.css">
/* ============================================================
   global.css — import ONCE in main.jsx or App.jsx
   Contains: fonts, CSS variables, reset, scrollbar
   ============================================================ */

@import url("https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap");

/* ── APP SHELL / DASHBOARD TOKENS ─────────────────────────── */
:root {
  --clr-bg: var(--theme-bg);
  --clr-surface: #ffffff;
  --clr-border: #e2e8f0;
  --clr-primary: #3b5bdb;
  --clr-primary-dark: #2f4ac4;
  --clr-primary-light: #eef2ff;
  --clr-accent: #22c55e;
  --clr-accent-dark: #16a34a;
  --clr-purple: #7c3aed;
  --clr-pink: #ec4899;
  --clr-teal: #0ea5e9;
  --clr-orange: #f97316;
  --clr-text-primary: #0f172a;
  --clr-text-secondary: #64748b;
  --clr-text-muted: #94a3b8;
  --clr-text-on-dark: #ffffff;

  --sidebar-w: 230px;
  --topbar-h: 56px;
  --rightpanel-w: 300px;

  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 20px;
  --sp-6: 24px;
  --sp-8: 32px;

  --r-sm: 6px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-xl: 20px;
  --r-full: 9999px;

  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.06);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.07);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1);
  --shadow-card: 0 2px 12px rgba(59, 91, 219, 0.08);

  --t-fast: 150ms ease;
  --t-base: 220ms ease;
  --t-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);

  --font-display: "Sora", sans-serif;
  --font-body: "DM Sans", sans-serif;

  /* ── AUTH (Login / Register) TOKENS ─────────────────────── */
  --color-primary: #2563eb;
  --color-primary-hover: #1d4ed8;
  --color-primary-light: #eff6ff;
  --color-bg-left: #ffffff;
  --color-text-heading: #0f172a;
  --color-text-body: #334155;
  --color-text-muted: #94a3b8;
  --color-border: #e2e8f0;
  --color-input-bg: #f8fafc;
  --color-input-focus-bg: #ffffff;
  --color-error-bg: #fef2f2;
  --color-error-text: #dc2626;
  --color-error-border: #fecaca;
  --color-link: #2563eb;
  --color-tip-bg: #eff6ff;
  --color-tip-border: #bfdbfe;
  --color-tip-text: #1d4ed8;
  --color-right-from: #1e3a8a;
  --color-right-mid: #312e81;
  --color-right-to: #581c87;
  --color-glass-bg: rgba(255, 255, 255, 0.1);
  --color-glass-border: rgba(255, 255, 255, 0.18);
  --color-stat-bg: rgba(37, 99, 235, 0.5);

  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;

  --radius-sm: 0.5rem;
  --radius-md: 0.875rem;
  --radius-lg: 1.25rem;
  --radius-xl: 1.75rem;
  --radius-full: 9999px;

  --shadow-input: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-btn: 0 4px 14px rgba(37, 99, 235, 0.35);
  --shadow-btn-hover: 0 6px 20px rgba(37, 99, 235, 0.5);

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-fast: 150ms;
  --dur-mid: 250ms;
  --dur-slow: 400ms;
}

/* ── RESET ─────────────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
}

body {
  font-family: var(--font-body);
  background: var(--theme-bg);
  color: var(--theme-text);
  line-height: 1.6;
  transition: background 0.3s ease, color 0.3s ease;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  outline: none;
}

img,
svg {
  display: block;
  max-width: 100%;
}

ul,
ol {
  list-style: none;
}

/* ── SCROLLBAR ─────────────────────────────────────────────── */
::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--theme-border);
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
/* hover */
  background: var(--theme-text-muted);
}

/* ── REDUCED MOTION ────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ================================================================
   THEME SYSTEM — append this block to the END of global.css
   Works via data-theme="dark" | data-theme="light" on <html>
   ================================================================ */

/* ── DARK (default — matches existing site) ───────────────── */
:root,
[data-theme="dark"] {
  --theme-bg: rgba(10, 12, 20, 1);
  --theme-bg-secondary: #13141f;
  --theme-surface: #1c1c1f;
  --theme-surface-2: #242428;
  --theme-border: rgba(255, 255, 255, 0.08);
  --theme-border-hover: rgba(255, 255, 255, 0.16);
  --theme-text: #f0f0f0;
  --theme-text-secondary: #8a8a9a;
  --theme-text-muted: #5a5a6a;
  --theme-accent: #ffd166;
  --theme-accent-dim: rgba(255, 209, 102, 0.12);
  --theme-accent-glow: rgba(255, 209, 102, 0.25);
  --theme-purple: #7c5ff5;
  --theme-purple-light: #c084fc;
  --theme-purple-dim: rgba(124, 95, 245, 0.15);
  --theme-green: #22c55e;
  --theme-red: #ef4444;
  --theme-card-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  --theme-navbar-bg: rgba(255, 255, 255, 0.04);
  --theme-navbar-blur: blur(12px);
  --theme-input-bg: rgba(255, 255, 255, 0.05);
  --theme-input-border: rgba(255, 255, 255, 0.12);

  /* Toggle button appearance */
  --toggle-track-bg: rgba(255, 255, 255, 0.1);
  --toggle-track-border: rgba(255, 255, 255, 0.15);
  --toggle-thumb-bg: #1c1c2e;
  --toggle-accent: #7c5ff5;
}

/* ── LIGHT ────────────────────────────────────────────────── */
[data-theme="light"] {
  --theme-bg: #f7f8fc;
  --theme-bg-secondary: #eef0f6;
  --theme-surface: #ffffff;
  --theme-surface-2: #f0f2f8;
  --theme-border: rgba(0, 0, 0, 0.08);
  --theme-border-hover: rgba(0, 0, 0, 0.16);
  --theme-text: #0d0e14;
  --theme-text-secondary: #4a4a5a;
  --theme-text-muted: #8a8a9a;
  --theme-accent: #c49a00;
  /* darkened yellow for light bg contrast */
  --theme-accent-dim: rgba(196, 154, 0, 0.1);
  --theme-accent-glow: rgba(196, 154, 0, 0.2);
  --theme-purple: #5b3fd4;
  --theme-purple-light: #7c5ff5;
  --theme-purple-dim: rgba(91, 63, 212, 0.12);
  --theme-green: #16a34a;
  --theme-red: #dc2626;
  --theme-card-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
  --theme-navbar-bg: rgba(255, 255, 255, 0.85);
  --theme-navbar-blur: blur(16px);
  --theme-input-bg: #ffffff;
  --theme-input-border: rgba(0, 0, 0, 0.12);

  /* Toggle button appearance */
  --toggle-track-bg: #e2e4ef;
  --toggle-track-border: #c8cadc;
  --toggle-thumb-bg: #ffffff;
  --toggle-accent: #5b3fd4;
}
