<file path="src/pages/styles/EventScheduling.module.css">
/* ─── CSS Variables ──────────────────────────────────────────────────────── */
:root {
    --bg-page: #0d1117;
    --bg-surface: #161b22;
    --bg-surface-2: #1c2333;
    --bg-surface-3: #21262d;
    --bg-hover: #2d333b;

    --accent-blue: #4f6ef7;
    --accent-blue-dim: rgba(79, 110, 247, 0.12);
    --accent-blue-border: rgba(79, 110, 247, 0.3);
    --accent-amber: #f59e0b;
    --accent-amber-dim: rgba(245, 158, 11, 0.12);
    --accent-amber-border: rgba(245, 158, 11, 0.3);
    --accent-red: #ef4444;
    --accent-red-dim: rgba(239, 68, 68, 0.12);
    --accent-red-border: rgba(239, 68, 68, 0.3);
    --accent-green: #10b981;
    --accent-green-dim: rgba(16, 185, 129, 0.12);
    --accent-green-border: rgba(16, 185, 129, 0.3);
    --accent-purple: #7c3aed;

    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --text-muted: #484f58;

    --border: rgba(48, 54, 61, 0.9);
    --border-light: rgba(48, 54, 61, 0.5);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 18px;

    --font-mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

    --sidebar-w: 200px;
    --transition: 0.15s ease;
    --transition-slow: 0.2s ease;
}

[data-theme="dark"] {
    --bg-page: #0d1117;
    --bg-surface: #161b22;
    --bg-surface-2: #1c2333;
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
}

/* ─── Layout ─────────────────────────────────────────────────────────────── */
.shell {
    display: flex;
    min-height: 100vh;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 14px;
}

/* ─── Sidebar ────────────────────────────────────────────────────────────── */
.sidebar {
    width: var(--sidebar-w);
    min-height: 100vh;
    background: var(--bg-surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    flex-shrink: 0;
}

.sidebarLogo {
    padding: 20px 16px 18px;
    border-bottom: 1px solid var(--border-light);
}

.logoMark {
    display: flex;
    align-items: center;
    gap: 10px;
}

.logoIcon {
    width: 32px;
    height: 32px;
    background: var(--accent-blue);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.5px;
    flex-shrink: 0;
}

.logoText {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.logoTitle {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.2px;
}

.logoSub {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.3px;
    text-transform: uppercase;
}

.sidebarNav {
    flex: 1;
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.navItem {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--text-secondary);
    transition: background var(--transition), color var(--transition);
    text-decoration: none;
    font-size: 13px;
    font-weight: 450;
    border: none;
    background: transparent;
    width: 100%;
    text-align: left;
}

.navItem:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.navItem.active {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border: 1px solid var(--accent-blue-border);
}

.navIcon {
    font-size: 15px;
    width: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.sidebarUser {
    padding: 12px;
    border-top: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    gap: 10px;
}

.userAvatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent-blue-dim);
    border: 1px solid var(--accent-blue-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-blue);
    flex-shrink: 0;
}

.userInfo {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
}

.userName {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.userRole {
    font-size: 10px;
    color: var(--text-muted);
}

/* ─── Main Content ───────────────────────────────────────────────────────── */
.main {
    flex: 1;
    overflow-y: auto;
    padding: 28px 32px;
    min-width: 0;
}

.pageHeader {
    margin-bottom: 24px;
}

.pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.4px;
    margin: 0 0 4px;
}

.pageSubtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
}

/* ─── Stat Cards ─────────────────────────────────────────────────────────── */
.statsGrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}

.statCard {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 18px 14px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    text-decoration: none;
    display: block;
}

.statCard::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-slow);
}

.statCard:hover {
    transform: translateY(-2px);
}

.statCard:hover::after {
    transform: scaleX(1);
}

.statCard.blue {
    border-bottom-color: transparent;
}

.statCard.blue::after {
    background: var(--accent-blue);
}

.statCard.blue:hover {
    border-color: var(--accent-blue-border);
    box-shadow: 0 4px 20px rgba(79, 110, 247, 0.1);
}

.statCard.amber {
    border-bottom-color: transparent;
}

.statCard.amber::after {
    background: var(--accent-amber);
}

.statCard.amber:hover {
    border-color: var(--accent-amber-border);
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.1);
}

.statCard.red {
    border-bottom-color: transparent;
}

.statCard.red::after {
    background: var(--accent-red);
}

.statCard.red:hover {
    border-color: var(--accent-red-border);
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.1);
}

.statCard.green {
    border-bottom-color: transparent;
}

.statCard.green::after {
    background: var(--accent-green);
}

.statCard.green:hover {
    border-color: var(--accent-green-border);
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.1);
}

.statCardTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 14px;
}

.statIconBlock {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
}

.statIconBlock.blue {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
}

.statIconBlock.amber {
    background: var(--accent-amber-dim);
    color: var(--accent-amber);
}

.statIconBlock.red {
    background: var(--accent-red-dim);
    color: var(--accent-red);
}

.statIconBlock.green {
    background: var(--accent-green-dim);
    color: var(--accent-green);
}

.statArrow {
    font-size: 14px;
    color: var(--text-muted);
    transition: transform var(--transition), color var(--transition);
}

.statCard:hover .statArrow {
    transform: translate(2px, -2px);
    color: var(--text-secondary);
}

.statCount {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 5px;
    letter-spacing: -1px;
}

.statLabel {
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 8px;
}

.statHint {
    font-size: 11px;
    font-weight: 500;
}

.statHint.blue {
    color: var(--accent-blue);
}

.statHint.amber {
    color: var(--accent-amber);
}

.statHint.red {
    color: var(--accent-red);
}

.statHint.green {
    color: var(--accent-green);
}

/* ─── Loading Skeleton ───────────────────────────────────────────────────── */
.skeleton {
    background: var(--bg-surface-3);
    border-radius: var(--radius-sm);
    animation: shimmer 1.4s infinite;
}

@keyframes shimmer {

    0%,
    100% {
        opacity: 0.6;
    }

    50% {
        opacity: 1;
    }
}

.skeletonCount {
    width: 48px;
    height: 30px;
    margin-bottom: 5px;
}

.skeletonText {
    width: 80px;
    height: 12px;
}

.skeletonTextSm {
    width: 60px;
    height: 10px;
}

/* ─── Mid Section (Schedule + Calendar) ─────────────────────────────────── */
.midSection {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 14px;
    margin-bottom: 24px;
}

.panel {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.panelHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 14px;
    border-bottom: 1px solid var(--border-light);
}

.panelTitle {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.2px;
}

.viewAll {
    font-size: 12px;
    color: var(--accent-blue);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 3px;
    transition: gap var(--transition);
    background: none;
    border: none;
    padding: 0;
}

.viewAll:hover {
    gap: 6px;
}

/* ─── Schedule Rows ──────────────────────────────────────────────────────── */
.scheduleList {
    padding: 8px 0;
}

.scheduleRow {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 20px;
    cursor: pointer;
    transition: background var(--transition);
    border-bottom: 1px solid var(--border-light);
}

.scheduleRow:last-child {
    border-bottom: none;
}

.scheduleRow:hover {
    background: var(--bg-hover);
}

.scheduleDay {
    text-align: center;
    min-width: 36px;
    flex-shrink: 0;
}

.scheduleDayAbbr {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    display: block;
}

.scheduleDayNum {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
}

.scheduleBar {
    width: 3px;
    height: 36px;
    border-radius: 2px;
    flex-shrink: 0;
}

.scheduleBar.urgent {
    background: var(--accent-red);
}

.scheduleBar.upcoming {
    background: var(--accent-amber);
}

.scheduleBar.class {
    background: var(--accent-blue);
}

.scheduleBar.done {
    background: var(--accent-green);
}

.scheduleInfo {
    flex: 1;
    min-width: 0;
}

.scheduleName {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.scheduleMeta {
    font-size: 11px;
    color: var(--text-muted);
}

.badge {
    padding: 3px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    flex-shrink: 0;
    border: 1px solid transparent;
}

.badge.urgent {
    background: var(--accent-red-dim);
    color: var(--accent-red);
    border-color: var(--accent-red-border);
}

.badge.upcoming {
    background: var(--accent-amber-dim);
    color: var(--accent-amber);
    border-color: var(--accent-amber-border);
}

.badge.class {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border-color: var(--accent-blue-border);
}

.badge.done {
    background: var(--accent-green-dim);
    color: var(--accent-green);
    border-color: var(--accent-green-border);
}

.emptyState {
    padding: 32px 20px;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
}

/* ─── Mini Calendar ──────────────────────────────────────────────────────── */
.calendarWrap {
    padding: 16px;
}

.calendarNav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.calMonthLabel {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
}

.calNavBtn {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    transition: background var(--transition), color var(--transition);
}

.calNavBtn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.calGrid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
}

.calDayHeader {
    text-align: center;
    font-size: 10px;
    color: var(--text-muted);
    padding: 4px 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.calCell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    cursor: pointer;
    position: relative;
    transition: background var(--transition);
    font-size: 12px;
    color: var(--text-secondary);
    gap: 2px;
}

.calCell:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.calCell.today {
    background: var(--accent-blue) !important;
    color: #fff !important;
    font-weight: 600;
}

.calCell.otherMonth {
    color: var(--text-muted);
    opacity: 0.4;
}

.calDots {
    display: flex;
    gap: 2px;
    align-items: center;
}

.calDot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
}

.calDot.exam {
    background: var(--accent-red);
}

.calDot.due {
    background: var(--accent-amber);
}

.calDot.done {
    background: var(--accent-green);
}

.calLegend {
    display: flex;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border-light);
    margin-top: 8px;
}

.calLegendItem {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--text-muted);
}

/* ─── Focus Insights Row ─────────────────────────────────────────────────── */
.insightsGrid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
}

/* ─── Heatmap ────────────────────────────────────────────────────────────── */
.heatmapWrap {
    padding: 4px 0;
}

.heatmapRow {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
}

.heatmapLabel {
    width: 28px;
    font-size: 10px;
    color: var(--text-muted);
    text-align: right;
    flex-shrink: 0;
    font-family: var(--font-mono);
}

.heatmapCells {
    display: flex;
    gap: 4px;
    flex: 1;
}

.heatmapCell {
    flex: 1;
    aspect-ratio: 1;
    border-radius: 3px;
    cursor: pointer;
    position: relative;
    transition: transform var(--transition);
}

.heatmapCell:hover {
    transform: scale(1.15);
    z-index: 1;
}

.heatmapWeekHeaders {
    display: flex;
    gap: 4px;
    padding-left: 34px;
    margin-bottom: 4px;
}

.heatmapWeekLabel {
    flex: 1;
    font-size: 9px;
    color: var(--text-muted);
    text-align: center;
    font-family: var(--font-mono);
}

.tooltip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-surface-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 5px 8px;
    font-size: 10px;
    white-space: nowrap;
    color: var(--text-primary);
    pointer-events: none;
    z-index: 10;
}

/* ─── Donut Chart ────────────────────────────────────────────────────────── */
.donutWrap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
}

.donutCanvas {
    flex-shrink: 0;
}

.donutLegend {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
}

.donutLegendItem {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--text-secondary);
}

.donutDot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.donutPercent {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-primary);
}

.chartNote {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 8px;
}

/* ─── Priority + Streak ──────────────────────────────────────────────────── */
.priorityCard {
    background: var(--accent-blue-dim);
    border: 1px solid var(--accent-blue-border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    margin-bottom: 12px;
}

.priorityCardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.urgencyChip {
    font-size: 10px;
    font-weight: 600;
    color: var(--accent-amber);
    background: var(--accent-amber-dim);
    border: 1px solid var(--accent-amber-border);
    padding: 2px 7px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 3px;
}

.aiBadge {
    font-size: 9px;
    color: var(--accent-blue);
    background: rgba(79, 110, 247, 0.08);
    padding: 2px 6px;
    border-radius: 20px;
    border: 1px solid var(--accent-blue-border);
}

.priorityDeadline {
    font-size: 10px;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.priorityName {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
}

.priorityDesc {
    font-size: 11px;
    color: var(--text-secondary);
    margin-bottom: 10px;
}

.progressBar {
    height: 4px;
    background: var(--bg-surface-3);
    border-radius: 2px;
    overflow: hidden;
}

.progressFill {
    height: 100%;
    border-radius: 2px;
    background: var(--accent-blue);
    transition: width 0.4s ease;
}

.streakSection {
    padding-top: 4px;
}

.streakHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.streakCount {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    color: var(--accent-green);
}

.streakLabel {
    font-size: 10px;
    color: var(--text-muted);
}

.streakMotivation {
    font-size: 11px;
    color: var(--text-secondary);
    font-style: italic;
}

.streakDays {
    display: flex;
    gap: 5px;
}

.streakDay {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.streakDayLabel {
    font-size: 9px;
    color: var(--text-muted);
    text-transform: uppercase;
}

.streakPill {
    width: 100%;
    height: 22px;
    border-radius: 4px;
    background: var(--bg-surface-3);
    border: 1px solid var(--border);
}

.streakPill.studied {
    background: var(--accent-green-dim);
    border-color: var(--accent-green-border);
}

/* ─── Recent Activity Table ──────────────────────────────────────────────── */
.activityPanel {
    margin-bottom: 24px;
}

.activityHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 14px;
    border-bottom: 1px solid var(--border-light);
}

.exportBtn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
}

.exportBtn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.activityTable {
    width: 100%;
    border-collapse: collapse;
}

.activityTable th {
    text-align: left;
    padding: 10px 20px;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-surface-2);
}

.activityTable td {
    padding: 12px 20px;
    font-size: 13px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-light);
    transition: background var(--transition);
}

.activityTable tr:hover td {
    background: var(--bg-hover);
}

.activityTable tr:last-child td {
    border-bottom: none;
}

.tdSubject {
    color: var(--text-primary) !important;
    font-weight: 500;
}

.actionLink {
    color: var(--accent-blue);
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    background: none;
    border: none;
    padding: 0;
    transition: opacity var(--transition);
}

.actionLink:hover {
    opacity: 0.75;
}

/* ─── Responsive ─────────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
    .statsGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .midSection {
        grid-template-columns: 1fr;
    }

    .insightsGrid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 768px) {
    .shell {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        position: static;
    }

    .sidebarNav {
        flex-direction: row;
        padding: 8px;
        overflow-x: auto;
    }

    .main {
        padding: 16px;
    }

    .statsGrid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .insightsGrid {
        grid-template-columns: 1fr;
    }

    .logoSub,
    .userInfo {
        display: none;
    }
}

@media (max-width: 480px) {
    .statsGrid {
        grid-template-columns: 1fr;
    }
}
