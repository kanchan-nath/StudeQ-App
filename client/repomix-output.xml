// ─── Add / Edit Modal ─────────────────────────────────────────────────────────

const ExamModal = ({ mode, initial, onClose, onSuccess }) => {
    const [form, setForm] = useState(initial || EMPTY_FORM)
    const [saving, setSaving] = useState(false)
    const token = localStorage.getItem("token")

    const handle = (e) => {
        const { name, value, type, checked } = e.target
        setForm((f) => ({ ...f, [name]: type === "checkbox" ? checked : value }))
    }

    const handleSubmit = async (e) => {
        e.preventDefault()
        setSaving(true)
        try {
            const url =
                mode === "edit"
                    ? `${BASE_URL}/api/scheduler/exam-dates/${initial._id}`
                    : `${BASE_URL}/api/scheduler/exam-dates`
            const res = await fetch(url, {
                method: mode === "edit" ? "PATCH" : "POST",
                headers: authHeaders(),
                body: JSON.stringify(form),
            })
            if (!res.ok) throw new Error("Failed")
            onSuccess()
            onClose()
        } catch (err) {
            console.error(err)
        } finally {
            setSaving(false)
        }
    }

    return (
        <div className={styles.modalOverlay} onClick={(e) => e.target === e.currentTarget && onClose()}>
            <div className={styles.modal} role="dialog" aria-modal="true">
                <div className={styles.modalHeader}>
                    <h2 className={styles.modalTitle}>{mode === "edit" ? "Edit Exam" : "Add New Exam"}</h2>
                    <button className={styles.drawerClose} onClick={onClose} aria-label="Close">×</button>
                </div>
                <form onSubmit={handleSubmit}>
                    <div className={styles.modalBody}>
                        <div className={styles.formGrid}>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Subject Name *</label>
                                <input name="subjectName" className={styles.formInput} value={form.subjectName} onChange={handle} required placeholder="e.g. Data Structures" />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Subject Code</label>
                                <input name="subjectCode" className={styles.formInput} value={form.subjectCode} onChange={handle} placeholder="e.g. CS201" />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Exam Date *</label>
                                <input name="examDate" type="date" className={styles.formInput} value={form.examDate} onChange={handle} required />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Exam Time *</label>
                                <input name="examTime" type="time" className={styles.formInput} value={form.examTime} onChange={handle} required />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Duration (min)</label>
                                <input name="duration" type="number" min="1" className={styles.formInput} value={form.duration} onChange={handle} placeholder="90" />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Venue / Room</label>
                                <input name="venue" className={styles.formInput} value={form.venue} onChange={handle} placeholder="e.g. Hall B" />
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Status</label>
                                <select name="status" className={styles.formSelect} value={form.status} onChange={handle}>
                                    {STATUS_OPTIONS.map((s) => (
                                        <option key={s} value={s}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>
                                    ))}
                                </select>
                            </div>
                            <div className={styles.formGroup}>
                                <label className={styles.formLabel}>Online Link</label>
                                <input name="onlineLink" className={styles.formInput} value={form.onlineLink} onChange={handle} placeholder="https://..." />
                            </div>
                            <div className={`${styles.formGroup} ${styles.formGridFull}`}>
                                <label className={styles.formLabel}>Notes</label>
                                <textarea name="notes" className={styles.formTextarea} value={form.notes} onChange={handle} placeholder="Additional instructions or reminders..." />
                            </div>
                            <div className={styles.checkRow}>
                                <input id="reminderEnabled" name="reminderEnabled" type="checkbox" className={styles.formCheck} checked={form.reminderEnabled} onChange={handle} />
                                <label htmlFor="reminderEnabled" className={styles.checkLabel}>Enable reminder</label>
                            </div>
                            {form.reminderEnabled && (
                                <div className={styles.formGroup}>
                                    <label className={styles.formLabel}>Days Before</label>
                                    <input name="reminderDaysBefore" type="number" min="1" className={styles.formInput} value={form.reminderDaysBefore} onChange={handle} placeholder="3" />
                                </div>
                            )}
                        </div>
                    </div>
                    <div className={styles.modalFooter}>
                        <button type="button" className={styles.cancelBtn} onClick={onClose}>Cancel</button>
                        <button type="submit" className={styles.submitBtn} disabled={saving}>
                            {saving ? "Saving…" : mode === "edit" ? "Save Changes" : "Add Exam"}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    )
}

