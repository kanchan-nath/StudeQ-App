                                <button className={styles.viewAll} onClick={() => navigate("/calendar")}>
                                    View all <i className="ti ti-arrow-right" aria-hidden="true" />
                                </button>
                            </div>
                            <div className={styles.scheduleList}>
                                {loading ? (
                                    <div className={styles.emptyState}>Loading schedule…</div>
