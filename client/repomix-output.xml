                </span>
            </div>
        ))}
        {projects.length === 0 && <div className={styles.emptyState}>No projects yet.</div>}
    </div>
);

// ─── Main Component ───────────────────────────────────────────────────────────

const ProjectSubmissionScheduler = () => {
    const [allProjects, setAllProjects] = useState([]);
    const [selectedProject, setSelectedProject] = useState(null);
    const [showModal, setShowModal] = useState(false);
    const [modalPhase, setModalPhase] = useState("Not Started");
    const [view, setView] = useState("Kanban");
    const [loading, setLoading] = useState(true);
    const token = localStorage.getItem("token");

    // ── Fetch ──────────────────────────────────────────────────────────────────
    const fetchAll = async () => {
        setLoading(true);
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/project-submission`, {
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            if (!res.ok) throw Error("Fetch failed");
            const data = await res.json();
            setAllProjects(data.data || []);
        } catch (e) { console.error(e); }
        finally { setLoading(false); }
    };

    useEffect(() => { fetchAll(); }, []);

    // ── CRUD ───────────────────────────────────────────────────────────────────
    const handleCreate = async (form) => {
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/project-submission`, {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                body: JSON.stringify(form),
            });
            if (!res.ok) throw Error("Create failed");
            setShowModal(false);
            fetchAll();
        } catch (e) { console.error(e); }
    };

    const handleView = async (id) => {
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/project-submission/${id}`, {
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            if (!res.ok) throw Error("Fetch failed");
            const data = await res.json();
            const proj = Array.isArray(data.data) ? data.data[0] : data.data;
            setSelectedProject(proj);
        } catch (e) { console.error(e); }
    };

    const handleDelete = async (id) => {
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/project-submission/${id}`, {
                method: "DELETE",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            if (!res.ok) throw Error("Delete failed");
            setSelectedProject(null);
            fetchAll();
        } catch (e) { console.error(e); }
    };

    const handleEdit = async (id, form) => {
        try {
            const res = await fetch(`${BASE_URL}/api/scheduler/project-submission/${id}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                body: JSON.stringify(form),
            });
            if (!res.ok) throw Error("Update failed");
            fetchAll();
            // refresh panel
            const updated = await fetch(`${BASE_URL}/api/scheduler/project-submission/${id}`, {
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            });
            const d = await updated.json();
            setSelectedProject(Array.isArray(d.data) ? d.data[0] : d.data);
        } catch (e) { console.error(e); }
    };

    // ── Derived ────────────────────────────────────────────────────────────────
    const byPhase = PHASES.reduce((acc, p) => {
        acc[p] = allProjects.filter(pr => pr.phase === p);
        return acc;
    }, {});

    const totalActive = allProjects.filter(p => p.phase !== "Graded").length;

    return (
        <div className={`${styles.wrapper} ${selectedProject ? styles.wrapperSplit : ""}`}>
            {/* ── Main ───────────────────────────────────────────────────────── */}
            <div className={styles.main}>
                {/* Top bar */}
                <div className={styles.topBar}>
                    <div>
                        <h1 className={styles.pageTitle}>Project Submissions</h1>
                        <p className={styles.pageSubtitle}>
                            <Layers size={15} />
                            {loading ? "Loading…" : `${totalActive} active projects across ${PHASES.length} stages`}
                        </p>
                    </div>
                    <div className={styles.topRight}>
                        <ViewToggle view={view} setView={setView} />
                        <button className={styles.btnNew} onClick={() => { setModalPhase("Not Started"); setShowModal(true); }}>
                            <Plus size={15} /> New Project
                        </button>
                    </div>
                </div>

                {/* Board */}
                {loading ? (
                    <div className={styles.loadingState}>
                        {[1, 2, 3, 4].map(i => <div key={i} className={styles.skeletonCol} />)}
                    </div>
                ) : view === "Kanban" ? (
                    <div className={styles.board}>
                        {PHASES.map(phase => (
                            <KanbanColumn
                                key={phase}
                                phase={phase}
                                items={byPhase[phase]}
                                onView={handleView}
                                activeId={selectedProject?._id}
                                onAddCard={(p) => { setModalPhase(p); setShowModal(true); }}
                            />
                        ))}
                    </div>
                ) : (
                    <ListView projects={allProjects} onView={handleView} onDelete={handleDelete} />
                )}
            </div>

            {/* ── Detail Panel ────────────────────────────────────────────────── */}
            {selectedProject && (
                <DetailPanel
                    project={selectedProject}
                    onClose={() => setSelectedProject(null)}
                    onDelete={handleDelete}
                    onEdit={handleEdit}
                />
            )}

            {/* ── Modal ───────────────────────────────────────────────────────── */}
            {showModal && (
                <NewProjectModal
                    onClose={() => setShowModal(false)}
                    onSave={handleCreate}
                    defaultPhase={modalPhase}
                />
            )}
        </div>
    );
};

export default ProjectSubmissionScheduler;
