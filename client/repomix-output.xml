// ─── Main Component ───────────────────────────────────────────────────────────
const Flashcards = () => {
  const [pdfFilePath, setPdfFilePath] = useState("");
  const [moreFlashId, setMoreFlashId] = useState("");
  const [input, setInput] = useState({ topic: "", subject: "" });
  const [flashcardId, setFlashcardId] = useState("");
  const [loading, setLoading] = useState(false);
  const [inputResult, setInputResult] = useState({});
  const [allFlashcards, setAllFlashcards] = useState([]);
  const [currentView, setCurrentView] = useState(VIEW.HOME);
  const [selectedSet, setSelectedSet] = useState(null);

  const inputRef = useRef(null);
  const token = localStorage.getItem("token");

  const handleSubmit = async ({ topic, subject }) => {
    setLoading(true);
    const id = uuidv4();
    setFlashcardId(id);
    if (moreFlashId) {
      try {
        const res = await fetch(
          `${BASE_URL}/api/quiz/flashcards/${moreFlashId}`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ topic, subject, flashcardId: id }),
          },
        );
        if (!res.ok) console.error("something went wrong");
        await res.json();
        fetchFlashcards();
        setSelectedSet(null);
      } catch (error) {
        console.error(error);
      } finally {
        setLoading(false);
      }
    } else {
      try {
        const res = await fetch(`${BASE_URL}/api/quiz/flashcards`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ topic, subject, flashcardId: id }),
        });
        if (!res.ok) console.error("Something went wrong, Try Again!");
        const data = await res.json();
        setInputResult(data.data);
        setInput({ topic: "", subject: "" });
        fetchFlashcards();
        setSelectedSet(null);
        setCurrentView(VIEW.VIEWER);
      } catch (error) {
        console.error(error);
      } finally {
        setLoading(false);
      }
    }
  };

  const fetchFlashcards = async () => {
    try {
      const res = await fetch(`${BASE_URL}/api/quiz/flashcards`, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
      });
      if (!res.ok) console.error(`Something went wrong, Try Again`);
      const data = await res.json();
      console.log("Flashcards response:", data.data);
      setAllFlashcards(data.data);
    } catch (error) {
      console.error(error);
    }
  };

  const handleClickPdfFlash = async (file) => {
    const formData = new FormData();
    formData.append("pdfFilePath", file);
    try {
      const res = await fetch(`${BASE_URL}/api/quiz/flashcards`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}` },
        body: formData,
      });
      if (!res.ok) console.error("something went wrong");
      const data = await res.json();
      setInputResult(data.data);
      fetchFlashcards();
      setSelectedSet(null);
      setCurrentView(VIEW.VIEWER);
    } catch (error) {
      console.error(error);
    }
  };

  useEffect(() => {
    fetchFlashcards();
  }, []);



  const handleDeleteSet = async (id) => {
    try {
      const res = await fetch(`${BASE_URL}/api/quiz/flashcards/${id}`, {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
      });
      if (!res.ok) return console.error("Delete failed");
      setAllFlashcards((prev) => prev.filter((s) => s._id !== id));
      if (selectedSet?._id === id) {
        setSelectedSet(null);
        setCurrentView(VIEW.HOME);
      }
    } catch (err) {
      console.error(err);
    }
  };

  const navigateTo = (view) => setCurrentView(view);
  const exitToViewer = () => setCurrentView(VIEW.HOME);

  return (
    <div className={styles.appShell}>
      {/* Main scrollable content */}
      <main className={styles.mainContent}>
        {currentView === VIEW.VIEWER && (
          <FlashcardViewer
            allFlashcards={selectedSet ? [selectedSet] : allFlashcards}
            onNavigate={navigateTo}
          />
        )}
        {currentView === VIEW.HOME && (
          <FlashcardHome onNavigate={navigateTo} />
        )}
        {currentView === VIEW.CREATE_STEP1 && (
          <CreateStep1
            onSelect={navigateTo}
            onExit={exitToViewer}
          />
        )}
        {currentView === VIEW.CREATE_STEP2_TOPIC && (
          <CreateStep2Topic
            onBack={() => navigateTo(VIEW.CREATE_STEP1)}
            onExit={exitToViewer}
            onSubmit={handleSubmit}
            loading={loading}
          />
        )}
        {currentView === VIEW.CREATE_STEP2_SCRATCH && (
          <CreateStep2Scratch
            onBack={() => navigateTo(VIEW.CREATE_STEP1)}
            onExit={exitToViewer}
            onSubmit={handleSubmit}
            loading={loading}
          />
        )}
        {currentView === VIEW.CREATE_STEP2_PDF && (
          <CreateStep2PDF
            onBack={() => navigateTo(VIEW.CREATE_STEP1)}
            onExit={exitToViewer}
            onPdfSubmit={handleClickPdfFlash}
          />
        )}
      </main>

      {/* Single right sidebar — static, inner scrollable */}
      <RightSidebar
        activeView={currentView}
        onNavigate={navigateTo}
        allFlashcards={allFlashcards}
        onSelectSet={(set) => {
          setSelectedSet(set);
          navigateTo(VIEW.VIEWER);
        }}
        onDeleteSet={handleDeleteSet}
      />
    </div>
  );
};

export default Flashcards;
</file>

<file path="src/pages/GeneratePlanView.jsx">
import React, { useState } from "react";
import BASE_URL from "../lib/api.js";
import Loader from "../components/Loader";

const GeneratePlanView = () => {
  const [loader, setLoader] = useState(false);
  const [isGenerate_AI_Study_Plan, setIsGenerate_AI_Study_Plan] =
    useState(false);
  const [loadingSavePlanButton, setLoadingSavePlanButton] = useState(false);
  const [studyPlanData, setStudyPlanData] = useState({
    subjects: "",
    hoursPerDay: "",
    goalDate: "",
  });

  const [studyPlanDataResult, setStudyPlanDataResult] = useState([]);

  const token = localStorage.getItem("token");

  const handlebuttonGenerativeAI = async (e) => {
    e.preventDefault();
    setIsGenerate_AI_Study_Plan(true);
    setLoadingSavePlanButton(true);
    setLoader(true);

    try {
      const res = await fetch(`${BASE_URL}/api/scheduler/generate-plan`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(studyPlanData),
      });

      if (!res.ok) {
        throw new Error("response error");
      }

      const data = await res.json();
      setLoader(false);
      setStudyPlanDataResult(data.data);
    } catch (error) {
      console.error(error);
      setLoader(false);
    } finally {
      setIsGenerate_AI_Study_Plan(false);
      setLoader(false);
    }
  };

  const handleChangeStudyPlan = (e) => {
    setStudyPlanData({ ...studyPlanData, [e.target.name]: e.target.value });
  };

  const handleClickSavePlan = async () => {
    setLoader(true);

    try {
      const res = await fetch(`${BASE_URL}/api/scheduler/generate-plan/save`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          subjects: studyPlanData.subjects,
          hoursPerDay: studyPlanData.hoursPerDay,
          goalDate: studyPlanData.goalDate,
          generatedPlan: studyPlanDataResult,
        }),
      });

      const data = await res.json();
      setLoader(false);

      console.log(data);
    } catch (error) {
      throw new Error(error);
    }
  };
  if (loader) return <Loader />;
  return (
    <>
      <div>
        {!isGenerate_AI_Study_Plan ? (
          <button onClick={() => setIsGenerate_AI_Study_Plan(true)}>
            Generate AI Study Plan
          </button>
        ) : (
          <form onSubmit={handlebuttonGenerativeAI}>
            <label htmlFor="subjects">Subjects: </label>
            <input
              type="text"
              name="subjects"
              value={studyPlanData.subjects}
              required
              onChange={handleChangeStudyPlan}
            />

            <label htmlFor="hoursPerDay">Hours Per Day: </label>
            <input
              type="number"
              name="hoursPerDay"
              value={studyPlanData.hoursPerDay}
              required
              onChange={handleChangeStudyPlan}
            />

            <label htmlFor="goalDate">Goal Date : </label>
            <input
              type="date"
              name="goalDate"
              value={studyPlanData.goalDate}
              required
              onChange={handleChangeStudyPlan}
            />
            <button>Submit</button>
          </form>
        )}
      </div>

      <div>
        {studyPlanDataResult.map((item, index) => (
          <div key={index}>
            <h3>Day: {item.day}</h3>
            <p>Duration: {item.duration}</p>
            <p>Subject: {item.subject}</p>
            <p>Topic:{item.topic}</p>
          </div>
        ))}
        {loadingSavePlanButton && (
          <button onClick={handleClickSavePlan}> Save Plan</button>
        )}
      </div>
    </>
  );
};

export default GeneratePlanView;
</file>

