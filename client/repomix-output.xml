<file path="src/pages/Projectsubmissionscheduler.jsx">
import React, { useEffect, useState } from "react";
import BASE_URL from "../lib/api.js";
import styles from "./styles/ProjectSubmissions.module.css";
import {
    CalendarDays, Check, ChevronRight, ClipboardList,
    Clock, Layers, LayoutGrid, List, MoreHorizontal, Plus, Star
} from "lucide-react";
import { Avatar, AvatarFallback } from "@/components/ui/avatar";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
// ─── Constants ────────────────────────────────────────────────────────────────

const PHASES = ["Not Started", "In Progress", "Submitted", "Graded"];

const PHASE_META = {
    "Not Started": { dot: styles.dotGray, bar: styles.barPurple },
    "In Progress": { dot: styles.dotBlue, bar: styles.barPurple },
    "Submitted": { dot: styles.dotBlue, bar: styles.barBlue },
    "Graded": { dot: styles.dotGreen, bar: styles.barGreen },
};

const EMPTY_FORM = { projectTitle: "", submissionDate: "", projectLink: "", phase: "Not Started" };

// ─── Helpers ──────────────────────────────────────────────────────────────────

const formatDate = (iso) => {
    if (!iso) return "";
    const d = new Date(iso);
    return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
};

const daysLeft = (iso) => {
    if (!iso) return null;
    const diff = Math.ceil((new Date(iso) - new Date()) / 86400000);
    return diff;
};

const dateLabel = (item) => {
    const phase = item.phase;
    const diff = daysLeft(item.submissionDate);
    if (phase === "Graded") return { icon: <Clock size={12} />, text: `Graded ${formatDate(item.submissionDate)}`, cls: styles.dateGreen };
    if (phase === "Submitted") return { icon: "⏱", text: `Submitted ${formatDate(item.submissionDate)}`, cls: styles.dateBlue };
    if (diff === null) return null;
    if (diff < 0) return { icon: <Clock size={12} />, text: `Overdue · ${formatDate(item.submissionDate)}`, cls: styles.dateRed };
    return { icon: "⏱", text: `Due in ${diff} day${diff !== 1 ? "s" : ""}`, cls: styles.dateOrange };
};

const initials = (title = "") => title.split(" ").map(w => w[0]).join("").slice(0, 2).toUpperCase();

const avatarColor = (str = "") => {
    const colors = ["#f97316", "#3b82f6", "#10b981", "#8b5cf6", "#ef4444", "#06b6d4"];
    let hash = 0;
    for (let c of str) hash = (hash * 31 + c.charCodeAt(0)) & 0xffff;
    return colors[hash % colors.length];
};

// ─── New Project Modal ─────────────────────────────────────────────────────────

const NewProjectModal = ({ onClose, onSave, defaultPhase }) => {
    const [form, setForm] = useState({ ...EMPTY_FORM, phase: defaultPhase || "Not Started" });
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState("");

    const handle = (e) => setForm({ ...form, [e.target.name]: e.target.value });

    const submit = async (e) => {
        e.preventDefault();
        if (!form.projectTitle.trim()) { setError("Project title is required."); return; }
        if (!form.submissionDate) { setError("Submission date is required."); return; }
        setError("");
        setLoading(true);
        await onSave(form);
        setLoading(false);
    };

    return (
        <div className={styles.modalOverlay} onClick={onClose}>
            <div className={styles.modal} onClick={e => e.stopPropagation()}>
                <div className={styles.modalHeader}>
                    <div>
                        <h2 className={styles.modalTitle}>Add New Project</h2>
                        <p className={styles.modalSub}>Fill in the details to add a new project to the board.</p>
                    </div>
                    <button className={styles.modalClose} onClick={onClose}>✕</button>
                </div>

                <form onSubmit={submit} className={styles.modalForm}>
                    {error && <div className={styles.formError}>{error}</div>}

                    <div className={styles.formRow}>
                        <div className={styles.formGroup}>
                            <label className={styles.formLabel}>Project Title</label>
                            <input
                                name="projectTitle"
                                type="text"
                                className={styles.formInput}
                                placeholder="e.g. Mobile App Prototype"
                                value={form.projectTitle}
                                onChange={handle}
                            />
                        </div>
                        <div className={styles.formGroup}>
                            <label className={styles.formLabel}>Submission Date</label>
                            <input
                                name="submissionDate"
                                type="date"
                                className={styles.formInput}
                                value={form.submissionDate}
                                onChange={handle}
                            />
                        </div>
