<file path="src/pages/styles/dashboard.module.css">
/* dashboard.module.css — Dashboard page (scoped) */

/* Wrapper — renders inside AppShell's main-content */
.app-shell {
  display: contents;
}

/* ── MAIN CONTENT ────────────────────────────────────────────── */
.main-content {
  overflow-y: auto;
  overflow-x: hidden;
  padding: var(--sp-6) var(--sp-8);
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  scroll-behavior: smooth;
}

/* ── GREETING BANNER ─────────────────────────────────────────── */
.greeting-banner {
  display: flex;
  align-items: center;
  gap: var(--sp-5);
  background: linear-gradient(135deg, var(--theme-surface) 0%, var(--theme-bg-secondary) 60%, var(--theme-surface) 100%);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-5) var(--sp-6);
  position: relative;
  overflow: hidden;
  animation: fadeSlideDown 0.45s ease both;
  box-shadow:
    0 0 0 1px var(--theme-border),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.greeting-banner::before {
  content: "";
  position: absolute;
  top: -60px;
  right: -60px;
  width: 220px;
  height: 220px;
  background: radial-gradient(circle,
      var(--theme-purple-dim) 0%,
      transparent 65%);
  pointer-events: none;
}

.greeting-banner::after {
  content: "";
  position: absolute;
  bottom: -40px;
  left: 30%;
  width: 140px;
  height: 140px;
  background: radial-gradient(circle,
      var(--theme-purple-dim) 0%,
      transparent 70%);
  pointer-events: none;
}

.greeting-banner__avatar {
  width: 52px;
  height: 52px;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--clr-primary), var(--theme-purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  flex-shrink: 0;
  box-shadow:
    0 4px 16px var(--theme-purple-dim),
    0 0 0 3px var(--theme-purple-dim);
}

.greeting-banner__text h1 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--theme-text);
  line-height: 1.3;
}

.greeting-banner__text p {
  font-size: 0.875rem;
  color: var(--theme-text-secondary);
  margin-top: 2px;
}

.greeting-banner__text p a,
.greeting-banner__text p strong {
  color: var(--theme-accent);
  font-weight: 600;
}

/* ── SECTION HEADER ──────────────────────────────────────────── */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--sp-4);
}

.section-header h2 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--theme-text);
}

.section-header p {
  font-size: 0.82rem;
  color: var(--theme-text-muted);
  margin-top: 2px;
}

/* ── QUICK ACTIONS ───────────────────────────────────────────── */
.quick-actions {
  background: linear-gradient(160deg, var(--theme-surface) 0%, var(--theme-bg-secondary) 100%);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  animation: fadeSlideDown 0.5s 0.05s ease both;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.quick-actions__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-3);
}

.quick-action-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-4) var(--sp-5);
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  transition:
    background var(--t-base),
    border-color var(--t-base),
    transform var(--t-base),
    box-shadow var(--t-base),
    color var(--t-base);
  cursor: pointer;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

.quick-action-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg,
      var(--theme-purple-dim) 0%,
      transparent 60%);
  opacity: 0;
  transition: opacity var(--t-base);
}

.quick-action-card:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  transform: translateY(-2px);
  box-shadow:
    0 8px 24px var(--theme-purple-dim),
    0 0 0 1px var(--theme-border-hover);
}

.quick-action-card:hover::before {
  opacity: 1;
}

.quick-action-card__icon {
  width: 32px;
  height: 32px;
  border-radius: var(--r-sm);
  background: var(--theme-purple-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
  transition:
    background var(--t-fast),
    box-shadow var(--t-fast);
  box-shadow: 0 2px 8px var(--theme-purple-dim);
  position: relative;
  z-index: 1;
}

.quick-action-card:hover .quick-action-card__icon {
  background: var(--theme-purple-dim);
  box-shadow: 0 2px 12px var(--theme-purple-dim);
}

/* ── PROFILE CARD ────────────────────────────────────────────── */
.profile-section {
  animation: fadeSlideDown 0.5s 0.1s ease both;
}

.profile-card {
  background: linear-gradient(160deg, var(--theme-surface) 0%, var(--theme-bg-secondary) 100%);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  display: flex;
  align-items: flex-start;
  gap: var(--sp-6);
  box-shadow: var(--theme-card-shadow);
}

.profile-card__info {
  flex: 1;
}

.profile-card__label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
  margin-bottom: var(--sp-4);
}

.profile-card__rows {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.profile-card__row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  font-size: 0.875rem;
}

.profile-card__row-key {
  width: 60px;
  font-weight: 600;
  color: var(--theme-text-muted);
  flex-shrink: 0;
}

.profile-card__row-val {
  color: var(--theme-text);
  font-weight: 500;
  background: var(--theme-purple-dim);
  padding: 3px 12px;
  border-radius: var(--r-full);
  border: 1px solid var(--theme-border);
  font-size: 0.82rem;
}

/* ── FEATURE CARDS ───────────────────────────────────────────── */
.feature-section {
  animation: fadeSlideDown 0.5s 0.15s ease both;
}

.feature-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-4);
}

.feature-card {
  background: linear-gradient(145deg, var(--theme-surface) 0%, var(--theme-bg-secondary) 100%);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  transition:
    border-color var(--t-base),
    box-shadow var(--t-base),
    transform var(--t-base),
    background var(--t-base);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg,
      transparent,
      var(--theme-purple-light),
      transparent);
  opacity: 0;
  transition: opacity var(--t-base);
}

.feature-card::after {
  content: "";
  position: absolute;
  top: -60px;
  right: -60px;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: radial-gradient(circle,
      var(--theme-purple-dim) 0%,
      transparent 70%);
  pointer-events: none;
  transition: opacity var(--t-base);
}

.feature-card:hover {
  border-color: var(--theme-border-hover);
  box-shadow: var(--theme-card-shadow);
  transform: translateY(-3px);
  background: linear-gradient(145deg, var(--theme-surface-2) 0%, var(--theme-surface) 100%);
}

.feature-card:hover::before {
  opacity: 1;
}

/* ── ICON VARIANTS ───────────────────────────────────────────── */
.feature-card__icon {
  width: 40px;
  height: 40px;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast);
}

.feature-card:hover .feature-card__icon {
  transform: scale(1.08);
}

.feature-card__icon--blue {
  background: rgba(59, 130, 246, 0.18);
  box-shadow:
    0 0 0 1px rgba(59, 130, 246, 0.25),
    0 4px 12px rgba(59, 130, 246, 0.12);
}

.feature-card:hover .feature-card__icon--blue {
  box-shadow:
    0 0 0 1px rgba(59, 130, 246, 0.4),
    0 4px 16px rgba(59, 130, 246, 0.22);
}

.feature-card__icon--purple {
  background: var(--theme-purple-dim);
  box-shadow:
    0 0 0 1px var(--theme-border),
    0 4px 12px var(--theme-purple-dim);
}

.feature-card:hover .feature-card__icon--purple {
  box-shadow:
    0 0 0 1px var(--theme-border-hover),
    0 4px 16px var(--theme-purple-dim);
}

.feature-card__icon--green {
  background: rgba(16, 185, 129, 0.18);
  box-shadow:
    0 0 0 1px rgba(16, 185, 129, 0.25),
    0 4px 12px rgba(16, 185, 129, 0.12);
}

.feature-card:hover .feature-card__icon--green {
  box-shadow:
    0 0 0 1px rgba(16, 185, 129, 0.4),
    0 4px 16px rgba(16, 185, 129, 0.22);
}

.feature-card__icon--orange {
  background: rgba(251, 146, 60, 0.18);
  box-shadow:
    0 0 0 1px rgba(251, 146, 60, 0.25),
    0 4px 12px rgba(251, 146, 60, 0.12);
}

.feature-card:hover .feature-card__icon--orange {
  box-shadow:
    0 0 0 1px rgba(251, 146, 60, 0.4),
    0 4px 16px rgba(251, 146, 60, 0.22);
}

.feature-card__icon--pink {
  background: rgba(236, 72, 153, 0.18);
  box-shadow:
    0 0 0 1px rgba(236, 72, 153, 0.25),
    0 4px 12px rgba(236, 72, 153, 0.12);
}

.feature-card:hover .feature-card__icon--pink {
  box-shadow:
    0 0 0 1px rgba(236, 72, 153, 0.4),
    0 4px 16px rgba(236, 72, 153, 0.22);
}

.feature-card__icon--teal {
  background: rgba(20, 184, 166, 0.18);
  box-shadow:
    0 0 0 1px rgba(20, 184, 166, 0.25),
    0 4px 12px rgba(20, 184, 166, 0.12);
}

.feature-card:hover .feature-card__icon--teal {
  box-shadow:
    0 0 0 1px rgba(20, 184, 166, 0.4),
    0 4px 16px rgba(20, 184, 166, 0.22);
}

/* ── CARD TEXT ───────────────────────────────────────────────── */
.feature-card__title {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--theme-text);
  position: relative;
  z-index: 1;
}

.feature-card__desc {
  font-size: 0.8rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  flex: 1;
  position: relative;
  z-index: 1;
}

.feature-card__cta {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--theme-accent);
  display: flex;
  align-items: center;
  gap: 4px;
  transition:
    gap var(--t-fast),
    color var(--t-fast);
  position: relative;
  z-index: 1;
  background: none;
  padding: 0;
}

.feature-card__cta::after {
  content: "→";
  font-size: 0.85rem;
  transition: transform var(--t-fast);
}

.feature-card:hover .feature-card__cta {
  gap: 8px;
  color: var(--theme-accent);
  filter: brightness(1.1);
}

.feature-card:hover .feature-card__cta::after {
  transform: translateX(2px);
}

/* ── FOCUS VISIBLE ───────────────────────────────────────────── */
.quick-action-card:focus-visible,
.feature-card:focus-visible {
  outline: 2px solid var(--theme-purple);
  outline-offset: 2px;
}

/* ── ANIMATIONS ──────────────────────────────────────────────── */
@keyframes fadeSlideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .feature-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quick-actions__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 720px) {
  .main-content {
    padding: var(--sp-4);
  }

  .greeting-banner {
    padding: var(--sp-4);
  }

  .greeting-banner__text h1 {
    font-size: 1rem;
  }

  .quick-actions__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .feature-cards-grid {
    grid-template-columns: 1fr;
  }

  .profile-card {
    flex-direction: column;
  }
}
