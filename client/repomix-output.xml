const LLMMarkdown = ({ content }) => {
  return (
    <ReactMarkdown
      remarkPlugins={[remarkGfm]}
      rehypePlugins={[rehypeRaw]} // enables raw HTML like <u> and <mark>
      components={{
        mark({ children }) {
          return (
            <mark
              style={{
                background: "#ffe066",
                padding: "0 2px",
                borderRadius: "3px",
              }}
            >
              {children}
            </mark>
          );
        },
        u({ children }) {
          return <u>{children}</u>;
        },
      }}
