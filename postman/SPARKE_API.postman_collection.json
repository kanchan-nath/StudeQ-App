              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Physics\",\n  \"topic\": \"Newton Laws of Motion\",\n  \"types\": \"mcq\",\n  \"difficulty\": \"medium\",\n  \"title\": \"Newton Laws Quiz\"\n}"
            }
          }
        },
        {
          "name": "Generate Quiz From File (PDF)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/quiz/generate/file",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "types", "value": "mcq", "type": "text" },
                { "key": "total", "value": "5", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Get All Quizzes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/quiz/all",
