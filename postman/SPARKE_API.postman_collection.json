          }
        },
        {
          "name": "Get Quiz By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/quiz/{{id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Submit Quiz Answers",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/quiz/{{id}}/submit",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"REPLACE_QUESTION_ID\", \"answer\": \"A\" },\n    { \"questionId\": \"REPLACE_QUESTION_ID\", \"answer\": \"True\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Quiz Result",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/quiz/{{id}}/result",
            "header": [
