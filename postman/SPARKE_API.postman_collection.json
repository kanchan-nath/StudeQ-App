{
  "info": {
    "name": "SPARK.E API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API collection for SPARK.E backend"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "id", "value": "REPLACE_WITH_ID", "type": "string" },
    { "key": "docId", "value": "REPLACE_WITH_DOC_ID", "type": "string" },
    { "key": "chatRoomKey", "value": "REPLACE_WITH_CHATROOM_KEY", "type": "string" },
    { "key": "chatId", "value": "REPLACE_WITH_CHAT_ID", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kanchan\",\n  \"email\": \"kanchan@example.com\",\n  \"password\": \"password123\",\n  \"grade\": 12\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kanchan@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "" }
          }
        },
        {
          "name": "Get User Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/userinfo",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notes",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Newton's laws of motion describe the relationship between forces acting on a body and its motion.\"\n}"
            }
          }
        },
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notes",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notes/{{id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated note content here.\"\n}"
            }
          }
        },
        {
          "name": "Toggle Pin Note",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notes/{{id}}/pin",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPinned\": true\n}"
            }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/notes/{{id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Quiz",
      "item": [
        {
          "name": "Generate Quiz (Text)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/quiz/generate",
            "header": [
