generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  pro
  premium
}

model User {
  id              Int         @id @default(autoincrement())
  name            String
  email           String      @unique
  password        String?
  grade           String?
  refreshToken    String?
  totalXp         Int         @default(0)
  streak          Int         @default(0)
  planId          Plan        @default(free)
  lastStudyDate   String?
  roomCreated     StudyRoom[]
  createdAt       DateTime    @default(now())
}
model StudyRoom {
  id          Int    @id @default(autoincrement())
  name        String
  roomId      String
  createdById Int
  createdBy   User   @relation(fields: [createdById], references: [id])
}
