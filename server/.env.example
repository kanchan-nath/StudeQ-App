# ─── SERVER ───────────────────────────────────────────────
PORT=3000
NODE_ENV=
LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated, no trailing slashes
CORS_ORIGINS=http://localhost:5173

# ─── AUTH ─────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=30d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=60d
BCRYPT_SALT_ROUNDS=10
REFRESH_TOKEN_SALT_ROUNDS=8

# ─── DATABASES ────────────────────────────────────────────
POSTGRES_URL=
MONGO_URI=
MONGO_DB_NAME=
MONGO_POOL_SIZE=10
DB_POOL_MAX=10

# ─── REDIS ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=743412

# ─── AI — GROQ ────────────────────────────────────────────
GROQ_API_KEY=
GROQ_SUMMARIZE_MODEL=llama-3.3-70b-versatile
GROQ_QUIZ_MODEL=llama-3.3-70b-versatile
GROQ_QA_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_RAG_MODEL=llama-3.3-70b-versatile

# ─── AI — NVIDIA ──────────────────────────────────────────
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_LLAMA_API_KEY=

# ─── VECTOR DB ────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# ─── SEARCH ───────────────────────────────────────────────
SERP_API_KEY=
SEARCH_LOCATION=India
SEARCH_HL=en
SEARCH_GL=in
UNSPLASH_ACCESS_KEY=

# ─── EMAIL ────────────────────────────────────────────────
SMTP_USER=
SMTP_APP_PASSWORD=

# ─── FILE UPLOAD ──────────────────────────────────────────
UPLOAD_DIR=uploads
PDF_IMAGES_DIR=uploads/images
MAX_UPLOAD_SIZE_MB=20
VISION_BATCH_SIZE=4
PDF_CONVERT_BATCH_SIZE=4

# ─── CACHE ────────────────────────────────────────────────
USER_CACHE_TTL_SECONDS=60

# ─── OBSERVABILITY ────────────────────────────────────────
AXIOM_TOKEN=
AXIOM_DATASET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=