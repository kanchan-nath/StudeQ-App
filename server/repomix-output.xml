<file path="controllers/analyzeImage.controller.js">
import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiError, ApiResponse } from "../utils/Async.js"
import fs from "fs"
import { imageAnalyze } from "../lib/groq/imageAnalyze.js"

const analyze = asyncHandler(async (req, res) => {
    try {
        const imageFile = req.files?.image[0]?.path

        if (!imageFile) {
            throw new ApiError(400, "No image file uploaded")
        }

        const mimeType = imageFile.mimetype
        const imageData = fs.readFileSync(imageFile.path)
        const base64Image = imageData.toString("base64")

        const data = await imageAnalyze(base64Image, mimeType)

        return res
            .status(200)
            .json(new ApiResponse(200, data, "file uploaded"))
    } finally {
        if (imageFile?.path && fs.existsSync(imageFile.path)) {
            fs.unlinkSync(imageFile.path)
        }
    }


})

export {
    analyze
}
</file>

<file path="controllers/filesRag.controller.js">
import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiError, ApiResponse } from "../utils/Async.js"
import { vectorDB, queryDB, deleteDocumentVectors } from "../services/vectordb.js"
import llmCall from "../lib/groq/llmCall.js"
import { Documents } from "../models/document.model.js"
import { v4 as uuid4 } from "uuid"
import { ChatRoom } from "../models/chatRoom.model.js"
import mongoose from "mongoose"
import { ragQueryValidator } from "../validators/ragQuery.validator.js"
import logger from "../logger/index.js"

const isValidId = (id)=>{
    return mongoose.Types.ObjectId.isValid(id)
}

const uploadFile = asyncHandler(async (req, res) => {
    const userId = req.user?.id

    const localFile = req.files?.file?.[0]

    if (!localFile) {
        throw new ApiError(400, "No file uploaded")
    }

    const metadata = await Documents.create(
        {
            userId,
            originalName: localFile.originalname,
            encoding: localFile.encoding,
            mimeType: localFile.mimetype,
            fileName: localFile.filename,
            size: localFile.size
        }
    )

    const documentId = metadata._id
    const documentName = metadata.originalName

    let data
    try {
        const chunkCount = await vectorDB(localFile, userId, documentId)
        await Documents.findByIdAndUpdate(documentId, { chunkCount }) 
        data = await ChatRoom.create({
            userId,
            docId: documentId
        })
    } catch (error) {
        await Documents.findByIdAndDelete(documentId).catch(()=>{})
        await deleteDocumentVectors(userId, documentId).catch(() => { })

        throw new ApiError(500, "File processing failed, please try again")
    }

    return res
        .status(201)
        .json(new ApiResponse(201, data, "Document's metadata uploaded successfully"))

})

const askQuery = asyncHandler(async (req, res) => {
    const { id, docId } = req.params
    
    if (!id) {
        throw new ApiError(400, "Something went wrong")
    }

    if (!docId) {
        throw new ApiError(400, "Something went wrong")
    }

    if(!isValidId(id)){
        throw new ApiError(400, "Invalid Id")
    }
    if (!isValidId(docId)) {
        throw new ApiError(400, "Invalid Document Id")
    }

    const userId = req.user.id

    const {data, error} = ragQueryValidator.safeParse(req.body)
    
    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { query } = data    

    const topChunks = await queryDB(query, userId, docId)
    const results = await llmCall(query, topChunks, userId)
    
    await ChatRoom.findOneAndUpdate(
        {
            userId,
            _id:id
        },
        {
            $push: {
                messages: {
                    $each: [
                        {
                            role: "user",
                            content: query
                        },
                        {
                            role: "assistant",
                            content: results
                        }
                    ]
                }
            }
        },
    )

    return res
        .status(200)
        .json(new ApiResponse(200, results, "Response provided successfully"))
})

const allChatsMessage = asyncHandler(async (req, res) => {
    const { id } = req.params

    if (!id) {
        throw new ApiError(400, "Something went wrong")
    }

    if (!isValidId(id)) {
        throw new ApiError(400, "Invalid Id")
    }

    const userId = req.user.id

    const data = await ChatRoom.findOne(
        {
            _id:id,
            userId
        }
    )

    if(!data){
        throw new ApiError(404, "Chat room not found")
    }

    return res
        .status(200)
        .json(new ApiResponse(200, data, "Messages fetched"))
})

const updateQuery = asyncHandler(async (req, res) => {
    
    const { id, chatId } = req.params

    const messageId = chatId

    if (!id || !messageId) {
        throw new ApiError(400, "Room id and message id are required")
    }

    if (!isValidId(id) || !isValidId(messageId)) {
        throw new ApiError(400, "Invalid id")
    }

    const {data, error} = ragQueryValidator.safeParse(req.body)
    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { query } = data

    const userId = req.user.id

    const topChunks = await queryDB(query, userId)

    if (!topChunks?.length) {
        throw new ApiError(400, "Could not retrieve relevant context")
    }

    const results = await llmCall(query, topChunks, userId)

    if (!results) {
        throw new ApiError(400, "Query answer problem, Try Again")
    }

    const chatRoom = await ChatRoom.findOne({ userId, _id:id })
    if (!chatRoom) throw new ApiError(404, "Chat room not found")

    const msgIndex = chatRoom.messages.findIndex(
        m => m._id.toString() == chatId
    )

    if (msgIndex === -1) throw new ApiError(404, "Message not found")

        const nextMsg = chatRoom.messages[msgIndex+1]
        if(!nextMsg || nextMsg.role !=="assistant"){
            throw new ApiError(400, "Message pair structure invalid")
        }

    chatRoom.messages[msgIndex].content = query
    chatRoom.messages[msgIndex + 1].content = results

   await chatRoom.save()

    return res
        .status(200)
        .json(new ApiResponse(200, chatRoom, "Query updated"))
})

const allChats = asyncHandler(async (req, res) => {
    const userId = req.user?.id

    const data = await ChatRoom.find(
        {
            userId
        }
    ).select({ docId: 1, messages: { $slice: -1 }, createdAt: 1 })

    return res
        .status(200)
        .json(new ApiResponse(200, data, "All chats fetched successfully"))
})

const deleteChat = asyncHandler(async (req, res) => {
    const { id } = req.params

    if (!id) {
        throw new ApiError(400, "Something went wrong")
    }

    if (!isValidId(id)) {
        throw new ApiError(400, "Invalid Id")
    }

    const userId = req.user.id

    const chatRoom = await ChatRoom.findOneAndDelete({ userId, _id: id })    

    if (!chatRoom) {
        throw new ApiError(404, "Chat not found")
    }

    if (chatRoom.docId) {
        const documentId = chatRoom.docId
        Promise.all([
            Documents.findByIdAndDelete(documentId).catch(e =>
                logger.error("Doc metadata cleanup failed:", e)
            ),
            deleteDocumentVectors(userId, documentId).catch(e =>
                logger.error("Vector cleanup failed:", e)
            )
        ])
    }

    return res
        .status(200)
        .json(new ApiResponse(200, {}, "Chat deleted successfully"))
})
export {
    uploadFile,
    askQuery,
    allChatsMessage,
    updateQuery,
    allChats,
    deleteChat
}
</file>

<file path="controllers/health.controller.js">
import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiResponse } from "../utils/Async.js"
import mongoose from "mongoose"
import prisma from "../lib/prisma.js"
import redisClient from "../lib/redisClient.js"

const withTimeout = (promise, ms = 3000, name = "check") =>
    Promise.race([
        promise,
        new Promise((_, reject) =>
            setTimeout(() => reject(new Error(`${name} timed out after ${ms}ms`)), ms)
        )
    ])

const liveness = asyncHandler(async (req, res) => {
    return res.status(200).json(
        new ApiResponse(200, {
            status: "ok",
            uptime: process.uptime(),
            timestamp: new Date().toISOString(),

        }, "Server is alive")
    )
})

const readiness = asyncHandler(async (req, res) => {
    const checks = await Promise.allSettled([
        withTimeout(checkMongo(), 3000, "MongoDB"),
        withTimeout(checkPostgres(), 3000, "PostgreSQL"),
        withTimeout(checkRedis(), 3000, "Redis"),
    ])

    const [mongo, postgres, redis] = checks.map(parseCheck)

    const allHealthy = [mongo, postgres, redis].every(s => s.status === "ok")
    const httpStatus = allHealthy ? 200 : 503

    return res.status(httpStatus).json(
        new ApiResponse(httpStatus, {
            status: allHealthy ? "ok" : "degraded",
            uptime: Math.floor(process.uptime()),
            timestamp: new Date().toISOString(),
            services: { mongo, postgres, redis },
        }, allHealthy ? "All services healthy" : "One or more services degraded")
    )
})

async function checkMongo() {
    const start = Date.now()
    const state = mongoose.connection.readyState
    if (state !== 1) throw new Error(`Mongoose readyState: ${state}`)
    await mongoose.connection.db.command({ ping: 1 })
    return { name: "MongoDB", latency: Date.now() - start }
}

async function checkPostgres() {
    const start = Date.now()
    await prisma.$queryRaw`SELECT 1`
    return { name: "PostgreSQL", latency: Date.now() - start }
}

async function checkRedis() {
    const start = Date.now()
    const pong = await redisClient.ping()
    if (pong !== "PONG") throw new Error(`Unexpected ping reply: ${pong}`)
    return { name: "Redis", latency: Date.now() - start }
}

function parseCheck(settled) {
    if (settled.status === "fulfilled") {
        return {
            status: "ok",
            name: settled.value.name,
            latencyMs: settled.value.latency
        }
    }
    return {
        status: "down",
        error: settled.reason?.message || "Unknown error",
    }
}

export { liveness, readiness }
</file>

<file path="controllers/note.controller.js">
import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiError, ApiResponse } from "../utils/Async.js"
import { summarizeText } from "../lib/groq/summarizer.js"
import { Note } from "../models/note.model.js"
import { AIResponseQueue } from "../services/queue.js"
import { noteValidator } from "../validators/note.validator.js"
import mongoose from "mongoose"

const titleExtract = (markdownResponse) => {
    if (!markdownResponse) return "Summary"
    const match = markdownResponse.match(/##\s+Topic\s*\n+(.+)/);
    return match ? match[1].trim() : "Summary";
};

const createNote = asyncHandler(async (req, res) => {

    const { data, error } = noteValidator.safeParse(req.body)

    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { content } = data

    if (!content) {
        throw new ApiError(400, "Content is required")
    }
    const userId = req.user.id

    const response = await summarizeText(content, userId)

    if (!response) {
        await AIResponseQueue(userId, content)

        return res
            .status(202)
            .json(new ApiResponse(202, {}, "Summarization queued — you'll be notified when ready"))

    }
    const title = await titleExtract(response)

    const dbData = await Note.create({
        userId,
        title,
        content,
        summary: response,
    })
    return res
        .status(201)
        .json(new ApiResponse(201, dbData, "Note created successfully"))

})

const getNote = asyncHandler(async (req, res) => {
    const userId = req.user.id

    const allNotes = await Note.find({
        userId: userId
    }).sort({ isPinned: -1, createdAt: -1 })

    return res
        .status(200)
        .json(new ApiResponse(200, allNotes, "All notes fetched successfully"))

})

const deleteNote = asyncHandler(async (req, res) => {
    const { id } = req.params

    if (!mongoose.Types.ObjectId.isValid(id)) {
        throw new ApiError(400, "Invalid note ID")
    }

    const userId = req.user.id

    const deleted = await Note.findByIdAndDelete({
        _id: id,
        userId: userId
    })

    if (!deleted) {
        throw new ApiError(404, "Note not found")
    }

    return res
        .status(200)
        .json(new ApiResponse(200, {}, "Note deleted succesfully"))
})

const updateNote = asyncHandler(async (req, res) => {

    const { data, error } = noteValidator.safeParse(req.body)

    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { content } = data

    if (!content) {
        throw new ApiError(400, "Content is required")
    }
    const { id } = req.params

    if (!content || !id) {
        throw new ApiError(400, "Content and id are required")
    }

    if (!mongoose.Types.ObjectId.isValid(id)) {
        throw new ApiError(400, "Invalid note ID")

    }
    const userId = req.user.id

    const response = await summarizeText(content, userId)

    if (!response) {
        throw new ApiError(500, "Summarization failed, please try again")

    }

    const title = titleExtract(response)

    const updated = await Note.findOneAndUpdate(
        {
            _id: id,
            userId
        },
        {
            content,
            title,
            summary: response
        },
        {
            returnDocument: 'after'
        }
    )

    if (!updated) {
        throw new ApiError(404, "Note not found")
    }

    return res
        .status(200)
        .json(new ApiResponse(200, updated, "Note updated successfully"))

})

const togglePin = asyncHandler(async (req, res) => {
    const { newPinned } = req.body
    if (typeof newPinned !== "boolean") {
        throw new ApiError(400, "newPinned must be a boolean")
    }

    const { id } = req.params
    if (!mongoose.Types.ObjectId.isValid(id)){
        throw new ApiError(400, "Invalid note ID")
    }
    const userId = req.user.id

    const updated = await Note.findOneAndUpdate(
        {
            userId,
            _id: id
        },
        {
            isPinned: newPinned
        },
        { returnDocument: "after" }
    )

    if(!updated){
        throw new ApiError(404, "Note not found")   
    }
    return res
        .status(200)
        .json(new ApiResponse(200, {}, "pin successful"))
})
export {
    createNote,
    getNote,
    deleteNote,
    updateNote,
    togglePin,
    titleExtract
}
</file>

