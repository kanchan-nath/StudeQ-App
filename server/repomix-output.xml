    getAllQuiz,
    getQuizById,
    submitQuizAnswers,
    deleteQuiz,
    generateQuizFromFiles,
    getResult,
    getQuizStats,

    generateFlashcards,
    getFlashcards,
    deleteFlashcards,
    addMoreFlashcards,
    getFlashcardStats
}
