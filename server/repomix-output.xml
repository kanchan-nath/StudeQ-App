<file path="services/chunking.js">
import { RecursiveCharacterTextSplitter } from "@langchain/textsplitters";
import embedText from "./embedText.js";
import logger from "../logger/index.js"

const splitter = new RecursiveCharacterTextSplitter({
    chunkSize: 1500,
    chunkOverlap: 200,
})

const chunking = async (text) => {
    if (!text || typeof text !== "string" || text.trim().length === 0) {
        throw new Error("chunking: non-empty string required")
    }

    const chunks = await splitter.splitText(text)

    if (chunks.length === 0) {
        throw new Error("chunking: no chunks produced — text may be too short or malformed")
    }

    if (chunks.length === 1) {
        logger.warn(`chunking: only 1 chunk produced from ${text.length} chars — document may be very short`)
    }
    return chunks
}

export default chunking
</file>

<file path="services/embedText.js">
import { pipeline } from "@xenova/transformers";

let embedderPromise = null

const getEmbedder = () => {
    if (!embedderPromise) {
        embedderPromise = pipeline("feature-extraction", "Xenova/bge-large-en-v1.5")
    }
    return embedderPromise
}

const embedText = async (text) => {

    const embedder = await getEmbedder()
    const output = await embedder(text, {
        pooling: "mean",
        normalize: true
    })

    return Array.from(output.data)
}

export default embedText
