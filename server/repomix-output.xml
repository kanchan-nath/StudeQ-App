<file path="services/textExtractor.js">
import {ApiError}from "../utils/Async.js"
import {PDFParse} from "pdf-parse"
import fs from "fs"
import XLSX from "xlsx"
import Tesseract from "tesseract.js"
import chunking from "./chunking.js"
import embedText from "./embedText.js"

const textExtractor = async (file) => {
    const mimeType = file.mimetype
    const filePath = file.path

    try {
        if (mimeType == "application/pdf") {
            const dataBuffer = fs.readFileSync(file.path)
            const uint8Array = new Uint8Array(dataBuffer)
            const parser = new PDFParse(uint8Array)
            const extractedText = (await parser.getText()).text
            
            embedText(extractedText)
            fs.unlinkSync(filePath)
            return extractedText

        } else if (mimeType == "application/vnd.ms-excel") {
            const wrokbook = XLSX.readFile(filePath)
            const sheet = wrokbook.Sheets[wrokbook.SheetNames[0]]

            const result = XLSX.utils.sheet_to_json(sheet)
            const extractedText = JSON.stringify(result)

            fs.unlinkSync(filePath)
            return extractedText

        } else if ((["image/jpeg", "image/png", "image/webp"].includes(mimeType))) {
            const dataBuffer = fs.readFileSync(filePath)

            const { data } = await Tesseract.recognize(filePath, "eng")
            const extractedText = data.text

            fs.unlinkSync(filePath)
            return extractedText

        } else if (mimeType == "text/plain") {
            const extractedText = fs.readFileSync(filePath, 'utf8')

            fs.unlinkSync(filePath)
            return extractedText
        } else {
            throw new ApiError(404, "File not supported")
            fs.unlinkSync(filePath)
        }
    } catch (error) {
        console.error("Text extractiobn error", error)
        fs.unlinkSync(filePath)

    }

    
}

export default textExtractor
</file>

<file path="services/vectorDB.js">
import dotenv from "dotenv"
dotenv.config()
import { Pinecone } from "@pinecone-database/pinecone";
import embedText from "./embedText.js";
import chunking from "./chunking.js";
import textExtractor from "./textExtractor.js";

const vectorDB = async (file) => {
    const extractedText = await textExtractor(file)

    const chunks = await chunking(extractedText)

    const pc = new Pinecone(
        {
            apiKey: process.env.PINECONE_API_KEY
        }
    )

    const index = await pc.index("vectordb")

    const namespace = process.env.PINECONE_NAME_SPACE ? process.env.PINECONE_NAME_SPACE.replace(/['"]/g, '') : "Kanchan_12345"

    const ns = index.namespace(namespace);

    const embeddings = await Promise.all(
        chunks.map(chunk => embedText(chunk))
    );

    const records = chunks.map((chunk, i) => (
        {
            id: `doc_${i}`,
            values: embeddings[i],
            metadata: {
                text: chunk,
            }
        }
    ))

    await ns.upsert({ records })
    
}

const queryDB = async(query)=>{
    const pc = new Pinecone(
        {
            apiKey: process.env.PINECONE_API_KEY
        }
    )

    const index = pc.index("vectordb")

    const namespace = process.env.PINECONE_NAME_SPACE ? process.env.PINECONE_NAME_SPACE.replace(/['"]/g, '') : "Kanchan_12345"

    const ns = index.namespace(namespace);


    const queryVector = await embedText(query)

    const results = await ns.query({
        vector: queryVector,
        topK: 5,
        includeMetadata: true
    })
    
    const topChunks = results.matches.map((m)=>(m.metadata.text))
    return topChunks
}
export  {vectorDB, queryDB}
</file>

