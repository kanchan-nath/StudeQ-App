    cleanup();

    render(
      <NoteDocument
        note={{ ...noteMock, isPinned: false }}
        onCopy={onCopyMock}
        onDelete={onDeleteMock}
        onDownload={onDownloadMock}
        onEdit={onEditMock}
        onPin={onPinMock}
        isCopied={true}
        docRef={null}
      />,
    );
    const button = screen.getByRole("button", {
      name: /Pin note/i,
