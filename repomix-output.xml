const ExamModal = ({ mode, initial, onClose, onSuccess }) => {
  const [form, setForm] = useState(initial || EMPTY_FORM);
  const [saving, setSaving] = useState(false);
  const token = localStorage.getItem("token");

  const handle = (e) => {
    const { name, value, type, checked } = e.target;
    setForm((f) => ({ ...f, [name]: type === "checkbox" ? checked : value }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setSaving(true);
    try {
      const url =
        mode === "edit"
          ? `${BASE_URL}/api/scheduler/exam-dates/${initial._id}`
          : `${BASE_URL}/api/scheduler/exam-dates`;
      const res = await fetch(url, {
        method: mode === "edit" ? "PATCH" : "POST",
        headers: authHeaders(),
        body: JSON.stringify(form),
      });
      if (!res.ok) throw new Error("Failed");
      onSuccess();
      onClose();
    } catch (err) {
      console.error(err);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div
      className={styles.modalOverlay}
      onClick={(e) => e.target === e.currentTarget && onClose()}
    >
      <div
        className={styles.modal}
        role="dialog"
        aria-modal="true"
      >
        <div className={styles.modalHeader}>
          <h2 className={styles.modalTitle}>
            {mode === "edit" ? "Edit Exam" : "Add New Exam"}
          </h2>
          <button
            className={styles.drawerClose}
            onClick={onClose}
            aria-label="Close"
          >
            ×
          </button>
        </div>
        <form onSubmit={handleSubmit}>
          <div className={styles.modalBody}>
            <div className={styles.formGrid}>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Subject Name *</label>
                <input
                  name="subjectName"
                  className={styles.formInput}
                  value={form.subjectName}
                  onChange={handle}
                  required
                  placeholder="e.g. Data Structures"
                />
              </div>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Subject Code</label>
                <input
                  name="subjectCode"
                  className={styles.formInput}
                  value={form.subjectCode}
                  onChange={handle}
                  placeholder="e.g. CS201"
                />
              </div>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Exam Date *</label>
                <input
                  name="examDate"
                  type="date"
                  className={styles.formInput}
                  value={form.examDate}
                  onChange={handle}
                  required
                />
              </div>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Exam Time *</label>
                <input
                  name="examTime"
                  type="time"
                  className={styles.formInput}
                  value={form.examTime}
                  onChange={handle}
                  required
                />
              </div>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Duration (min)</label>
                <input
                  name="duration"
                  type="number"
                  min="1"
                  className={styles.formInput}
                  value={form.duration}
                  onChange={handle}
                  placeholder="90"
                />
              </div>
              <div className={styles.formGroup}>
                <label className={styles.formLabel}>Venue / Room</label>
                <input
                  name="venue"
                  className={styles.formInput}
                  value={form.venue}
                  onChange={handle}
                  placeholder="e.g. Hall B"
