// Bridge: Suspense fallback can't call hooks directly, so delegate to component
const SuspenseLoader = () => {
  const { show, hide } = useLoader();
  useEffect(() => {
    show("Loading...");
    return () => hide();
  }, []);
  return null; // GlobalLoader renders via LoaderProvider portal
};

