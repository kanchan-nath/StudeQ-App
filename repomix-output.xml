<file path="client/src/pages/styles/Dashboard.module.css">
/* ============================================================
   Dashboard.module.css
   NO :root — all tokens consumed from global.css
   Theme switching: data-theme="dark"|"light" on <html>
   ============================================================ */

/* ── Shell ───────────────────────────────────────────────── */
.appShell {
  display: flex;
  min-height: 100vh;
  width: 100%;
  background: var(--theme-bg);
  font-family: var(--font-body);
  color: var(--theme-text);
  overflow-x: hidden;
}

/* ── Main ────────────────────────────────────────────────── */
.main {
  margin-left: 64px;
  flex: 1;
  min-height: 100vh;
  padding: 28px 28px 48px;
  display: flex;
  flex-direction: column;
  gap: 22px;
  background: var(--theme-bg);
  overflow-y: auto;
  scroll-behavior: smooth;
}

/* ── Top bar ─────────────────────────────────────────────── */
.topBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.sessionIndicator {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pulseDot {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

.pulseDotCore {
  position: relative;
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--theme-purple);
}

.pulseDotRing {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--theme-purple);
  opacity: 0.6;
  animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
}

@keyframes ping {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }

  80% {
    transform: scale(2.2);
    opacity: 0;
  }

  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

.sessionLabel {
  font-family: var(--font-display);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
  margin: 0 0 2px;
}

.welcomeHeading {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
  color: var(--theme-text);
  line-height: 1.2;
}

.welcomeName {
  color: var(--theme-purple);
}

.welcomeNameSkeleton {
  display: inline-block;
  min-width: 120px;
  background: var(--skeleton-bg, rgba(255, 255, 255, 0.1));
  border-radius: 4px;
  color: transparent;
  animation: shimmer 1.2s infinite;
}

/* Skeleton for loading state */
.skeletonHeading {
  height: 26px;
  width: 220px;
  border-radius: var(--r-sm);
  background: linear-gradient(90deg,
      var(--theme-surface-2) 25%,
      var(--theme-surface) 50%,
      var(--theme-surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeletonLine {
  height: 14px;
  width: 140px;
  border-radius: var(--r-sm);
  background: linear-gradient(90deg,
      var(--theme-surface-2) 25%,
      var(--theme-surface) 50%,
      var(--theme-surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-bottom: 4px;
}

.skeletonLineSm {
  width: 90px;
  height: 11px;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

.dateChip {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-display);
  font-size: 12px;
  color: var(--theme-text-secondary);
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 6px 12px;
}

/* ── Quick strip ─────────────────────────────────────────── */
.quickStrip {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}

.quickStrip::-webkit-scrollbar {
  display: none;
}

.stripBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: var(--r-full);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  text-decoration: none;
  transition:
    opacity 0.15s,
    transform 0.15s;
  flex-shrink: 0;
}

.stripBtn:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}

.stripBtnPrimary {
  background: var(--theme-purple);
  color: #fff;
}

.stripBtnSecondary {
  background: var(--theme-surface-2);
  color: var(--theme-text);
  border: 1px solid var(--theme-border);
}

/* ── Dashboard grid ──────────────────────────────────────── */
.dashGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto auto;
  gap: 14px;
}

/* ── Base card ───────────────────────────────────────────── */
.card {
  position: relative;
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: 22px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition:
    border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.card:hover {
  border-color: var(--theme-border-hover);
  transform: translateY(-2px);
  box-shadow: var(--theme-card-shadow);
}

/* cardGlow kept in DOM but no visual effect */
.cardGlow {
  display: none;
}

/* ── Tutor card — col 1, rows 1-2 ───────────────────────── */
.cardTutor {
  grid-column: 1;
  grid-row: 1 / 3;
}

/* ── Quiz card — col 2-3, row 1 ─────────────────────────── */
.cardQuiz {
  grid-column: 2 / 4;
  grid-row: 1;
}

/* ── Flashcard — col 2, row 2 ───────────────────────────── */
.cardFlash {
  grid-column: 2;
  grid-row: 2;
}

/* ── Scheduler — col 3, row 2 ───────────────────────────── */
.cardScheduler {
  grid-column: 3;
  grid-row: 2;
}

/* ── Profile card ────────────────────────────────────────── */
.cardProfile {
  border-color: var(--theme-border);
}

/* ── Card shared components ──────────────────────────────── */
.cardIconWrap {
  width: 38px;
  height: 38px;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-surface);
  flex-shrink: 0;
}

.cardTitle {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--theme-text);
  margin: 0;
}

.cardTitleSm {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0;
}

.cardSubtitle {
  font-size: 11px;
  color: var(--theme-text-secondary);
  margin: 2px 0 0;
}

.cardDesc {
  font-size: 13px;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin: 0;
}

.cardRowHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.cardIconGroup {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cardBadge {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-display);
  font-size: 10px;
  color: var(--theme-purple);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 3px 10px;
  width: fit-content;
}

.cardCta {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-purple);
  text-decoration: none;
  transition: gap 0.15s;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
}

.cardCta:hover {
  gap: 4px;
}

.cardCta svg {
  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.cardCta:hover svg {
  transform: translateX(3px);
}

.cardCtaGreen {
  color: var(--theme-green);
}

.cardCtaAmber {
  color: var(--theme-accent);
}

.cardCtaPink {
  color: var(--clr-pink, #ec4899);
}

.cardCtaRed {
  color: var(--theme-red);
}

/* ── Chat preview ────────────────────────────────────────── */
.chatPreview {
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.chatBubble {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.chatAvatar {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}

.chatAvatarBot {
  background: var(--theme-surface);
  color: var(--theme-purple);
}

.chatAvatarUser {
  background: var(--theme-surface);
  color: var(--theme-text-secondary);
}

.chatText {
  font-size: 11px;
  color: var(--theme-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.chatTextUser {
  color: var(--theme-text);
}

/* ── Quiz stats ──────────────────────────────────────────── */
.quizBadge {
  font-family: var(--font-display);
  font-size: 11px;
  color: var(--clr-teal, #0ea5e9);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 4px 12px;
  white-space: nowrap;
}

.quizStats {
  display: flex;
  align-items: center;
  gap: 12px;
}

.statBox {
  flex: 1;
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  padding: 10px 12px;
}

.statBoxRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.statLabel {
  font-family: var(--font-display);
  font-size: 10px;
  color: var(--theme-text-secondary);
}

.statValue {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
}

.statValueGreen {
  color: var(--theme-green);
}

.statValuePurple {
  color: var(--theme-purple);
}

.progressTrack {
  height: 5px;
  background: var(--theme-surface);
  border-radius: var(--r-full);
  overflow: hidden;
}

.progressBar {
  height: 100%;
  border-radius: var(--r-full);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.progressBarGreen {
  background: var(--theme-green);
}

.progressBarPurple {
  background: var(--theme-purple);
}

/* ── Flashcard stats ─────────────────────────────────────── */
.flashStats {
  display: flex;
  align-items: center;
  gap: 16px;
}

.flashStat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flashNum {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  color: var(--theme-text);
  line-height: 1;
}

.flashNumGreen {
  color: var(--theme-green);
}

.flashLabel {
  font-size: 10px;
  color: var(--theme-text-secondary);
  margin-top: 3px;
}

.flashDivider {
  width: 1px;
  height: 32px;
  background: var(--theme-border);
}

.flashCta {
  margin-left: auto;
}

/* ── Schedule list ───────────────────────────────────────── */
.scheduleList {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.scheduleItem {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
}

.scheduleDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}

.scheduleDotPurple {
  background: var(--theme-purple);
}

.scheduleDotAmber {
  background: var(--theme-accent);
}

.scheduleTitle {
  color: var(--theme-text);
  font-weight: 500;
  flex: 1;
}

.scheduleTime {
  font-family: var(--font-display);
  font-size: 11px;
  color: var(--theme-text-muted);
  white-space: nowrap;
}

/* ── Profile card ────────────────────────────────────────── */
.profileTop {
  display: flex;
  align-items: center;
  gap: 14px;
}

.profileAvatar {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--theme-purple);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.profileName {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0;
}

.profileEmail {
  font-size: 11px;
  color: var(--theme-text-secondary);
  margin: 2px 0 0;
}

.profileDivider {
  height: 1px;
  background: var(--theme-border);
}

.profileStats {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.profileStat {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.profileStatLabel {
  font-family: var(--font-display);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
}

.profileStatValue {
  font-size: 13px;
  font-weight: 700;
  color: var(--theme-text);
}

.profileStatValuePurple {
  color: var(--theme-purple);
}

.profileStatValueAmber {
  color: var(--theme-accent);
}

.xpTrack {
  height: 5px;
  background: var(--theme-surface);
  border-radius: var(--r-full);
  overflow: hidden;
}

.xpBar {
  height: 100%;
  border-radius: var(--r-full);
  background: var(--theme-purple);
  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.xpLabels {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-display);
  font-size: 10px;
  color: var(--theme-text-muted);
}

/* ── Feature section ─────────────────────────────────────── */
.featureSection {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.sectionHeader {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.sectionTitle {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0;
  letter-spacing: -0.01em;
}

.sectionSub {
  font-size: 13px;
  color: var(--theme-text-secondary);
  margin: 0;
}

.featureGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.featureCard {
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition:
    border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.featureCard:hover {
  border-color: var(--theme-border-hover);
  transform: translateY(-2px);
  box-shadow: var(--theme-card-shadow);
}

.featureIcon {
  width: 38px;
  height: 38px;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.featureIcon--blue {
  background: var(--theme-surface);
}

.featureIcon--purple {
  background: var(--theme-surface);
}

.featureIcon--teal {
  background: var(--theme-surface);
}

.featureIcon--orange {
  background: var(--theme-surface);
}

.featureIcon--pink {
  background: var(--theme-surface);
}

.featureIcon--green {
  background: var(--theme-surface);
}

.featureTitle {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0;
}

.featureDesc {
  font-size: 12px;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin: 0;
  flex: 1;
}

.featureCta {
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  color: var(--theme-purple);
  transition: letter-spacing 0.15s;
}

.featureCta:hover {
  /* letter-spacing: 0.02em; */
  opacity: 0.75;
}

.featureCta--blue {
  color: #3b8bff;
}

.featureCta--purple {
  color: var(--theme-purple);
}

.featureCta--teal {
  color: var(--clr-teal, #0ea5e9);
}

.featureCta--orange {
  color: var(--theme-accent);
}

.featureCta--pink {
  color: var(--clr-pink, #ec4899);
}

.featureCta--green {
  color: var(--theme-green);
}

/* ── Responsive ──────────────────────────────────────────── */
@media (max-width: 1100px) {
  .dashGrid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cardTutor {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .cardQuiz {
    grid-column: 2;
    grid-row: 1;
  }

  .cardFlash {
    grid-column: 2;
    grid-row: 2;
  }

  .cardScheduler {
    grid-column: 1 / 3;
    grid-row: 3;
  }

  .cardImage {
    grid-column: 1;
  }

  .cardPdf {
    grid-column: 2;
  }

  .cardProfile {
    grid-column: 1 / 3;
  }

  .featureGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .main {
    margin-left: 0;
    padding: 18px 16px 40px;
  }

  .dashGrid {
    grid-template-columns: 1fr;
  }

  .cardTutor {
    grid-column: 1;
    grid-row: auto;
  }

  .cardQuiz {
    grid-column: 1;
    grid-row: auto;
  }

  .cardFlash {
    grid-column: 1;
    grid-row: auto;
  }

  .cardScheduler {
    grid-column: 1;
    grid-row: auto;
  }

  .cardImage {
    grid-column: 1;
  }

  .cardPdf {
    grid-column: 1;
  }

  .cardProfile {
    grid-column: 1;
  }

  .quizStats {
    flex-wrap: wrap;
  }

  .featureGrid {
    grid-template-columns: 1fr;
  }

  .welcomeHeading {
    font-size: 18px;
  }
}

/* Later Upadted */
@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
