/* GlobalLoader.module.css
   Overlay sits above all app chrome (z-index > sidebar z-50, topbar z-40)
   Uses only tokens from global.css — no new :root vars
*/

.overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 12, 20, 0.72);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  animation: overlayIn var(--t-base) ease both;
}

@keyframes overlayIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border-hover);
  border-radius: var(--r-xl);
  padding: var(--sp-6) var(--sp-8);
  box-shadow: var(--theme-card-shadow);
  animation: cardIn var(--t-slow) cubic-bezier(0.34, 1.56, 0.64, 1) both;

  /* Prevent card from touching screen edges on tiny viewports */
  max-width: calc(100vw - var(--sp-6) * 2);
  box-sizing: border-box;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: scale(0.88) translateY(12px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.lottie {
  width: 100px;
  height: 100px;
}

.label {
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  letter-spacing: 0.02em;
  margin: 0;
}

/* ── Mobile ────────────────────────────────────────────────── */
@media (max-width: 480px) {
  .card {
    padding: var(--sp-4) var(--sp-5);
    gap: var(--sp-2);
    border-radius: var(--r-lg);
  }

  .lottie {
    width: 72px;
    height: 72px;
  }

  .label {
    font-size: 0.78rem;
  }
}

/* ── Reduced motion ─────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .overlay {
    animation: none;
  }

  .card {
    animation: none;
  }
}
