  </div>
);

// ── Sidebar chat item ──────────────────────────────────────────────────────────
const SidebarItem = ({ chat, isActive, onSelect, onDelete }) => {
  const [menuOpen, setMenuOpen] = useState(false);
  const menuRef = useRef(null);

  const title = chat.messages?.[0]?.content || "Study Session";
  const msgCount = chat.messages?.length || 0;
  const date = chat.createdAt
    ? new Date(chat.createdAt).toLocaleDateString("en-GB")
    : "";

  useEffect(() => {
    const close = (e) => {
      if (menuRef.current && !menuRef.current.contains(e.target))
        setMenuOpen(false);
    };
    document.addEventListener("click", close);
    return () => document.removeEventListener("click", close);
  }, []);

  return (
    <li
      className={`${styles.historyCard} ${isActive ? styles.historyCardActive : ""}`}
      onClick={() => onSelect(chat)}
    >
      <div className={styles.historyCardBody}>
        <p className={styles.historyCardTitle}>{title}</p>
        <span className={styles.historyCardMeta}>
          {msgCount} q · {date}
        </span>
      </div>
      <div
        className={styles.historyCardMenu}
        ref={menuRef}
      >
        <button
          className={styles.historyDots}
          onClick={(e) => {
            e.stopPropagation();
            setMenuOpen((v) => !v);
          }}
          aria-label="Options"
        >
          ···
        </button>
        {menuOpen && (
          <div className={styles.sidebarMenu}>
            <button
              className={styles.sidebarMenuDelete}
              onClick={(e) => {
                e.stopPropagation();
                setMenuOpen(false);
                onDelete(chat);
              }}
            >
              🗑 Delete
            </button>
          </div>
        )}
      </div>
    </li>
  );
};

// ── Main component ─────────────────────────────────────────────────────────────
const Notebook = () => {
  // ── Router ─────────────────────────────────────────────────────────────────
  const { chatId } = useParams();
  const navigate = useNavigate();

  // ── State ──────────────────────────────────────────────────────────────────
  const [inputFile, setInputFile] = useState(null);
  const [dragOver, setDragOver] = useState(false);
  const [loading, setLoading] = useState(false);
  const [inputFileResult, setInputFileResult] = useState({});

  // chatRoom is now derived from URL param — no useState needed
  const chatRoom = !!chatId;

  const [rightSidebarOpen, setRightSidebarOpen] = useState(true);

  const [query, setQuery] = useState("");
  const [loadingSendQuery, setLoadingQuery] = useState(false);
  const [result, setResult] = useState([]);

  const [editId, setEditId] = useState(null);
  const [editingMessageId, setEditingMessageId] = useState(null);
  const [hiddenAiIds, setHiddenAiIds] = useState([]);

  const [allChats, setAllChats] = useState([]);
  const [sidebarOpen, setSidebarOpen] = useState(true);

  const [toasts, setToasts] = useState([]);
  const [theme, setTheme] = useState(
    () => localStorage.getItem("sparke-theme") || "dark",
  );
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  const inputRef = useRef(null);
  const fileInputRef = useRef(null);
  const messagesEndRef = useRef(null);

  const { notifyError, notifySuccess } = useErrorHandler();
  const [pageError, setPageError] = useState(null); 


  // ── Theme ──────────────────────────────────────────────────────────────────
  useEffect(() => {
    document.documentElement.setAttribute("data-theme", theme);
  }, [theme]);

  // ── Toast helpers ──────────────────────────────────────────────────────────
  const pushToast = (message, type = "success") => {
    const id = Date.now();
    setToasts((prev) => [...prev, { id, message, type, exiting: false }]);
    setTimeout(() => {
      setToasts((prev) =>
        prev.map((t) => (t.id === id ? { ...t, exiting: true } : t)),
      );
      setTimeout(
        () => setToasts((prev) => prev.filter((t) => t.id !== id)),
        350,
      );
    }, 3500);
  };

  const removeToast = (id) => {
    setToasts((prev) =>
      prev.map((t) => (t.id === id ? { ...t, exiting: true } : t)),
    );
    setTimeout(() => setToasts((prev) => prev.filter((t) => t.id !== id)), 350);
  };

  // ── Scroll to bottom on new messages ──────────────────────────────────────
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [result, loadingSendQuery]);

  // ── Restore state on reload (chatId exists but inputFileResult is empty) ──
  useEffect(() => {
    if (!chatId || allChats.length === 0) return;
    if (inputFileResult?._id) return; // already set
    const found = allChats.find((c) => (c._id || c.id) === chatId);
    if (found) {
      setInputFileResult(found);
    }
  }, [chatId, allChats]);

  // ── File handling ──────────────────────────────────────────────────────────
  const handleChangeFile = (e) => setInputFile(e.target.files[0]);

  const handleDrop = (e) => {
    e.preventDefault();
    setDragOver(false);
    const file = e.dataTransfer.files[0];
    if (file) setInputFile(file);
  };

  // ── Upload submit ──────────────────────────────────────────────────────────
  // ── Upload submit ──────────────────────────────────────────────────────────
  const handleClickSubmit = async () => {
    if (!inputFile) {
      pushToast("Please select a file first.", "error");
      return;
    }
    setLoading(true);
    const formData = new FormData();
    formData.append("file", inputFile);

    if (editId) {
      try {
        const res = await apiFetch(
          `/api/documents/${inputFileResult._id}/chat/${inputFileResult.docId}/${editId}`,
          {
            method: "PATCH",
            body: JSON.stringify({query}),
          },
        );

        // ── Auth errors → redirect + toast ──────────────────────────
        if (res.status === 401) {
          notifyError("Session expired. Sign in again.");
          navigate("/login");
          return;
        }
        if (res.status === 403) {
          setPageError(ERROR_TYPES.FORBIDDEN);
          return;
        }
        // ── Server errors → full-page error ───────────────────────
        if (res.status >= 500) {
          setPageError(ERROR_TYPES.SERVER_ERROR);
          return;
        }
        if (!res.ok) {
          pushToast("Edit failed, try again.", "error");
          return;
        }

        const data = await res.json();
        setInputFileResult(data.data);
        fetchAllChats();
        pushToast("Document updated successfully.");
      } catch (err) {
        const type = resolveErrorType(err);
        if (type === ERROR_TYPES.NETWORK) {
          setPageError(ERROR_TYPES.NETWORK);
        } else {
          pushToast(err.message, "error");
        }
      } finally {
        setLoading(false);
      }
    } else {
      try {
        const res = await apiFetch(`/api/documents/upload`, {
          method: "POST",
          body: formData,
        });

        // ── Auth errors → redirect + toast ──────────────────────────
        if (res.status === 401) {
          notifyError("Session expired. Sign in again.");
          navigate("/login");
          return;
        }
        if (res.status === 403) {
          setPageError(ERROR_TYPES.FORBIDDEN);
          return;
        }
        // ── Server errors → full-page error ───────────────────────
        if (res.status >= 500) {
          setPageError(ERROR_TYPES.SERVER_ERROR);
          return;
        }
        if (!res.ok) {
          pushToast("File upload failed.", "error");
          return;
        }

        const data = await res.json();
        
        setInputFileResult(data.data);
        setInputFile(null);
        fetchAllChats();
        pushToast("Document uploaded! Chat is ready.");
        // Navigate to chatroom route — this is what switches the view
        navigate(`/notebook/${data.data._id}`);
      } catch (err) {
        const type = resolveErrorType(err);
        if (type === ERROR_TYPES.NETWORK) {
          setPageError(ERROR_TYPES.NETWORK);
        } else {
          pushToast(err.message, "error");
        }
      } finally {
        setLoading(false);
      }
    }
  };

  // ── Send query ─────────────────────────────────────────────────────────────
  const handleSubmitQuery = async (e) => {
    e?.preventDefault();
    if (!query.trim()) return;
    setLoadingQuery(true);

    if (editId) {
      setHiddenAiIds((prev) => [...prev, editId]);
    }

    const tempUserMsg = {
      _id: `temp_${Date.now()}`,
      role: "user",
      content: query,
      createdAt: new Date().toISOString(),
      temp: true,
    };
    setResult((prev) => {
      const flat = prev.flatMap((item) => item.messages || []);
      return [{ messages: [...flat, tempUserMsg] }];
    });
    setQuery("");
    setEditId(null);
    setEditingMessageId(null);

    try {
      const res = await apiFetch(
        `/api/documents/${inputFileResult._id}/chat/${inputFileResult.docId}`,
        {
          method: "POST",
          body: JSON.stringify({ query }),
        },
      );
      // ── Auth errors → redirect + toast ──────────────────────────
      if (res.status === 401) {
        notifyError("Session expired. Sign in again.");
        navigate("/login");
        return;
      }
      if (res.status === 403) {
        setPageError(ERROR_TYPES.FORBIDDEN);
        return;
      }
      // ── Server errors → full-page error ───────────────────────
      if (res.status >= 500) {
        setPageError(ERROR_TYPES.SERVER_ERROR);
        return;
      }
      if (!res.ok) {
        pushToast("Message failed, try again.", "error");
        return;
      }

      await fetchAllMessages();
    } catch (err) {
      const type = resolveErrorType(err);
      if (type === ERROR_TYPES.NETWORK) {
        setPageError(ERROR_TYPES.NETWORK);
      } else {
        pushToast(err.message, "error");
      }
    } finally {
      setLoadingQuery(false);
    }
  };

  // ── Fetch messages ─────────────────────────────────────────────────────────
  const fetchAllMessages = async () => {
    if (!inputFileResult?._id) return;
    try {
      
      const res = await apiFetch(
        `/api/documents/${inputFileResult._id}/chat/${inputFileResult.docId}`);

      // ── Auth errors → redirect + toast ──────────────────────────
      if (res.status === 401) {
        notifyError("Session expired. Sign in again.");
        navigate("/login");
        return;
      }
      if (res.status === 403) {
        setPageError(ERROR_TYPES.FORBIDDEN);
        return;
      }
      // ── Server errors → full-page error ───────────────────────
      if (res.status >= 500) {
        setPageError(ERROR_TYPES.SERVER_ERROR);
        return;
      }
      if (!res.ok) {
        pushToast("Failed to load messages.", "error");
        return;
      }

      const data = await res.json();
      console.log("Data:",data.data);
      
      setResult([data.data]);
    } catch (err) {
      const type = resolveErrorType(err);
      if (type === ERROR_TYPES.NETWORK) {
        setPageError(ERROR_TYPES.NETWORK);
      } else {
        pushToast(err.message, "error");
      }
    }
  };

  // ── Fetch all chats (sidebar) ──────────────────────────────────────────────
  const fetchAllChats = async () => {
    try {
      const res = await apiFetch(`/api/documents/chat/all`);

      // ── Auth errors → redirect + toast ──────────────────────────
      if (res.status === 401) {
        notifyError("Session expired. Sign in again.");
        navigate("/login");
        return;
      }
      if (res.status === 403) {
        setPageError(ERROR_TYPES.FORBIDDEN);
        return;
      }
      // ── Server errors → full-page error ───────────────────────
      if (res.status >= 500) {
        setPageError(ERROR_TYPES.SERVER_ERROR);
        return;
      }
      if (!res.ok) {
        pushToast("Failed to load chat history.", "error");
        return;
      }

      const data = await res.json();
      setAllChats(data.data || []);
    } catch (err) {
      const type = resolveErrorType(err);
      if (type === ERROR_TYPES.NETWORK) {
        setPageError(ERROR_TYPES.NETWORK);
      } else {
        pushToast(err.message, "error");
