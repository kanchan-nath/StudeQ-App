<file path="client/src/pages/styles/SearchResults.module.css">
/* ─── Design Tokens (mapped to global.css) ───────────────────── */
:root {
  --blue-link: #1a73e8;
  --visited-link: #681da8;
  --text-primary: var(--theme-text);
  --text-secondary: var(--theme-text-secondary);
  --surface: var(--theme-surface);
  --surface-raised: var(--theme-surface-2);
  --surface-overlay: rgba(255, 255, 255, 0.85);
  --border: var(--theme-border);
  --border-subtle: var(--theme-border);
  --accent: var(--theme-accent);
  --accent-soft: var(--theme-accent-dim);
  --danger: var(--theme-red);
  --success: var(--theme-green);
  --warn: #f29900;
  --shadow-sm: var(--shadow-sm);
  --shadow-md: var(--shadow-md);
  --shadow-lg: var(--theme-card-shadow);
  --radius-sm: var(--r-sm);
  --radius-md: var(--r-md);
  --radius-lg: var(--r-lg);
  --radius-pill: var(--r-full);
  --font-body: var(--font-body);
  --font-display: var(--font-display);
  --transition-fast: var(--t-fast);
  --transition-base: var(--t-base);
  --transition-slow: var(--t-slow);
  --max-w: 1200px;
  --col-main: 65%;
  --col-side: 30%;
}

[data-theme="dark"] {
  --blue-link: #8ab4f8;
  --visited-link: #c58af9;
  --surface-overlay: rgba(26, 29, 39, 0.9);
}

/* ─── Page Shell ─────────────────────────────────────────────── */

.page {
  min-height: 100vh;
  background: var(--surface);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.6;
  transition:
    background var(--transition-slow),
    color var(--transition-slow);
  scroll-behavior: smooth;
  padding-top: 24px;
  /* MOTION: smooth in-page scroll (e.g. PAA jump) */
}

/* ─── Search Bar ─────────────────────────────────────────────── */

.searchWrap {
  max-width: 740px;
  margin: 24px auto 0;
  padding: 0 24px;
}

.searchBar {
  display: flex;
  gap: 10px;
  align-items: center;
}

.searchInputWrap {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.searchIcon {
  position: absolute;
  left: 14px;
  color: var(--text-secondary);
  display: flex;
  pointer-events: none;
  transition: color var(--transition-base);
}

.searchInput {
  width: 100%;
  padding: 12px 40px 12px 44px;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--text-primary);
  background: var(--surface-raised);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-pill);
  outline: none;
  transition:
    border-color var(--transition-base),
    box-shadow var(--transition-base),
    background var(--transition-slow);
}

.searchInput::placeholder {
  color: var(--text-secondary);
}

.searchInput:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
  background: var(--surface);
}

.searchInput:focus-visible {
  /* MOTION: visible focus ring for keyboard nav */
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.searchInput:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.clearBtn {
  position: absolute;
  right: 12px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 18px;
  line-height: 1;
  padding: 2px 4px;
  border-radius: 50%;
  transition:
    color var(--transition-fast),
    background var(--transition-fast);
}

.clearBtn:hover {
  color: var(--text-primary);
  background: var(--border);
}

.searchBtn {
  padding: 12px 24px;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-pill);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  min-width: 88px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background var(--transition-base),
    transform var(--transition-fast),
    opacity var(--transition-base);
}

.searchBtn:hover:not(:disabled) {
  background: #1557b0;
  transform: translateY(-1px);
}

.searchBtn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  display: inline-block;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ─── Focus States ───────────────────────────────────────────── */
/* MOTION: consistent keyboard focus ring across interactive elements */
.searchBtn:focus-visible,
.clearBtn:focus-visible,
.tab:focus-visible,
.openPill:focus-visible,
.chip:focus-visible,
.aiExpandBtn:focus-visible,
.aiSourceChip:focus-visible,
.paaQuestion:focus-visible,
.relatedItem:focus-visible,
.bookmarkBtn:focus-visible,
.copyBtn:focus-visible,
.resultTitle a:focus-visible,
.ytCard:focus-visible,
.shortCard:focus-visible,
.inlineVideoCard:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* ─── Tabs Bar ───────────────────────────────────────────────── */

.tabsBar {
  max-width: var(--max-w);
  margin: 16px auto 0;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  transition: border-color var(--transition-slow);
}

.tabs {
  display: flex;
  gap: 2px;
}

.tab {
  display: flex;
  align-items: center;
  padding: 10px 18px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  transition:
    color var(--transition-base),
    border-color var(--transition-base);
  margin-bottom: -1px;
  gap: 4px;
}

.tab:hover {
  color: var(--text-primary);
  background: var(--accent-soft);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.tabActive {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 600;
}

.tabCount {
  font-size: 11px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--surface-raised);
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  margin-left: 4px;
}

.openPill {
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1px solid var(--accent);
  border-radius: var(--radius-pill);
  padding: 6px 14px;
  text-decoration: none;
  transition:
    background var(--transition-base),
    transform var(--transition-fast);
  white-space: nowrap;
}

.openPill:hover {
  background: var(--accent);
  color: #fff;
  transform: translateY(-1px);
}

/* ─── Error / Loading ────────────────────────────────────────── */

.errorBanner {
  max-width: var(--max-w);
  margin: 20px auto;
  padding: 14px 20px;
  background: #fce8e6;
  border: 1px solid #f5c6c2;
  border-radius: var(--radius-md);
  color: var(--danger);
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 500;
}

[data-theme="dark"] .errorBanner {
  background: #2c1515;
  border-color: #5c2020;
  color: #f28b82;
}

.skeletonWrap {
  max-width: 760px;
  margin: 32px auto;
  padding: 0 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.skeleton {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeletonLine {
  height: 14px;
  background: linear-gradient(
    90deg,
    var(--border) 25%,
    var(--surface-raised) 50%,
    var(--border) 75%
  );
  background-size: 200% 100%;
  border-radius: var(--radius-sm);
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }

  100% {
    background-position: 200% 0;
  }
}

/* ─── Empty State ────────────────────────────────────────────── */

.emptyState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 80px 24px;
  color: var(--text-secondary);
  text-align: center;
}

.emptyIcon {
  opacity: 0.25;
  color: var(--text-primary);
}

.emptyState p {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-secondary);
  margin: 0;
}

.emptyHint {
  font-size: 12px;
  font-family: "SFMono-Regular", "Fira Code", monospace;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
}

/* ─── Layout ─────────────────────────────────────────────────── */

.contentLayout {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 20px 24px 60px;
  display: grid;
  grid-template-columns: var(--col-main) var(--col-side);
  gap: 40px;
  align-items: start;
}

.mainCol {
  min-width: 0;
}

/* ─── Filter Chips ───────────────────────────────────────────── */

.filterChips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 14px;
}

.chip {
  padding: 6px 14px;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  transition:
    background var(--transition-base),
    color var(--transition-base),
    border-color var(--transition-base),
    transform var(--transition-fast);
}

.chip:hover {
  background: var(--border);
  color: var(--text-primary);
  transform: translateY(-1px);
}

.chipActive {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

/* ─── Result Count Row ───────────────────────────────────────── */

.resultCountRow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  font-size: 13px;
  color: var(--text-secondary);
}

.resultCount strong {
  color: var(--text-primary);
}

.resultTime {
  color: var(--text-secondary);
  opacity: 0.7;
}

/* ─── Section Title ──────────────────────────────────────────── */

.sectionTitle {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
  transition:
    color var(--transition-slow),
    border-color var(--transition-slow);
}

/* ─── AI Overview ────────────────────────────────────────────── */

.blurOverlay {
  position: fixed;
  inset: 0;
  top: 0;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  background: rgba(255, 255, 255, 0.3);
  z-index: 99;
  animation: fadeIn 200ms ease;
}

[data-theme="dark"] .blurOverlay {
  background: rgba(0, 0, 0, 0.4);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.aiCard {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition:
    box-shadow var(--transition-base),
    border-color var(--transition-base);
  position: relative;
  z-index: 1;
}

.aiCardExpanded {
  z-index: 100;
  box-shadow: var(--shadow-lg);
  border-color: var(--accent);
}

.aiCardHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: linear-gradient(135deg, var(--accent-soft) 0%, transparent 60%);
  border-bottom: 1px solid var(--border-subtle);
}

.aiCardTitle {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.aiDot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: linear-gradient(135deg, #4285f4, #34a853, #fbbc04, #ea4335);
  flex-shrink: 0;
}

.aiPowered {
  font-size: 11px;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1px solid var(--accent);
  padding: 1px 7px;
  border-radius: var(--radius-pill);
  opacity: 0.85;
}

.aiExpandBtn {
  display: flex;
  align-items: center;
  gap: 5px;
  background: none;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  cursor: pointer;
  transition:
    background var(--transition-base),
    border-color var(--transition-base);
}

.aiExpandBtn:hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.aiBody {
  padding: 16px 18px;
  max-height: 120px;
  overflow: hidden;
  position: relative;
  transition: max-height var(--transition-slow);
}

.aiBody::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40px;
  background: linear-gradient(transparent, var(--surface));
  pointer-events: none;
  transition: opacity var(--transition-base);
}

.aiBodyExpanded {
  max-height: 1200px;
  overflow: visible;
}

.aiBodyExpanded::after {
  opacity: 0;
}

.aiPara {
  font-size: 14px;
  color: var(--text-primary);
  margin: 0 0 10px;
  line-height: 1.65;
}

.aiHeading {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 14px 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  opacity: 0.7;
}

.aiList {
  margin: 0 0 10px;
  padding-left: 20px;
}

.aiList li {
  font-size: 14px;
  color: var(--text-primary);
  margin-bottom: 6px;
  line-height: 1.6;
}

.aiSources {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 12px 18px;
  border-top: 1px solid var(--border-subtle);
}

.aiSourceChip {
  font-size: 11px;
  font-weight: 600;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 3px 10px;
  color: var(--text-secondary);
  text-decoration: none;
  transition:
    background var(--transition-base),
    color var(--transition-base);
}

.aiSourceChip:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

/* ─── Inline Videos ──────────────────────────────────────────── */

.inlineVideos {
  margin-bottom: 20px;
}

.inlineVideoRow {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 6px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.inlineVideoCard {
  flex-shrink: 0;
  width: 180px;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  text-decoration: none;
  color: inherit;
  transition:
    box-shadow var(--transition-base),
    transform var(--transition-base);
  display: flex;
  flex-direction: column;
}

.inlineVideoCard:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.inlineVideoThumb {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  background: var(--border);
}

.inlineVideoThumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.durationBadge {
  position: absolute;
  bottom: 5px;
  right: 6px;
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 5px;
  border-radius: 3px;
}

.inlineVideoInfo {
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.inlineVideoTitle {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.inlineVideoChannel {
  font-size: 11px;
  color: var(--text-secondary);
}

.inlineVideoDate {
  font-size: 11px;
  color: var(--text-secondary);
  opacity: 0.7;
}

/* ─── People Also Ask ────────────────────────────────────────── */

.paaSection {
  margin-bottom: 20px;
}

.paaList {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.paaItem {
  border-bottom: 1px solid var(--border-subtle);
}

.paaItem:last-child {
  border-bottom: none;
}

.paaQuestion {
  width: 100%;
  background: none;
  border: none;
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  text-align: left;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  cursor: pointer;
  transition: background var(--transition-base);
}

.paaQuestion:hover {
  background: var(--accent-soft);
}

.paaAnswer {
  padding: 12px 18px 16px;
  background: var(--surface-raised);
  border-top: 1px solid var(--border-subtle);
  animation: slideDown 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.paaAnswer p {
  font-size: 14px;
  color: var(--text-secondary);
  margin: 0;
  line-height: 1.65;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─── Organic Results ────────────────────────────────────────── */

.organicList {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 20px;
}

.resultCard {
  padding: 16px 18px;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  transition:
    background var(--transition-base),
    border-color var(--transition-base),
    box-shadow var(--transition-base);
  scroll-margin-top: 80px;
}

.resultCard:hover {
  background: var(--surface-raised);
  border-color: var(--border);
}

.resultCardActive {
  background: var(--accent-soft);
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-soft);
}

.resultMeta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
}

.favicon {
  border-radius: 3px;
  flex-shrink: 0;
}

.breadcrumb {
  font-size: 12px;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300px;
}

.credBadge {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  letter-spacing: 0.3px;
  flex-shrink: 0;
}

.cred_edu {
  background: #e6f4ea;
  color: #137333;
  border: 1px solid #b7dfc0;
}

.cred_established {
  background: #e8f0fe;
  color: #1a73e8;
  border: 1px solid #c5d7fb;
}

.cred_unknown {
  background: var(--surface-raised);
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

[data-theme="dark"] .cred_edu {
  background: #1a3020;
  color: #81c995;
  border-color: #2d5a38;
}

[data-theme="dark"] .cred_established {
  background: #1e2a40;
  color: #8ab4f8;
  border-color: #2d4070;
}

.resultTitle {
  font-size: 18px;
  font-weight: 500;
  margin: 0 0 6px;
  line-height: 1.3;
}

.resultTitle a {
  color: var(--blue-link);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.resultTitle a:visited {
  color: var(--visited-link);
}

.resultTitle a:hover {
  text-decoration: underline;
}

.resultSnippet {
  font-size: 14px;
  color: var(--text-secondary);
  margin: 0 0 8px;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resultFooter {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: var(--text-secondary);
}

.resultDate {
  opacity: 0.75;
}

.readTime {
  background: var(--surface-raised);
  border: 1px solid var(--border);
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  opacity: 0.8;
}

.resultActions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6px;
}

.bookmarkBtn,
.copyBtn {
  background: none;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  cursor: pointer;
  color: var(--text-secondary);
  transition:
    background var(--transition-base),
    color var(--transition-base),
    border-color var(--transition-base),
    transform var(--transition-fast);
}

.bookmarkBtn:hover,
.copyBtn:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
  transform: scale(1.1);
}

.bookmarkActive {
  color: var(--warn);
  border-color: var(--warn);
  background: #fff8e1;
}

[data-theme="dark"] .bookmarkActive {
  background: #2a2010;
}

/* ─── Related Searches ───────────────────────────────────────── */

.relatedSection {
  margin-bottom: 20px;
}

.relatedGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.relatedItem {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--text-primary);
  cursor: pointer;
  text-align: left;
  transition:
    background var(--transition-base),
    border-color var(--transition-base),
    transform var(--transition-fast);
}

.relatedItem:hover {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-1px);
}

/* ─── Knowledge Panel ────────────────────────────────────────── */

.knowledgePanel {
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  position: sticky;
  top: 80px;
  transition:
    background var(--transition-slow),
    border-color var(--transition-slow);
}

.kpHeader {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-subtle);
}

.kpIcon {
  width: 50px;
  height: 50px;
  background: linear-gradient(
    135deg,
    var(--accent-soft) 0%,
    var(--border) 100%
  );
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  flex-shrink: 0;
}

.kpTitle {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  text-transform: capitalize;
}

.kpCategory {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 3px;
}

.kpDesc {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.65;
  margin: 0 0 16px;
}

.kpTable {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 16px;
}

.kpTable tr {
  border-bottom: 1px solid var(--border-subtle);
}

.kpTable tr:last-child {
  border-bottom: none;
}

.kpLabel {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 7px 0;
  vertical-align: top;
  white-space: nowrap;
  width: 40%;
}

.kpValue {
  font-size: 13px;
  color: var(--text-primary);
  padding: 7px 0 7px 10px;
  vertical-align: top;
}

.kpChips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
}

.kpChip {
  font-size: 11px;
  font-weight: 500;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 4px 10px;
  color: var(--accent);
  cursor: default;
}

/* ─── YouTube Layout ─────────────────────────────────────────── */

.ytLayout {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 20px 24px 60px;
}

.ytGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

/* ─── YouTube Video Card ─────────────────────────────────────── */

.ytCard {
  display: flex;
  flex-direction: column;
  gap: 12px;
  border-radius: var(--radius-md);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  background: var(--surface);
  border: 1px solid transparent;
  transition:
    border-color var(--transition-base),
    box-shadow var(--transition-base),
    transform var(--transition-base);
}

.ytCard:hover {
  border-color: var(--border);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.ytThumbWrap {
  position: relative;
  aspect-ratio: 16/9;
  background: var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.ytThumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 300ms ease;
}

.ytCard:hover .ytThumb {
  transform: scale(1.03);
}

.ytDuration {
  position: absolute;
  bottom: 7px;
  right: 8px;
  background: rgba(0, 0, 0, 0.85);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  font-family: "SFMono-Regular", monospace;
}

.ytCardInfo {
  padding: 0 4px 8px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.ytChannelRow {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ytAvatar {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  flex-shrink: 0;
  object-fit: cover;
}

.ytChannelName {
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 500;
}

.ytVerified {
  font-size: 10px;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 50%;
  width: 14px;
  height: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ytTitle {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.ytMeta {
  font-size: 12px;
  color: var(--text-secondary);
  display: flex;
  gap: 4px;
}

.ytDesc {
  font-size: 12px;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
  margin: 2px 0 0;
  opacity: 0.8;
}

/* ─── Shorts ─────────────────────────────────────────────────── */

.shortsSection {
  margin-top: 16px;
}

.shortsRow {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 10px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
  -webkit-overflow-scrolling: touch;
}

.shortCard {
  flex-shrink: 0;
  width: 130px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-decoration: none;
  color: inherit;
}

.shortThumbWrap {
  aspect-ratio: 9/16;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--border);
  transition:
    box-shadow var(--transition-base),
    transform var(--transition-base);
}

.shortCard:hover .shortThumbWrap {
  box-shadow: var(--shadow-md);
  transform: scale(1.03);
}

.shortThumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.shortTitle {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin: 0;
}

.shortViews {
  font-size: 11px;
  color: var(--text-secondary);
}

/* ─── Responsive ─────────────────────────────────────────────── */

/* RESPONSIVE: wide-screen tier — give knowledge panel more breathing room */
@media (min-width: 1024px) {
  :root {
    --max-w: 1280px;
  }
}

@media (max-width: 900px) {
  .contentLayout {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .knowledgePanel {
    position: static;
    order: -1;
  }
}

@media (max-width: 600px) {
  .topBar {
    padding: 12px 16px;
  }

  .searchWrap {
    padding: 0 16px;
    margin-top: 16px;
  }

  .searchBar {
    flex-direction: column;
    gap: 8px;
  }

  .searchBtn {
    width: 100%;
  }

  .tabsBar {
    /* RESPONSIVE: scroll instead of wrap so openPill stays put */
    padding: 0 12px;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 8px;
    scrollbar-width: none;
  }

  .tabsBar::-webkit-scrollbar {
    display: none;
  }

  .tabs {
    flex-shrink: 0;
  }

  .openPill {
    flex-shrink: 0;
  }

  .contentLayout {
    padding: 16px;
  }

  .ytLayout {
    padding: 16px;
  }

  .ytGrid {
    grid-template-columns: 1fr;
  }

  .relatedGrid {
    grid-template-columns: 1fr;
  }

  .resultTitle {
    font-size: 16px;
  }
}

/* RESPONSIVE: small-phone tier (320px-480px) */
@media (max-width: 480px) {
  .searchWrap,
  .tabsBar,
  .contentLayout,
  .ytLayout {
    padding-left: 12px;
    padding-right: 12px;
  }

  .searchInput {
    font-size: 14px;
    padding: 10px 36px 10px 38px;
  }

  .resultCard {
    padding: 12px 10px;
  }

  .breadcrumb {
    max-width: 160px;
  }

  .resultActions {
    gap: 4px;
  }

  /* Stack knowledge-panel rows so long values don't get crushed */
  .kpTable,
  .kpTable tbody,
  .kpTable tr,
  .kpLabel,
  .kpValue {
    display: block;
    width: 100%;
  }

  .kpTable tr {
    padding: 6px 0;
  }

  .kpValue {
    padding: 2px 0 0;
  }

  .inlineVideoCard {
    width: 150px;
  }

  .shortCard {
    width: 110px;
  }
}

/* ─── Reduced Motion ─────────────────────────────────────────── */
/* MOTION: respect user preference — strip animation/transition/transform */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .searchBtn:hover:not(:disabled),
  .openPill:hover,
  .chip:hover,
  .inlineVideoCard:hover,
  .ytCard:hover,
  .ytCard:hover .ytThumb,
  .shortCard:hover .shortThumbWrap,
  .relatedItem:hover,
  .bookmarkBtn:hover,
  .copyBtn:hover {
    transform: none;
  }
}
