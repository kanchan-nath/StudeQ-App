import { useState, memo } from "react";
import styles from "./ComingSoon.module.css";

const ComingSoon = memo(({ label, eta, showNotifyForm = false }) => {
  const [email, setEmail] = useState("");
  const [submitted, setSubmitted] = useState(false);

  const handleNotify = () => {
    if (!email.trim()) return;
    setSubmitted(true);
  };

  return (
    <div className={styles.wrapper}>
      <div
        className={styles.stars}
        aria-hidden="true"
      />
      <div
        className={styles.glow}
        aria-hidden="true"
      />

      <div className={styles.content}>
        <div
          className={styles.orbitContainer}
          aria-hidden="true"
        >
          <span className={`${styles.ring} ${styles.ringOuter}`} />
          <span className={styles.ring} />
          <span className={styles.sparkIcon}>✦</span>
        </div>

        <h1 className={styles.heading}>Coming Soon</h1>

        {label && (
          <p className={styles.label}>
            <span className={styles.labelFeature}>{label}</span> is almost ready
          </p>
        )}

        {eta && (
          <span className={styles.etaBadge}>
            <span className={styles.etaDot} />
            Expected: {eta}
          </span>
        )}

        {showNotifyForm &&
          (submitted ? (
            <p className={styles.notifySuccess}>
              ✓ You're on the list — we'll let you know!
            </p>
          ) : (
            <div
              className={styles.notifyForm}
              role="group"
              aria-label="Notify me form"
            >
              <input
                className={styles.notifyInput}
                type="email"
                placeholder="you@email.com"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && handleNotify()}
                aria-label="Email address"
              />
              <button
                className={styles.notifyBtn}
                onClick={handleNotify}
                type="button"
              >
                Notify me
              </button>
            </div>
          ))}
      </div>
    </div>
  );
});

ComingSoon.displayName = "ComingSoon";

export { ComingSoon };
export default ComingSoon;
</file>

<file path="client/src/components/layouts/appShell.module.css">
/* appShell.module.css — App shell layout (scoped)
   Motion system added. Duration scale via CSS vars.
   All anim: transform/opacity only (GPU). will-change surgical.
   prefers-reduced-motion block at bottom kills everything.
*/

/* ── DURATION SCALE ─────────────────────────────────────────── */
:root {
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 400ms;
  --duration-slower: 600ms;

  /* Named easings — no plain ease/linear anywhere */
  --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0.0, 1.0, 1);
  --ease-inout: cubic-bezier(0.4, 0.0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  /* slight overshoot for tactile feel */
  --ease-decel: cubic-bezier(0.0, 0.0, 0.2, 1);
}

/* ── KEYFRAMES ──────────────────────────────────────────────── */

/* Shell entrance — entire grid fades up once from nothing */
@keyframes shellEnter {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Sidebar slides in from left on mount */
@keyframes sidebarEnter {
  from {
    opacity: 0;
    transform: translateX(-16px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Topbar drops in from top */
@keyframes topbarEnter {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Page content fade-up (Outlet children) */
@keyframes contentFadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Right panel slides from right */
@keyframes panelSlideIn {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Nav link stagger — each link fades+slides left */
@keyframes linkEnter {
  from {
    opacity: 0;
    transform: translateX(-8px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Section label fade-in */
@keyframes labelEnter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* Active indicator bar grows down from top */
@keyframes indicatorGrow {
  from {
    transform: scaleY(0);
    opacity: 0;
  }

  to {
    transform: scaleY(1);
    opacity: 1;
  }
}

/* Panel widgets stagger up */
@keyframes widgetEnter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Button press ripple scale */
@keyframes pressRipple {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }

  100% {
    transform: scale(2.4);
    opacity: 0;
  }
}

/* Focus ring pulse — draws attention on keyboard nav */
@keyframes focusPulse {

  0%,
  100% {
    box-shadow: 0 0 0 2px var(--theme-accent);
  }

  50% {
    box-shadow: 0 0 0 4px var(--theme-accent);
  }
}

/* Logo shimmer on mount */
@keyframes logoShimmer {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Avatar spin-in on mount */
@keyframes avatarIn {
  from {
    opacity: 0;
    transform: scale(0.6) rotate(-20deg);
  }

  to {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

/* Upgrade btn bounce in */
@keyframes upgradeBounce {
  from {
    opacity: 0;
    transform: scale(0.8);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ── APP SHELL GRID ─────────────────────────────────────────── */
.app-shell {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr 0px;
  /* Grid column resize when right panel opens — transform not viable here,
     layout change is necessary. Keep slow easing for smoothness. */
  transition: grid-template-columns var(--duration-slow) var(--ease-inout);
  grid-template-rows: var(--topbar-h) 1fr;
  grid-template-areas:
    "sidebar topbar    topbar"
    "sidebar main      rightpanel";
  height: 100vh;
  overflow: hidden;
  /* Shell entrance: entire layout fades up once */
  animation: shellEnter var(--duration-slow) var(--ease-out) both;
}

.app-shell--panel-open {
  grid-template-columns: var(--sidebar-w) 1fr var(--rightpanel-w);
}

/* ── TOP BAR ────────────────────────────────────────────────── */
.topbar {
  grid-area: topbar;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-3);
  padding: 0 var(--sp-6);
  background: var(--theme-navbar-bg);
  backdrop-filter: var(--theme-navbar-blur);
  border-bottom: 1px solid var(--theme-border);
  box-shadow:
    0 1px 0 rgba(0, 0, 0, 0.15),
    inset 0 -1px 0 var(--theme-border);
  position: sticky;
  top: 0;
  z-index: 40;
  transition:
    background var(--duration-slow) var(--ease-inout),
    border-color var(--duration-slow) var(--ease-inout);
  /* Topbar drops in after shell enter (80ms delay for cascade) */
  animation: topbarEnter var(--duration-slow) var(--ease-decel) 80ms both;
}

.topbar__left {
  margin-right: auto;
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}

/* ── HAMBURGER ──────────────────────────────────────────────── */
/* RESPONSIVE — hidden on desktop */
.topbar__hamburger {
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text-secondary);
  border: 1px solid transparent;
  flex-shrink: 0;
  /* Icon swap is instant visually; border/bg fade signals state */
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
}

.topbar__hamburger:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
}

/* Spring scale on press — confirms tap */
.topbar__hamburger:active {
  transform: scale(0.88);
}

.topbar__hamburger:focus-visible {
  outline: none;
  /* Pulse ring for keyboard nav — more visible than static outline */
  animation: focusPulse var(--duration-slow) var(--ease-inout) infinite;
}

/* ── ICON BUTTONS (generic) ─────────────────────────────────── */
.topbar__icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text-secondary);
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
}

.topbar__icon-btn:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-text);
}

.topbar__icon-btn:active {
  transform: scale(0.88);
}

.topbar__icon-btn:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 2px;
}

/* ── THEME TOGGLE ───────────────────────────────────────────── */
.topbar__theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text-secondary);
  border: 1px solid transparent;
  /* Rotation encodes "switching" — earned metaphor for a toggle */
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    transform var(--duration-base) var(--ease-spring);
}

.topbar__theme-toggle:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  transform: rotate(14deg);
}

/* Extra rotation on press — satisfying spring snap */
.topbar__theme-toggle:active {
  transform: rotate(30deg) scale(0.9);
}

.topbar__theme-toggle:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 2px;
}

/* ── UPGRADE BUTTON ─────────────────────────────────────────── */
.topbar__upgrade-btn {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 7px 16px;
  background: var(--clr-accent);
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 600;
  border-radius: var(--r-full);
  /* Lift + shadow bloom = primary CTA affordance */
  transition:
    background var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring),
    box-shadow var(--duration-fast) var(--ease-out);
  box-shadow: 0 2px 8px rgba(34, 197, 94, 0.3);
  /* Bounce in after topbar settles */
  animation: upgradeBounce var(--duration-slow) var(--ease-spring) 200ms both;
  will-change: transform;
  /* frequent hover target — worth it */
}

.topbar__upgrade-btn:hover {
  background: var(--clr-accent-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(34, 197, 94, 0.45);
}

.topbar__upgrade-btn:active {
  transform: translateY(0) scale(0.96);
  box-shadow: 0 2px 6px rgba(34, 197, 94, 0.25);
  transition-duration: var(--duration-fast);
}

.topbar__upgrade-btn:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 3px;
}

/* ── AVATAR ─────────────────────────────────────────────────── */
.topbar__avatar {
  width: 34px;
  height: 34px;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--clr-primary), var(--clr-purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  flex-shrink: 0;
  /* Ring expand on hover = clickable identity */
  transition:
    box-shadow var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
  box-shadow: 0 2px 8px rgba(124, 111, 224, 0.25);
  /* Spin-in after topbar — playful but brief */
  animation: avatarIn var(--duration-slow) var(--ease-spring) 160ms both;
  will-change: transform;
}

.topbar__avatar:hover {
  box-shadow:
    0 0 0 3px var(--theme-purple-dim),
    0 2px 12px rgba(124, 111, 224, 0.3);
  transform: scale(1.08);
}

.topbar__avatar:active {
  transform: scale(0.94);
  transition-duration: var(--duration-fast);
}

.topbar__avatar:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 3px;
}

/* ── SIDEBAR ────────────────────────────────────────────────── */
.sidebar {
  grid-area: sidebar;
  background: var(--theme-bg);
  border-right: 1px solid var(--theme-border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  z-index: 50;
  position: relative;
  transition:
    background var(--duration-slow) var(--ease-inout),
    border-color var(--duration-slow) var(--ease-inout);
  /* Sidebar slides in from left — counterpart to topbar's top entrance */
  animation: sidebarEnter var(--duration-slow) var(--ease-decel) 40ms both;
}

/* Glowing right edge line — unchanged */
.sidebar::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(180deg,
      transparent 0%,
      var(--theme-border-hover) 30%,
      var(--theme-border-hover) 70%,
      transparent 100%);
  pointer-events: none;
}

/* ── SIDEBAR LOGO ───────────────────────────────────────────── */
.sidebar__logo {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-5) var(--sp-5) var(--sp-4);
  border-bottom: 1px solid var(--theme-border);
  text-decoration: none;
  /* Logo settles after sidebar — slight delay for cascade */
  animation: logoShimmer var(--duration-slow) var(--ease-spring) 200ms both;
}

.sidebar__logo-text {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 1.15rem;
  color: var(--theme-text);
  line-height: 1.2;
}

.sidebar__logo-text span {
  color: var(--theme-accent);
}

/* ── SIDEBAR NAV ────────────────────────────────────────────── */
.sidebar__nav {
  padding: var(--sp-4) var(--sp-3);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.sidebar__section-label {
  font-size: 0.67rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
  padding: var(--sp-4) var(--sp-3) var(--sp-2);
  /* Labels fade in — subtle, doesn't compete with links */
  animation: labelEnter var(--duration-slow) var(--ease-out) 300ms both;
}

/* ── NAV LINKS — staggered entrance ─────────────────────────── */
/* 14 nav items max across 3 groups. Stagger 30ms each.
   Base delay 320ms (after sidebar+logo settle).
   Using :nth-child on .sidebar__nav children to hit links + labels. */
.sidebar__nav>*:nth-child(1) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 0 * 30ms) both;
}

.sidebar__nav>*:nth-child(2) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 1 * 30ms) both;
}

.sidebar__nav>*:nth-child(3) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 2 * 30ms) both;
}

.sidebar__nav>*:nth-child(4) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 3 * 30ms) both;
}

.sidebar__nav>*:nth-child(5) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 4 * 30ms) both;
}

.sidebar__nav>*:nth-child(6) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 5 * 30ms) both;
}

.sidebar__nav>*:nth-child(7) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 6 * 30ms) both;
}

.sidebar__nav>*:nth-child(8) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 7 * 30ms) both;
}

.sidebar__nav>*:nth-child(9) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 8 * 30ms) both;
}

.sidebar__nav>*:nth-child(10) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 9 * 30ms) both;
}

.sidebar__nav>*:nth-child(11) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 10 * 30ms) both;
}

.sidebar__nav>*:nth-child(12) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 11 * 30ms) both;
}

.sidebar__nav>*:nth-child(13) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 12 * 30ms) both;
}

.sidebar__nav>*:nth-child(14) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 13 * 30ms) both;
}

.sidebar__nav>*:nth-child(15) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 14 * 30ms) both;
}

.sidebar__nav>*:nth-child(16) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 15 * 30ms) both;
}

.sidebar__nav>*:nth-child(17) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 16 * 30ms) both;
}

.sidebar__nav>*:nth-child(18) {
  animation: linkEnter var(--duration-base) var(--ease-decel) calc(320ms + 17 * 30ms) both;
}

/* ── SIDEBAR LINK ────────────────────────────────────────────── */
.sidebar__link {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 9px var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  /* padding-left shift on hover: layout change, but small & intentional
     for nav indent metaphor. Keep — it's the design. */
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    padding-left var(--duration-base) var(--ease-inout),
    box-shadow var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
  position: relative;
  white-space: nowrap;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid transparent;
}

.sidebar__link:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  padding-left: 18px;
}

.sidebar__link:active {
  opacity: 0.75;
  transform: scale(0.98);
  transition-duration: var(--duration-fast);
}

.sidebar__link:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: -2px;
  border-radius: var(--r-md);
}

/* ── ACTIVE LINK ─────────────────────────────────────────────── */
.active {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border-hover);
  color: var(--theme-text);
  font-weight: 600;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 2px 8px var(--theme-purple-dim);
}

/* Active indicator bar — grows down on route change */
.sidebar__link.active::before,
.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 3px;
  background: var(--theme-accent);
  border-radius: 0 var(--r-full) var(--r-full) 0;
  box-shadow: 0 0 8px var(--theme-accent-glow);
  transform-origin: top center;
  /* Bar grows down — implies "you are here" anchoring */
  animation: indicatorGrow var(--duration-base) var(--ease-spring) both;
}

/* ── LINK ICON ───────────────────────────────────────────────── */
.sidebar__link-icon {
  color: var(--theme-text-secondary);
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition:
    opacity var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
}

.sidebar__link:hover .sidebar__link-icon {
  opacity: 1;
  color: var(--theme-text);
  /* Slight nudge right — reinforces the indent animation */
  transform: translateX(2px);
}

.sidebar__link:active .sidebar__link-icon {
  transform: scale(0.9);
}

.sidebar__link.active .sidebar__link-icon {
  opacity: 1;
}

/* Colored icon overrides — unchanged */
.sidebar__link[data-color="teal"] .sidebar__link-icon {
  color: var(--clr-teal);
}

.sidebar__link[data-color="purple"] .sidebar__link-icon {
  color: var(--theme-purple);
}

.sidebar__link[data-color="pink"] .sidebar__link-icon {
  color: var(--clr-pink);
}

.sidebar__link[data-color="orange"] .sidebar__link-icon {
  color: var(--clr-orange);
}

.sidebar__link[data-color="green"] .sidebar__link-icon {
  color: var(--theme-green);
}

.sidebar__link[data-color="blue"] .sidebar__link-icon {
  color: var(--clr-primary);
}

/* ── SIDEBAR FOOTER ─────────────────────────────────────────── */
.sidebar__footer {
  padding: var(--sp-4) var(--sp-3);
  border-top: 1px solid var(--theme-border);
  /* Footer fades in last */
  animation: labelEnter var(--duration-slow) var(--ease-out) 700ms both;
}

.sidebar__logout-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 9px var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--theme-red);
  background: transparent;
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring),
    border-color var(--duration-fast) var(--ease-out);
  border: 1px solid transparent;
  opacity: 0.75;
}

.sidebar__logout-btn:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.18);
  color: var(--theme-red);
  opacity: 1;
}

.sidebar__logout-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.sidebar__logout-btn:focus-visible {
  outline: 2px solid var(--theme-red);
  outline-offset: 2px;
}

/* ── MOBILE SIDEBAR BACKDROP ────────────────────────────────── */
.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  z-index: 55;
  opacity: 0;
  pointer-events: none;
  /* Backdrop fade — signals focus shift to drawer */
  transition: opacity var(--duration-base) var(--ease-inout);
}

.sidebar-backdrop--visible {
  opacity: 1;
  pointer-events: auto;
}

/* ── MAIN CONTENT ───────────────────────────────────────────── */
.main-content {
  grid-area: main;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--theme-bg);
  transition: background var(--duration-slow) var(--ease-inout);
  scroll-behavior: smooth;
}

/* Route page entrance — each new Outlet child fades up */
.main-content>* {
  animation: contentFadeIn var(--duration-base) var(--ease-decel) both;
}

/* ── RIGHT PANEL ────────────────────────────────────────────── */
.right-panel {
  grid-area: rightpanel;
  background: var(--theme-bg);
  border-left: 1px solid var(--theme-border);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  padding: var(--sp-6) var(--sp-5);
  position: relative;
  width: 0;
  min-width: 0;
  opacity: 0;
  transform: translateX(40px);
  pointer-events: none;
  transition:
    opacity var(--duration-slower) var(--ease-out),
    transform var(--duration-slower) var(--ease-out),
    background var(--duration-slow) var(--ease-inout),
    border-color var(--duration-slow) var(--ease-inout);
}

.right-panel--open {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
  width: var(--rightpanel-w);
}

/* Panel widgets stagger after panel opens.
   Panel takes ~600ms to open; widgets start at 500ms. */
.right-panel--open>*:nth-child(1) {
  animation: widgetEnter var(--duration-base) var(--ease-decel) 500ms both;
}

.right-panel--open>*:nth-child(2) {
  animation: widgetEnter var(--duration-base) var(--ease-decel) 560ms both;
}

.right-panel--open>*:nth-child(3) {
  animation: widgetEnter var(--duration-base) var(--ease-decel) 620ms both;
}

.right-panel--open>*:nth-child(4) {
  animation: widgetEnter var(--duration-base) var(--ease-decel) 680ms both;
}

.right-panel--open>*:nth-child(5) {
  animation: widgetEnter var(--duration-base) var(--ease-decel) 740ms both;
}

/* ── PANEL CLOSE BUTTON ─────────────────────────────────────── */
.panel-close-btn {
  position: absolute;
  top: var(--sp-3);
  right: var(--sp-3);
  width: 26px;
  height: 26px;
  border-radius: var(--r-full);
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-border-hover);
  color: var(--theme-text-secondary);
  font-size: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring),
    border-color var(--duration-fast) var(--ease-out);
  z-index: 10;
}

.panel-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.3);
  color: var(--theme-red);
  transform: scale(1.12) rotate(90deg);
  /* X rotates to signal "closing" */
}

.panel-close-btn:active {
  transform: scale(0.92) rotate(90deg);
  transition-duration: var(--duration-fast);
}

.panel-close-btn:focus-visible {
  outline: 2px solid var(--theme-red);
  outline-offset: 2px;
}

/* ── UPGRADE CARD ───────────────────────────────────────────── */
.upgrade-card {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  color: var(--theme-text);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: var(--theme-card-shadow);
  transition:
    background var(--duration-slow) var(--ease-inout),
    border-color var(--duration-slow) var(--ease-inout),
    box-shadow var(--duration-base) var(--ease-out),
    transform var(--duration-base) var(--ease-spring);
}

.upgrade-card:hover {
  /* Card lift — signals it's interactive */
  transform: translateY(-2px);
  box-shadow:
    var(--theme-card-shadow),
    0 8px 24px rgba(124, 111, 224, 0.15);
  border-color: var(--theme-border-hover);
}

.upgrade-card::before {
  content: "";
  position: absolute;
  top: -30px;
  right: -30px;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--theme-purple-dim) 0%, transparent 70%);
  pointer-events: none;
}

.upgrade-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--theme-border-hover), transparent);
}

.upgrade-card__header {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.upgrade-card__badge {
  width: 28px;
  height: 28px;
  border-radius: var(--r-sm);
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-border-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  transition: transform var(--duration-fast) var(--ease-spring);
}

.upgrade-card:hover .upgrade-card__badge {
  transform: rotate(-8deg) scale(1.1);
  /* badge wiggle on card hover */
}

.upgrade-card__title {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--theme-text);
}

.upgrade-card__desc {
  font-size: 0.78rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--sp-4);
}

.upgrade-card__btn {
  width: 100%;
  padding: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--clr-accent);
  color: white;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: var(--r-md);
  transition:
    background var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring),
    box-shadow var(--duration-fast) var(--ease-out);
  box-shadow: 0 2px 10px rgba(34, 197, 94, 0.25);
  will-change: transform;
  /* repeated hover target in visible panel */
}

.upgrade-card__btn:hover {
  background: var(--clr-accent-dark);
  transform: scale(1.02);
  box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);
}

.upgrade-card__btn:active {
  transform: scale(0.97);
  transition-duration: var(--duration-fast);
}

.upgrade-card__btn:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 3px;
}

/* ── PANEL WIDGETS ──────────────────────────────────────────── */
.panel-widget {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  padding: var(--sp-4) var(--sp-5);
  flex-shrink: 0;
  transition:
    border-color var(--duration-base) var(--ease-inout),
    box-shadow var(--duration-base) var(--ease-inout),
    background var(--duration-slow) var(--ease-inout),
    transform var(--duration-base) var(--ease-spring);
}

.panel-widget:hover {
  border-color: var(--theme-border-hover);
  box-shadow: 0 4px 16px var(--theme-purple-dim);
  transform: translateY(-2px);
  /* lift = interactivity affordance */
}

.panel-widget:active {
  transform: translateY(0) scale(0.99);
  transition-duration: var(--duration-fast);
}

.panel-widget__title {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--theme-text);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.panel-widget__body {
  font-size: 0.78rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
}

.panel-widget__link {
  display: inline-block;
  margin-top: var(--sp-2);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--theme-accent);
  transition:
    opacity var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
}

.panel-widget__link:hover {
  opacity: 0.85;
  color: var(--theme-accent);
  /* Arrow nudge — classic link affordance */
  transform: translateX(3px);
}

.panel-widget__link:active {
  transform: translateX(1px);
}

.panel-widget__link:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 2px;
  border-radius: 2px;
}

/* ── STREAK WIDGET ──────────────────────────────────────────── */
.streak-widget {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-widget__left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--theme-text);
}

.streak-widget__link {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--theme-accent);
  transition:
    opacity var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-spring);
}

.streak-widget__link:hover {
  opacity: 0.85;
  transform: translateX(3px);
}

.streak-widget__link:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 2px;
  border-radius: 2px;
}

/* ── UTILITY ────────────────────────────────────────────────── */
.text-primary {
  color: var(--theme-accent);
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — ≤ 1100px
   Right panel drops from grid (laptop / narrow desktop)
───────────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar topbar" "sidebar main";
  }

  .right-panel {
    display: none;
  }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — ≤ 768px
   Sidebar → fixed off-canvas drawer.
   Hamburger + backdrop activate.
───────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .app-shell {
    grid-template-columns: 1fr;
    grid-template-rows: var(--topbar-h) 1fr;
    grid-template-areas:
      "topbar"
      "main";
    height: 100dvh;
  }

  .app-shell--panel-open {
    grid-template-columns: 1fr;
  }

  .sidebar {
    grid-area: unset;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(260px, 80vw);
    z-index: 60;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    /* Mount animation disabled on mobile — drawer starts off-screen,
       slides in only on user action (hamburger tap) */
    animation: none;
    transform: translateX(-100%);
    transition:
      transform 320ms var(--ease-inout),
      box-shadow 320ms var(--ease-inout),
      background var(--duration-slow) var(--ease-inout),
      border-color var(--duration-slow) var(--ease-inout);
    box-shadow: none;
  }

  .sidebar--open {
    transform: translateX(0);
    box-shadow: 6px 0 28px rgba(0, 0, 0, 0.4);
  }

  .sidebar-backdrop {
    display: block;
  }

  .topbar__hamburger {
    display: flex;
  }

  .topbar {
    padding: 0 var(--sp-4);
    gap: var(--sp-2);
  }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — ≤ 480px
───────────────────────────────────────────────────────────── */
@media (max-width: 480px) {
  .sidebar__link {
    font-size: 0.85rem;
    padding: 8px var(--sp-3);
  }

  .sidebar__section-label {
    font-size: 0.63rem;
    letter-spacing: 0.06em;
  }

  .topbar__upgrade-btn {
    padding: 7px 9px;
    gap: 0;
  }

  .topbar__upgrade-btn .topbar__upgrade-label {
    display: none;
  }
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — ≤ 320px
───────────────────────────────────────────────────────────── */
@media (max-width: 320px) {
  .sidebar {
    width: 90vw;
  }

  .topbar {
    padding: 0 var(--sp-2);
    gap: var(--sp-1);
  }

  .topbar__upgrade-btn {
    display: none;
  }
}

/* ─────────────────────────────────────────────────────────────
   MOTION — prefers-reduced-motion
   Single authoritative kill-switch. Every animation/transition
   collapses to near-instant. No exceptions.
───────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  /* Rotations */
  .topbar__theme-toggle:hover,
  .topbar__theme-toggle:active {
    transform: none;
  }

  /* Lifts */
  .topbar__upgrade-btn:hover,
  .topbar__upgrade-btn:active,
  .topbar__avatar:hover,
  .topbar__avatar:active {
    transform: none;
  }

  /* Card/widget lifts */
  .panel-widget:hover,
  .panel-widget:active,
  .upgrade-card:hover {
    transform: none;
  }

  /* Badge wiggle */
  .upgrade-card:hover .upgrade-card__badge {
    transform: none;
  }

  /* Close button rotation */
  .panel-close-btn:hover,
  .panel-close-btn:active {
    transform: none;
  }

  /* Link arrow nudge */
  .panel-widget__link:hover,
  .panel-widget__link:active,
  .streak-widget__link:hover {
    transform: none;
  }

  /* Icon nudge */
  .sidebar__link:hover .sidebar__link-icon,
  .sidebar__link:active .sidebar__link-icon {
    transform: none;
  }
}

/* ═══════════════════════════════════════════════════════════
   PROFILE DROPDOWN — append these rules to appShell.module.css
   ═══════════════════════════════════════════════════════════ */

/* ── WRAPPER (gives the avatar button a positioning context) ── */
.topbar__profile {
  position: relative;
}

/* Reset browser button defaults on the avatar — visual styles
   already live in .topbar__avatar from the original CSS */
button.topbar__avatar {
  border: none;
  padding: 0;
}

/* ── KEYFRAMES ──────────────────────────────────────────────── */
@keyframes dropdownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes submenuFadeIn {
  from {
    opacity: 0;
    transform: translateX(6px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ── DROPDOWN PANEL ─────────────────────────────────────────── */
.profile-dropdown {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 220px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: 6px;
  z-index: 200;
  transform-origin: top right;
  animation: dropdownFadeIn var(--duration-fast) var(--ease-out) both;
}

/* ── HEADER (name + email, non-interactive) ─────────────────── */
.profile-dropdown__header {
  padding: 10px 10px 8px;
  border-bottom: 1px solid var(--theme-border);
  margin-bottom: 4px;
}

.profile-dropdown__name {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--theme-text);
  margin: 0 0 2px;
  line-height: 1.3;
}

.profile-dropdown__email {
  font-size: 0.73rem;
  color: var(--theme-text-muted);
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── DIVIDER ────────────────────────────────────────────────── */
.profile-dropdown__divider {
  height: 1px;
  background: var(--theme-border);
  margin: 4px 0;
}

/* ── MENU ITEM (base) ───────────────────────────────────────── */
.profile-dropdown__item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  border-radius: var(--r-md);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  background: transparent;
  border: none;
  text-align: left;
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out);
}

.profile-dropdown__item:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-text);
}

.profile-dropdown__item:active {
  opacity: 0.8;
  transform: scale(0.98);
  transition-duration: var(--duration-fast);
}

.profile-dropdown__item:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: -2px;
  border-radius: var(--r-md);
}

/* ── ITEM ICON ──────────────────────────────────────────────── */
.profile-dropdown__item-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--theme-text-muted);
}

.profile-dropdown__item:hover .profile-dropdown__item-icon {
  color: var(--theme-text-secondary);
}

/* ── "PRO" BADGE ────────────────────────────────────────────── */
.profile-dropdown__badge {
  margin-left: auto;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 2px 7px;
  border-radius: var(--r-full);
  background: rgba(34, 197, 94, 0.15);
  color: var(--clr-accent);
  border: 1px solid rgba(34, 197, 94, 0.25);
  flex-shrink: 0;
}

/* ── DANGER (log out) ───────────────────────────────────────── */
.profile-dropdown__item--danger {
  color: var(--theme-red);
}

.profile-dropdown__item--danger:hover {
  background: rgba(239, 68, 68, 0.1);
  color: var(--theme-red);
}

.profile-dropdown__item--danger .profile-dropdown__item-icon {
  color: var(--theme-red);
}

.profile-dropdown__item--danger:hover .profile-dropdown__item-icon {
  color: var(--theme-red);
}

/* ── CHEVRON (Learn more trigger) ───────────────────────────── */
.profile-dropdown__chevron {
  margin-left: auto;
  display: flex;
  align-items: center;
  color: var(--theme-text-muted);
  flex-shrink: 0;
  transition: transform var(--duration-fast) var(--ease-spring);
}

.profile-dropdown__chevron--open {
  transform: rotate(90deg);
}

/* ── SUBMENU ROOT (positioning context for the flyout) ──────── */
.profile-dropdown__submenu-root {
  position: relative;
}

/* ── SUBMENU FLYOUT ─────────────────────────────────────────── */
/* Floats to the LEFT — avatar sits on the right edge of the
   viewport so there's no room to fly right. */
.profile-submenu {
  position: absolute;
  right: calc(100% + 8px);
  top: 0;
  width: 196px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: 6px;
  z-index: 201;
  transform-origin: right top;
  animation: submenuFadeIn var(--duration-fast) var(--ease-out) both;
}

/* ── SUBMENU ITEM ───────────────────────────────────────────── */
.profile-submenu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: var(--r-md);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--theme-text-secondary);
  text-decoration: none;
  transition:
    background var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out);
}

.profile-submenu__item:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-text);
}

.profile-submenu__item:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: -2px;
  border-radius: var(--r-md);
}

/* External link icon */
.profile-submenu__external {
  display: flex;
  align-items: center;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── MOBILE (≤768px) — submenu becomes inline accordion ─────── */
@media (max-width: 768px) {
  .profile-dropdown {
    width: min(220px, calc(100vw - 16px));
  }

  .profile-submenu {
    position: relative;
    right: auto;
    top: auto;
    width: 100%;
    margin-top: 4px;
    border-radius: var(--r-md);
    animation: dropdownFadeIn var(--duration-fast) var(--ease-out) both;
  }
}

/* ── REDUCED MOTION ─────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {

  .profile-dropdown,
  .profile-submenu {
    animation: none;
  }

  .profile-dropdown__chevron {
    transition: none;
  }
}
