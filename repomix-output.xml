export default function SearchResults() {
  const { tab } = useParams();
  const navigate = useNavigate();
  const [searchParams, setSearchParams] = useSearchParams();

  const activeTab =
    tab?.toLowerCase() === "youtube"
      ? "YouTube"
      : tab?.toLowerCase() === "saved"
        ? "Saved"
        : "Google";

  const urlQuery = searchParams.get("q") || "";

  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [query, setQuery] = useState(urlQuery);
  const { notifyError, notifySuccess } = useErrorHandler();
  const [pageError, setPageError] = useState(null);
  const [filterChip, setFilterChip] = useState("All");
  const [dark, setDark] = useState(() => {
    return localStorage.getItem("sparke-theme");
  });

  // ── Saved items: store full result objects keyed by link ──
  const [savedItems, setSavedItems] = useState(() => {
    try {
      // migrate old saved_links array if present
      const oldLinks = JSON.parse(
        localStorage.getItem("saved_links") || "null",
      );
      const newItems = JSON.parse(
        localStorage.getItem("saved_items") || "null",
      );
      if (newItems) return newItems;
      if (oldLinks)
        return oldLinks.map((link) => ({
          link,
          title: link,
          snippet: "",
          displayed_link: link,
        }));
      return [];
    } catch {
      return [];
    }
  });

  // savedLinks — kept for compat with OrganicResults prop
  const savedLinks = savedItems.map((i) => i.link);

  const [activeResultIndex, setActiveResultIndex] = useState(-1);

  // Apply theme
  useEffect(() => {
    document.documentElement.setAttribute(
      "data-theme",
      dark ? "dark" : "light",
    );
    localStorage.setItem("search_theme", dark ? "dark" : "light");
  }, [dark]);

  // Persist saved items
  useEffect(() => {
    localStorage.setItem("saved_items", JSON.stringify(savedItems));
    // remove old key
    localStorage.removeItem("saved_links");
  }, [savedItems]);

  // Keyboard navigation
  useEffect(() => {
    const organicResults = data?.googleResponse?.organic_results || [];
    function onKeyDown(e) {
      if (e.target.tagName === "INPUT") return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActiveResultIndex((i) => Math.min(i + 1, organicResults.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActiveResultIndex((i) => Math.max(i - 1, 0));
      } else if (e.key === "Enter" && activeResultIndex >= 0) {
        const r = organicResults[activeResultIndex];
        if (r) window.open(r.link, "_blank");
      } else if (e.key === "b" || e.key === "B") {
        const r = organicResults[activeResultIndex];
        if (r) toggleSave(r.link);
      }
    }
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [data, activeResultIndex]);

  async function handleSearch(q) {
    setQuery(q);
    setLoading(true);
    setError(null);
    setData(null);
    setActiveResultIndex(-1);

    const params = new URLSearchParams(searchParams);
    params.set("q", q);
    setSearchParams(params, { replace: true });

    try {
      const result = await fetchSearch(q);
      setData(result);
    } catch (err) {
      // ── Auth → toast + redirect (don't show banner, we're leaving) ──
      if (err.status === 401) {
        notifyError("Session expired. Sign in again.");
        navigate("/login");
        return;
      }

      // ── Forbidden → toast only ───────────────────────────────────────
      if (err.status === 403) {
        notifyError("Access denied.");
        setError("You don't have permission to use search.");
        return;
      }

      // ── Network vs server → inline banner ───────────────────────────
      const type = resolveErrorType(err);
      if (type === ERROR_TYPES.NETWORK) {
        setError("No internet connection. Check network and try again.");
      } else {
        setError(err.message || "Search failed. Try again.");
      }
    } finally {
      setLoading(false);
    }
  }

  // Restore search on mount from ?q= param
  useEffect(() => {
    if (urlQuery && !data && !loading) {
      handleSearch(urlQuery);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  function toggleSave(link) {
    setSavedItems((prev) => {
      if (prev.some((i) => i.link === link)) {
        return prev.filter((i) => i.link !== link);
      }
      // find full result from current search data
      const match = data?.googleResponse?.organic_results?.find(
        (r) => r.link === link,
      );
      const item = match
        ? {
          link,
          title: match.title,
          snippet: match.snippet,
          displayed_link: match.displayed_link,
          favicon: match.favicon,
          date: match.date,
        }
        : { link, title: link, snippet: "", displayed_link: link };
      return [...prev, item];
    });
  }

  function handleTabChange(t) {
    const paths = {
      Google: "/search",
      YouTube: "/search/youtube",
      Saved: "/search/saved",
    };
    const qs = query ? `?q=${encodeURIComponent(query)}` : "";
    navigate(`${paths[t]}${qs}`);
  }

  const google = data?.googleResponse;
  const youtube = data?.youtubeResponse;
  const shorts = flattenShorts(youtube?.shorts_results);
  const totalResults = google?.search_information?.total_results;
  const ytTotal = youtube?.search_information?.total_results;
  const googleUrl = google?.search_metadata?.google_url;
  const youtubeUrl = youtube?.search_metadata?.youtube_url;

  if (pageError) {
    return (
      <ErrorPage
        type={pageError}
        onRetry={fetchData}
      />
    );
  }
  return (
    <div className={styles.page}>
      {/* Search bar */}
      <div className={styles.searchWrap}>
        <SearchBar
          onSearch={handleSearch}
          loading={loading}
          initialQuery={query}
        />
      </div>

      {/* Tabs */}
      <div className={styles.tabsBar}>
        <div className={styles.tabs}>
