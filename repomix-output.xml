/* ─── Flashcards.module.css — Motion-Enhanced ──────────────────────────── */

/* ── Non-theme vars: layout, radii, fonts, durations, easings ── */

/* ═══════════════════════════════════════════════════════
   KEYFRAMES
   Only transform + opacity — GPU composited, no reflow.
═══════════════════════════════════════════════════════ */

/* General fade-up: used for page sections, panels, cards */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade-in only: overlays, sidebars sliding in from side */
@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* Scale-in: dropdowns, dot menus — feels snappy not floaty */
@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Drop-down: mode dropdown, keeps slight Y shift */
@keyframes dropIn {
  from {
    opacity: 0;
    transform: translateY(-8px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Slide-in from right: history sidebar drawer on mobile */
@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100%);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Stagger helper: sidebar items enter one by one */
@keyframes staggerFadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Button press feedback: quick scale-down then spring back */
@keyframes pressDown {
  0% {
    transform: scale(1);
  }

  40% {
    transform: scale(0.94);
  }

  100% {
    transform: scale(1);
  }
}

/* Headbar entrance: slides down from top */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Card area entrance: subtle fade-up after headbar */
@keyframes cardEntrance {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Fan card stagger: each fan card enters offset */
@keyframes fanEntrance {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

/* Overlay backdrop */
@keyframes fadeInOverlay {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* ═══════════════════════════════════════════════════════
   REDUCED MOTION — disable all animations for a11y
═══════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ═══════════════════════════════════════════════════════
   SMOOTH SCROLL
═══════════════════════════════════════════════════════ */
html {
  scroll-behavior: smooth;
}

/* ── App Shell ── */
.appShell {
  display: flex;
  flex-direction: row;
  height: 100%;
  overflow: hidden;
  background: var(--theme-bg);
  font-family: var(--font-body);
  color: var(--theme-text);
  /* Entrance: shell fades in so first paint feels intentional */
  animation: fadeIn var(--duration-slow) var(--ease-out-quart) both;
}

.mainContent {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  /* Smooth scrolling inside main content pane */
  scroll-behavior: smooth;
}

/* ── Flashcard Homepage ── */
.flashHomeWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 60px 24px;
  text-align: center;
  min-height: 100%;
  /* Page entrance: fade up */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

.flashHomeIcon {
  font-size: 3.5rem;
  width: 80px;
  height: 80px;
  background: var(--theme-purple);
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28px;
  /* Icon pops in slightly after wrapper via delay */
  animation: fadeUp var(--duration-slow) var(--ease-spring) 80ms both;
  transition: transform var(--duration-base) var(--ease-spring);
}

.flashHomeIcon:hover {
  /* Subtle lift on hover — engage without distraction */
  transform: scale(1.08) rotate(-3deg);
}

.flashHomeHeading {
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 800;
  color: var(--theme-text);
  margin: 0 0 14px;
  letter-spacing: -0.03em;
  max-width: 600px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 120ms both;
}

.flashHomeSub {
  font-size: 1rem;
  color: var(--theme-text-secondary);
  margin: 0 0 40px;
  max-width: 480px;
  line-height: 1.6;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 180ms both;
}

.flashHomeCard {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 28px 36px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-xs);
  cursor: pointer;
  text-align: left;
  max-width: 480px;
  width: 100%;
  /* Card stagger: appears after subheading */
  animation: fadeUp var(--duration-slow) var(--ease-spring) 240ms both;
  /* GPU hint: will lift + shadow on hover */
  will-change: transform;
  transition:
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart);
}

.flashHomeCard:hover {
  border-color: var(--theme-purple);
  box-shadow: var(--shadow-hover);
  transform: translateY(-4px);
}

/* Press micro-interaction: triggers on :active */
.flashHomeCard:active {
  transform: translateY(-1px) scale(0.99);
  transition-duration: var(--duration-fast);
}

.flashHomeCardIcon {
  width: 52px;
  height: 52px;
  background: var(--theme-purple-dim);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-purple);
  flex-shrink: 0;
  /* Icon scales up gently when card hovered */
  transition: transform var(--duration-base) var(--ease-spring);
}

.flashHomeCard:hover .flashHomeCardIcon {
  transform: scale(1.12);
}

.flashHomeCardTitle {
  font-size: 1rem;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0 0 4px;
}

.flashHomeCardSub {
  font-size: 0.85rem;
  color: var(--theme-text-secondary);
  margin: 0;
}

/* ── RIGHT Sidebar ── */
.sidebarExpanded {
  width: var(--sidebar-width);
}

.sidebarCollapsed {
  width: 40px;
}

.historySidebar {
  position: relative;
  height: 100%;
  background: var(--theme-surface);
  border-left: 1px solid var(--theme-border);
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  overflow: hidden;
  z-index: 20;
  /* Width collapse uses snappy easing, not plain ease */
  transition: width var(--duration-slow) var(--ease-snappy);
}

.sidebarOpen {
  width: 260px;
}

.sidebarClosed {
  width: 36px;
}

/* Toggle button at left edge of sidebar */
.sidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--theme-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.sidebarToggleBtn:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-purple);
  /* Nudge left toward sidebar — invites click */
  transform: translateY(-50%) translateX(-2px);
}

.sidebarToggleBtn:active {
  transform: translateY(-50%) scale(0.92);
}

.sidebarContent {
  padding: 20px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--theme-border) var(--theme-surface);
  display: flex;
  flex-direction: column;
}

.sidebarContent::-webkit-scrollbar {
  width: 4px;
}

.sidebarContent::-webkit-scrollbar-track {
  background: var(--theme-surface);
}

.sidebarContent::-webkit-scrollbar-thumb {
  background: var(--theme-border);
  border-radius: 999px;
  transition: background var(--duration-fast) var(--ease-out-quart);
}

.sidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--theme-text-muted);
}

.uploadBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 10px;
  background: var(--theme-purple);
  color: white;
  border: none;
  border-radius: var(--r-sm);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  margin-bottom: 20px;
  white-space: nowrap;
  /* will-change for transform + opacity only */
  will-change: transform;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.uploadBtn:hover {
  background: var(--theme-purple-light);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
}

/* Press: squish down then spring */
.uploadBtn:active {
  animation: pressDown var(--duration-fast) var(--ease-spring) both;
  transform: translateY(0);
}

.sidebarTitle {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--theme-text);
  /* Entrance: slides in slightly from left */
  animation: fadeUp var(--duration-base) var(--ease-out-quart) 60ms both;
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--theme-text-muted);
}

/* Staggered sidebar items: nth-child delays create visual flow */
.sidebarItem {
  padding: 12px 14px;
  border: 1.5px solid var(--theme-border);
  border-radius: var(--r-sm);
  margin-bottom: 10px;
  cursor: pointer;
  background: var(--theme-surface);
  flex-shrink: 0;
  /* Stagger entrance via nth-child */
  animation: staggerFadeUp var(--duration-base) var(--ease-out-quart) both;
  will-change: transform;
  transition:
    transform var(--duration-base) var(--ease-spring),
    border-color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

/* Stagger delay per item: up to 8 items, 40ms apart */
.sidebarItem:nth-child(1) {
  animation-delay: 80ms;
}

.sidebarItem:nth-child(2) {
  animation-delay: 120ms;
}

.sidebarItem:nth-child(3) {
  animation-delay: 160ms;
}

.sidebarItem:nth-child(4) {
  animation-delay: 200ms;
}

.sidebarItem:nth-child(5) {
  animation-delay: 240ms;
}

.sidebarItem:nth-child(6) {
  animation-delay: 280ms;
}

.sidebarItem:nth-child(7) {
  animation-delay: 320ms;
}

.sidebarItem:nth-child(8) {
  animation-delay: 360ms;
}

.sidebarItem:hover {
  border-color: var(--theme-purple);
  background: var(--theme-purple-dim);
  transform: translateX(-2px);
  /* slight left nudge = selected feel */
}

.sidebarItem:active {
  transform: scale(0.98);
  transition-duration: var(--duration-fast);
}

.sidebarItemActive {
  border-color: var(--theme-purple);
  background: var(--theme-purple-dim);
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
}

.sidebarItemActive .sidebarItemTitle {
  color: var(--theme-purple);
}

.sidebarItemTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--theme-text);
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebarItemMeta {
  font-size: 11px;
  color: var(--theme-text-muted);
}

.sidebarItemRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.sidebarItemText {
  flex: 1;
  overflow: hidden;
}

.sidebarItemMenuWrapper {
  position: relative;
  flex-shrink: 0;
}

.threeDotBtn {
  width: 26px;
  height: 26px;
  border: none;
  background: transparent;
  color: var(--theme-text-muted);
  font-size: 16px;
  cursor: pointer;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  letter-spacing: -1px;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.threeDotBtn:hover {
  background: var(--theme-border);
  color: var(--theme-text);
  transform: scale(1.15);
  /* enlarge hit area feel */
}

.threeDotBtn:active {
  transform: scale(0.9);
  transition-duration: var(--duration-fast);
}

/* Dot menu: scale-in from top-right origin */
.dotMenu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  box-shadow: var(--shadow-md);
  z-index: 50;
  min-width: 110px;
  overflow: hidden;
  transform-origin: top right;
  animation: scaleIn var(--duration-base) var(--ease-spring) both;
}

.dotMenuDelete {
  width: 100%;
  padding: 9px 14px;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  color: #ef4444;
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-out-quart);
}

.dotMenuDelete:hover {
  background: #fee2e2;
  /* Subtle X-shift = destructive affordance */
  transform: translateX(2px);
}

/* ── Viewer Layout ── */
.viewerLayout {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  animation: fadeIn var(--duration-base) var(--ease-out-quart) both;
}

/* ── Headbar ── */
.headbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: var(--headbar-height);
  padding: 0 20px;
  background: var(--bg-headbar);
  border-bottom: 1px solid var(--theme-border);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-xs);
  /* Slides in from top on mount */
  animation: slideDown var(--duration-slow) var(--ease-out-quart) both;
}

.headbarLeft {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.headbarRight {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.modeDropdownWrapper {
  position: relative;
}

.modeBtn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  color: var(--theme-text);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.modeBtn:hover {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  transform: translateY(-1px);
  box-shadow: var(--shadow-xs);
}

.modeBtn:active {
  transform: scale(0.97);
  transition-duration: var(--duration-fast);
}

/* Dropdown: drop-in animation from updated keyframe */
.modeDropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  background: var(--bg-dropdown);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  z-index: 50;
  min-width: 200px;
  transform-origin: top left;
  animation: dropIn var(--duration-base) var(--ease-spring) both;
}

.modeOption {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 16px;
  background: transparent;
  border: none;
  color: var(--theme-text);
  font-size: 0.875rem;
  cursor: pointer;
  text-align: left;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-out-quart);
}

.modeOption:hover {
  background: var(--theme-purple-dim);
  color: var(--theme-purple);
  transform: translateX(3px);
  /* nudge right = selected direction */
}

.modeOptionActive {
  color: var(--theme-purple);
  font-weight: 600;
}

/* Progress dots */
.progressDots {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  justify-content: center;
  overflow: hidden;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 2px solid var(--theme-border);
  background: transparent;
  cursor: pointer;
  flex-shrink: 0;
  padding: 0;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.dot:hover {
  border-color: var(--theme-purple);
  transform: scale(1.3);
  /* spring scale = satisfying dot hover */
}

.dotActive {
  background: var(--theme-purple);
  border-color: var(--theme-purple);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  /* Active dot pops in */
  animation: pressDown var(--duration-fast) var(--ease-spring) both;
}

.dotsMore {
  color: var(--theme-text-muted);
  font-size: 1rem;
}

.shuffleBtn {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text-secondary);
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.shuffleBtn:hover {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  background: var(--theme-purple-dim);
  transform: rotate(30deg) scale(1.08);
  /* shuffle = rotation metaphor */
}

.shuffleBtn:active {
  transform: rotate(-15deg) scale(0.9);
  transition-duration: var(--duration-fast);
}

.cardCounter {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--theme-text-secondary);
  white-space: nowrap;
  padding: 0 4px;
}

.navArrow {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--theme-text);
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.navArrow:hover:not(:disabled) {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  background: var(--theme-purple-dim);
  /* Left arrow nudges left, right nudges right = directional affordance */
  transform: translateX(-2px);
}

.navArrow:last-child:hover:not(:disabled) {
  transform: translateX(2px);
}

.navArrow:active:not(:disabled) {
  transform: scale(0.88);
  transition-duration: var(--duration-fast);
}

.navArrow:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

/* ── Card Area ── */
.cardArea {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 32px;
  gap: 20px;
  /* Enters after headbar: delayed so headbar lands first */
  animation: cardEntrance var(--duration-slower) var(--ease-out-quart) 120ms
    both;
}

.cardMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 720px;
}

.cardSideLabel {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--theme-text-secondary);
  letter-spacing: 0.02em;
  transition: opacity var(--duration-base) var(--ease-out-quart);
}

.ratingBtns {
  display: flex;
  gap: 8px;
}

.ratingBtn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--theme-border);
  border-radius: 50%;
  background: transparent;
  color: var(--theme-text-muted);
  cursor: pointer;
  will-change: transform;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.ratingBtn:hover {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  background: var(--theme-purple-dim);
  transform: scale(1.18);
}

.ratingBtn:active {
  animation: pressDown var(--duration-fast) var(--ease-spring) both;
}

.ratingBtnActive {
  background: #dcfce7;
  border-color: #22c55e;
  color: #16a34a;
  transform: scale(1.08);
  /* stays slightly large = committed state */
}

.ratingBtnDown {
  background: #fee2e2;
  border-color: #ef4444;
  color: #dc2626;
  transform: scale(1.08);
}

.ratingBtnBookmark {
  background: var(--theme-purple-dim);
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  transform: scale(1.08);
}

/* ── 3D Card Flip ── */
.cardScene {
  width: 100%;
  max-width: 720px;
  height: 380px;
  perspective: 1200px;
  cursor: pointer;
  flex-shrink: 0;
  will-change: transform;
  /* hint compositor for flip */
}

.card3d {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  /* Flip: slower = dramatic; spring-like easing via cubic-bezier */
  transition: transform var(--duration-slower) cubic-bezier(0.4, 0.2, 0.2, 1);
}

.cardFlipped {
  transform: rotateX(180deg);
}

.cardFront,
.cardBack {
  position: absolute;
  inset: 0;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  box-shadow: var(--theme-card-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  /* Card surface hover: lift + shadow intensify */
  transition:
    box-shadow var(--duration-base) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.cardScene:hover .cardFront,
.cardScene:hover .cardBack {
  box-shadow: var(--shadow-hover);
  /* Only nudge up if not already flipping — no competing with 3D */
}

.cardBack {
  transform: rotateX(180deg);
  background: linear-gradient(
    135deg,
    var(--theme-surface) 0%,
    var(--theme-purple-dim) 100%
  );
}

.cardText {
  font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  font-weight: 500;
  color: var(--theme-text);
  text-align: center;
  line-height: 1.5;
  margin: 0;
  /* Text fades in after flip completes */
  transition: opacity var(--duration-fast) var(--ease-out-quart);
}

/* ── Bottom Bar ── */
.bottomBar {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
  padding-bottom: 24px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 200ms both;
}

.bottomNavBtn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 22px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  color: var(--theme-text);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  will-change: transform;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.bottomNavBtn:hover:not(:disabled) {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  box-shadow: var(--shadow-xs);
  transform: translateY(-2px);
}

.bottomNavBtn:active:not(:disabled) {
  transform: scale(0.96) translateY(0);
  transition-duration: var(--duration-fast);
}

.bottomNavBtn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.flipBtn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 28px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  color: var(--theme-text);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  will-change: transform;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.flipBtn:hover {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  background: var(--theme-purple-dim);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
}

.flipBtn:active {
  animation: pressDown var(--duration-fast) var(--ease-spring) both;
}

.kbd {
  display: inline-flex;
  align-items: center;
  padding: 2px 6px;
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: 4px;
  font-size: 0.7rem;
  font-family: monospace;
  color: var(--theme-text-muted);
  transition: border-color var(--duration-fast) var(--ease-out-quart);
}

/* ── Create Layout ── */
.createLayout {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  background: var(--theme-bg);
  animation: fadeIn var(--duration-base) var(--ease-out-quart) both;
}

.createHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  height: var(--headbar-height);
  background: var(--bg-headbar);
  border-bottom: 1px solid var(--theme-border);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-xs);
  animation: slideDown var(--duration-slow) var(--ease-out-quart) both;
}

.createTitle {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--theme-text);
}

.exitBtn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  background: var(--theme-surface);
  color: var(--theme-text);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.exitBtn:hover {
  border-color: #ef4444;
  color: #ef4444;
  transform: scale(1.03);
}

.exitBtn:active {
  transform: scale(0.96);
  transition-duration: var(--duration-fast);
}

.createBody {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.createLeft {
  flex: 1;
  padding: 36px 40px;
  overflow-y: auto;
  border-right: 1px solid var(--theme-border);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 80ms both;
}

.stepIndicator {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--theme-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 10px;
}

.createHeading {
  font-size: clamp(1.3rem, 2vw, 1.8rem);
  font-weight: 800;
  color: var(--theme-text);
  margin: 0 0 6px;
  line-height: 1.2;
  letter-spacing: -0.02em;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 100ms both;
}

.createSubheading {
  font-size: 0.9rem;
  color: var(--theme-text-secondary);
  margin: 0 0 28px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 140ms both;
}

/* ── Tiles ── */
.tilesGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-width: 560px;
}

.tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 28px 20px;
  background: var(--bg-tile);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  cursor: pointer;
  position: relative;
  text-align: center;
  /* Stagger tiles as grid fills in */
  animation: fadeUp var(--duration-slow) var(--ease-spring) both;
  will-change: transform;
  transition:
    transform var(--duration-slow) var(--ease-spring),
    box-shadow var(--duration-slow) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart);
}

/* Tile stagger: pairs enter together, stagger by row */
.tile:nth-child(1) {
  animation-delay: 160ms;
}

.tile:nth-child(2) {
  animation-delay: 200ms;
}

.tile:nth-child(3) {
  animation-delay: 240ms;
}

.tile:nth-child(4) {
  animation-delay: 280ms;
}

.tile:nth-child(5) {
  animation-delay: 320ms;
}

.tile:hover:not(.tileDisabled) {
  transform: translateY(-10px) rotate(var(--tile-rotate, 0deg));
  box-shadow: var(--shadow-hover);
  border-color: var(--theme-purple);
}

.tile:active:not(.tileDisabled) {
  transform: translateY(-4px) scale(0.98);
  transition-duration: var(--duration-fast);
}

.tileDisabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.tileIcon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-purple-dim);
  color: var(--theme-purple);
  transition: transform var(--duration-base) var(--ease-spring);
}

.tile:hover:not(.tileDisabled) .tileIcon {
  transform: scale(1.15) rotate(-5deg);
  /* icon wiggles on card hover */
}

/* Tile color variants */
.tileColorIndigo .tileIcon {
  background: #ede9fe;
  color: #6366f1;
}

.tileColorAmber .tileIcon {
  background: #fef3c7;
  color: #f59e0b;
}

.tileColorViolet .tileIcon {
  background: #f3e8ff;
  color: #a855f7;
}

.tileColorSky .tileIcon {
  background: #e0f2fe;
  color: #0284c7;
}

.tileColorTeal .tileIcon {
  background: #ccfbf1;
  color: #0d9488;
}

.tileLabel {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--theme-text);
}

.tileBadge {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 0.65rem;
  font-weight: 600;
  padding: 2px 6px;
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: 99px;
  color: var(--theme-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ── Create Right Panel ── */
.createRight {
  width: 44%;
  background: var(--theme-purple-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  overflow: hidden;
  animation: fadeIn var(--duration-slow) var(--ease-out-quart) 120ms both;
}

[data-theme="dark"] .createRight {
  background: #1a1f35;
}

.previewPanel {
  text-align: center;
  max-width: 360px;
  width: 100%;
}

.previewTitle {
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-weight: 800;
  color: var(--theme-text);
  margin: 0 0 8px;
  letter-spacing: -0.03em;
}

.accent {
  color: var(--theme-purple);
}

.previewSub {
  font-size: 0.9rem;
  color: var(--theme-text-secondary);
  margin: 0 0 32px;
}

/* ── Fan Cards ── */
.cardFanWrapper {
  position: relative;
  height: 260px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fanCard {
  position: absolute;
  background: var(--theme-surface);
  border-radius: var(--r-md);
  padding: 16px 14px;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 130px;
  font-size: 0.8rem;
  color: var(--theme-text);
  font-weight: 600;
  /* Fan cards enter from center-bottom staggered */
  animation: fanEntrance var(--duration-slow) var(--ease-spring) both;
}

.fanCard1 {
  transform: rotate(-18deg) translateX(-90px) translateY(20px);
  z-index: 1;
  opacity: 0.7;
  animation-delay: 80ms;
}

.fanCard2 {
  transform: rotate(-8deg) translateX(-40px) translateY(10px);
  z-index: 2;
  opacity: 0.85;
  animation-delay: 140ms;
}

.fanCard3 {
  transform: rotate(0deg);
  z-index: 3;
  min-width: 160px;
  animation-delay: 200ms;
}

.fanCard4 {
  transform: rotate(12deg) translateX(70px) translateY(10px);
  z-index: 2;
  opacity: 0.7;
  animation-delay: 260ms;
}

.fanCardIcon {
  width: 32px;
  height: 32px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  font-weight: 700;
}

.fanCardSection {
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--theme-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-top: 4px;
}

.fanLine {
  height: 6px;
  background: var(--theme-bg);
  border-radius: 99px;
  width: 100%;
}

/* ── Form Fields ── */
.fieldGroup {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 20px;
  animation: fadeUp var(--duration-base) var(--ease-out-quart) both;
}

.fieldLabel {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-label);
}

.fieldInput {
  width: 100%;
  max-width: 480px;
  padding: 12px 16px;
  border: 1px solid var(--theme-border);
  border-radius: var(--r-sm);
  background: var(--theme-surface-2);
  color: var(--theme-text);
  font-size: 0.9rem;
  font-family: var(--font-body);
  outline: none;
  /* Focus glow: border-color + box-shadow animate together */
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    box-shadow var(--duration-base) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.fieldInput::placeholder {
  color: var(--theme-text-muted);
}

.fieldInput:focus {
  border-color: var(--theme-purple);
  /* Glow: layered shadows for depth */
  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.12),
    0 0 0 1px var(--theme-purple);
  /* Micro lift on focus = "active" state */
  transform: translateY(-1px);
}

.fieldHint {
  font-size: 0.78rem;
  color: var(--theme-text-muted);
  line-height: 1.5;
  margin: 0;
  max-width: 480px;
}

/* ── Step Nav ── */
.stepNav {
  display: flex;
  gap: 12px;
  margin-top: 32px;
}

.backBtn {
  padding: 11px 28px;
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  background: var(--theme-surface);
  color: var(--theme-text);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.backBtn:hover {
  border-color: var(--theme-purple);
  color: var(--theme-purple);
  transform: translateX(-3px);
  /* back = leftward nudge */
}

.backBtn:active {
  transform: scale(0.97);
  transition-duration: var(--duration-fast);
}

.nextBtn {
  padding: 11px 32px;
  border: none;
  border-radius: var(--r-md);
  background: var(--theme-purple);
  color: white;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  will-change: transform;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.nextBtn:hover:not(:disabled) {
  background: var(--theme-purple-light);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
}

.nextBtn:active:not(:disabled) {
  animation: pressDown var(--duration-fast) var(--ease-spring) both;
  transform: translateY(0);
}

.nextBtn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* ── Topic Preview ── */
.topicPreview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  padding: 36px 24px;
  margin-bottom: 28px;
  box-shadow: var(--shadow-xs);
  animation: fadeUp var(--duration-slow) var(--ease-spring) 100ms both;
}

.topicPreviewIcon {
  color: var(--theme-purple);
  display: flex;
  transition: transform var(--duration-base) var(--ease-spring);
}

.topicPreview:hover .topicPreviewIcon {
  transform: scale(1.12) rotate(-5deg);
}

.topicPreviewText {
  font-size: 0.9rem;
  color: var(--theme-text-secondary);
  margin: 0;
  text-align: center;
}

/* ── PDF Dropzone ── */
.dropzone {
  position: relative;
  max-width: 480px;
  border: 2px dashed var(--theme-border);
  border-radius: var(--r-md);
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  color: var(--theme-text-secondary);
  text-align: center;
  font-size: 0.875rem;
  will-change: transform;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.dropzone:hover {
  border-color: var(--theme-purple);
  background: var(--theme-purple-dim);
  transform: scale(1.01);
  /* subtle swell = "droppable" affordance */
  box-shadow: var(--shadow-xs);
}

/* Active drag state: more pronounced swell */
.dropzone:focus-within {
  border-color: var(--theme-purple);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.fileInput {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}

.fileName {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--theme-purple);
  background: var(--theme-purple-dim);
  padding: 4px 10px;
  border-radius: 99px;
  /* Pill pops in when file selected */
  animation: scaleIn var(--duration-base) var(--ease-spring) both;
}

/* ── Scratch Preview ── */
.scratchPreview {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 24px;
}

.scratchCard {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--theme-text-secondary);
  box-shadow: var(--shadow-xs);
  animation: staggerFadeUp var(--duration-base) var(--ease-out-quart) both;
}

.scratchCard:nth-child(1) {
  animation-delay: 60ms;
}

.scratchCard:nth-child(2) {
  animation-delay: 110ms;
}

.scratchCard:nth-child(3) {
  animation-delay: 160ms;
}

.noteItem {
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.noteItem:hover {
  background: rgba(99, 102, 241, 0.08);
  border-radius: 8px;
  transform: translateX(3px);
  /* nudge right = list item selected */
}

.noteItem:active {
  transform: scale(0.98);
  transition-duration: var(--duration-fast);
}

.noteItemText {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}

.noteTopic {
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.noteSubject {
  font-size: 11px;
  opacity: 0.55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.emptyRecent {
  font-size: 12px;
  opacity: 0.4;
  padding: 8px 4px;
}

/* ═══════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════ */
@media (max-width: 1024px) {
  .createRight {
    width: 40%;
  }

  .tilesGrid {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .rightSidebar {
    display: none;
  }

  .createBody {
    flex-direction: column;
  }

  .createRight {
    width: 100%;
    min-height: 240px;
  }

  .tilesGrid {
    grid-template-columns: 1fr 1fr;
  }

  .cardScene {
    height: 260px;
  }

  .headbar {
    padding: 0 12px;
    gap: 8px;
  }

  .progressDots {
    gap: 4px;
  }

  .dot {
    width: 8px;
    height: 8px;
  }

  .cardArea {
    padding: 16px;
  }
}

@media (max-width: 480px) {
  .tilesGrid {
    grid-template-columns: 1fr;
  }

  .createLeft {
    padding: 24px 20px;
  }

  .bottomBar {
    gap: 8px;
  }

  .bottomNavBtn,
  .flipBtn {
    padding: 9px 14px;
    font-size: 0.8rem;
  }
}

/* ── MOBILE DRAWER ── */
.drawerOverlay {
  display: none;
}

.drawerCloseBtn {
  display: none;
}

.hamburgerBtn {
  display: none;
}

@media (max-width: 768px) {
  .hamburgerBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    bottom: 70px;
    right: 16px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: var(--theme-purple);
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    z-index: 298;
    box-shadow: var(--shadow-md);
    will-change: transform;
    transition:
      background var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-out-quart);
  }

  .hamburgerBtn:hover {
    transform: scale(1.08);
    box-shadow: var(--shadow-hover);
  }

  .hamburgerBtn:active {
    background: var(--theme-purple-dim);
    color: var(--theme-purple);
    animation: pressDown var(--duration-fast) var(--ease-spring) both;
  }

  .hamburgerBtn:has(~ * .mobileSidebarOpen) {
    display: none;
  }

  /* Backdrop */
  .drawerOverlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 299;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    animation: fadeInOverlay var(--duration-base) var(--ease-out-quart) both;
  }

  /* Sidebar → fixed right drawer */
  .historySidebar {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 85vw;
    max-width: 300px;
    z-index: 300;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    /* Use snappy easing; will-change for compositor hint */
    transition: transform var(--duration-slow) var(--ease-snappy);
    will-change: transform;
    overflow-y: auto;
    border-left: 1px solid var(--theme-border);
  }

  .mobileSidebarOpen {
    transform: translateX(0) !important;
  }

  .historySidebar .sidebarContent {
    padding: 16px;
    display: flex !important;
    flex-direction: column;
  }

  .sidebarToggleBtn {
    display: none;
  }

  .drawerCloseBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--theme-border);
    border-radius: 6px;
    background: var(--bg-dropdown);
    color: var(--theme-text-secondary);
    font-size: 13px;
    cursor: pointer;
    margin: 14px 14px 4px auto;
    flex-shrink: 0;
    transition:
      background var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-spring);
  }

  .drawerCloseBtn:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    transform: rotate(90deg);
    /* X rotates in = close affordance */
  }

  .drawerCloseBtn:active {
    transform: rotate(90deg) scale(0.88);
    transition-duration: var(--duration-fast);
  }
}

@supports (padding-bottom: env(safe-area-inset-bottom)) {
  @media (max-width: 768px) {
    .historySidebar {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
}
