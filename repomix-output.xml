  // ── Delete chat ────────────────────────────────────────────────────────────
  const handleDeleteChat = async (chat) => {
    try {
      const res = await apiFetch(`/api/documents/${chat._id}`, {
        method: "DELETE",
      });

      // ── Auth errors → redirect + toast ──────────────────────────
