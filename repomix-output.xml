                      fill="none"
                      stroke="currentColor"
                      strokeWidth="2.5"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                    >
                      <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                    </svg>
                  </button>
                </form>
              </footer>
            </div>
          </div>
        )}
      </div>
      {/* end appShell */}

      {/* FIX: Right sidebar is NOW outside chatRoom block — always visible */}
      {/* ── MOBILE TOPBAR ── */}

      {/* ── BACKDROP OVERLAY ── */}
      {mobileSidebarOpen && (
