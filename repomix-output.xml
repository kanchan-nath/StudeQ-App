<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/* notes.module.css — Notes page (scoped) */
/* Colors now sourced from global.css --theme-* vars */
&nbsp;
/* ── NOTES-SPECIFIC CSS VARS ─────────────────────────────────── */
/* --n-* aliases map to --theme-* so dark/light toggle works via  */
/* data-theme on &lt;html&gt;. No more local [data-theme] overrides.    */
/* Shadows, radii, timing, layout vars remain hardcoded here.     */
&nbsp;
.notes-page,
.notes-page * {
  /* ── color aliases ── */
  --n-bg: var(--theme-bg);
  --n-surface: var(--theme-surface);
  --n-surface-raised: var(--theme-surface-2);
  --n-border: var(--theme-border);
  --n-border-subtle: var(--theme-border);
&nbsp;
  --n-primary: var(--theme-purple);
  --n-primary-dark: var(--theme-purple-light);
  /* lighter shade = hover on dark, still works light */
  --n-primary-light: var(--theme-purple-dim);
  --n-primary-glow: var(--theme-accent-glow);
&nbsp;
  --n-accent: var(--theme-green);
  --n-accent-light: var(--theme-accent-dim);
&nbsp;
  --n-purple: var(--theme-purple);
  --n-teal: var(--theme-purple-light);
  --n-danger: var(--theme-red);
  --n-danger-light: rgba(239, 68, 68, 0.1);
  --n-warning: var(--theme-accent);
  --n-pin: var(--theme-accent);
&nbsp;
  --n-text-primary: var(--theme-text);
  --n-text-secondary: var(--theme-text-secondary);
  --n-text-muted: var(--theme-text-muted);
  --n-text-inverse: var(--theme-bg);
&nbsp;
  /* ── layout / shape / motion (unchanged) ── */
  --n-sidebar-w: 260px;
  --n-r-sm: 6px;
  --n-r-md: 12px;
  --n-r-lg: 16px;
  --n-r-xl: 24px;
  --n-r-full: 9999px;
  --n-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.08);
  --n-shadow-card: 0 4px 20px rgba(0, 0, 0, 0.18), 0 1px 4px rgba(0, 0, 0, 0.1);
  --n-shadow-lift: 0 8px 32px rgba(0, 0, 0, 0.28), 0 2px 8px rgba(0, 0, 0, 0.12);
  --n-t-fast: 150ms ease;
  --n-t-base: 220ms ease;
  --n-t-slow: 380ms cubic-bezier(0.4, 0, 0.2, 1);
}
&nbsp;
/* ── PAGE LAYOUT ─────────────────────────────────────────────── */
.notes-page {
  display: grid;
  grid-template-columns: 1fr var(--n-sidebar-w);
  grid-template-rows: 1fr;
  height: 100%;
  overflow: hidden;
  background: var(--n-bg);
  animation: fadeIn var(--n-t-slow) both;
  transition: grid-template-columns var(--n-t-base), background var(--t-slow);
}
&nbsp;
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
&nbsp;
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
&nbsp;
/* ── NOTES SIDEBAR (RIGHT) ───────────────────────────────────── */
/* MODIFIED */
.sidebar-wrapper {
  position: relative;
  display: flex;
  flex-direction: row;
  grid-column: 2;
  grid-row: 1;
  overflow: hidden;
  flex-shrink: 0;
  border-left: 1px solid var(--n-border);
  /* moved from notes-sidebar */
  transition: width var(--t-slow), border-color var(--t-slow);
}
&nbsp;
/* NEW */
.sidebar-wrapper--open {
  width: 260px;
}
&nbsp;
.sidebar-wrapper--closed {
  width: 36px;
}
&nbsp;
/* MODIFIED */
.sidebar-toggle {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-left: none;
  border-radius: 0 var(--n-r-sm) var(--n-r-sm) 0;
  color: var(--n-primary);
  font-size: 0.85rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  flex-shrink: 0;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
