.dueDate {
  font-size: 12px;
  color: var(--theme-text-secondary);
  margin: 0;
}

.overdueLine {
  font-size: 12px;
  color: var(--red);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 4px;
}

.rowActions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.priorityBadge {
  background: var(--orange-light);
  color: #f97316;
  font-size: 11px;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: var(--r-full);
}

.initials {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f3f4f6;
  border: 1.5px solid var(--theme-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 600;
  color: var(--theme-text-secondary);
}

/* MOTION: chevron button — bg fade + icon rotation */
.chevronBtn {
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
  color: var(--theme-text-muted);
  display: flex;
  align-items: center;
  border-radius: 4px;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart);
}

.chevronBtn:hover {
  background: var(--theme-surface-2);
  color: var(--theme-text);
}

.chevronBtn:focus-visible {
  outline: 2px solid #f97316;
  outline-offset: 2px;
}

/* MOTION: chevron icon rotates 90° to signal expanded state */
.chevronBtn svg {
  /* will-change: rotate is GPU — declare to avoid repaint flash */
  will-change: transform;
  transition: transform var(--duration-base) var(--ease-out-quart);
}

.chevronBtnExpanded svg {
  transform: rotate(90deg);
}

/* ─── Expanded Content ───────────────────────────────────────────────────── */
/* MOTION: reveal slides down from top edge — translateY + opacity, no height */
.expanded {
  border-top: 1.5px solid var(--theme-border);
  padding: 14px 16px 14px 52px;
  animation: expandIn var(--duration-base) var(--ease-out-quart) both;
}

@keyframes expandIn {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.expandedDesc {
  font-size: 13px;
  color: var(--theme-text-secondary);
  margin: 0 0 12px;
  line-height: 1.6;
}

.expandedMeta {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.metaItem {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12.5px;
  color: var(--theme-text-secondary);
}

/* MOTION: rubric link fades opacity — avoids layout shift from color change */
.viewRubric {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12.5px;
  color: #f97316;
  font-weight: 500;
  cursor: pointer;
  transition: opacity var(--duration-fast) var(--ease-out-quart);
}

.viewRubric:hover {
  opacity: 0.7;
}

.rubricDot {
  width: 10px;
  height: 10px;
  background: #f97316;
  border-radius: 2px;
  display: inline-block;
}

/* MOTION: delete button — scale grows slightly (danger signals intent) */
.deleteSmall {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: 1.5px solid var(--theme-border);
  color: var(--red);
  font-size: 12px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.deleteSmall:hover {
  background: var(--red-light);
  border-color: var(--red);
  transform: scale(1.04);
  /* small grow signals destructive action */
}

/* MOTION: press snaps to slightly smaller — confirms click registered */
.deleteSmall:active {
  transform: scale(0.96);
}

.deleteSmall:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 2px;
}

/* ─── Bulk Action Bar ────────────────────────────────────────────────────── */
/* MOTION: bar slides up from below on mount — translateY only (composited) */
.bulkBar {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--theme-surface);
  border: 1.5px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: var(--theme-card-shadow);
  z-index: 100;
  /* will-change: bar animates via translate → GPU layer */
  will-change: transform, opacity;
  animation: bulkBarIn var(--duration-slow) var(--ease-out-quart) both;
}

@keyframes bulkBarIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.bulkCount {
  font-size: 13px;
  color: var(--theme-text-secondary);
  font-weight: 500;
  padding-right: 6px;
  border-right: 1.5px solid var(--theme-border);
  white-space: nowrap;
}

/* Shared bulk button base — hover lift + press snap */
.bulkComplete {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #f97316;
  color: #fff;
  border: none;
  border-radius: var(--r-full);
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.bulkComplete:hover {
  background: var(--orange-hover);
  transform: translateY(-1px);
}

.bulkComplete:active {
  transform: scale(0.96);
}

.bulkReassign {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 1.5px solid var(--theme-border);
  color: var(--theme-text);
  border-radius: var(--r-full);
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.bulkReassign:hover {
  border-color: var(--theme-text-secondary);
  transform: translateY(-1px);
}

.bulkReassign:active {
  transform: scale(0.96);
}

.bulkDelete {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 1.5px solid var(--theme-border);
  color: var(--red);
  border-radius: var(--r-full);
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.bulkDelete:hover {
  background: var(--red-light);
  border-color: var(--red);
  transform: translateY(-1px);
}

.bulkDelete:active {
  transform: scale(0.96);
}

/* Shared focus ring */
.bulkComplete:focus-visible,
.bulkReassign:focus-visible,
.bulkDelete:focus-visible {
  outline: 2px solid #f97316;
  outline-offset: 3px;
}

/* ─── Modal Overlay ──────────────────────────────────────────────────────── */
/* MOTION: overlay fades in, modal scales up from 96% — both GPU-composited */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 24px;
  animation: overlayFadeIn var(--duration-base) var(--ease-out-quart) both;
}

@keyframes overlayFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* ─── Modal Card ─────────────────────────────────────────────────────────── */
.modal {
  background: var(--theme-surface);
  border-radius: var(--r-lg);
  width: 100%;
  max-width: 580px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--theme-card-shadow);
  overscroll-behavior: contain;
  /* will-change: modal enters via scale+translate → compositor layer */
  will-change: transform, opacity;
  animation: modalIn var(--duration-slow) var(--ease-out-quart) both;
}

/* MOTION: modal scales up from slightly small — depth cue of z-arrival */
@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.94) translateY(12px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modalHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28px 28px 0;
  margin-bottom: 20px;
}

.modalTitle {
  font-size: 19px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0 0 4px;
}

.modalSub {
  font-size: 13px;
  color: var(--theme-text-secondary);
  margin: 0;
}

/* MOTION: close button spins 90° on hover — unmistakable "close" signal */
.closeBtn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--theme-text-muted);
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.closeBtn:hover {
  background: var(--theme-surface-2);
  color: var(--theme-text);
  transform: rotate(90deg);
}

.closeBtn:active {
  transform: rotate(90deg) scale(0.88);
}

.closeBtn:focus-visible {
  outline: 2px solid #f97316;
  outline-offset: 2px;
}

/* ─── Form ───────────────────────────────────────────────────────────────── */
.modalForm {
  padding: 0 28px 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.formRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.formGroup {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--theme-text);
  letter-spacing: 0.2px;
}

/* MOTION: input glow on focus — box-shadow is GPU-composited via the
   compositor's opacity layer. border-color also transitions smoothly. */
.input {
  background: var(--theme-surface);
  border: 1.5px solid var(--theme-border);
  border-radius: var(--r-sm);
  padding: 9px 12px;
  font-size: 13.5px;
  color: var(--theme-text);
  outline: none;
  width: 100%;
  box-sizing: border-box;
  font-family: inherit;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

/* MOTION: orange glow ring on focus — depth cue that field is active */
.input:focus {
  border-color: #f97316;
  box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.14);
}

.input::placeholder {
  color: var(--theme-text-muted);
}

.textarea {
  resize: vertical;
  min-height: 72px;
  line-height: 1.5;
}

/* ─── Priority Radio Pills ───────────────────────────────────────────────── */
.radioGroup {
  display: flex;
  gap: 8px;
}

/* MOTION: pills lift + recolor on hover, spring on select */
.radioPill {
  padding: 7px 18px;
  border-radius: var(--r-full);
  border: 1.5px solid var(--theme-border);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  color: var(--theme-text-secondary);
  background: var(--theme-surface);
  user-select: none;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.radioPill input[type="radio"] {
  display: none;
}

.radioPill:hover {
  border-color: #f97316;
  color: #f97316;
  transform: translateY(-1px);
}

.radioPillActive {
  background: #f97316 !important;
  border-color: #f97316 !important;
  color: #fff !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 2px 10px rgba(249, 115, 22, 0.3);
}

/* ─── Drop Zone ──────────────────────────────────────────────────────────── */
/* MOTION: subtle scale expand on hover — scale only (composited) */
.dropZone {
  border: 2px dashed var(--theme-border);
  border-radius: var(--r-md);
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--theme-text-muted);
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-out-quart);
}

.dropZone:hover {
  border-color: #f97316;
  background: var(--orange-light);
  transform: scale(1.015);
  /* slight expand invites drag */
}

.dropText {
  font-size: 13px;
  margin: 0;
  color: var(--theme-text-secondary);
}

.browseLink {
  color: #f97316;
  font-weight: 600;
  cursor: pointer;
}

/* ─── Notify Toggle Row ──────────────────────────────────────────────────── */
.notifyRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  border-top: 1.5px solid var(--theme-border);
  border-bottom: 1.5px solid var(--theme-border);
}

.notifyLabel {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--theme-text);
  margin: 0 0 2px;
}

.notifySub {
  font-size: 12px;
  color: var(--theme-text-muted);
  margin: 0;
}

/* ─── Toggle Switch ──────────────────────────────────────────────────────── */
.toggle {
  position: relative;
  display: flex;
  align-items: center;
  cursor: pointer;
  flex-shrink: 0;
}

.toggle input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

/* MOTION: track color cross-fades — background transitions via ease-in-out
   which feels like a physical switch snapping through center */
.toggleTrack {
  width: 42px;
  height: 24px;
  background: var(--toggle-track-bg);
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  padding: 2px;
  position: relative;
  transition: background var(--duration-base) var(--ease-in-out);
}

.toggle input:checked ~ .toggleTrack {
  background: #3b82f6;
}

/* MOTION: thumb slides with spring — overshoot simulates physical momentum */
.toggleThumb {
  width: 20px;
  height: 20px;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  /* will-change: thumb animates translateX every toggle */
  will-change: transform;
  transition: transform var(--duration-base) var(--ease-spring);
  position: relative;
}

.toggle input:checked ~ .toggleTrack .toggleThumb {
  transform: translateX(18px);
}

/* ─── Modal Footer ───────────────────────────────────────────────────────── */
.modalFooter {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  padding-top: 4px;
}

.cancelBtn {
  padding: 9px 20px;
  background: none;
  border: 1.5px solid var(--theme-border);
  color: var(--theme-text-secondary);
  border-radius: var(--r-full);
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
}

.cancelBtn:hover {
  border-color: var(--theme-text-secondary);
  color: var(--theme-text);
  transform: translateY(-1px);
}

.cancelBtn:focus-visible {
  outline: 2px solid #f97316;
  outline-offset: 3px;
}

/* MOTION: same lift + press pattern as primary .newBtn */
.saveBtn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 9px 22px;
  background: #f97316;
  border: none;
  border-radius: var(--r-full);
  color: #fff;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(249, 115, 22, 0.3);
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.saveBtn:hover {
  background: var(--orange-hover);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(249, 115, 22, 0.4);
}

.saveBtn:active {
  transform: scale(0.96);
  box-shadow: 0 1px 4px rgba(249, 115, 22, 0.2);
  transition-duration: 80ms;
}

.saveBtn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.saveBtn:focus-visible {
  outline: 2px solid #f97316;
  outline-offset: 3px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   RESPONSIVE — breakpoints
   <768px      → mobile (off-canvas sidebar)
   600-767px   → tablet portrait
   768-1023px  → tablet landscape
   ≥1280px     → large desktop
   ═══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 767px) {
  /* MOTION: sidebar becomes off-canvas drawer, slides in via translate */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 260px;
    transform: translateX(-100%);
    /* will-change already declared above */
    transition: transform var(--duration-slow) var(--ease-out-quart);
    animation: none;
    /* disable page-load animation — replaced by drawer slide */
    box-shadow: none;
    z-index: 300;
  }

  .sidebar.sidebarOpen {
    transform: translateX(0);
    box-shadow: 4px 0 40px rgba(0, 0, 0, 0.3);
  }

  .drawerBackdrop {
    display: block;
  }

  .hamburger {
    display: flex;
  }

  .main {
    padding: 20px 16px 100px;
  }

  .pageTitle {
    font-size: 20px;
    letter-spacing: -0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .newBtn {
    padding: 8px 14px;
    font-size: 13px;
  }

  .filters {
    margin-bottom: 20px;
  }

  .rowMain {
    padding: 12px 12px;
    gap: 8px;
  }

  .rowTitle {
    font-size: 13px;
  }

  .initials {
    display: none;
  }

  /* save horizontal space */
  .expanded {
    padding: 12px;
  }

  .expandedMeta {
    gap: 12px;
  }

  /* MOTION: bulk bar slides up from screen bottom — full-width sheet on mobile */
  .bulkBar {
    bottom: 0;
    left: 0;
    right: 0;
    transform: none;
    border-radius: var(--r-md) var(--r-md) 0 0;
    border-left: none;
    border-right: none;
    border-bottom: none;
    padding: 12px 16px;
    gap: 8px;
    flex-wrap: wrap;
    animation: bulkBarMobile var(--duration-base) var(--ease-out-quart) both;
  }

  @keyframes bulkBarMobile {
    from {
      opacity: 0;
      transform: translateY(100%);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bulkCount {
    flex: 0 0 100%;
    border-right: none;
    border-bottom: 1.5px solid var(--theme-border);
    padding: 0 0 8px;
  }

  .bulkComplete,
  .bulkReassign,
  .bulkDelete {
    flex: 1;
    justify-content: center;
    min-width: 0;
    padding: 8px;
    font-size: 12px;
  }

  /* MOTION: modal becomes bottom sheet — slides up from below */
  .overlay {
    padding: 0;
    align-items: flex-end;
    padding-top: 60px;
  }

  .modal {
    max-width: 100%;
    max-height: calc(100vh - 60px - env(safe-area-inset-bottom, 0px));
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
    animation: sheetUp var(--duration-slow) var(--ease-out-quart) both;
  }

  @keyframes sheetUp {
    from {
      opacity: 0;
      transform: translateY(48px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .modalHeader {
    padding: 20px 20px 0;
  }

  .modalForm {
    padding: 0 20px 20px;
  }

  .formRow {
    grid-template-columns: 1fr;
  }

  /* stack on mobile */
  .radioGroup {
    flex-wrap: wrap;
  }

  .modalFooter {
    flex-direction: column-reverse;
  }

  /* CTA on top */
  .saveBtn,
  .cancelBtn {
    width: 100%;
    justify-content: center;
  }
}

@media (min-width: 600px) and (max-width: 767px) {
  .main {
    padding: 24px 24px 120px;
  }

  .pageTitle {
    font-size: 22px;
  }

  .formRow {
    grid-template-columns: 1fr 1fr;
  }

  /* restore 2-col on wider mobile */
  .initials {
    display: flex;
  }

  .overlay {
    padding: 24px;
    align-items: center;
  }

  .modal {
    max-width: 520px;
    max-height: 90vh;
    border-radius: var(--r-lg);
    animation: modalIn var(--duration-slow) var(--ease-out-quart) both;
  }

  .modalFooter {
    flex-direction: row;
  }

  .saveBtn,
  .cancelBtn {
    width: auto;
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .sidebar {
    width: 180px;
    min-width: 180px;
  }

  .main {
    padding: 28px 28px 120px;
  }

  .pageTitle {
    font-size: 22px;
  }

  .logoName,
  .logoSub {
    display: none;
  }

  /* icon-only sidebar at mid-width */
  .logo {
    justify-content: center;
    padding: 0 12px;
  }

  .navItem {
    gap: 8px;
    font-size: 12.5px;
  }
}

@media (min-width: 1280px) {
  .main {
    padding: 40px 56px 120px;
  }

  .pageTitle {
    font-size: 28px;
  }
}
