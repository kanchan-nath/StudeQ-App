<file path="client/src/pages/styles/Quiz.module.css">
/* Quiz.module.css — CSS Modules, theme via data-theme on <html> */
/* Colors now sourced from global.css --theme-* vars */

/* ─── DURATION SCALE ────────────────────────────────── */
/* Centralised timing tokens — reference these everywhere  */
/* fast=150ms  base=250ms  slow=400ms  slower=600ms        */
.app {
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 400ms;
  --duration-slower: 600ms;

  /* Named easing curves — no bare ease/linear anywhere */
  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  /* overshoot for lift */
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in-quart: cubic-bezier(0.5, 0, 0.75, 0);

  /* ─── LOCAL ALIASES (map Quiz's old internal vars → theme vars) ─ */
  --bg: var(--theme-bg);
  --surface: var(--theme-surface);
  --surface2: var(--theme-surface-2);
  --border: var(--theme-border);
  --text: var(--theme-text);
  --text2: var(--theme-text-secondary);
  --text3: var(--theme-text-muted);
  --accent: var(--theme-purple);
  --accent-light: var(--theme-purple-dim);
  --accent-mid: var(--theme-purple-light);
  --success: var(--theme-green);
  --error: var(--theme-red);
  --radius: 14px;
  --radius-sm: 8px;
  --shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.28);
  --theme-amber: #f59e0b;
  --theme-orange: #f97316;
}

/* ─── BASE ──────────────────────────────────────────── */
.app {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    color var(--duration-slow) var(--ease-in-out);
}

.screen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  /* Whole-screen fade-in on mount */
  animation: screenEnter var(--duration-slow) var(--ease-out-quart) both;
}

/* Screen entrance — opacity only (GPU safe) */
@keyframes screenEnter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* ─── SPLIT LAYOUT ──────────────────────────────────── */
.split {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.splitLeft {
  flex: 1;
  overflow-y: auto;
  padding: 40px 48px;
  min-height: 0;
  scroll-behavior: smooth;
}

.splitRight {
  width: 420px;
  background: var(--surface2);
  border-left: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
  flex-shrink: 0;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  /* Slide in from right on mount */
  animation: panelSlideIn var(--duration-slower) var(--ease-out-quart) both;
}

@keyframes panelSlideIn {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ─── HOME ──────────────────────────────────────────── */

.homeCenter {
  max-width: 600px;
  padding: 80px 32px;
  text-align: center;
  /* Stagger children via nth-child in the sections below */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Icon bounces in with a spring overshoot */
.homeIcon {
  width: 64px;
  height: 64px;
  background: linear-gradient(
    135deg,
    var(--theme-purple),
    var(--theme-purple-light)
  );
  border-radius: 18px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  box-shadow: 0 8px 24px rgba(124, 95, 245, 0.3);
  animation: iconPop var(--duration-slower) var(--ease-spring) both;
  /* Spring lift on hover — transform only */
  transition:
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
}

.homeIcon:hover {
  transform: scale(1.08) rotate(-4deg);
  box-shadow: 0 14px 36px rgba(124, 95, 245, 0.45);
}

@keyframes iconPop {
  from {
    opacity: 0;
    transform: scale(0.6);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.homeH1 {
  font-family: "Lora", serif;
  font-size: 44px;
  line-height: 1.2;
  margin-bottom: 14px;
  color: var(--text);
  /* Delayed stagger after icon */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 80ms both;
}

.homeSub {
  font-size: 17px;
  color: var(--text2);
  margin-bottom: 40px;
  line-height: 1.65;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 160ms both;
}

.homeCards {
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 20px;
}

/* Each card staggers in via nth-child */
.homeCard {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 20px;
  text-align: center;
  cursor: pointer;
  /* Spring lift + border/shadow on hover — transform + opacity only */
  transition:
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-base) var(--ease-out-quart),
    background var(--duration-slow) var(--ease-in-out);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
  will-change: transform;
  /* card lift is frequent enough to hint */
}

/* Stagger entrance: card 1 at 240ms, card 2 at 320ms */
.homeCard:nth-child(1) {
  animation-delay: 240ms;
}

.homeCard:nth-child(2) {
  animation-delay: 320ms;
}

.homeCard:hover {
  border-color: var(--accent-mid);
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

/* Press feedback — quick scale-down on active */
.homeCard:active {
  transform: translateY(-2px) scale(0.98);
  transition-duration: var(--duration-fast);
}

.homeCard h3 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.homeCard p {
  font-size: 13px;
  color: var(--text2);
  margin: 0;
}

/* Card icon spins slightly on card hover via sibling trick */
.homeCardIcon {
  font-size: 32px;
  margin-bottom: 12px;
  display: inline-block;
  transition: transform var(--duration-base) var(--ease-spring);
}

.homeCard:hover .homeCardIcon {
  transform: scale(1.2) rotate(-8deg);
}

.historyBtn {
  width: 100%;
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition:
    background var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-base) var(--ease-out-quart),
    color var(--duration-base) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
  margin-top: 12px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 400ms both;
}

.historyBtn:hover {
  background: var(--surface2);
  border-color: var(--text3);
  transform: translateY(-2px);
}

.historyBtn:active {
  transform: scale(0.97);
}

/* ─── METHOD CARDS ──────────────────────────────────── */
.methodGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 32px;
}

.methodCard {
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 20px;
  background: var(--surface);
  text-align: center;
  cursor: pointer;
  transition:
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-base) var(--ease-out-quart),
    background var(--duration-slow) var(--ease-in-out);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
  will-change: transform;
}

.methodCard:nth-child(1) {
  animation-delay: 80ms;
}

.methodCard:nth-child(2) {
  animation-delay: 160ms;
}

.methodCard:nth-child(3) {
  animation-delay: 240ms;
}

.methodCard:nth-child(4) {
  animation-delay: 320ms;
}

.methodCard:hover {
  border-color: var(--accent-mid);
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.methodCard:active {
  transform: translateY(-1px) scale(0.98);
  transition-duration: var(--duration-fast);
}

/* Selected state pulses border gently */
.methodCard.selected {
  border-color: var(--accent);
  background: var(--accent-light);
  animation: selectedPulse 2s var(--ease-in-out) infinite;
}

@keyframes selectedPulse {
  0%,
  100% {
    box-shadow: 0 0 0 0px rgba(124, 95, 245, 0);
  }

  50% {
    box-shadow: 0 0 0 5px rgba(124, 95, 245, 0.18);
  }
}

.methodCard h3 {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

.methodCard p {
  font-size: 13px;
  color: var(--text2);
  margin: 0;
}

.methodIcon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  margin: 0 auto 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  transition: transform var(--duration-base) var(--ease-spring);
}

.methodCard:hover .methodIcon {
  transform: scale(1.15) rotate(-6deg);
}

/* ─── FORMAT PILLS ──────────────────────────────────── */
.formatPills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.pill {
  border: 1px solid var(--border);
  border-radius: 40px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 500;
  background: var(--surface);
  color: var(--text2);
  cursor: pointer;
  transition:
    background var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-base) var(--ease-out-quart),
    color var(--duration-base) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

.pill:hover {
  border-color: var(--accent-mid);
  color: var(--accent);
  transform: translateY(-2px);
}

.pill:active {
  transform: scale(0.95);
}

/* ─── DROPZONE ──────────────────────────────────────── */
.dropzone {
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  padding: 56px 32px;
  text-align: center;
  cursor: pointer;
  background: var(--surface);
  transition:
    background var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-base) var(--ease-out-quart),
    transform var(--duration-base) var(--ease-spring);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

.dropzone:hover,
.dragover {
  border-color: var(--accent);
  background: var(--accent-light);
  transform: scale(1.015);
  /* subtle inflate signals readiness */
}

/* File landed — icon scales up briefly */
.uploaded {
  border-color: var(--success);
  background: var(--theme-purple-dim);
  animation: uploadPop var(--duration-base) var(--ease-spring) both;
}

@keyframes uploadPop {
  0% {
    transform: scale(0.97);
  }

  60% {
    transform: scale(1.03);
  }

  100% {
    transform: scale(1);
  }
}

.dropIcon {
  font-size: 36px;
  display: block;
  margin-bottom: 12px;
  transition: transform var(--duration-base) var(--ease-spring);
}

.dropzone:hover .dropIcon,
.dragover .dropIcon {
  transform: translateY(-4px) scale(1.1);
}

.dropText {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 6px;
}

.dropSub {
  font-size: 13px;
  color: var(--text3);
  margin: 0;
}

.browseLink {
  color: var(--accent);
  text-decoration: underline;
  transition: opacity var(--duration-fast) var(--ease-out-quart);
}

.browseLink:hover {
  opacity: 0.75;
}

/* ─── FORM ──────────────────────────────────────────── */
.formGroup {
  margin-bottom: 20px;
  /* Each group fades in sequentially via nth-child in parent */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

.formGroup:nth-child(1) {
  animation-delay: 0ms;
}

.formGroup:nth-child(2) {
  animation-delay: 60ms;
}

.formGroup:nth-child(3) {
  animation-delay: 120ms;
}

.formGroup:nth-child(4) {
  animation-delay: 180ms;
}

.formGroup:nth-child(5) {
  animation-delay: 240ms;
}

.formLabel {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 7px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  transition: color var(--duration-fast) var(--ease-out-quart);
}

/* Label brightens when sibling input is focused */
.formGroup:focus-within .formLabel {
  color: var(--accent);
}

.formInput {
  width: 100%;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 11px 14px;
  font-size: 14px;
  color: var(--text);
  background: var(--surface);
  /* Box-shadow glow instead of outline (GPU-safe, doesn't affect layout) */
  transition:
    border-color var(--duration-fast) var(--ease-out-quart),
    box-shadow var(--duration-fast) var(--ease-out-quart),
    background var(--duration-slow) var(--ease-in-out);
  outline: none;
  font-family: "DM Sans", sans-serif;
}

/* Focus glow — inset shadow avoids layout shift */
.formInput:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}

.formTextarea {
  resize: vertical;
  min-height: 120px;
  line-height: 1.6;
}

.charCount {
  font-size: 12px;
  color: var(--text3);
  text-align: right;
  margin-top: 4px;
  transition: color var(--duration-fast) var(--ease-out-quart);
}

.segControl {
  display: flex;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--surface);
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
}

.segBtn {
  flex: 1;
  padding: 10px;
  font-size: 13px;
  font-weight: 500;
  border: none;
  background: none;
  color: var(--text2);
  cursor: pointer;
  transition:
    background var(--duration-base) var(--ease-out-quart),
    color var(--duration-base) var(--ease-out-quart);
}

.segActive {
  background: var(--accent);
  color: var(--theme-text);
}

/* ─── QUESTION TYPES (STEP 3) ───────────────────────── */
.totalBar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  font-size: 14px;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
}

.mutedText {
  font-size: 12px;
  color: var(--text3);
}

.qtypeList {
  display: flex;
  flex-direction: column;
}

.qtypeRow {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-top: none;
  background: var(--surface);
  transition:
    background var(--duration-base) var(--ease-out-quart),
    border-color var(--duration-slow) var(--ease-in-out),
    transform var(--duration-base) var(--ease-spring);
  /* Stagger rows */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

.qtypeRow:nth-child(1) {
  animation-delay: 0ms;
}

.qtypeRow:nth-child(2) {
  animation-delay: 60ms;
}

.qtypeRow:nth-child(3) {
  animation-delay: 120ms;
}

.qtypeRow:nth-child(4) {
  animation-delay: 180ms;
}

.qtypeRow:nth-child(5) {
  animation-delay: 240ms;
}

.qtypeRow:last-child {
  border-radius: 0 0 var(--radius) var(--radius);
}

.qtypeRow:hover {
  background: var(--surface2);
}

.qtypeIcon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-right: 14px;
  flex-shrink: 0;
  transition: transform var(--duration-base) var(--ease-spring);
}

.qtypeRow:hover .qtypeIcon {
  transform: scale(1.12) rotate(-5deg);
}

.qtypeInfo {
  flex: 1;
}

.qtypeName {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}

.qtypeDesc {
  font-size: 12px;
  color: var(--text2);
  margin-top: 2px;
}

/* ─── COUNTER CONTROL ───────────────────────────────── */
.counter {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cntBtn {
  width: 30px;
  height: 30px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--text2);
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
  line-height: 1;
}

.cntBtn:hover {
  background: var(--accent);
  color: var(--theme-text);
  border-color: var(--accent);
}

/* Tactile press feedback */
.cntBtn:active {
  transform: scale(0.88);
}

.cntVal {
  width: 44px;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px;
  font-size: 14px;
  font-weight: 500;
  background: var(--surface);
  color: var(--text);
  outline: none;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-fast) var(--ease-out-quart),
    box-shadow var(--duration-fast) var(--ease-out-quart);
}

.cntVal:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}

/* ─── PREVIEW CARD (STEP 3 RIGHT PANEL) ─────────────── */
.quizPreviewCard {
  background: var(--surface);
  border: 2px solid var(--accent);
  border-radius: 14px;
  padding: 18px;
  width: 200px;
  box-shadow:
    0 0 0 6px var(--accent-light),
    var(--shadow-lg);
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  /* Float the preview card like the loader */
  animation: cardFloat 3s var(--ease-in-out) infinite;
}

.pcHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.pcTitle {
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
}

.pcBadge {
  width: 22px;
  height: 22px;
  background: var(--accent);
  color: var(--theme-text);
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pcLine {
  height: 7px;
  border-radius: 4px;
  background: var(--border);
  margin-bottom: 7px;
  width: 90%;
}

.pcOpt {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px 8px;
  font-size: 11px;
  color: var(--text3);
  margin-bottom: 4px;
}

/* ─── LOADING ───────────────────────────────────────── */
.loadingScreen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  padding: 60px;
  background: var(--bg);
  height: 100%;
  transition: background var(--duration-slow) var(--ease-in-out);
  animation: screenEnter var(--duration-slow) var(--ease-out-quart) both;
}

.loaderCard {
  width: 200px;
  background: var(--surface);
  border-radius: var(--radius);
  border: 2px solid var(--accent);
  padding: 18px;
  box-shadow:
    0 0 0 6px var(--accent-light),
    var(--shadow-lg);
  /* Gentle float — transform only */
  animation: cardFloat 2s var(--ease-in-out) infinite;
  will-change: transform;
  /* continuous animation — worth hinting */
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
}

@keyframes cardFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

.loaderLines {
  margin: 10px 0;
}

.loaderLine {
  height: 7px;
  border-radius: 4px;
  background: var(--border);
  margin-bottom: 7px;
  /* Opacity-only shimmer — GPU safe */
  animation: shimmer 1.5s var(--ease-in-out) infinite;
}

.loaderLine:nth-child(1) {
  width: 80%;
  animation-delay: 0ms;
}

.loaderLine:nth-child(2) {
  width: 60%;
  animation-delay: 200ms;
}

.loaderLine:nth-child(3) {
  width: 70%;
  animation-delay: 400ms;
}

@keyframes shimmer {
  0%,
  100% {
    opacity: 0.35;
  }

  50% {
    opacity: 1;
  }
}

.loaderHeading {
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 200ms both;
}

.loaderStatus {
  font-size: 15px;
  color: var(--text2);
  /* Opacity pulse for "thinking" feel */
  animation: fadeStatus 3s var(--ease-in-out) infinite;
}

@keyframes fadeStatus {
  0%,
  100% {
    opacity: 0.45;
  }

  50% {
    opacity: 1;
  }
}

/* ─── QUIZ SCREEN ───────────────────────────────────── */
.quizScreen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: screenEnter var(--duration-slow) var(--ease-out-quart) both;
}

.quizTopbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0 40px;
  height: 60px;
  display: flex;
  align-items: center;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 50;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  /* Slide down from top */
  animation: topbarIn var(--duration-slow) var(--ease-out-quart) both;
}

@keyframes topbarIn {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.quizTitleBar {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.quizProgress {
  flex: 1;
  height: 6px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
  max-width: 300px;
}

/* Fill animates via width transition set inline from JS — only exception */
.quizProgressFill {
  height: 100%;
  background: var(--accent);
  border-radius: 3px;
  transition: width var(--duration-slow) var(--ease-out-quart);
}

.quizQnum {
  font-size: 13px;
  color: var(--text2);
  white-space: nowrap;
}

.quizTimer {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  color: var(--text2);
  background: var(--surface2);
  padding: 5px 10px;
  border-radius: 20px;
  border: 1px solid var(--border);
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out),
    color var(--duration-base) var(--ease-out-quart);
}

.quizBody {
  max-width: 720px;
  margin: 0 auto;
  padding: 56px 32px;
  width: 100%;
  flex: 1;
  overflow-y: auto;
  scroll-behavior: smooth;
  /* Body content fades up after topbar */
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 120ms both;
}

/* Question text slides in from below on each new question */
.quizQText {
  font-size: 22px;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 32px;
  font-family: "Lora", serif;
  color: var(--text);
  animation: fadeUp var(--duration-base) var(--ease-out-quart) both;
}

.optionList {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Options stagger in after question text */
.optionCard {
  border: 2px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 18px;
  cursor: pointer;
  background: var(--surface);
  font-size: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
  animation: fadeUp var(--duration-base) var(--ease-out-quart) both;
}

.optionCard:nth-child(1) {
  animation-delay: 80ms;
}

.optionCard:nth-child(2) {
  animation-delay: 140ms;
}

.optionCard:nth-child(3) {
  animation-delay: 200ms;
}

.optionCard:nth-child(4) {
  animation-delay: 260ms;
}

.optionCard:hover {
  border-color: var(--accent-mid);
  background: var(--accent-light);
  transform: translateX(4px);
  /* horizontal nudge signals selection intent */
}

.optionCard:active {
  transform: translateX(2px) scale(0.99);
  transition-duration: var(--duration-fast);
}

.optionSelected {
  border-color: var(--accent) !important;
  background: var(--accent-light) !important;
  transform: translateX(4px);
}

.optionLetter {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
  color: var(--text2);
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

/* Letter circle pops when option selected */
.optionLetterActive {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--theme-text);
  transform: scale(1.1);
}

.quizNav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 300ms both;
}

.btnNav {
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 11px 24px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

.btnNav:hover {
  background: var(--surface2);
  transform: translateY(-2px);
}

.btnNav:active {
  transform: scale(0.96);
}

.btnSubmit {
  background: var(--accent);
  color: var(--theme-text);
  border: none;
  padding: 12px 32px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  font-family: "DM Sans", sans-serif;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring),
    box-shadow var(--duration-fast) var(--ease-out-quart);
}

.btnSubmit:hover {
  background: var(--theme-purple-light);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(124, 95, 245, 0.35);
}

.btnSubmit:active {
  transform: scale(0.96);
  box-shadow: none;
}
.quizHeader {
  height: 56px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 8px;
}
.quizHeaderIcon {
  width: 32px;
  height: 32px;
  background: linear-gradient(
    135deg,
    var(--theme-amber, #f59e0b),
    var(--theme-orange, #f97316)
  );
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}
.quizHeaderTitle {
  font-weight: 600;
  font-size: 15px;
  margin-left: 12px;
  color: var(--text);
  flex: 1;
}
.btnAction {
  flex-shrink: 0;
  white-space: nowrap;
  border: 1px solid var(--border);
  background: none;
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text2);
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart);
}

.btnAction:hover {
  background: var(--surface2);
  border-color: var(--text3);
}

.btnPrimary {
  background: none;
  /* border-color: 1px solid var(--border);; */
  color: var(--text2);
  font-weight: 600;
}

.btnPrimary:hover {
  opacity: 0.88;
}

.btnExit {
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: auto;
  border: 1px solid var(--border);
  background: none;
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text2);
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart);
}

.btnExit:hover {
  background: var(--error);
  border-color: transparent;
  color: #fff;
}

@media (max-width: 480px) {
  .quizHeader {
    padding: 0 12px;
    gap: 6px;
  }

  .btnAction,
  .btnExit {
    padding: 5px 10px;
    font-size: 12px;
  }
}

/* ─── RESULTS ───────────────────────────────────────── */
.resultsScreen {
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: screenEnter var(--duration-slow) var(--ease-out-quart) both;
}

/* ─── RESULTS COMPACT STRIP ─────────────────────────── */
/* Single-row header: ring | pct+label | divider | grade | title | stats  */
/* Max height ≈ 56px — gives quiz body maximum real estate                 */
.resultsTop {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 8px 32px;
  /* vertical padding — ring never clips */
  min-height: 72px;
  /* soft floor — fits 56px ring + 8px padding each side */
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
  /* body gets remaining flex space */
  overflow-x: auto;
  /* scroll instead of clip when narrow */
  overflow-y: hidden;
  /* suppress vertical scroll; ring sized to fit */
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  animation: topbarIn var(--duration-slow) var(--ease-out-quart) both;
}

/* Scrollbar visible only when strip overflows (e.g. very narrow viewport) */
.resultsTop::-webkit-scrollbar {
  height: 3px;
}

.resultsTop::-webkit-scrollbar-track {
  background: transparent;
}

.resultsTop::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

/* Ring 56px — enough for "20%" + "Score" without overlap */
.scoreRing {
  position: relative;
  width: 55px;
  height: 55px;
  flex-shrink: 0;
  animation: scoreRingIn var(--duration-slower) var(--ease-out-quart) both;
}

@keyframes scoreRingIn {
  from {
    opacity: 0;
    transform: scale(0.7) rotate(-90deg);
  }

  to {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

.scoreRingText {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Text scaled to 56px ring */
.scorePct {
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  color: var(--text);
  animation: fadeUp var(--duration-base) var(--ease-out-quart) 300ms both;
}

.scoreLabel {
  font-size: 10px;
  color: var(--text3);
  line-height: 1.2;
  margin-top: 1px;
}

/* Title collapses to single line inline, no margin stack */
.scoreInfo {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
  /* allow text truncation */
}

.scoreInfo h2 {
  font-size: 14px;
  font-weight: 600;
  margin: 0;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  animation: fadeUp var(--duration-base) var(--ease-out-quart) 200ms both;
}

/* Grade badge inline, no bottom margin */
.scoreGrade {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  background: var(--accent-light);
  color: var(--accent);
  animation: iconPop var(--duration-base) var(--ease-spring) 350ms both;
}

/* Stats inline, right-aligned, small text */
.scoreStats {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: var(--text2);
  flex-shrink: 0;
  white-space: nowrap;
  animation: fadeUp var(--duration-base) var(--ease-out-quart) 400ms both;
}

/* Thin vertical divider between title block and stats */
.scoreStats::before {
  content: "";
  display: block;
  width: 1px;
  height: 20px;
  background: var(--border);
  align-self: center;
  margin-right: 4px;
}

.resultsBody {
  max-width: 800px;
  margin: 0 auto;
  padding: 32px;
  flex: 1;
  overflow-y: auto;
  width: 100%;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: var(--accent-mid) transparent;
}

.resultsBody::-webkit-scrollbar {
  width: 5px;
}

.resultsBody::-webkit-scrollbar-track {
  background: transparent;
}

.resultsBody::-webkit-scrollbar-thumb {
  background: var(--accent-mid);
  border-radius: 999px;
}

.resultsBody::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

.filterTabs {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 200ms both;
}

.tabBtn {
  border: 1.5px solid var(--border);
  background: var(--surface);
  padding: 7px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  color: var(--text2);
  font-family: "DM Sans", sans-serif;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

.tabBtn:hover {
  transform: translateY(-2px);
}

.tabBtn:active {
  transform: scale(0.95);
}

.tabActive {
  background: var(--accent);
  color: var(--surface);
  border-color: var(--accent);
}

.reviewList {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Review cards stagger in */
.reviewCard {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out),
    transform var(--duration-base) var(--ease-spring),
    box-shadow var(--duration-base) var(--ease-out-quart);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) both;
}

/* Stagger up to 8 cards; additional cards inherit 0ms delay (acceptable) */
.reviewCard:nth-child(1) {
  animation-delay: 0ms;
}

.reviewCard:nth-child(2) {
  animation-delay: 60ms;
}

.reviewCard:nth-child(3) {
  animation-delay: 120ms;
}

.reviewCard:nth-child(4) {
  animation-delay: 180ms;
}

.reviewCard:nth-child(5) {
  animation-delay: 240ms;
}

.reviewCard:nth-child(6) {
  animation-delay: 300ms;
}

.reviewCard:nth-child(7) {
  animation-delay: 360ms;
}

.reviewCard:nth-child(8) {
  animation-delay: 420ms;
}

.reviewCard:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.correctCard {
  border-left: 4px solid var(--success);
}

.wrongCard {
  border-left: 4px solid var(--error);
}

.reviewQ {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 8px;
  color: var(--text);
}

.reviewAns {
  font-size: 13px;
  padding: 6px 10px;
  border-radius: 6px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.userCorrect {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.userWrong {
  background: rgba(239, 68, 68, 0.12);
  color: var(--error);
}

.correctAns {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.resultActions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  padding: 24px 32px;
  border-top: 1px solid var(--border);
  background: var(--surface);
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 500ms both;
}

/* .btnPrimary {
  background: var(--accent);
  color: var(--theme-text);
  border-color: var(--accent);
} */

/* .btnPrimary:hover {
  background: var(--theme-purple-light);
  box-shadow: 0 6px 20px rgba(124, 95, 245, 0.35);
} */

/* ─── RIGHT PANEL ───────────────────────────────────── */
.rpanelInfo {
  text-align: center;
  padding: 0 20px;
  animation: fadeUp var(--duration-slow) var(--ease-out-quart) 200ms both;
}

.rpanelInfo h3 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text);
}

.rpanelInfo p {
  font-size: 13px;
  color: var(--text2);
  line-height: 1.6;
}

/* ─── SHARED ─────────────────────────────────────────── */
.accent {
  color: var(--accent);
}

.errorMsg {
  color: var(--error);
  font-size: 13px;
  margin-bottom: 12px;
  padding: 10px 14px;
  background: rgba(239, 68, 68, 0.1);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(239, 68, 68, 0.25);
  /* Error shakes in — horizontal only (transform) */
  animation: errorShake var(--duration-slow) var(--ease-out-quart) both;
}

@keyframes errorShake {
  0% {
    opacity: 0;
    transform: translateX(-6px);
  }

  40% {
    transform: translateX(4px);
  }

  70% {
    transform: translateX(-2px);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ─── HOME WRAPPER (sidebar layout) ─────────────────── */
.homeWrapper {
  display: flex;
  height: 100%;
  overflow: hidden;
}

.homeScreen {
  flex: 1;
  height: 100%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    flex var(--duration-slow) var(--ease-in-out);
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: var(--accent-mid) var(--bg);
}

.homeScreen::-webkit-scrollbar {
  width: 6px;
}

.homeScreen::-webkit-scrollbar-track {
  background: var(--bg);
}

.homeScreen::-webkit-scrollbar-thumb {
  background: var(--accent-mid);
  border-radius: 999px;
}

.homeScreen::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* ─── HISTORY SIDEBAR ────────────────────────────────── */
.historySidebar {
  position: relative;
  height: 100%;
  background: var(--surface);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: row;
  transition:
    width var(--duration-slow) var(--ease-in-out),
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  flex-shrink: 0;
  overflow: hidden;
}

.sidebarOpen {
  width: 300px;
}

.sidebarClosed {
  width: 36px;
}

.sidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--text2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-slow) var(--ease-in-out),
    transform var(--duration-fast) var(--ease-spring);
}

/* translateY stays in play; we add a micro scale on hover */
.sidebarToggleBtn:hover {
  background: var(--accent-light);
  color: var(--accent);
  transform: translateY(-50%) scaleX(1.12);
}

.sidebarToggleBtn:active {
  transform: translateY(-50%) scaleX(0.95);
}

.sidebarContent {
  padding: 24px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: var(--border) var(--surface2);
}

.sidebarContent::-webkit-scrollbar {
  width: 4px;
}

.sidebarContent::-webkit-scrollbar-track {
  background: var(--surface2);
}

.sidebarContent::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

.sidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--text3);
}

.sidebarTitle {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--text);
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--text3);
  animation: fadeUp var(--duration-base) var(--ease-out-quart) both;
}

/* History items stagger in */
.sidebarItem {
  padding: 12px 14px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 10px;
  cursor: pointer;
  background: var(--surface2);
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    border-color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring),
    box-shadow var(--duration-fast) var(--ease-out-quart);
  animation: fadeUp var(--duration-base) var(--ease-out-quart) both;
}

.sidebarItem:nth-child(1) {
  animation-delay: 0ms;
}

.sidebarItem:nth-child(2) {
  animation-delay: 50ms;
}

.sidebarItem:nth-child(3) {
  animation-delay: 100ms;
}

.sidebarItem:nth-child(4) {
  animation-delay: 150ms;
}

.sidebarItem:nth-child(5) {
  animation-delay: 200ms;
}

.sidebarItem:hover {
  border-color: var(--accent-mid);
  background: var(--accent-light);
  transform: translateX(-3px);
  /* nudge left toward content */
  box-shadow: 4px 0 12px rgba(124, 95, 245, 0.1);
}

.sidebarItemTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 3px;
}

.sidebarItemMeta {
  font-size: 11px;
  color: var(--text3);
}

/* ─── ITEM ROW / THREE-DOT MENU ─────────────────────── */
.sidebarItemRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.sidebarItemText {
  flex: 1;
  overflow: hidden;
}

.sidebarItemMenuWrapper {
  position: relative;
  flex-shrink: 0;
}

.threeDotBtn {
  width: 26px;
  height: 26px;
  border: none;
  background: transparent;
  color: var(--text3);
  font-size: 16px;
  cursor: pointer;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  letter-spacing: -1px;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    color var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

.threeDotBtn:hover {
  background: var(--border);
  color: var(--text);
  transform: scale(1.15);
}

.threeDotBtn:active {
  transform: scale(0.9);
}

/* Dot-menu pops in from top-right */
.dotMenu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  z-index: 50;
  min-width: 110px;
  overflow: hidden;
  transition:
    background var(--duration-slow) var(--ease-in-out),
    border-color var(--duration-slow) var(--ease-in-out);
  /* Scale + fade from origin */
  animation: menuPop var(--duration-fast) var(--ease-spring) both;
  transform-origin: top right;
}

@keyframes menuPop {
  from {
    opacity: 0;
    transform: scale(0.88);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.dotMenuDelete {
  width: 100%;
  padding: 9px 14px;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  color: var(--error);
  cursor: pointer;
  transition:
    background var(--duration-fast) var(--ease-out-quart),
    transform var(--duration-fast) var(--ease-spring);
}

.dotMenuDelete:hover {
  background: rgba(239, 68, 68, 0.1);
  transform: translateX(3px);
  /* small nudge emphasises action */
}

.mobileTopbar {
  display: none;
}

/* ─── MOBILE RESPONSIVE ──────────────────────────────────────── */
@media (max-width: 768px) {
  .homeWrapper {
    flex-direction: column;
    position: relative;
  }

  .homeScreen {
    width: 100%;
    min-height: 100%;
  }

  .mobileTopbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 60;
    transition:
      background var(--duration-slow) var(--ease-in-out),
      border-color var(--duration-slow) var(--ease-in-out);
    animation: topbarIn var(--duration-slow) var(--ease-out-quart) both;
  }

  .mobileTopbar__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }

  .mobileTopbar__btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text2);
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast) var(--ease-out-quart);
  }

  .mobileTopbar__btn:hover,
  .mobileTopbar__btn:active {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.08);
  }

  /* Slide-in drawer — transform only for GPU performance */
  .historySidebar {
    position: fixed !important;
    top: 0;
    right: 0;
    height: 100% !important;
    width: 85vw !important;
    max-width: 320px;
    z-index: 300;
    border-left: 1px solid var(--border);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    /* translateX only — compositor-friendly */
    transition:
      transform var(--duration-slow) var(--ease-in-out),
      background var(--duration-slow) var(--ease-in-out),
      border-color var(--duration-slow) var(--ease-in-out);
    will-change: transform;
    /* drawer animates on user tap — worth hinting */
    flex-direction: column;
  }

  .historySidebar.mobileSidebarOpen {
    transform: translateX(0);
  }

  .sidebarToggleBtn {
    display: none;
  }

  .sidebarContent {
    padding: 24px 16px !important;
    width: 100%;
  }

  .sidebarCloseBtn {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text2);
    font-size: 14px;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-spring);
  }

  /* X button rotates on hover — satisfying close affordance */
  .sidebarCloseBtn:hover {
    background: rgba(239, 68, 68, 0.1);
    color: var(--error);
    border-color: var(--error);
    transform: rotate(90deg);
  }

  /* Backdrop fades in */
  .sidebarOverlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 299;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    animation: overlayIn var(--duration-base) var(--ease-out-quart) both;
  }

  @keyframes overlayIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .splitRight {
    display: none;
  }

  .splitLeft {
    padding: 24px 16px;
  }

  .homeCards,
  .methodGrid {
    grid-template-columns: 1fr;
  }

  .homeH1 {
    font-size: 28px;
  }

  .homeCenter {
    padding: 40px 16px;
  }

  .quizBody {
    padding: 24px 16px;
  }

  .quizTopbar {
    padding: 10px 16px;
    gap: 8px;
    flex-wrap: wrap;
    height: auto;
  }

  .quizTitleBar {
    font-size: 13px;
    flex: 1 1 100%;
    order: -1;
  }

  .quizQText {
    font-size: 18px;
  }

  /* Strip stays horizontal on mobile — tighter padding, no fixed height */
  .resultsTop {
    padding: 6px 16px;
    gap: 10px;
    min-height: 52px;
    overflow-x: auto;
  }

  /* Hide long title on small screens — grade badge + stats sufficient */
  .scoreInfo h2 {
    display: none;
  }

  .scoreStats {
    gap: 10px;
    font-size: 11px;
  }

  .resultsBody {
    padding: 16px;
  }

  .resultActions {
    padding: 16px;
    flex-direction: column;
  }

  .btnAction {
    width: 100%;
    justify-content: center;
  }

  .filterTabs {
    flex-wrap: wrap;
  }
}

/* Safe area (notch / home bar) */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  @media (max-width: 768px) {
    .historySidebar {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
}

/* ─── REDUCED MOTION ────────────────────────────────── */
/* Disable all animations & slow transitions for users who prefer it */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  /* Sidebar drawer still needs to be reachable — keep it visible */
  .historySidebar.mobileSidebarOpen {
    transform: translateX(0) !important;
  }
}
