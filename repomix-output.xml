/// <reference types="vitest/globals" />
import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import {
  render,
  screen,
  waitFor,
  cleanup,
  act,
  within,
} from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import Notes from "../../pages/Notes";
import styles from "/src/pages/styles/notes.module.css";

// ─── Hoisted socket setup ─────────────────────────────────────────────────────
const { socketHandlers, mockSocket, connectSocketMock } = vi.hoisted(() => {
  const socketHandlers = {};
  const connectSocketMock = vi.fn();
  const mockSocket = {
    on: vi.fn((event, cb) => {
      socketHandlers[event] = cb;
    }),
    off: vi.fn(),
  };
  return { socketHandlers, mockSocket, connectSocketMock };
});

// ─── Module mocks ─────────────────────────────────────────────────────────────

vi.mock("react-markdown", () => ({
  default: ({ children }) => <span>{children}</span>,
}));

vi.mock("../../lib/socket.js", () => ({
  connectSocket: connectSocketMock,
  getSocket: vi.fn(() => mockSocket),
}));

// ─── Fixtures ─────────────────────────────────────────────────────────────────

const pinnedNote = {
  _id: "pin-1",
  title: "Pinned Note",
  summary: "Sum A",
  keyPoints: ["KP 1"],
  isPinned: true,
};
const unpinnedNote = {
  _id: "unpin-1",
  title: "Unpinned Note",
  summary: "Sum B",
  keyPoints: ["KP 2"],
  isPinned: false,
};
const aiNote = {
  _id: "ai-1",
  title: "AI Title",
  summary: "AI Summary",
  keyPoints: ["AI KP"],
  isPinned: false,
};

// ─── Helper ───────────────────────────────────────────────────────────────────

async function openSidebar() {
  await userEvent.click(
    screen.getByRole("button", { name: /expand sidebar/i }),
  );
}

afterEach(() => {
  cleanup();
  vi.clearAllMocks();
  vi.clearAllTimers();
  Object.keys(socketHandlers).forEach((k) => delete socketHandlers[k]);
});

describe("Notes — initial render", () => {
