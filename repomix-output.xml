// ─── PHASE CONSTANTS ───────────────────────────────────────────────
const PHASE = {
  HOME: "home",
  STEP1: "step1",
  STEP2A: "step2a", // file upload
  STEP2B: "step2b", // text input
  STEP3: "step3", // question types
  LOADING: "loading",
  QUIZ: "quiz",
  RESULTS: "results",
  HISTORY: "history",
};

// Phase → URL
const PHASE_PATH = {
  [PHASE.HOME]: "/quiz",
  [PHASE.STEP1]: "/quiz/create",
  [PHASE.STEP2A]: "/quiz/upload",
  [PHASE.STEP2B]: "/quiz/text",
  [PHASE.STEP3]: "/quiz/types",
  [PHASE.LOADING]: "/quiz/types", // stays on /types during load
  [PHASE.HISTORY]: "/quiz/history",
};

// URL → Phase (for mount init)
const PATH_PHASE = {
  "/quiz": PHASE.HOME,
  "/quiz/create": PHASE.STEP1,
  "/quiz/upload": PHASE.STEP2A,
  "/quiz/text": PHASE.STEP2B,
  "/quiz/types": PHASE.STEP3,
  "/quiz/history": PHASE.HISTORY,
};

// ─── QUESTION TYPE CONFIG ─────────────────────────────────────────
const QTYPES = [
  {
    id: "multiple-choice",
    name: "Multiple Choice",
    desc: "Select the correct answer from options",
    icon: "📋",
    bg: "#dcfce7",
  },
  {
    id: "true-false",
    name: "True / False",
    desc: "Determine if a statement is true or false",
    icon: "☑️",
    bg: "#ede9fe",
  },
  {
    id: "fill-blank",
    name: "Fill in the Blank",
    desc: "Complete the sentence with the missing word",
    icon: "[ ]",
