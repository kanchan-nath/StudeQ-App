/* ── NAV DROPDOWN SYSTEM — FIXED ─────────────────────────────────────────────
   Fix: invisible pseudo-element bridges the gap between trigger and panel.
   Fix: transition-delay on hide so cursor has time to reach dropdown.
   ──────────────────────────────────────────────────────────────────────────── */

.navItem {
  position: relative;
  list-style: none;
}

.navLink {
  display: flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  padding: 0;
  font-family: inherit;
}

.navChevron {
  font-size: 10px;
  display: inline-block;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  color: var(--theme-text-muted);
}

.hasDropdown:hover .navChevron,
.hasDropdown:focus-within .navChevron {
  transform: rotate(180deg);
}

/* ── DROPDOWN PANEL ──────────────────────────────────────────────────────── */
.navDropdown {
  position: absolute;
  top: calc(100% + 20px);
  left: 50%;
  transform: translateX(-50%) translateY(-10px);

  background: var(--theme-surface);
  border: 1px solid var(--theme-border-hover);
  border-radius: 16px;
  padding: 14px;
  min-width: 340px;
  z-index: 300;

  opacity: 0;
  pointer-events: none;
  visibility: hidden;

  /* Show fast, hide slow — gives cursor time to travel */
  transition:
    opacity 0.18s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.18s cubic-bezier(0.4, 0, 0.2, 1),
    visibility 0s linear 0.18s;   /* delay visibility on hide only */

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.35),
    0 2px 8px rgba(0, 0, 0, 0.2),
    inset 0 0 0 1px var(--theme-border);
}

.hasDropdown:hover .navDropdown,
.hasDropdown:focus-within .navDropdown {
  opacity: 1;
  pointer-events: all;
  visibility: visible;
  transform: translateX(-50%) translateY(0);

  /* On show: no delay */
  transition:
    opacity 0.18s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.18s cubic-bezier(0.4, 0, 0.2, 1),
    visibility 0s linear 0s;
}

:global([data-theme="light"]) .navDropdown {
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.12),
    0 2px 8px rgba(0, 0, 0, 0.06);
}

/* ── HOVER BRIDGE ────────────────────────────────────────────────────────────
   Invisible pseudo-element fills the gap between trigger and dropdown panel.
   Without this, moving the mouse from trigger → dropdown crosses empty space
   and fires mouseleave, collapsing the menu before you reach it.
   ──────────────────────────────────────────────────────────────────────────── */
.hasDropdown::after {
  content: "";
  position: absolute;
  top: 100%;           /* starts right below the trigger */
  left: -20px;
  right: -20px;
  height: 24px;        /* covers the gap (must be >= top offset on .navDropdown) */
  background: transparent;
}

/* ── ARROW CARET ─────────────────────────────────────────────────────────── */
.navDropdownArrow {
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 10px;
  height: 10px;
  background: var(--theme-surface);
  border-left: 1px solid var(--theme-border-hover);
  border-top: 1px solid var(--theme-border-hover);
  border-radius: 2px 0 0 0;
}

/* ── GRID OF ITEMS ───────────────────────────────────────────────────────── */
.navDropdownGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
}

.navDropdownItem {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  cursor: pointer;
  text-decoration: none;
  transition:
    background 0.15s ease,
    border-color 0.15s ease;
  border: 1px solid transparent;
}

.navDropdownItem:hover {
  background: var(--theme-purple-dim);
  border-color: var(--theme-border);
}

.navDropdownIcon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 1px;
  transition: background 0.15s ease;
}

.navDropdownItem:hover .navDropdownIcon {
  background: var(--theme-accent-dim);
  border-color: var(--theme-accent-glow);
}

.navDropdownText {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.navDropdownLabel {
  font-size: 13px;
  font-weight: 600;
  color: var(--theme-text);
  font-family: var(--font-display);
  line-height: 1.2;
}

.navDropdownDesc {
  font-size: 11px;
  color: var(--theme-text-muted);
  line-height: 1.4;
}

/* ── FOOTER CTA ──────────────────────────────────────────────────────────── */
.navDropdownFooter {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--theme-border);
}

.navDropdownFooterLink {
  display: block;
  width: 100%;
  padding: 9px 14px;
  border-radius: 8px;
  background: var(--theme-accent-dim);
  border: 1px solid var(--theme-accent-glow);
  color: var(--theme-accent);
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  font-family: var(--font-display);
  transition:
    background 0.15s ease,
    box-shadow 0.15s ease;
}

.navDropdownFooterLink:hover {
  box-shadow: 0 0 0 1px var(--theme-accent-glow);
}

/* ── RESPONSIVE ──────────────────────────────────────────────────────────── */
@media (max-width: 680px) {
  .hasDropdown .navDropdown {
    display: none;
  }
}
