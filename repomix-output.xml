<file path="client/src/pages/styles/login.module.css">
/* login.module.css — Login page (scoped) */
.auth-toast {
  position: fixed;
  top: 20px;
  right: 20px;
  background: #1a1a1a;
  color: #fff;
  padding: 14px 20px 10px;
  border-radius: 10px;
  min-width: 300px;
  z-index: 9999;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  animation: toast-in 0.3s ease;
}

.auth-toast-text {
  display: block;
  font-size: 0.9rem;
  margin-bottom: 10px;
}

.auth-toast-bar {
  height: 3px;
  background: #22c55e;
  border-radius: 2px;
  animation: slide-bar 6s linear forwards;
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-bar {
  from {
    width: 100%;
  }

  to {
    width: 0%;
  }
}
/* ── ROOT LAYOUT ──────────────────────────────────────────── */
.auth-root {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 100dvh;
}

/* ── LEFT PANEL ───────────────────────────────────────────── */
.auth-left {
  display: flex;
  flex-direction: column;
  background: var(--color-bg-left);
  padding: var(--space-6) var(--space-8);
  position: relative;
  animation: fadeInLeft var(--dur-slow) var(--ease-out) both;
}

.auth-header {
  flex-shrink: 0;
  margin-bottom: var(--space-8);
}

.auth-logo {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  text-decoration: none;
}

.auth-logo-icon {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 1rem;
  line-height: 1;
}

.auth-logo-text {
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-text-heading);
  letter-spacing: -0.02em;
}

.auth-form-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-form-container {
  width: 100%;
  max-width: 26rem;
}

.auth-heading-group {
  margin-bottom: var(--space-8);
  animation: slideUp var(--dur-slow) var(--ease-out) 80ms both;
}

.auth-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 700;
  color: var(--color-text-heading);
  letter-spacing: -0.04em;
  line-height: 1.1;
  margin-bottom: var(--space-2);
}

.auth-subtitle {
  font-size: 0.9375rem;
  color: var(--color-text-muted);
  font-weight: 400;
}

/* Error */
.auth-error {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  background: var(--color-error-bg);
  border: 1px solid var(--color-error-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-5);
  animation: shake 400ms var(--ease-out);
}

.auth-error-icon {
  flex-shrink: 0;
  width: 1.125rem;
  height: 1.125rem;
  border-radius: var(--radius-full);
  background: var(--color-error-text);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  display: grid;
  place-items: center;
  margin-top: 1px;
}

.auth-error-text {
  font-size: 0.875rem;
  color: var(--color-error-text);
  font-weight: 500;
}

/* Form */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  animation: slideUp var(--dur-slow) var(--ease-out) 140ms both;
}

.auth-field-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.auth-label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text-heading);
  letter-spacing: 0.01em;
}

.auth-input-wrapper {
  position: relative;
}

.auth-input-icon {
  position: absolute;
  left: var(--space-4);
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  pointer-events: none;
  transition: color var(--dur-fast);
}

.auth-input {
  width: 100%;
  padding: var(--space-3) var(--space-4) var(--space-3)
    calc(var(--space-4) + 1.25rem + var(--space-3));
  background: var(--color-input-bg);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  color: var(--color-text-body);
  box-shadow: var(--shadow-input);
  outline: none;
  transition:
    border-color var(--dur-fast),
    background var(--dur-fast),
    box-shadow var(--dur-fast);
}

.auth-input::placeholder {
  color: var(--color-text-muted);
  font-weight: 300;
}

.auth-input:hover {
  border-color: #cbd5e1;
}

.auth-input:focus {
  border-color: var(--color-primary);
  background: var(--color-input-focus-bg);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.auth-input-wrapper:focus-within .auth-input-icon {
  color: var(--color-primary);
}

.auth-input--password {
  padding-right: calc(var(--space-4) + 1.5rem + var(--space-2));
}

/* Submit button */
.auth-submit-btn {
  margin-top: var(--space-2);
  width: 100%;
  padding: var(--space-4) var(--space-6);
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 0.01em;
  box-shadow: var(--shadow-btn);
  transition:
    background var(--dur-fast),
    box-shadow var(--dur-fast),
    transform var(--dur-fast);
  position: relative;
  overflow: hidden;
}

.auth-submit-btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.15) 0%,
    transparent 60%
  );
  pointer-events: none;
}

.auth-submit-btn:hover:not(:disabled) {
  background: var(--color-primary-hover);
  box-shadow: var(--shadow-btn-hover);
  transform: translateY(-1px);
}

.auth-submit-btn:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: var(--shadow-btn);
}

.auth-submit-btn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.auth-btn-label,
.auth-btn-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

.auth-btn-arrow {
  transition: transform var(--dur-fast);
}

.auth-submit-btn:hover:not(:disabled) .auth-btn-arrow {
  transform: translateX(3px);
}

.auth-spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 600ms linear infinite;
}

/* Footer */
.auth-form-footer {
  margin-top: var(--space-6);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  animation: slideUp var(--dur-slow) var(--ease-out) 200ms both;
}

.auth-footer-text {
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

.auth-footer-terms {
  margin-bottom: var(--space-2);
}

.auth-link {
  color: var(--color-link);
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid transparent;
  transition: border-color var(--dur-fast);
}

.auth-link:hover {
  border-color: var(--color-link);
}

/* ── SOCIAL BUTTONS ───────────────────────────────────────── */
.auth-social-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  animation: slideUp var(--dur-slow) var(--ease-out) 100ms both;
}

.auth-social-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-left);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text-heading);
  cursor: pointer;
  box-shadow: var(--shadow-input);
  transition:
    border-color var(--dur-fast),
    background var(--dur-fast),
    box-shadow var(--dur-fast),
    transform var(--dur-fast);
}

.auth-social-btn:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transform: translateY(-1px);
}

.auth-social-btn:active {
  transform: translateY(0);
}

/* ── DIVIDER ──────────────────────────────────────────────── */
.auth-divider {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  animation: slideUp var(--dur-slow) var(--ease-out) 110ms both;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--color-border);
}

.auth-divider-text {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* ── EYE TOGGLE ───────────────────────────────────────────── */
.auth-eye-btn {
  position: absolute;
  right: var(--space-4);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-muted);
  padding: var(--space-1);
  border-radius: var(--radius-sm);
  transition: color var(--dur-fast);
}

.auth-eye-btn:hover {
  color: var(--color-text-heading);
}

.auth-eye-btn:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ── RIGHT PANEL ──────────────────────────────────────────── */
.auth-right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    145deg,
    var(--color-right-from) 0%,
    var(--color-right-mid) 50%,
    var(--color-right-to) 100%
  );
  overflow: hidden;
  padding: var(--space-10) var(--space-8);
  animation: fadeInRight var(--dur-slow) var(--ease-out) both;
}

.auth-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.25;
  pointer-events: none;
}

.auth-blob--1 {
  width: 28rem;
  height: 28rem;
  background: #6366f1;
  top: -8rem;
  right: -8rem;
  animation: blobFloat 8s ease-in-out infinite alternate;
}

.auth-blob--2 {
  width: 20rem;
  height: 20rem;
  background: #ec4899;
  bottom: -6rem;
  left: -4rem;
  animation: blobFloat 10s ease-in-out infinite alternate-reverse;
}

.auth-blob--3 {
  width: 14rem;
  height: 14rem;
  background: #0ea5e9;
  top: 40%;
  left: 30%;
  animation: blobFloat 12s ease-in-out infinite alternate;
}

.auth-right-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 28rem;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  animation: slideUp var(--dur-slow) var(--ease-out) 160ms both;
}

.auth-stat-banner {
  background: var(--color-stat-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.auth-stat-number {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  flex-shrink: 0;
  background: linear-gradient(135deg, #fff 0%, #bfdbfe 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.auth-stat-label {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
  font-weight: 400;
}

.auth-showcase-card {
  background: var(--color-glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--color-glass-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
}

.auth-showcase-header {
  margin-bottom: var(--space-5);
}

.auth-showcase-tag {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: var(--space-2);
}

.auth-showcase-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}

.auth-showcase-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

.auth-showcase-item {
  border-radius: var(--radius-md);
  padding: var(--space-4);
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  letter-spacing: -0.01em;
  transition:
    transform var(--dur-fast),
    opacity var(--dur-fast);
  cursor: default;
}

.auth-showcase-item:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

.auth-showcase-item--blue {
  background: rgba(59, 130, 246, 0.5);
}

.auth-showcase-item--purple {
  background: rgba(139, 92, 246, 0.5);
}

.auth-showcase-item--teal {
  background: rgba(20, 184, 166, 0.5);
}

.auth-showcase-item--orange {
  background: rgba(249, 115, 22, 0.5);
}

.auth-tagline {
  text-align: center;
}

.auth-tagline-main {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-3);
}

.auth-tagline-sub {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: var(--space-4);
}

.auth-trust-logos {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-6);
}

.auth-trust-logo {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.55);
  text-transform: uppercase;
  transition: color var(--dur-fast);
}

.auth-trust-logo--lg {
  font-size: 1.25rem;
  letter-spacing: 0.02em;
  color: rgba(255, 255, 255, 0.8);
}

.auth-trust-logo:hover {
  color: #fff;
}

/* ── FOCUS VISIBLE ────────────────────────────────────────── */
.auth-submit-btn:focus-visible,
.auth-input:focus-visible,
.auth-link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ── ANIMATIONS ───────────────────────────────────────────── */
@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }

  20% {
    transform: translateX(-6px);
  }

  40% {
    transform: translateX(6px);
  }

  60% {
    transform: translateX(-4px);
  }

  80% {
    transform: translateX(4px);
  }
}

@keyframes blobFloat {
  from {
    transform: scale(1) translate(0, 0);
  }

  to {
    transform: scale(1.15) translate(20px, -20px);
  }
}

/* ── RESPONSIVE ───────────────────────────────────────────── */
@media (max-width: 1024px) {
  .auth-root {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .auth-right {
    order: -1;
    min-height: 40vh;
    padding: var(--space-8) var(--space-6);
  }

  .auth-right-inner {
    gap: var(--space-4);
  }

  .auth-showcase-card {
    display: none;
  }

  .auth-left {
    padding: var(--space-6);
  }
}

@media (max-width: 640px) {
  .auth-left {
    padding: var(--space-5) var(--space-4);
  }

  .auth-right {
    min-height: 32vh;
    padding: var(--space-6) var(--space-4);
  }

  .auth-stat-banner {
    flex-direction: column;
    text-align: center;
    gap: var(--space-2);
  }

  .auth-stat-number {
    font-size: 1.5rem;
  }

  .auth-trust-logos {
    gap: var(--space-4);
  }

  .auth-blob--1 {
    width: 14rem;
    height: 14rem;
  }

  .auth-blob--2 {
    width: 10rem;
    height: 10rem;
  }

  .auth-blob--3 {
    display: none;
  }
}

@media (min-width: 1440px) {
  .auth-form-container {
    max-width: 28rem;
  }

  .auth-right-inner {
    max-width: 32rem;
  }
}
</file>

<file path="client/src/pages/styles/MissionPage.module.css">
/* ============================================================
   MissionPage.module.css
   Mobile-first · CSS vars from global.css only · No hardcoded colors
   ============================================================ */

/* ── SKIP LINK ─────────────────────────────────────────────── */
.skipLink {
    position: absolute;
    top: -100%;
    left: var(--sp-4);
    z-index: 9999;
    padding: var(--sp-2) var(--sp-4);
    background: var(--theme-purple);
    color: #ffffff;
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    transition: top var(--t-fast);
}

.skipLink:focus {
    top: var(--sp-4);
}

/* ── MAIN ───────────────────────────────────────────────────── */
.main {
    width: 100%;
    background: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-body);
}

/* ── SHARED SECTION INNER ───────────────────────────────────── */
.sectionInner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--sp-4);
}

.sectionEyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--theme-purple-light);
    margin-bottom: var(--sp-3);
}

.sectionTitle {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-4);
}

.sectionSub {
    font-size: 1rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin-bottom: 2.5rem;
}

/* ── HERO ───────────────────────────────────────────────────── */
.hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 5rem var(--sp-4) 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.heroGlow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(ellipse at center, var(--theme-purple-dim) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
}

.heroEyebrow {
    position: relative;
    z-index: 1;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--theme-purple-light);
    margin-bottom: var(--sp-4);
}

.heroTitle {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-5);
    max-width: 820px;
}

.heroAccent {
    color: var(--theme-purple-light);
    position: relative;
}

.heroBody {
    position: relative;
    z-index: 1;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--theme-text-secondary);
    line-height: 1.75;
    max-width: 640px;
    margin-bottom: var(--sp-8);
}

.heroCtas {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
}

/* ── BUTTONS ────────────────────────────────────────────────── */
.btnPrimary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.625rem;
    background: linear-gradient(135deg, var(--theme-purple) 0%, var(--theme-purple-light) 100%);
    color: #ffffff;
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity var(--t-base), transform var(--t-fast);
}

.btnPrimary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
}

.btnPrimary:focus-visible {
    outline: 2px solid var(--theme-purple-light);
    outline-offset: 3px;
}

.btnGhost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.625rem;
    background: transparent;
    color: var(--theme-text-secondary);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--t-base), color var(--t-base), transform var(--t-fast);
}

.btnGhost:hover {
    border-color: var(--theme-border-hover);
    color: var(--theme-text);
    transform: translateY(-1px);
}

.btnGhost:focus-visible {
    outline: 2px solid var(--theme-purple);
    outline-offset: 3px;
}

/* ── STATS BAR ──────────────────────────────────────────────── */
.statsBar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--theme-border);
    border-top: 1px solid var(--theme-border);
    border-bottom: 1px solid var(--theme-border);
}

@media (min-width: 768px) {
    .statsBar {
        grid-template-columns: repeat(4, 1fr);
    }
}

.statItem {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem var(--sp-4);
    background: var(--theme-bg);
    gap: 0.25rem;
}

.statNumber {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--theme-purple-light);
    line-height: 1;
}

.statLabel {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--theme-text);
}

.statSub {
    font-size: 0.75rem;
    color: var(--theme-text-muted);
}

/* ── PROBLEM SECTION ────────────────────────────────────────── */
.problemSection {
    padding: 5rem 0;
}

.problemGrid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .problemGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .problemGrid {
        grid-template-columns: repeat(3, 1fr);
    }
}

.problemCard {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: border-color var(--t-base), transform var(--t-slow);
}

.problemCard:hover {
    border-color: var(--theme-purple);
    transform: translateY(-2px);
}

.problemEmoji {
    font-size: 1.75rem;
    line-height: 1;
}

.problemTitle {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--theme-text-secondary);
    line-height: 1.4;
}

.problemDivider {
    font-size: 1.125rem;
    color: var(--theme-purple-light);
    font-weight: 700;
}

.problemSolution {
    font-size: 0.9375rem;
    color: var(--theme-text);
    line-height: 1.65;
}

/* ── HOW IT WORKS ───────────────────────────────────────────── */
.howSection {
    padding: 5rem 0;
    background: var(--theme-bg-secondary);
    border-top: 1px solid var(--theme-border);
    border-bottom: 1px solid var(--theme-border);
}

.stepList {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    list-style: none;
    counter-reset: none;
}

.stepItem {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
}

.stepNum {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--theme-purple-dim);
    line-height: 1;
    flex-shrink: 0;
    min-width: 2.5rem;
    color: var(--theme-purple);
    opacity: 0.4;
}

.stepContent {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.stepTitle {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--theme-text);
}

.stepBody {
    font-size: 0.9375rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
    max-width: 600px;
}

/* ── VALUES ─────────────────────────────────────────────────── */
.valuesSection {
    padding: 5rem 0;
}

.valuesGrid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .valuesGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .valuesGrid {
        grid-template-columns: repeat(4, 1fr);
    }
}

.valueCard {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.valueIcon {
    font-size: 1.5rem;
    line-height: 1;
}

.valueTitle {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text);
}

.valueBody {
    font-size: 0.875rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
}

/* ── TRUST SECTION ──────────────────────────────────────────── */
.trustSection {
    padding: 5rem 0;
    background: var(--theme-bg-secondary);
    border-top: 1px solid var(--theme-border);
    border-bottom: 1px solid var(--theme-border);
}

.trustGrid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .trustGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

.trustBlock {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.trustBlockTitle {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text);
}

.trustBlockBody {
    font-size: 0.9375rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
}

/* ── ROADMAP ────────────────────────────────────────────────── */
.roadmapSection {
    padding: 5rem 0;
}

.roadmapGrid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .roadmapGrid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .roadmapGrid {
        grid-template-columns: repeat(4, 1fr);
    }
}

.roadmapCard {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-xl);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top-width: 3px;
}

.road_purple {
    border-top-color: var(--theme-purple);
}

.road_teal {
    border-top-color: var(--clr-teal);
}

.road_accent {
    border-top-color: var(--theme-accent);
}

.road_pink {
    border-top-color: var(--clr-pink);
}

.roadmapPhase {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
}

.roadmapTitle {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text);
}

.roadmapList {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
}

.roadmapItem {
    font-size: 0.875rem;
    color: var(--theme-text-secondary);
    line-height: 1.5;
    display: flex;
    gap: 0.375rem;
}

/* ── SUBJECTS ───────────────────────────────────────────────── */
.subjectsSection {
    padding: 5rem 0;
    background: var(--theme-bg-secondary);
    border-top: 1px solid var(--theme-border);
    border-bottom: 1px solid var(--theme-border);
}

.subjectsPills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
}

.subjectPill {
    display: inline-flex;
    padding: 0.4375rem 1rem;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
    font-size: 0.875rem;
    color: var(--theme-text-secondary);
    transition: border-color var(--t-fast), color var(--t-fast);
}

.subjectPill:hover {
    border-color: var(--theme-purple);
    color: var(--theme-purple-light);
}

/* ── FAQ ────────────────────────────────────────────────────── */
.faqSection {
    padding: 5rem 0;
}

.faqList {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 780px;
}

.faqItem {
    border-bottom: 1px solid var(--theme-border);
    padding: 1.5rem 0;
}

.faqQ {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text);
    margin-bottom: 0.625rem;
}

.faqA {
    font-size: 0.9375rem;
    color: var(--theme-text-secondary);
    line-height: 1.75;
}

/* ── CTA FOOTER ─────────────────────────────────────────────── */
.ctaSection {
    position: relative;
    overflow: hidden;
    padding: 6rem var(--sp-4);
    text-align: center;
    border-top: 1px solid var(--theme-border);
}

.ctaGlow {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(ellipse at center, var(--theme-purple-dim) 0%, transparent 70%);
    pointer-events: none;
}

.ctaInner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-5);
}

.ctaTitle {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--theme-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.ctaBody {
    font-size: 1rem;
    color: var(--theme-text-secondary);
    line-height: 1.7;
}

.ctaBtns {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
}

/* ── REDUCED MOTION ─────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {

    .btnPrimary,
    .btnGhost,
    .problemCard,
    .subjectPill {
        transition: none !important;
        transform: none !important;
    }
}
</file>

<file path="client/src/pages/styles/Notebook.module.css">
/* ═══════════════════════════════════════════════════════════════════
   Notebook.module.css — Motion Refactor
   Theming via global.css --theme-* tokens only.
   Local --n-* tokens bridge gaps; defined on :root per theme.
   ═══════════════════════════════════════════════════════════════════ */

:root {
  --n-bg: var(--theme-bg);
  --n-surface: var(--theme-surface);
  --n-input-bg: var(--theme-input-bg);
  --n-border: var(--theme-border);
  --n-text: var(--theme-text);
  --n-text-muted: var(--theme-text-secondary);
  --n-text-faint: var(--theme-text-muted);
  --n-accent: var(--theme-purple);
  --n-accent-hover: var(--theme-purple-light);
  --n-accent-glow: var(--theme-purple-dim);
  --n-bubble-user-bg: var(--theme-purple);
  --n-bubble-user-fg: #ffffff;
  --n-bubble-ai-bg: var(--theme-surface-2);
  --n-bubble-ai-fg: var(--theme-text);
  --n-sidebar-bg: var(--theme-surface);
  --n-sidebar-active: var(--theme-purple-dim);
  --n-sidebar-hover: var(--theme-surface-2);
  --n-toast-ok-bg: #e6f9f0;
  --n-toast-ok-fg: #1a7a4a;
  --n-toast-err-bg: #fdecea;
  --n-toast-err-fg: #b0190e;
  --n-shadow-sm: var(--shadow-sm);
  --n-shadow-md: var(--shadow-md);
  --n-shadow-lg: 0 8px 40px rgba(30, 32, 60, 0.14);
  --n-radius: 14px;
  --n-radius-sm: 8px;
  --n-radius-pill: 999px;
  --n-font-display: "DM Serif Display", "Georgia", serif;
  --n-sidebar-w: 260px;

  /* ── Duration scale ──────────────────────────────────────────── */
  --n-duration-fast: 150ms;
  /* micro: hover color, opacity flicks   */
  --n-duration-base: 250ms;
  /* default interactive: buttons, inputs  */
  --n-duration-slow: 400ms;
  /* entrances, sidebar slide              */
  --n-duration-slower: 600ms;
  /* page-level, stagger parents           */

  /* ── Easing library ──────────────────────────────────────────── */
  --n-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  /* overshoot-free decelerate */
  --n-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  /* playful spring pop        */
  --n-ease-in: cubic-bezier(0.55, 0, 1, 0.45);
  /* accelerate into dismiss   */
  --n-ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  /* material-style standard   */

  /* Legacy alias kept for one-liner properties */
  --n-transition: var(--n-duration-base) var(--n-ease-smooth);
}

[data-theme="dark"] {
  --n-bg: var(--theme-bg);
  --n-surface: var(--theme-surface);
  --n-input-bg: var(--theme-input-bg);
  --n-border: var(--theme-border);
  --n-text: var(--theme-text);
  --n-text-muted: var(--theme-text-secondary);
  --n-text-faint: var(--theme-text-muted);
  --n-accent: var(--theme-purple-light);
  --n-accent-hover: #9195ff;
  --n-accent-glow: var(--theme-purple-dim);
  --n-bubble-user-bg: var(--theme-purple-light);
  --n-bubble-user-fg: #ffffff;
  --n-bubble-ai-bg: var(--theme-surface-2);
  --n-bubble-ai-fg: var(--theme-text);
  --n-sidebar-bg: var(--theme-bg-secondary);
  --n-sidebar-active: var(--theme-purple-dim);
  --n-sidebar-hover: var(--theme-surface);
  --n-toast-ok-bg: #0d2a1e;
  --n-toast-ok-fg: #4ade80;
  --n-toast-err-bg: #2a0f0c;
  --n-toast-err-fg: #f87171;
  --n-shadow-sm: 0 1px 4px rgba(0, 0, 0, 0.3);
  --n-shadow-md: 0 4px 20px rgba(0, 0, 0, 0.4);
  --n-shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.55);
}

/* ── Accessibility: kill all motion for prefers-reduced-motion ── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    transition-duration: 1ms !important;
    transition-delay: 0ms !important;
  }
}

/* ══════════════════════════════════════════════════════════════════
   KEYFRAMES
══════════════════════════════════════════════════════════════════ */

/* Page-level fade+lift entrance — used on uploadPage, chatroom shells */
@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Card/item stagger entrance — shorter travel for subtlety */
@keyframes itemEnter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Sidebar slide-in from right */
@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Message bubble pop-in */
@keyframes msgFadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Floating upload icon */
@keyframes floatUp {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }
}

/* Morph blob loader */
@keyframes morphBlob {
  0% {
    border-radius: 50%;
    transform: scale(1);
    box-shadow: 0 0 0 0 var(--n-accent-glow);
  }

  30% {
    border-radius: 40% 60% 60% 40% / 50% 40% 60% 50%;
    transform: scale(1.08);
  }

  60% {
    border-radius: 60% 40% 40% 60% / 40% 60% 50% 40%;
    transform: scale(0.96);
    box-shadow: 0 0 0 14px transparent;
  }

  100% {
    border-radius: 50%;
    transform: scale(1);
    box-shadow: 0 0 0 0 var(--n-accent-glow);
  }
}

/* Text pulse for loader label */
@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}

/* Live dot pulse on chat header */
@keyframes dotPulse {
  0%,
  100% {
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  }

  50% {
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1);
  }
}

/* Dot bounce for "thinking" indicator */
@keyframes dotBounce {
  0%,
  80%,
  100% {
    transform: translateY(0) scale(1);
    opacity: 0.5;
  }

  40% {
    transform: translateY(-7px) scale(1.1);
    opacity: 1;
  }
}

/* Context-menu spring pop */
@keyframes menuPop {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(-4px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* Toast slide in/out */
@keyframes toastSlideIn {
  from {
    transform: translateX(110%);
    opacity: 0;
  }

  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes toastSlideOut {
  from {
    transform: translateX(0);
    opacity: 1;
  }

  to {
    transform: translateX(110%);
    opacity: 0;
  }
}

/* Mobile backdrop fade */
@keyframes fadeInOverlay {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* ══════════════════════════════════════════════════════════════════
   Root shell
══════════════════════════════════════════════════════════════════ */
.root {
  height: 100%;
  overflow: hidden;
  background: var(--n-bg);
  color: var(--n-text);
  font-family: var(--font-body);
  position: relative;
  display: flex;
  flex-direction: row;
  /* Theme swap fades rather than jumps */
  transition:
    background var(--n-duration-slow) var(--n-ease-smooth),
    color var(--n-duration-slow) var(--n-ease-smooth);
}

.appShell {
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ── Theme toggle ──────────────────────────────────────────────── */
.themeToggle {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 200;
  width: 40px;
  height: 40px;
  border-radius: var(--n-radius-pill);
  border: 1px solid var(--n-border);
  background: var(--n-surface);
  box-shadow: var(--n-shadow-sm);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  /* GPU: transform + box-shadow only */
  transition:
    transform var(--n-duration-base) var(--n-ease-spring),
    box-shadow var(--n-duration-base) var(--n-ease-smooth),
    border-color var(--n-duration-fast) var(--n-ease-smooth),
    background var(--n-duration-fast) var(--n-ease-smooth);
}

.themeToggle:hover {
  transform: scale(1.1) rotate(20deg);
  /* icon spin hints at theme flip */
  box-shadow: var(--n-shadow-md);
}

.themeToggle:active {
  transform: scale(0.94) rotate(0deg);
  /* press-down micro-interaction */
  transition-duration: var(--n-duration-fast);
}

/* ══════════════════════════════════════════════════════════════════
   RIGHT SIDEBAR
══════════════════════════════════════════════════════════════════ */
.rightSidebar {
  height: 100%;
  background: var(--n-surface);
  border-left: 1px solid var(--n-border);
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  overflow: hidden;
  /* Width change → slide feel; avoid animating width directly but
     sidebar uses overflow:hidden so content clips cleanly */
  transition:
    width var(--n-duration-slow) var(--n-ease-smooth),
    background var(--n-duration-base) var(--n-ease-smooth);
  position: relative;
}

.rightSidebarOpen {
  width: 280px;
}

.rightSidebarClosed {
  width: 36px;
}

/* Sidebar content entrance: slides in from right when panel opens */
.rightSidebarOpen .rightSidebarContent {
  animation: slideInRight var(--n-duration-slow) var(--n-ease-out) both;
}

.rightSidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--n-input-bg);
  border: 1px solid var(--n-border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--n-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  /* Animate colour + icon nudge — not position */
  transition:
    background var(--n-duration-fast) var(--n-ease-smooth),
    color var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
  /* already has translateY(-50%) */
}

.rightSidebarToggleBtn:hover {
  background: var(--n-accent-glow);
  color: var(--n-accent);
  /* Subtle horizontal nudge draws eye to expand affordance */
  transform: translateY(-50%) translateX(2px);
}

.rightSidebarToggleBtn:active {
  transform: translateY(-50%) translateX(0px);
  transition-duration: var(--n-duration-fast);
}

.rightSidebarContent {
  padding: 24px 12px 24px 44px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--n-border) transparent;
}

.rightSidebarContent::-webkit-scrollbar {
  width: 4px;
}

.rightSidebarContent::-webkit-scrollbar-track {
  background: transparent;
}

.rightSidebarContent::-webkit-scrollbar-thumb {
  background: var(--n-border);
  border-radius: 999px;
}

.rightSidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--n-text-faint);
}

.rightSidebarTitle {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 14px;
  color: var(--n-text);
  letter-spacing: 0.01em;
  /* Entrance: title fades in slightly after content panel */
  animation: itemEnter var(--n-duration-base) var(--n-ease-out) 80ms both;
}

/* ══════════════════════════════════════════════════════════════════
   HISTORY CARD LIST
══════════════════════════════════════════════════════════════════ */
.sidebarList {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow-y: auto;
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--n-text-faint);
  padding: 12px 4px;
  text-align: center;
  animation: itemEnter var(--n-duration-base) var(--n-ease-out) both;
}

/* Stagger: each card delays by its DOM order via nth-child.
   CSS-only stagger up to 8 cards; beyond that they share last delay. */
.sidebarList > li:nth-child(1) {
  animation-delay: 60ms;
}

.sidebarList > li:nth-child(2) {
  animation-delay: 110ms;
}

.sidebarList > li:nth-child(3) {
  animation-delay: 160ms;
}

.sidebarList > li:nth-child(4) {
  animation-delay: 210ms;
}

.sidebarList > li:nth-child(5) {
  animation-delay: 260ms;
}

.sidebarList > li:nth-child(6) {
  animation-delay: 310ms;
}

.sidebarList > li:nth-child(7) {
  animation-delay: 360ms;
}

.sidebarList > li:nth-child(n + 8) {
  animation-delay: 400ms;
}

/* Card */
.historyCard {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 6px;
  padding: 12px 12px 12px 14px;
  border-radius: var(--r-md, 12px);
  background: var(--theme-surface-2);
  border: 1.5px solid transparent;
  cursor: pointer;
  position: relative;
  /* Stagger parent drives the entrance; card handles its own hovers */
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) both;
  transition:
    background var(--n-duration-fast) var(--n-ease-smooth),
    border-color var(--n-duration-fast) var(--n-ease-smooth),
    box-shadow var(--n-duration-base) var(--n-ease-smooth),
    transform var(--n-duration-base) var(--n-ease-spring);
  /* lift uses spring */
}

.historyCard:hover {
  background: var(--theme-surface-2);
  border-color: var(--n-border);
  box-shadow: var(--theme-card-shadow);
  transform: translateY(-2px);
  /* lift: GPU transform only */
}

.historyCard:active {
  transform: translateY(0px) scale(0.98);
  /* press-down */
  transition-duration: var(--n-duration-fast);
}

/* Active — layered border glow */
.historyCardActive {
  background: var(--n-accent-glow) !important;
  border-color: var(--n-accent) !important;
  box-shadow:
    0 0 0 3px var(--n-accent-glow),
    0 2px 12px var(--n-accent-glow),
    var(--n-shadow-sm) !important;
  transform: translateY(-1px);
}

.historyCardActive::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1.5px solid var(--n-accent);
  opacity: 0.4;
  pointer-events: none;
}

.historyCardBody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.historyCardTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--n-text);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-transform: capitalize;
  margin: 0;
  transition: color var(--n-duration-fast) var(--n-ease-smooth);
}

.historyCardActive .historyCardTitle {
  color: var(--n-accent);
}

.historyCardMeta {
  font-size: 11px;
  color: var(--n-text-faint);
  white-space: nowrap;
  transition: color var(--n-duration-fast) var(--n-ease-smooth);
}

.historyCardActive .historyCardMeta {
  color: var(--n-text-muted);
}

/* Three-dot menu */
.historyCardMenu {
  position: relative;
  flex-shrink: 0;
  align-self: flex-start;
}

.historyDots {
  background: none;
  border: none;
  font-size: 15px;
  color: var(--n-text-faint);
  cursor: pointer;
  padding: 2px 4px;
  border-radius: 4px;
  opacity: 0;
  line-height: 1;
  transition:
    opacity var(--n-duration-fast) var(--n-ease-smooth),
    background var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.historyCard:hover .historyDots,
.historyCardActive .historyDots {
  opacity: 1;
}

.historyDots:hover {
  background: var(--n-border);
  color: var(--n-text);
  transform: scale(1.15);
  /* subtle enlarge on hover */
}

.historyDots:active {
  transform: scale(0.9);
  transition-duration: var(--n-duration-fast);
}

/* Shared dropdown */
.sidebarMenu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 50;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-sm);
  box-shadow: var(--n-shadow-md);
  padding: 4px;
  min-width: 110px;
  /* Spring pop for delight */
  animation: menuPop var(--n-duration-base) var(--n-ease-spring) both;
  transform-origin: top right;
}

.sidebarMenuDelete {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 7px 12px;
  background: none;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  color: var(--n-toast-err-fg);
  cursor: pointer;
  white-space: nowrap;
  transition:
    background var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.sidebarMenuDelete:hover {
  background: var(--n-toast-err-bg);
  transform: translateX(2px);
  /* micro slide hint */
}

/* ══════════════════════════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════════════════════════ */
.toastStack {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.toast {
  pointer-events: all;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: var(--n-radius-sm);
  font-size: 14px;
  font-weight: 500;
  box-shadow: var(--n-shadow-md);
  max-width: 340px;
  animation-duration: var(--n-duration-slow);
  animation-fill-mode: both;
}

.toastEnter {
  animation-name: toastSlideIn;
  animation-timing-function: var(--n-ease-spring);
  /* spring = satisfying arrival */
}

.toastExit {
  animation-name: toastSlideOut;
  animation-timing-function: var(--n-ease-in);
  /* accelerate = quick dismiss */
  animation-duration: var(--n-duration-base);
  /* exits faster than entrances */
}

.toast_success {
  background: var(--n-toast-ok-bg);
  color: var(--n-toast-ok-fg);
  border-left: 3px solid currentColor;
}

.toast_error {
  background: var(--n-toast-err-bg);
  color: var(--n-toast-err-fg);
  border-left: 3px solid currentColor;
}

.toastIcon {
  font-size: 16px;
  flex-shrink: 0;
}

.toastMsg {
  flex: 1;
}

.toastClose {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
  color: inherit;
  opacity: 0.6;
  line-height: 1;
  padding: 0;
  transition:
    opacity var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.toastClose:hover {
  opacity: 1;
  transform: scale(1.2) rotate(90deg);
  /* × button rotates on hover */
}

/* ══════════════════════════════════════════════════════════════════
   VIEW 1 — UPLOAD PAGE
══════════════════════════════════════════════════════════════════ */
.uploadPage {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 24px 60px;
  gap: 32px;
  /* Whole page fades+lifts in */
  animation: pageEnter var(--n-duration-slower) var(--n-ease-out) both;
}

.uploadHeader {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  /* Header lands slightly after page shell */
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 80ms both;
}

.logoMark {
  margin-bottom: 8px;
  filter: drop-shadow(0 4px 12px var(--n-accent-glow));
  /* Logo scales up from nothing for a focal entrance */
  animation: itemEnter var(--n-duration-slow) var(--n-ease-spring) 40ms both;
}

.uploadTitle {
  font-family: var(--n-font-display);
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 400;
  line-height: 1.2;
  color: var(--n-text);
  margin: 0;
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 120ms both;
}

.uploadTitle em {
  font-style: italic;
  color: var(--n-accent);
}

.uploadSubtitle {
  font-size: 1rem;
  color: var(--n-text-muted);
  max-width: 480px;
  margin: 0;
  line-height: 1.6;
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 180ms both;
}

.formatGrid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
  justify-content: center;
  max-width: 520px;
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 240ms both;
}

.formatChip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: var(--n-radius-pill);
  border: 1px solid var(--n-border);
  background: var(--n-surface);
  font-size: 13px;
  font-weight: 500;
  color: var(--n-text-muted);
  box-shadow: var(--n-shadow-sm);
  transition:
    border-color var(--n-duration-fast) var(--n-ease-smooth),
    color var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-base) var(--n-ease-spring),
    box-shadow var(--n-duration-base) var(--n-ease-smooth);
}

.formatChip:hover {
  border-color: var(--n-accent);
  color: var(--n-accent);
  transform: translateY(-2px);
  box-shadow: var(--n-shadow-md);
}

.dropZone {
  width: 100%;
  max-width: 540px;
  min-height: 200px;
  border: 2px dashed var(--n-border);
  border-radius: var(--n-radius);
  background: var(--n-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: var(--n-shadow-sm);
  position: relative;
  /* entrance after chips */
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 300ms both;
  transition:
    border-color var(--n-duration-base) var(--n-ease-smooth),
    background var(--n-duration-base) var(--n-ease-smooth),
    box-shadow var(--n-duration-base) var(--n-ease-smooth),
    transform var(--n-duration-base) var(--n-ease-spring);
  /* slight lift on drag-over */
}

.dropZone:hover,
.dropZoneActive {
  border-color: var(--n-accent);
  background: var(--n-accent-glow);
  box-shadow:
    0 0 0 4px var(--n-accent-glow),
    var(--n-shadow-md);
  transform: scale(1.012);
  /* subtle grow confirms drag target */
}

.dropZoneHasFile {
  border-style: solid;
  border-color: var(--n-accent);
}

.hiddenInput {
  display: none;
}

.dropHint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
  padding: 32px;
  color: var(--n-text-muted);
}

.dropIcon {
  font-size: 2.2rem;
  display: block;
  margin-bottom: 4px;
  animation: floatUp 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  /* smooth sinusoidal float */
}

.dropHint p {
  margin: 0;
  font-size: 14px;
  line-height: 1.5;
}

.dropMeta {
  font-size: 12px !important;
  color: var(--n-text-faint) !important;
}

.filePreview {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px;
  animation: itemEnter var(--n-duration-base) var(--n-ease-spring) both;
  /* spring = file popped in */
}

.fileIcon {
  font-size: 1.6rem;
}

.fileName {
  font-size: 14px;
  font-weight: 600;
  color: var(--n-text);
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fileRemove {
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  color: var(--n-text-muted);
  line-height: 1;
  padding: 0;
  transition:
    color var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.fileRemove:hover {
  color: var(--n-toast-err-fg);
  transform: scale(1.2) rotate(10deg);
  /* × grows + tilts */
}

.fileRemove:active {
  transform: scale(0.9) rotate(0deg);
}

.uploadLoader {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 8px 0;
}

.morphBlob {
  width: 52px;
  height: 52px;
  background: var(--n-accent);
  border-radius: 50%;
  animation: morphBlob 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  box-shadow: 0 0 0 0 var(--n-accent-glow);
  /* will-change justified: morphBlob runs indefinitely on a visible loader */
  will-change: border-radius, transform;
}

.uploadLoaderText {
  font-size: 14px;
  color: var(--n-text-muted);
  margin: 0;
  animation: pulse 1.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

.submitBtn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  border-radius: var(--n-radius-pill);
  border: none;
  background: var(--n-border);
  color: var(--n-text-faint);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  cursor: not-allowed;
  animation: itemEnter var(--n-duration-slow) var(--n-ease-out) 360ms both;
  transition:
    background var(--n-duration-base) var(--n-ease-smooth),
    color var(--n-duration-base) var(--n-ease-smooth),
    box-shadow var(--n-duration-base) var(--n-ease-smooth),
    transform var(--n-duration-base) var(--n-ease-spring);
}

.submitBtnActive {
  background: var(--n-accent);
  color: #fff;
  cursor: pointer;
  box-shadow: 0 4px 20px var(--n-accent-glow);
}

.submitBtnActive:hover {
  background: var(--n-accent-hover);
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 8px 28px var(--n-accent-glow);
}

.submitBtnActive:active {
  transform: translateY(0) scale(0.97);
  /* press-down feedback */
  transition-duration: var(--n-duration-fast);
}

/* ══════════════════════════════════════════════════════════════════
   VIEW 2 — CHATROOM
══════════════════════════════════════════════════════════════════ */
.chatroomShell {
  display: flex;
  height: 100%;
  overflow: hidden;
  /* Chatroom view transitions in from upload page */
  animation: pageEnter var(--n-duration-slow) var(--n-ease-out) both;
}

.chatroomMain {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--n-bg);
  min-width: 0;
  min-height: 0;
}

.chatHeader {
  padding: 18px 28px;
  border-bottom: 1px solid var(--n-border);
  background: var(--n-surface);
  flex-shrink: 0;
  box-shadow: var(--n-shadow-sm);
}

.chatHeaderInner {
  display: flex;
  align-items: center;
  gap: 10px;
}

.chatHeaderDot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  flex-shrink: 0;
  /* Continuous ambient pulse signals live connection */
  animation: dotPulse 2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

.chatTitle {
  font-family: var(--n-font-display);
  font-size: 1.1rem;
  font-weight: 400;
  text-transform: capitalize;
  margin: 0;
  color: var(--n-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.messagesArea {
  flex: 1;
  overflow-y: auto;
  padding: 28px 28px 8px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  scroll-behavior: smooth;
  min-height: 0;
}

/* Message row entrance */
.messageRow {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  animation: msgFadeUp var(--n-duration-base) var(--n-ease-out) both;
}

.messageRowUser {
  flex-direction: row-reverse;
}

.messageRowAI {
  flex-direction: row;
}

.aiAvatar,
.userAvatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.aiAvatar {
  background: var(--n-accent);
  color: #fff;
  letter-spacing: 0.02em;
}

.userAvatar {
  background: var(--n-input-bg);
  color: var(--n-text-muted);
}

.messageBubble {
  max-width: min(520px, 72%);
  padding: 12px 16px;
  border-radius: 16px;
  position: relative;
  box-shadow: var(--n-shadow-sm);
  transition:
    box-shadow var(--n-duration-base) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.messageBubble:hover {
  transform: translateY(-1px);
  /* subtle lift on hover reveals editability */
}

.bubbleUser {
  background: var(--n-bubble-user-bg);
  color: var(--n-bubble-user-fg);
  border-bottom-right-radius: 4px;
}

.bubbleAI {
  background: transparent;
  color: var(--n-bubble-ai-fg);
  border-bottom-left-radius: 4px;
  box-shadow: none;
  max-width: 100%;
  padding: 4px 0;
}

/* ── AI content rich formatting ─────────────────────────────── */
.aiContent {
  font-size: 15px;
  line-height: 1.75;
  color: var(--n-text);
}

.aiContent p {
  margin: 0 0 12px;
}

.aiContent p:last-child {
  margin-bottom: 0;
}

.aiContent h1,
.aiContent h2,
.aiContent h3 {
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--n-text);
  margin: 20px 0 8px;
  line-height: 1.35;
}

.aiContent h1 {
  font-size: 1.2rem;
}

.aiContent h2 {
  font-size: 1.08rem;
}

.aiContent h3 {
  font-size: 0.98rem;
  color: var(--n-accent);
}

.aiContent ul,
.aiContent ol {
  padding-left: 1.5em;
  margin: 8px 0 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.aiContent li {
  font-size: 15px;
  line-height: 1.7;
}

.aiContent code {
  background: var(--n-accent-glow);
  color: var(--n-accent);
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 13px;
  font-family: "Fira Code", monospace;
}

.aiContent pre {
  background: var(--n-input-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-sm);
  padding: 14px 16px;
  overflow-x: auto;
  margin: 12px 0;
}

.aiContent pre code {
  background: none;
  color: var(--n-text);
  padding: 0;
}

.aiContent .katex-display {
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-left: 3px solid var(--n-accent);
  border-radius: var(--n-radius-sm);
  padding: 14px 18px;
  margin: 14px 0;
  overflow-x: auto;
  box-shadow: var(--n-shadow-sm);
}

.aiContent .katex {
  font-size: 1em;
}

.aiContent blockquote {
  border-left: 3px solid var(--n-accent);
  padding: 8px 16px;
  margin: 12px 0;
  background: var(--n-accent-glow);
  border-radius: 0 var(--n-radius-sm) var(--n-radius-sm) 0;
  color: var(--n-text-muted);
  font-style: italic;
}

.aiContent table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 12px 0;
  border-radius: var(--n-radius-sm);
  overflow: hidden;
}

.aiContent th {
  background: var(--n-accent);
  color: #fff;
  padding: 9px 14px;
  text-align: left;
  font-weight: 600;
}

.aiContent td {
  padding: 8px 14px;
  border-bottom: 1px solid var(--n-border);
}

.aiContent tr:nth-child(even) td {
  background: var(--n-input-bg);
}

.aiContent strong {
  font-weight: 700;
}

.aiContent em {
  font-style: italic;
  opacity: 0.88;
}

.aiContent hr {
  border: none;
  border-top: 1px solid var(--n-border);
  margin: 16px 0;
}

.aiContent a {
  color: var(--n-accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.bubbleEditing {
  box-shadow:
    0 0 0 2px var(--n-accent),
    var(--n-shadow-sm);
}

/* ── User message content ─────────────────────────────────── */
.messageContent {
  margin: 0 0 4px;
  font-size: 14px;
  line-height: 1.65;
  word-break: break-word;
}

.messageContent p {
  margin: 0 0 8px;
  line-height: 1.7;
}

.messageContent p:last-child {
  margin-bottom: 0;
}

.messageContent h1,
.messageContent h2,
.messageContent h3 {
  font-family: var(--n-font-display);
  font-weight: 600;
  margin: 14px 0 6px;
  color: var(--n-text);
  line-height: 1.3;
}

.messageContent h1 {
  font-size: 1.15rem;
}

.messageContent h2 {
  font-size: 1.05rem;
}

.messageContent h3 {
  font-size: 0.95rem;
}

.messageContent ul,
.messageContent ol {
  padding-left: 1.4em;
  margin: 6px 0 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.messageContent li {
  font-size: 14px;
  line-height: 1.6;
}

.messageContent code {
  background: var(--n-accent-glow);
  color: var(--n-accent);
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 13px;
  font-family: "Fira Code", "Cascadia Code", monospace;
}

.messageContent pre {
  background: var(--n-input-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-sm);
  padding: 14px 16px;
  overflow-x: auto;
  margin: 10px 0;
  box-shadow: var(--n-shadow-sm);
}

.messageContent pre code {
  background: none;
  color: var(--n-text);
  padding: 0;
  font-size: 13px;
}

.messageContent blockquote {
  border-left: 3px solid var(--n-accent);
  padding: 6px 14px;
  margin: 10px 0;
  background: var(--n-accent-glow);
  border-radius: 0 var(--n-radius-sm) var(--n-radius-sm) 0;
  color: var(--n-text-muted);
  font-style: italic;
}

.messageContent table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin: 10px 0;
  border-radius: var(--n-radius-sm);
  overflow: hidden;
}

.messageContent th {
  background: var(--n-accent);
  color: #fff;
  padding: 8px 12px;
  text-align: left;
  font-weight: 600;
}

.messageContent td {
  padding: 7px 12px;
  border-bottom: 1px solid var(--n-border);
}

.messageContent tr:nth-child(even) td {
  background: var(--n-input-bg);
}

.messageContent a {
  color: var(--n-accent);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color var(--n-duration-fast) var(--n-ease-smooth);
}

.messageContent a:hover {
  color: var(--n-accent-hover);
}

.messageContent hr {
  border: none;
  border-top: 1px solid var(--n-border);
  margin: 12px 0;
}

.messageContent strong {
  font-weight: 700;
}

.messageContent em {
  font-style: italic;
  opacity: 0.9;
}

.messageTime {
  font-size: 11px;
  opacity: 0.55;
  display: block;
  margin-top: 2px;
}

/* Edit button pops up below bubble */
.editBtn {
  position: absolute;
  bottom: -30px;
  right: 0;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-pill);
  font-size: 12px;
  padding: 4px 10px;
  cursor: pointer;
  color: var(--n-accent);
  font-weight: 600;
  box-shadow: var(--n-shadow-sm);
  white-space: nowrap;
  z-index: 10;
  animation: menuPop var(--n-duration-base) var(--n-ease-spring) both;
  transition:
    background var(--n-duration-fast) var(--n-ease-smooth),
    transform var(--n-duration-fast) var(--n-ease-spring);
}

.editBtn:hover {
  background: var(--n-sidebar-active);
  transform: scale(1.06);
  /* subtle enlarge */
}

.editBtn:active {
  transform: scale(0.95);
  transition-duration: var(--n-duration-fast);
}

/* Thinking indicator */
.thinkingBubble {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--n-bubble-ai-bg);
  padding: 12px 18px;
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  box-shadow: var(--n-shadow-sm);
  animation: msgFadeUp var(--n-duration-base) var(--n-ease-out) both;
}

.thinkingLabel {
  font-size: 13px;
  color: var(--n-text-muted);
  font-style: italic;
}

.dots {
  display: flex;
  gap: 4px;
  align-items: center;
}

.dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--n-accent);
  animation: dotBounce 1.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  display: block;
}

.dots span:nth-child(2) {
  animation-delay: 0.18s;
}

.dots span:nth-child(3) {
  animation-delay: 0.36s;
}

/* Input bar */
.inputBar {
  padding: 16px 28px 20px;
  background: var(--n-surface);
  border-top: 1px solid var(--n-border);
  flex-shrink: 0;
}

.editBanner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--n-accent-glow);
  border-radius: var(--n-radius-sm);
  padding: 6px 12px;
  font-size: 12px;
  color: var(--n-accent);
  font-weight: 600;
  margin-bottom: 10px;
  animation: itemEnter var(--n-duration-base) var(--n-ease-spring) both;
}

.editBanner button {
  background: none;
  border: none;
  color: var(--n-accent);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  padding: 0;
  transition: opacity var(--n-duration-fast) var(--n-ease-smooth);
}

.editBanner button:hover {
  opacity: 0.7;
}

.inputForm {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--n-input-bg);
  border: 1px solid var(--n-border);
  border-radius: var(--n-radius-pill);
  padding: 6px 6px 6px 18px;
  /* Focus glow uses box-shadow — GPU composited, no layout */
  transition:
    border-color var(--n-duration-base) var(--n-ease-smooth),
    box-shadow var(--n-duration-base) var(--n-ease-smooth);
}

.inputForm:focus-within {
  border-color: var(--n-accent);
  box-shadow: 0 0 0 3px var(--n-accent-glow);
  /* ring expands in — satisfying focus signal */
}

.queryInput {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--n-text);
  min-width: 0;
}

.queryInput::placeholder {
  color: var(--n-text-faint);
}

.sendBtn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: var(--n-border);
  color: var(--n-text-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: not-allowed;
  flex-shrink: 0;
  transition:
    background var(--n-duration-base) var(--n-ease-smooth),
    color var(--n-duration-base) var(--n-ease-smooth),
    transform var(--n-duration-base) var(--n-ease-spring),
    box-shadow var(--n-duration-base) var(--n-ease-smooth);
}

.sendBtnActive {
  background: var(--n-accent);
  color: #fff;
  cursor: pointer;
  box-shadow: 0 2px 12px var(--n-accent-glow);
}

.sendBtnActive:hover {
  background: var(--n-accent-hover);
  transform: scale(1.1);
  /* send button bounces on hover = ready signal */
}

.sendBtnActive:active {
  transform: scale(0.92) rotate(-10deg);
  /* press + slight rotation = "launched" */
  transition-duration: var(--n-duration-fast);
}

.mobileTopbar {
  display: none;
}
/* ══════════════════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .mobileTopbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--n-surface);
    border-bottom: 1px solid var(--n-border);
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    z-index: 60;
  }

  .mobileTopbarTitle {
    font-size: 15px;
    font-weight: 700;
    color: var(--n-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 52px);
  }

  .uploadPage {
    padding: 48px 16px 40px;
    padding-top: 24px;
    gap: 24px;
  }

  .messagesArea {
    padding: 16px 16px 8px;
  }

  .chatHeader {
    padding: 14px 16px;
  }

  .inputBar {
    padding: 12px 16px 16px;
  }

  .messageBubble {
    max-width: 100%;
  }

  .rightSidebar {
    display: none;
  }
}

@media (max-width: 480px) {
  .uploadTitle {
    font-size: 1.7rem;
  }

  .formatGrid {
    gap: 7px;
  }

  .formatChip {
    font-size: 12px;
    padding: 5px 10px;
  }

  .toastStack {
    right: 12px;
    bottom: 12px;
  }

  .toast {
    font-size: 13px;
  }
}

/* ── Scrollbar ─────────────────────────────────────────────────── */
.messagesArea::-webkit-scrollbar,
.sidebarList::-webkit-scrollbar {
  width: 4px;
}

.messagesArea::-webkit-scrollbar-thumb,
.sidebarList::-webkit-scrollbar-thumb {
  background: var(--n-border);
  border-radius: 4px;
}

.messagesArea::-webkit-scrollbar-track,
.sidebarList::-webkit-scrollbar-track {
  background: transparent;
}

.hamburgerBtn {
  display: none;
}

/* ══════════════════════════════════════════════════════════════════
   MOBILE SIDEBAR DRAWER
══════════════════════════════════════════════════════════════════ */
.overlay {
  display: none;
}

.sidebarCloseBtn {
  display: none;
}

@media (max-width: 768px) {
  .chatHeaderInner {
    justify-content: space-between;
  }

  .hamburgerBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--n-border);
    border-radius: var(--n-radius-sm);
    background: var(--n-input-bg);
    color: var(--n-text);
    font-size: 18px;
    cursor: pointer;
    flex-shrink: 0;
    margin-left: auto;
    transition:
      background var(--n-duration-fast) var(--n-ease-smooth),
      color var(--n-duration-fast) var(--n-ease-smooth),
      transform var(--n-duration-fast) var(--n-ease-spring);
  }

  .hamburgerBtn:active {
    background: var(--n-accent-glow);
    color: var(--n-accent);
    transform: scale(0.92);
    /* press feedback */
  }

  /* Backdrop */
  .overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 299;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    animation: fadeInOverlay var(--n-duration-base) var(--n-ease-smooth) both;
  }

  /* Sidebar fixed right drawer */
  .rightSidebar {
    position: fixed !important;
    top: 0;
    right: 0;
    height: 100% !important;
    width: 85vw !important;
    max-width: 320px !important;
    z-index: 300;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    /* will-change: GPU layer ready before slide starts */
    will-change: transform;
    transition: transform var(--n-duration-slow) var(--n-ease-smooth) !important;
    border-left: 1px solid var(--n-border);
    overflow-y: auto;
    display: flex !important;
    flex-direction: column;
  }

  .rightSidebarOpen,
  .rightSidebarClosed {
    width: 85vw !important;
  }

  .mobileSidebarOpen {
    transform: translateX(0) !important;
  }

  .rightSidebarToggleBtn {
    display: none;
  }

  /* Close button inside drawer */
  .sidebarCloseBtn {
    display: flex;
    position: absolute;
    top: 16px;
    right: 14px;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--n-border);
    border-radius: 6px;
    background: var(--n-input-bg);
    color: var(--n-text-muted);
    font-size: 13px;
    cursor: pointer;
    z-index: 10;
    transition:
      background var(--n-duration-fast) var(--n-ease-smooth),
      color var(--n-duration-fast) var(--n-ease-smooth),
      transform var(--n-duration-base) var(--n-ease-spring);
  }

  .sidebarCloseBtn:hover {
    background: var(--n-toast-err-bg);
    color: var(--n-toast-err-fg);
    transform: rotate(90deg) scale(1.1);
    /* × rotates closed = clear affordance */
  }

  .rightSidebarContent {
    padding-top: 52px;
  }
}

/* Safe area (iPhone notch / home bar) */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  @media (max-width: 768px) {
    .rightSidebar {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
}
