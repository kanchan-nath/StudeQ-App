export const StyledSummary = ({ content }) => {
  const lines = (content ?? "").split("\n");
  const elements = [];
  let i = 0;

  while (i < lines.length) {
    const line = lines[i].trim();
    if (!line) {
      i++;
      continue;
    }

    if (line.startsWith("### ")) {
      elements.push(
        <h4
          key={i}
          className={styles["sum-h3"]}
        >
          {line.slice(4)}
        </h4>,
      );
    } else if (line.startsWith("## ")) {
      elements.push(
        <h3
          key={i}
          className={styles["sum-h2"]}
        >
          {line.slice(3)}
        </h3>,
      );
    } else if (line.startsWith("# ")) {
      elements.push(
        <h2
          key={i}
          className={styles["sum-h1"]}
        >
          {line.slice(2)}
        </h2>,
      );
    } else if (line.startsWith("- ") || line.startsWith("* ")) {
      const bullets = [];
      while (
        i < lines.length &&
        (lines[i].trim().startsWith("- ") || lines[i].trim().startsWith("* "))
      ) {
        bullets.push(
          <li key={i}>
            <LLMMarkdown content={lines[i].trim().slice(2)} />
          </li>,
        );
        i++;
      }
      elements.push(
        <ul
          key={`ul-${i}`}
          className={styles["sum-list"]}
        >
          {bullets}
        </ul>,
      );
      continue;
    } else {
      elements.push(
        <div
          key={i}
          className={styles["sum-para"]}
        >
          <LLMMarkdown content={line} />
        </div>,
      );
    }
    i++;
  }

  return <div className={styles["sum-body"]}>{elements}</div>;
};

