      type: "project",
    })),
    ...assignments.map((a) => ({
      date: toDateObj(a.dueDate),
      name: `Assignment due`,
      meta: `Due ${a.dueDate ? new Date(a.dueDate).toLocaleDateString() : ""}${a.allowLateSubmission ? " · Late ok" : ""}`,
      status: getEventStatus(a, "assignment"),
      type: "assignment",
    })),
