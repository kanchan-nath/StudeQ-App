/* ─── Assignments.module.css ──────────────────────────────────────────── */

/* ─────────────────────────────────────────────────────────────────────────
   MOTION: Global kill-switch — reduced-motion collapses all durations to
   near-zero. Transition/animation still fire (avoids flash), just instant.
   ───────────────────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ─────────────────────────────────────────────────────────────────────────
   DESIGN TOKENS
   Duration scale: fast=150ms  base=250ms  slow=400ms  slower=600ms
   Easing: all cubic-bezier — no plain `ease` or `linear` anywhere.
     --ease-out-quart  : standard decelerate (most UI motion)
     --ease-spring     : overshoot for bouncy interactive feedback
     --ease-in-quart   : accelerate for exits/collapses
     --ease-in-out     : symmetric for toggles / continuous motion
   ───────────────────────────────────────────────────────────────────────── */

/* ── Smooth scroll on scroll container ── */
html {
  scroll-behavior: smooth;
}

/* ─── Layout ─────────────────────────────────────────────────────────────── */
/* MOTION: whole page fades in on mount — opacity only, zero layout shift */
.layout {
  display: flex;
  min-height: 100vh;
  background: var(--theme-bg);
  font-family: var(--font-body);
  position: relative;
  animation: pageFadeIn var(--duration-slow) var(--ease-out-quart) both;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* ─── Sidebar ────────────────────────────────────────────────────────────── */
/* MOTION: slides in from left on load — translateX only (GPU layer) */
