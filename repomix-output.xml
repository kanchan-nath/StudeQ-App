import useErrorHandler from "../errors/hooks/useErrorHandler.jsx";

// ─── Helpers ──────────────────────────────────────────────────

async function fetchSearch(query) {
  const res = await apiFetch(`/api/search?query=${encodeURIComponent(query)}`);
  if (!res.ok) {
    const err = new Error(`Search failed: ${res.status}`);
    err.status = res.status;   // ← caller can branch on this
    throw err;
  }
  const json = await res.json();
  return json.data;
}

function getCredibility(url = "") {
  if (!url) return "unknown";
  if (url.includes(".edu") || url.includes(".gov")) return "edu";
  const established = [
    "wikipedia",
    "ibm",
    "google",
    "nasa",
    "stanford",
    "mit",
    "bbc",
    "nytimes",
    "reuters",
    "sas",
    "iso.org",
  ];
  if (established.some((d) => url.includes(d))) return "established";
  return "unknown";
}

function credLabel(type) {
  if (type === "edu") return "Edu/Gov";
  if (type === "established") return "Trusted";
  return "Unknown";
}

function readingTime(snippet = "") {
  const words = snippet.split(/\s+/).length;
  const mins = Math.max(1, Math.round(words / 200));
  return `~${mins} min read`;
}

function flattenShorts(shortsResults = []) {
  return shortsResults.flatMap((b) => b.shorts || []);
}

function formatViews(n) {
  if (!n) return "";
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(0)}K`;
  return `${n}`;
}

