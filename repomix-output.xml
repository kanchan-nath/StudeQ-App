// ─── Flashcard Viewer ─────────────────────────────────────────────────────────
const FlashcardViewer = ({ allFlashcards, onNavigate, onOpenSidebar }) => {
  const cards = allFlashcards.flatMap((set) => set.flashcards || []);

  const [currentIndex, setCurrentIndex] = useState(0);
  const [isFlipped, setIsFlipped] = useState(false);
  const [mode, setMode] = useState("Standard");
  const [modeOpen, setModeOpen] = useState(false);
  const [thumbUp, setThumbUp] = useState(false);
  const [thumbDown, setThumbDown] = useState(false);
  const [bookmarked, setBookmarked] = useState(false);

  const modes = ["Standard", "Spaced Repetition", "Bookmarked Flashcards"];

  useEffect(() => {
    const handleKey = (e) => {
      if (
        e.code === "Space" &&
        e.target.tagName !== "INPUT" &&
        e.target.tagName !== "TEXTAREA"
      ) {
        e.preventDefault();
        setIsFlipped((f) => !f);
      }
      if (e.code === "ArrowRight") goNext();
      if (e.code === "ArrowLeft") goPrev();
    };
    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [currentIndex, cards.length]);

  const goNext = () => {
    if (currentIndex < cards.length - 1) {
      setCurrentIndex((i) => i + 1);
      setIsFlipped(false);
    }
  };
  const goPrev = () => {
    if (currentIndex > 0) {
      setCurrentIndex((i) => i - 1);
      setIsFlipped(false);
    }
  };
  const goTo = (i) => {
    setCurrentIndex(i);
    setIsFlipped(false);
  };

  const currentCard = cards[currentIndex] || {
    front: "No cards yet",
    back: "Add cards to your set",
  };

  return (
    <div className={styles.viewerLayout}>
      {/* Headbar */}
      <div className={styles.headbar}>
        <div className={styles.progressDots}>
          {cards.slice(0, Math.min(cards.length, 12)).map((_, i) => (
            <button
              key={i}
              className={`${styles.dot} ${i === currentIndex ? styles.dotActive : ""}`}
              onClick={() => goTo(i)}
              aria-label={`Card ${i + 1}`}
            />
          ))}
          {cards.length > 12 && <span className={styles.dotsMore}>›</span>}
        </div>

        <div className={styles.headbarRight}>
          <div className={styles.cardCounter}>
            {currentIndex + 1} / {cards.length}
          </div>
          <button
            className={styles.navArrow}
            onClick={goPrev}
            disabled={currentIndex === 0}
          >
            <IconChevronLeft />
          </button>
          <button
            className={styles.navArrow}
            onClick={goNext}
            disabled={currentIndex === cards.length - 1}
          >
            <IconChevronRight />
          </button>
        </div>
      </div>

      {/* Card area */}
      <div className={styles.cardArea}>
        <div className={styles.cardMeta}>
          <span className={styles.cardSideLabel}>
            {isFlipped ? "Definition" : "Term"}
          </span>
        </div>

        <div
          className={styles.cardScene}
          onClick={() => setIsFlipped((f) => !f)}
