<file path="server/services/textExtractor.js">
import { ApiError } from "../utils/Async.js"
import { PDFParse } from "pdf-parse"
import fs from "fs"
import XLSX from "xlsx"
import Tesseract from "tesseract.js"
import chunking from "./chunking.js"
import embedText from "./embedText.js"
import { extract, extractTextFromImage } from "../lib/groq/extractText.js"
import pdfToImages from "./pdfToImages.js"
import { fileTypeFromBuffer } from "file-type"
import logger from "../logger/index.js"

const isFile = async (buffer) => {
    return await fileTypeFromBuffer(buffer)
}

const cleanExtractedText = (text) => {
    return text
        // page markers
        .replace(/--\s*\d+\s*of\s*\d+\s*--/g, '')
        // unicode math symbols
        .replace(/[²³°±×÷√∑∫∞≤≥≠αβγδεζηθλμπσφψω↑↓→←⟶⟹]/g, '')
        // filter lines that are mostly math garbage
        .split('\n')
        .filter(line => {
            const tokens = line.trim().split(/\s+/).filter(Boolean)
            if (tokens.length === 0) return false
            const realWords = tokens.filter(t => /[a-zA-Z]{3,}/.test(t))
            // drop line if less than 40% tokens are real words
            return (realWords.length / tokens.length) > 0.4
        })
        .join('\n')
        // isolated 1-2 char tokens (standalone a b x 2 b2 etc)
        .replace(/(?<![^\s])[a-zA-Z0-9]{1,2}(?![^\s])/g, '')
        // collapse multiple spaces/newlines
        .replace(/\n{3,}/g, '\n\n')
        .replace(/ {2,}/g, ' ')
        .trim()
}

const safeUnlink = (filePath) => {
    try {
        fs.unlinkSync(filePath)
    } catch (error) {
        throw new Error(`File is not deleted: ${error}`)
    }
}

const textExtractor = async (file) => {
    const mimeType = file.mimetype
    const filePath = file.path
    const fileDataBuffer = fs.readFileSync(filePath)
    const fileType = await isFile(fileDataBuffer)
    console.log(fileType.ext);

    const THERESOLD_CHAR = 200
    const THERESOLD_WORD = 50

    try {
        if (mimeType == "application/pdf") {

            if (!fileType || fileType?.ext !== "pdf") {
                throw new ApiError(400, "File content does not match declared type")
            }

            const uint8Array = new Uint8Array(fileDataBuffer)
            const parser = await new PDFParse(uint8Array)

            const rawText = ((await parser.getText()).text.replace(/--\s*\d+\s*of\s*\d+\s*--/g, '').trim())

            const extractedText = cleanExtractedText(rawText)

            const charCount = extractedText.length
            const wordCount = extractedText.split(/\s+/).filter(Boolean).length
            const pageCount = parser.numPages

            const isSparse = charCount < (THERESOLD_CHAR * pageCount) ||
                wordCount < (THERESOLD_WORD * pageCount)

            if (isSparse) {
                    const outputDir = process.env.PDF_IMAGES_DIR ||
                        path.join(process.cwd(), "uploads", "images")

                        if(!fs.existsSync(outputDir)){
                            fs.mkdirSync(outputDir, {recursive: true})
                        }

                    await pdfToImages(filePath, pageCount, outputDir)

                    const results = await extract(outputDir)
                    safeUnlink(filePath)
                    logger.info("Text Extracted from Pdf -> Images");

                    return results

            } 
            
            safeUnlink(filePath)

            return extractedText

        } else if (mimeType == "application/vnd.ms-excel" || mimeType === "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet") {
            const wrokbook = XLSX.readFile(filePath)
            const sheet = wrokbook.Sheets[wrokbook.SheetNames[0]]

            const result = XLSX.utils.sheet_to_json(sheet)
            safeUnlink(filePath)
            return JSON.stringify(result)

        } else if ((["jpeg", "png", "webp", "jpg"].includes(fileType?.ext))) {

            const extractedText = await extractTextFromImage(filePath)

            safeUnlink(filePath)

            return extractedText

        } else if (mimeType == "text/plain") {
            const extractedText = fs.readFileSync(filePath, 'utf8')

            safeUnlink(filePath)

            return extractedText
        } else {
            safeUnlink(filePath)
            throw new ApiError(404, "File not supported")
        }
    } catch (error) {
        safeUnlink(filePath)

        if (error instanceof ApiError) throw error
        throw new ApiError(500, `Text extraction failed: ${error.message}`)
    }
}

export default textExtractor
</file>

<file path="server/services/vectordb.js">
import { Pinecone } from "@pinecone-database/pinecone";
import embedText from "./embedText.js";
import chunking from "./chunking.js";
import textExtractor from "./textExtractor.js";
import logger from "../logger/index.js"

let pcClient = null

const getIndex = ()=>{
    if(!pcClient){
        pcClient = new Pinecone(
            {
                apiKey: process.env.PINECONE_API_KEY

            }
        )
    }

    return pcClient.index(process.env.PINECONE_INDEX_NAME)
}

const getNamespace = (userId)=>{
    if(!userId){
        throw new Error("vectorDB: userId required for namespace isolation")
    }

    return `user_${userId}`
}

const vectorDB = async (file, userId, documentId) => {

    if (!userId || !documentId) {
        throw new Error("vectorDB: userId and documentId are required")
    }

    const extractedText = await textExtractor(file)
    const chunks = await chunking(extractedText)

    const index = getIndex()
    const ns = index.namespace(getNamespace(userId));

    const records= []

    for(let i=0; i<chunks.length;i++){
        const values = await embedText(chunks[i])

        records.push(
            {
                id: `${documentId}_chunk_${i}`,
                values,
                metadata:{
                    text:chunks[i],
                    userId,
                    documentId,
                    chunkIndex: i,
                }
            }
        )
    }

    await ns.upsert( {records} )
    logger.info(`Upserted ${records.length} chunks for document ${documentId} (user ${userId})`)
    
    return chunks.length
}

const deleteDocumentVectors = async (userId, documentId, chunkCount) => {
    const index = getIndex()
    const ns = index.namespace(getNamespace(userId))

    if (chunkCount) {
        const ids = Array.from({ length: chunkCount }, (_, i) => `${documentId}_chunk_${i}`)
        await ns.deleteMany(ids)
    } else {
        await ns.deleteMany({ filter: { documentId: { "$eq": String(documentId) } } })
    }
}

const queryDB = async (query, userId, documentId) => {
    if (!documentId) {
        throw new Error("queryDB: documentId required to scope search to single document")
    }

    const index = getIndex()
    const ns = index.namespace(getNamespace(userId))
    const queryVector = await embedText(query)

    const results = await ns.query({
        vector: queryVector,
        topK: 5,
        includeMetadata: true,
        filter: { documentId: { "$eq": documentId } }
    })

    logger.info(`queryDB: ${results.matches.length} matches for user ${userId}, doc ${documentId}`)

    return results.matches.map(m => m.metadata.text)
}   
export  {vectorDB, queryDB, deleteDocumentVectors}
</file>

<file path="server/services/xpService.js">
import prisma from "../lib/prisma.js"
import redisClient from "../lib/redisClient.js"
import { ApiError } from "../utils/Async.js"
import logger from "../logger/index.js"

export const XP_TABLE = {
  QUIZ_COMPLETE: 50,
  FLASHCARD_SESSION: 20,
  DOC_UPLOAD: 10,
  CHAT_SESSION: 5,
  DAILY_LOGIN: 5,
}

const xpForLevel = (n)=> {
  return Math.pow(n - 1, 2) * 100
}

export const computeStats= (totalXp)=> {
  const level = Math.floor(Math.sqrt(totalXp / 100)) + 1
  const xpCurrentLevel = xpForLevel(level)
  const xpNextLevel = xpForLevel(level + 1)
  const xpPercent = Math.round(
    ((totalXp - xpCurrentLevel) / (xpNextLevel - xpCurrentLevel)) * 100
  )
  return { xp: totalXp, level, xpNextLevel, xpPercent }
}

const calcStreak = (currentStreak, lastStudyDate) =>{
  const today = new Date().toISOString().slice(0, 10)
  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10)

  if (lastStudyDate === today) return { streak: currentStreak, updated: false }
  const streak = lastStudyDate === yesterday ? currentStreak + 1 : 1
  return { streak, updated: true }
}

const invalidateUserCache = async (userId)=> {
  try {
    await redisClient.del(`user-cache:${userId}`)
  } catch (err) {
    logger.error("Redis invalidate failed:", err.message)
  }
}

export const grantXP = async (userId, action)=> {
  const amount = XP_TABLE[action]
  if (!amount) throw new ApiError(400, `Unknown XP action: ${action}`)

  const user = await prisma.user.findUnique({
    where: { id: userId },
    select: { totalXp: true, streak: true, lastStudyDate: true },
  })
  if (!user) throw new ApiError(404, "User not found")

  const { streak, updated } = calcStreak(user.streak, user.lastStudyDate)
  const today = new Date().toISOString().slice(0, 10)

  const updated_user = await prisma.user.update({
    where: { id: userId },
    data: {
      totalXp: user.totalXp + amount,
      streak,
      ...(updated && { lastStudyDate: today }),
    },
    select: { totalXp: true, streak: true },
  })

  await invalidateUserCache(userId)

  return {
    granted: amount,
    streak: updated_user.streak,
    stats: computeStats(updated_user.totalXp),
  }
}

// idempotent — safe to call every login
export const  grantDailyLoginXP = async (userId) =>{
  const user = await prisma.user.findUnique({
    where: { id: userId },
    select: { totalXp: true, streak: true, lastStudyDate: true },
  })
  if (!user) throw new ApiError(404, "User not found")

  const today = new Date().toISOString().slice(0, 10)
  if (user.lastStudyDate === today) return null // already counted today

  const { streak } = calcStreak(user.streak, user.lastStudyDate)

  const updated_user = await prisma.user.update({
    where: { id: userId },
    data: {
      totalXp: user.totalXp + XP_TABLE.DAILY_LOGIN,
      streak,
      lastStudyDate: today,
    },
    select: { totalXp: true, streak: true },
  })

  await invalidateUserCache(userId)

  return {
    granted: XP_TABLE.DAILY_LOGIN,
    streak: updated_user.streak,
    stats: computeStats(updated_user.totalXp),
  }
}
</file>

