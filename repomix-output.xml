<file path="client/src/components/ComingSoon/Comingsoon.module.css">
.wrapper {
  position: relative;
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-bg);
  overflow: hidden;
  padding: 2rem 1rem;
}

.glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      ellipse 60% 50% at 50% 40%,
      rgba(124, 95, 245, 0.18) 0%,
      transparent 70%
    ),
    radial-gradient(
      ellipse 40% 30% at 70% 60%,
      rgba(124, 95, 245, 0.08) 0%,
      transparent 60%
    );
  pointer-events: none;
  z-index: 0;
}

.stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-image:
    radial-gradient(
      1px 1px at 15% 20%,
      rgba(255, 255, 255, 0.35) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 72% 14%,
      rgba(255, 255, 255, 0.25) 0%,
      transparent 100%
    ),
    radial-gradient(
      1.5px 1.5px at 38% 75%,
      rgba(255, 255, 255, 0.2) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 85% 55%,
      rgba(255, 255, 255, 0.3) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 25% 88%,
      rgba(255, 255, 255, 0.2) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 60% 42%,
      rgba(255, 255, 255, 0.15) 0%,
      transparent 100%
    ),
    radial-gradient(
      1.5px 1.5px at 5% 60%,
      rgba(255, 255, 255, 0.25) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 92% 82%,
      rgba(255, 255, 255, 0.2) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 48% 8%,
      rgba(255, 255, 255, 0.3) 0%,
      transparent 100%
    ),
    radial-gradient(
      1px 1px at 78% 95%,
      rgba(255, 255, 255, 0.15) 0%,
      transparent 100%
    );
}

.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.5rem;
  max-width: 480px;
  width: 100%;
}

/* ── ORBIT ─────────────────────────────────────────────────── */
.orbitContainer {
  position: relative;
  width: 120px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1.5px solid transparent;
  border-top-color: var(--theme-purple);
  border-right-color: rgba(124, 95, 245, 0.3);
  will-change: transform;
  animation: orbit 4s linear infinite;
}

.ringOuter {
  inset: -16px;
  border-top-color: rgba(124, 95, 245, 0.35);
  border-right-color: transparent;
  border-bottom-color: rgba(124, 95, 245, 0.15);
  animation: orbit 7s linear infinite reverse;
}

@keyframes orbit {
  to {
    transform: rotate(360deg);
  }
}

.sparkIcon {
  font-size: 2rem;
  line-height: 1;
  color: var(--theme-accent);
  filter: drop-shadow(0 0 8px var(--theme-accent-glow));
  user-select: none;
}

/* ── TEXT ──────────────────────────────────────────────────── */
.heading {
  font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
  font-size: clamp(2.5rem, 8vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--theme-text);
  text-shadow: 0 0 40px rgba(124, 95, 245, 0.4);
  margin: 0;
}

.label {
  font-size: 1rem;
  color: var(--theme-text-secondary);
  margin: 0;
  line-height: 1.5;
}

.labelFeature {
  color: var(--theme-purple-light);
  font-weight: 500;
}

/* ── ETA BADGE ─────────────────────────────────────────────── */
.etaBadge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.3rem 0.875rem;
  border-radius: 9999px;
  background: var(--theme-purple-dim);
  border: 1px solid rgba(124, 95, 245, 0.25);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--theme-purple-light);
  letter-spacing: 0.01em;
}

.etaDot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--theme-purple-light);
  animation: pulse 2s ease-in-out infinite;
  will-change: opacity;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

/* ── NOTIFY FORM ───────────────────────────────────────────── */
.notifyForm {
  display: flex;
  gap: 0.5rem;
  width: 100%;
  max-width: 360px;
  flex-wrap: wrap;
}

.notifyInput {
  flex: 1 1 200px;
  min-width: 0;
  padding: 0.6rem 1rem;
  background: var(--theme-input-bg);
  border: 1px solid var(--theme-input-border);
  border-radius: 8px;
  font-family: inherit;
  font-size: 0.875rem;
  color: var(--theme-text);
  outline: none;
  transition: border-color 150ms ease;
}

.notifyInput::placeholder {
  color: var(--theme-text-muted);
}

.notifyInput:focus {
  border-color: var(--theme-purple);
}

.notifyBtn {
  flex-shrink: 0;
  padding: 0.6rem 1.25rem;
  background: var(--theme-purple);
  border: none;
  border-radius: 8px;
  font-family: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  cursor: pointer;
  transition:
    background 150ms ease,
    transform 100ms ease;
  white-space: nowrap;
}

.notifyBtn:hover {
  background: var(--theme-purple-light, #a78bfa);
}

.notifyBtn:active {
  transform: scale(0.97);
}

.notifySuccess {
  font-size: 0.85rem;
  color: var(--theme-green);
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

/* ── REDUCED MOTION ────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .ring,
  .ringOuter,
  .etaDot {
    animation: none;
  }
}

/* ── MOBILE ────────────────────────────────────────────────── */
@media (max-width: 480px) {
  .orbitContainer {
    width: 88px;
    height: 88px;
  }

  .ringOuter {
    inset: -12px;
  }

  .sparkIcon {
    font-size: 1.5rem;
  }

  .notifyForm {
    flex-direction: column;
  }

  .notifyBtn {
    width: 100%;
  }
}
