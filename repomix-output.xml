import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiError, ApiResponse } from "../utils/Async.js"
import { summarizeText } from "../lib/groq/summarizer.js"
import { Note } from "../models/note.model.js"
import { AIResponseQueue } from "../services/queue.js"
import { noteValidator } from "../validators/note.validator.js"
import mongoose from "mongoose"

const titleExtract = (markdownResponse) => {
    if (!markdownResponse) return "Summary"
    const match = markdownResponse.match(/##\s+Topic\s*\n+(.+)/);
    return match ? match[1].trim() : "Summary";
};

const createNote = asyncHandler(async (req, res) => {

    const { data, error } = noteValidator.safeParse(req.body)

    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { content } = data

    if (!content) {
        throw new ApiError(400, "Content is required")
    }
    const userId = req.user.id

    const response = await summarizeText(content, userId)

    if (!response) {
        await AIResponseQueue(userId, content)

        return res
            .status(202)
            .json(new ApiResponse(202, {}, "Summarization queued — you'll be notified when ready"))

    }
    const title = await titleExtract(response)

    const dbData = await Note.create({
        userId,
        title,
        content,
        summary: response,
    })
    return res
        .status(201)
        .json(new ApiResponse(201, dbData, "Note created successfully"))

})

const getNote = asyncHandler(async (req, res) => {
    const userId = req.user.id

    const allNotes = await Note.find({
        userId: userId
    }).sort({ isPinned: -1, createdAt: -1 })

    return res
        .status(200)
        .json(new ApiResponse(200, allNotes, "All notes fetched successfully"))

})

const deleteNote = asyncHandler(async (req, res) => {
    const { id } = req.params

    if (!mongoose.Types.ObjectId.isValid(id)) {
        throw new ApiError(400, "Invalid note ID")
    }

    const userId = req.user.id

    const deleted = await Note.findByIdAndDelete({
        _id: id,
        userId: userId
    })

    if (!deleted) {
        throw new ApiError(404, "Note not found")
    }

    return res
        .status(200)
        .json(new ApiResponse(200, {}, "Note deleted succesfully"))
})

const updateNote = asyncHandler(async (req, res) => {

    const { data, error } = noteValidator.safeParse(req.body)

    if (error) {
        throw new ApiError(400, error.issues.map(e => e.message).join(", "))
    }
    const { content } = data

    if (!content) {
        throw new ApiError(400, "Content is required")
    }
    const { id } = req.params

    if (!content || !id) {
        throw new ApiError(400, "Content and id are required")
    }

    if (!mongoose.Types.ObjectId.isValid(id)) {
        throw new ApiError(400, "Invalid note ID")

    }
    const userId = req.user.id

    const response = await summarizeText(content, userId)

    if (!response) {
        throw new ApiError(500, "Summarization failed, please try again")

    }

    const title = titleExtract(response)

    const updated = await Note.findOneAndUpdate(
        {
            _id: id,
            userId
        },
        {
            content,
            title,
            summary: response
        },
        {
            returnDocument: 'after'
        }
    )

    if (!updated) {
        throw new ApiError(404, "Note not found")
    }

    return res
        .status(200)
        .json(new ApiResponse(200, updated, "Note updated successfully"))

})

const togglePin = asyncHandler(async (req, res) => {
    const { newPinned } = req.body
    if (typeof newPinned !== "boolean") {
        throw new ApiError(400, "newPinned must be a boolean")
    }

    const { id } = req.params
    if (!mongoose.Types.ObjectId.isValid(id)){
        throw new ApiError(400, "Invalid note ID")
    }
    const userId = req.user.id

    const updated = await Note.findOneAndUpdate(
        {
            userId,
            _id: id
        },
        {
            isPinned: newPinned
        },
        { returnDocument: "after" }
    )

    if(!updated){
        throw new ApiError(404, "Note not found")   
    }
    return res
        .status(200)
        .json(new ApiResponse(200, {}, "pin successful"))
})
export {
    createNote,
    getNote,
    deleteNote,
    updateNote,
    togglePin,
    titleExtract
}
</file>

<file path="server/controllers/payment.controller.js">
import { asyncHandler } from "../utils/asyncHandler.js"
import { ApiError, ApiResponse } from "../utils/Async.js"
import { plansData } from "../constants/plansData.constant.js"
import { Plan } from "../models/plan.model.js"
import sharedFeaturesSeed from "../constants/sharedFeatures.constant.js"
import { SharedFeature } from "../models/sharedFeature.model.js"
import mongoose from "mongoose"
import { razorpay } from "../lib/razorpay.js"
import Payment from "../models/payment.model.js"
import { verifyPaymentValidator } from "../validators/payment.validator.js"
import crypto from "crypto"
import logger from "../logger/index.js"
import prisma from "../lib/prisma.js"

if (!process.env.RAZORPAY_KEY_SECRET || !process.env.RAZORPAY_KEY_ID) {
    throw new Error("Missing required env vars: RAZORPAY_KEY_SECRET, RAZORPAY_KEY_ID")
}

const isValidId = (id) => mongoose.Types.ObjectId.isValid(id)

export const seedPlansData = async () => {
    const opsPlan = plansData.map(p => ({
        updateOne: { filter: { planId: p.planId }, update: { $set: p }, upsert: true }
    }))
    const opsFeatures = sharedFeaturesSeed.map(f => ({
        updateOne: { filter: { iconKey: f.iconKey }, update: { $set: f }, upsert: true }
    }))
    await Plan.bulkWrite(opsPlan)
    await SharedFeature.bulkWrite(opsFeatures)
    logger.info("Plans and shared features seeded")
}

const getPaymentPlans = asyncHandler(async (req, res) => {
    const [plans, sharedFeatures] = await Promise.all([
        Plan.find({}).lean(),
        SharedFeature.find({}).lean()
    ])
    return res
        .status(200)
        .json(new ApiResponse(200, { plans, sharedFeatures }, "Plans fetched"))
})

const setSubscription = asyncHandler(async (req, res) => {
    const userId = req.user?.id
    if (!userId) throw new ApiError(401, "Unauthorized")

    // query Prisma user for current plan
    const user = await prisma.user.findUnique({
        where: { id: userId },
        select: { planId: true }
    })

    return res.status(200).json(new ApiResponse(200, {
        planId: user?.planId ?? "free",
    }, "Subscription fetched"))
})

const createOrder = asyncHandler(async (req, res) => {
    const { id } = req.params
    const { billingCycle } = req.body
    const userId = req.user.id

    if (!billingCycle) {
        throw new ApiError(400, "Billing cycle is required")
    }
    if (!id || !isValidId(id)) {
        throw new ApiError(400, "Invalid plan Id")
    }

    const plan = await Plan.findById(id)
    if (!plan) throw new ApiError(404, "Plan not found")

    const amount = billingCycle === "yearly"
        ? plan.priceYearly * 100
        : plan.priceMonthly * 100

    const order = await razorpay.orders.create(
        {
            amount,
            currency: "INR",
            receipt: `rcpt_${userId}_${Date.now()}`,
        }
    )

    await Payment.create({
        userId,
        planId: plan._id,
        razorpayOrderId: order.id,
        amount: order.amount,
        currency: order.currency,
        status: order.status,
        receipt: order.receipt
    })

    return res
        .status(200)
        .json(new ApiResponse(200, { orderId: order.id, amount, currency: "INR", keyId: process.env.RAZORPAY_KEY_ID }, "Payment order created"))
})

const verifyOrder = asyncHandler(async (req, res) => {
    const { data: body, error } = verifyPaymentValidator.safeParse(req.body)

    if (error) {
        throw new ApiError(400, "Invalid payment credentials")
    }

    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } = req.body
    const userId = req.user.id

    const payment = await Payment.findOne({ userId, razorpayOrderId: razorpay_order_id }).populate("planId")

    if (!payment) {
        throw new ApiError(403, "Order does not belong to this user")
    }

    const expected = crypto
        .createHmac("sha256", process.env.RAZORPAY_KEY_SECRET)
        .update(`${razorpay_order_id}|${razorpay_payment_id}`)
        .digest("hex")

    const isValid =
        expected.length === razorpay_signature.length &&
        crypto.timingSafeEqual(Buffer.from(expected, 'utf8'), Buffer.from(razorpay_signature, 'utf8'));

    if (!isValid) {
        await Payment.findOneAndUpdate(
            {
                userId,
                razorpayOrderId: razorpay_order_id
            },
            {
                status: "FAILED",
                failureReason: 'signature mismatch'
            }
        )

        logger.warn('Payment signature mismatch');
        console.error({ orderId: razorpay_order_id, userId: req.user.id });

        throw new ApiError(400, "Payment verification failed")
    }

    const verified = await Payment.findOneAndUpdate(
        {
            userId,
            razorpayOrderId: razorpay_order_id
        },
        {
            razorpayPaymentId: razorpay_payment_id,
            status: "VERIFIED",
        },
        { new: true }
    ).populate("planId")

    const planIdentifier = verified?.planId?.planId

    if (!planIdentifier) {
        logger.error("Plan not found on verified payment")
        console.error({ paymentId: verified._id });
        throw new ApiError(500, "Plan resolution failed after payment")
    }

    await prisma.user.update({
        where: { id: userId },
        data: { planId: planIdentifier }
    })

    return res
        .status(200)
        .json(new ApiResponse(200, {}, "Payment verified successfully"))
})
export { getPaymentPlans, setSubscription, createOrder, verifyOrder }
</file>

