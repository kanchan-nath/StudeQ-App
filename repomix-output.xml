/* notes.module.css — Notes page (scoped) */
/* Colors now sourced from global.css --theme-* vars */

/* ── NOTES-SPECIFIC CSS VARS ─────────────────────────────────── */
.notes-page,
.notes-page * {
  --n-bg: var(--theme-bg);
  --n-surface: var(--theme-surface);
  --n-surface-raised: var(--theme-surface-2);
  --n-border: var(--theme-border);
  --n-border-subtle: var(--theme-border);

  --n-primary: var(--theme-purple);
  --n-primary-dark: var(--theme-purple-light);
  --n-primary-light: var(--theme-purple-dim);
  --n-primary-glow: var(--theme-accent-glow);

  --n-accent: var(--theme-green);
  --n-accent-light: var(--theme-accent-dim);

  --n-purple: var(--theme-purple);
  --n-teal: var(--theme-purple-light);
  --n-danger: var(--theme-red);
  --n-danger-light: rgba(239, 68, 68, 0.1);
  --n-warning: var(--theme-accent);
  --n-pin: var(--theme-accent);

  --n-text-primary: var(--theme-text);
  --n-text-secondary: var(--theme-text-secondary);
  --n-text-muted: var(--theme-text-muted);
  --n-text-inverse: var(--theme-bg);

  --n-sidebar-w: 300px;
  --n-r-sm: 6px;
  --n-r-md: 12px;
  --n-r-lg: 16px;
  --n-r-xl: 24px;
  --n-r-full: 9999px;
  --n-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.08);
  --n-shadow-card: 0 4px 20px rgba(0, 0, 0, 0.18), 0 1px 4px rgba(0, 0, 0, 0.1);
  --n-shadow-lift:
    0 8px 32px rgba(0, 0, 0, 0.28), 0 2px 8px rgba(0, 0, 0, 0.12);
  --n-shadow-glow:
    0 0 0 3px var(--n-primary-light), 0 8px 32px var(--n-primary-glow);

  /* ── MOTION TOKENS ──────────────────────────────────────────── */
  --n-t-fast: 120ms cubic-bezier(0.4, 0, 0.2, 1);
  --n-t-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  --n-t-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);
  --n-t-spring: 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  --n-t-bounce: 400ms cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --n-t-silk: 600ms cubic-bezier(0.23, 1, 0.32, 1);
}

/* ── PAGE LAYOUT ─────────────────────────────────────────────── */
.notes-page {
  display: flex;
  flex-direction: row;
  height: 100%;
  overflow: hidden;
  background: var(--n-bg);
  animation: pageReveal 0.55s cubic-bezier(0.23, 1, 0.32, 1) both;
  transition: background var(--n-t-slow);
}

@keyframes pageReveal {
  from {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(3px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* ── MAIN PANEL (LEFT) ───────────────────────────────────────── */
.notes-main {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--n-bg);
  position: relative;
  transition: background var(--n-t-slow);
  scroll-behavior: smooth;
}

/* Scrollbar — fade in on hover */
.notes-main::-webkit-scrollbar {
  width: 5px;
}

.notes-main::-webkit-scrollbar-track {
  background: transparent;
}

.notes-main::-webkit-scrollbar-thumb {
  background: transparent;
  border-radius: var(--n-r-full);
  transition: background var(--n-t-base);
}

.notes-main:hover::-webkit-scrollbar-thumb {
  background: var(--n-border);
}

.notes-main::-webkit-scrollbar-thumb:hover {
  background: var(--n-text-muted);
}

/* ── MOBILE TOPBAR (hidden on desktop) ───────────────────────── */
.mobile-topbar {
  display: none;
}

/* ── NOTES SIDEBAR (RIGHT) ───────────────────────────────────── */
.sidebar {
  position: relative;
  height: 100%;
  background: var(--n-surface);
  border-left: 1px solid var(--n-border);
  display: flex;
  flex-direction: row;
  transition:
    width var(--n-t-silk),
    background var(--n-t-slow),
    border-color var(--n-t-slow);
  flex-shrink: 0;
  overflow: hidden;
  will-change: width;
}

.sidebarOpen {
  width: 300px;
}

.sidebarClosed {
  width: 36px;
}

.sidebarToggleBtn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 48px;
  background: var(--n-surface-raised);
  border: 1px solid var(--n-border);
  border-left: none;
  border-radius: 0 8px 8px 0;
  cursor: pointer;
  font-size: 14px;
  color: var(--n-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition:
    background var(--n-t-base),
    color var(--n-t-base),
    border-color var(--n-t-slow),
    transform var(--n-t-spring);
  padding: 0;
  flex-shrink: 0;
}

.sidebarToggleBtn:hover {
  background: var(--n-primary-light);
  color: var(--n-primary);
  /* nudge out slightly on hover — spring snaps back */
  transform: translateY(-50%) translateX(2px);
}

.sidebarToggleBtn:active {
  transform: translateY(-50%) translateX(0) scale(0.92);
}

.sidebarContent {
  padding: 24px 16px 24px 48px;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: transparent var(--n-surface-raised);
  transition: scrollbar-color var(--n-t-base);
}

.sidebarContent:hover {
  scrollbar-color: var(--n-border) var(--n-surface-raised);
}

.sidebarContent::-webkit-scrollbar {
  width: 4px;
}

.sidebarContent::-webkit-scrollbar-track {
  background: var(--n-surface-raised);
}

.sidebarContent::-webkit-scrollbar-thumb {
  background: transparent;
  border-radius: 999px;
  transition: background var(--n-t-base);
}

.sidebarContent:hover::-webkit-scrollbar-thumb {
  background: var(--n-border);
}

.sidebarContent::-webkit-scrollbar-thumb:hover {
  background: var(--n-text-muted);
}

/* ── MOBILE SIDEBAR OVERLAY (drawer) ─────────────────────────── */
.sidebarOverlay {
  display: none;
}

/* ── SIDEBAR INTERNALS ───────────────────────────────────────── */
.sidebarHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.sidebarTitle {
  font-size: 15px;
  font-weight: 700;
  color: var(--n-text-primary);
  margin: 0;
}

.sidebarNewBtn {
  width: 26px;
  height: 26px;
  border: 1px solid var(--n-border);
  border-radius: 6px;
  background: var(--n-surface-raised);
  color: var(--n-text-secondary);
  font-size: 18px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    background var(--n-t-base),
    color var(--n-t-base),
    border-color var(--n-t-base),
    transform var(--n-t-spring),
    box-shadow var(--n-t-base);
}

.sidebarNewBtn:hover {
  background: var(--n-primary);
  color: var(--theme-text);
  border-color: var(--n-primary);
  transform: scale(1.12) rotate(8deg);
  box-shadow: 0 4px 12px var(--n-primary-glow);
}

.sidebarNewBtn:active {
  transform: scale(0.9) rotate(0deg);
}

.sidebarGroupLabel {
  font-size: 11px;
  font-weight: 600;
  color: var(--n-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 14px 0 8px;
}

.sidebarEmpty {
  font-size: 13px;
  color: var(--n-text-muted);
  margin: 0;
}

/* Sidebar items — staggered entry animation */
.sidebarItem {
  padding: 12px 14px;
  border: 1.5px solid var(--n-border);
  border-radius: 8px;
  margin-bottom: 10px;
  cursor: pointer;
  background: var(--n-surface-raised);
  transition:
    background var(--n-t-base),
    border-color var(--n-t-base),
    transform var(--n-t-spring),
    box-shadow var(--n-t-base);
  animation: itemSlideIn var(--n-t-silk) both;
  will-change: transform;
}

/* Stagger delay — apply via nth-child or inline style in JSX */
.sidebarItem:nth-child(1) {
  animation-delay: 40ms;
}

.sidebarItem:nth-child(2) {
  animation-delay: 80ms;
}

.sidebarItem:nth-child(3) {
  animation-delay: 120ms;
}

.sidebarItem:nth-child(4) {
  animation-delay: 160ms;
}

.sidebarItem:nth-child(5) {
  animation-delay: 200ms;
}

.sidebarItem:nth-child(n + 6) {
  animation-delay: 240ms;
}

@keyframes itemSlideIn {
  from {
    opacity: 0;
    transform: translateX(16px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.sidebarItem:hover {
  border-color: var(--n-primary-dark);
  background: var(--n-primary-light);
  transform: translateX(-3px);
  box-shadow:
    3px 0 0 0 var(--n-primary) inset,
    var(--n-shadow-sm);
}

.sidebarItemActive {
  border-color: var(--n-primary) !important;
  background: var(--n-primary-light) !important;
  transform: translateX(-3px) !important;
  box-shadow:
    3px 0 0 0 var(--n-primary) inset,
    var(--n-shadow-sm) !important;
}

.sidebarItemTitle {
  font-size: 13px;
  font-weight: 600;
  color: var(--n-text-primary);
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color var(--n-t-fast);
}

.sidebarItem:hover .sidebarItemTitle,
.sidebarItemActive .sidebarItemTitle {
  color: var(--n-primary);
}

.sidebarItemMeta {
  font-size: 11px;
  color: var(--n-text-muted);
  transition: color var(--n-t-fast);
}

/* ── ERROR ───────────────────────────────────────────────────── */
.notes-error {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid var(--n-danger);
  border-radius: var(--n-r-lg);
  font-size: 0.85rem;
  box-shadow: var(--n-shadow-lift);
  z-index: 100;
  animation: errorBounceUp 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.notes-error button {
  background: none;
  color: var(--n-danger);
  font-size: 1rem;
  padding: 0 4px;
  opacity: 0.7;
  transition:
    opacity var(--n-t-fast),
    transform var(--n-t-spring);
}

.notes-error button:hover {
  opacity: 1;
  transform: scale(1.2) rotate(90deg);
}

/* ── WELCOME PANEL ───────────────────────────────────────────── */
.welcome-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding: 48px 24px;
  animation: pageReveal 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
}

.welcome-panel__inner {
  max-width: 580px;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.welcome-panel__icon-wrap {
  width: 72px;
  height: 72px;
  border-radius: var(--n-r-xl);
  background: linear-gradient(
    135deg,
    var(--n-primary),
    var(--theme-purple-light)
  );
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 32px var(--n-primary-glow);
  animation:
    iconFloat 4s ease-in-out infinite,
    iconReveal 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  will-change: transform, box-shadow;
}

@keyframes iconReveal {
  from {
    opacity: 0;
    transform: scale(0.5) rotate(-15deg);
  }

  to {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

@keyframes iconFloat {
  0%,
  100% {
    transform: translateY(0);
    box-shadow: 0 8px 32px var(--n-primary-glow);
  }

  50% {
    transform: translateY(-6px);
    box-shadow:
      0 16px 48px var(--n-primary-glow),
      0 0 0 8px var(--n-primary-light);
  }
}

.welcome-panel__sparkle {
  font-size: 2rem;
  color: var(--theme-text);
  animation: sparkleWiggle 3s ease-in-out infinite;
}

@keyframes sparkleWiggle {
  0%,
  100% {
    transform: rotate(0deg) scale(1);
  }

  25% {
    transform: rotate(-8deg) scale(1.1);
  }

  75% {
    transform: rotate(8deg) scale(1.1);
  }
}

.welcome-panel__heading {
  font-family: var(--font-display);
  font-size: 1.9rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.2;
  animation: fadeUpStagger 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.2s both;
}

.welcome-panel__sub {
  font-size: 0.95rem;
  color: var(--n-text-secondary);
  max-width: 420px;
  line-height: 1.7;
  animation: fadeUpStagger 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.3s both;
}

@keyframes fadeUpStagger {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome-panel__features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  width: 100%;
  text-align: left;
  margin: 8px 0;
  animation: fadeUpStagger 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.4s both;
}

.welcome-feature {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-lg);
  transition:
    box-shadow var(--n-t-base),
    transform var(--n-t-spring),
    border-color var(--n-t-base),
    background var(--n-t-slow);
  cursor: default;
}

.welcome-feature:hover {
  box-shadow:
    var(--n-shadow-card),
    0 0 0 1px var(--n-primary);
  border-color: var(--n-primary);
  transform: translateY(-4px) scale(1.01);
}

.welcome-feature:active {
  transform: translateY(-1px) scale(0.99);
}

.welcome-feature__icon {
  font-size: 1.4rem;
  flex-shrink: 0;
  margin-top: 2px;
  transition: transform var(--n-t-spring);
}

.welcome-feature:hover .welcome-feature__icon {
  transform: scale(1.2) rotate(-5deg);
}

.welcome-feature strong {
  display: block;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--n-text-primary);
  margin-bottom: 2px;
  transition: color var(--n-t-fast);
}

.welcome-feature:hover strong {
  color: var(--n-primary);
}

.welcome-feature p {
  font-size: 0.77rem;
  color: var(--n-text-muted);
  line-height: 1.5;
  margin: 0;
}

.welcome-panel__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 28px;
  background: linear-gradient(
    135deg,
    var(--n-primary),
    var(--theme-purple-light)
  );
  color: white;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  border-radius: var(--n-r-full);
  box-shadow: 0 4px 18px var(--n-primary-glow);
  transition:
    transform var(--n-t-spring),
    box-shadow var(--n-t-base),
    filter var(--n-t-fast);
  letter-spacing: 0.01em;
  animation: fadeUpStagger 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.5s both;
  position: relative;
  overflow: hidden;
}

/* Shimmer sweep on hover */
.welcome-panel__cta::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(255, 255, 255, 0.18) 50%,
    transparent 70%
  );
  transform: translateX(-100%);
  transition: transform 0.55s cubic-bezier(0.23, 1, 0.32, 1);
}

.welcome-panel__cta:hover::after {
  transform: translateX(100%);
}

.welcome-panel__cta:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 12px 36px var(--n-primary-glow);
  filter: brightness(1.08);
}

.welcome-panel__cta:active {
  transform: translateY(0) scale(0.97);
  box-shadow: 0 4px 18px var(--n-primary-glow);
}

/* ── INPUT FORM CARD ─────────────────────────────────────────── */
.note-input-wrap {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 100%;
  padding: 40px 24px;
  animation: pageReveal 0.5s cubic-bezier(0.23, 1, 0.32, 1) both;
}

.note-input-card {
  width: 100%;
  max-width: 680px;
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-xl);
  box-shadow: var(--n-shadow-card);
  overflow: hidden;
  transition:
    box-shadow var(--n-t-base),
    border-color var(--n-t-base),
    background var(--n-t-slow),
    transform var(--n-t-spring);
}

.note-input-card:focus-within {
  box-shadow: var(--n-shadow-glow);
  border-color: var(--n-primary);
  transform: translateY(-2px);
}

.note-input-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 14px;
  border-bottom: 1px solid var(--n-border-subtle);
  transition: border-color var(--n-t-slow);
}

.note-input-card__label {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--n-primary);
}

.note-input-card__cancel {
  font-size: 0.8rem;
  color: var(--n-text-muted);
  background: transparent;
  padding: 4px 10px;
  border-radius: var(--n-r-full);
  border: 1px solid var(--n-border);
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    border-color var(--n-t-slow),
    transform var(--n-t-spring);
}

.note-input-card__cancel:hover {
  background: var(--n-surface-raised);
  color: var(--n-text-secondary);
  transform: scale(0.97);
}

.note-input-card__form {
  display: flex;
  flex-direction: column;
}

.note-input-card__textarea {
  width: 100%;
  padding: 20px;
  background: transparent;
  border: none;
  outline: none;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.92rem;
  color: var(--n-text-primary);
  line-height: 1.7;
  min-height: 180px;
  transition: color var(--n-t-fast);
}

.note-input-card__textarea::placeholder {
  color: var(--n-text-muted);
  transition: opacity var(--n-t-base);
}

.note-input-card__textarea:focus::placeholder {
  opacity: 0.5;
}

.note-input-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-top: 1px solid var(--n-border-subtle);
  background: var(--n-surface-raised);
  transition:
    background var(--n-t-slow),
    border-color var(--n-t-slow);
}

.note-input-card__hint {
  font-size: 0.75rem;
  color: var(--n-text-muted);
}

.note-input-card__submit {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  background: var(--n-primary);
  color: white;
  font-family: var(--font-display);
  font-size: 0.84rem;
  font-weight: 700;
  border-radius: var(--n-r-full);
  transition:
    background var(--n-t-fast),
    transform var(--n-t-spring),
    box-shadow var(--n-t-base),
    opacity var(--n-t-fast);
  box-shadow: 0 2px 10px var(--n-primary-glow);
  letter-spacing: 0.01em;
  position: relative;
  overflow: hidden;
}

.note-input-card__submit::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(255, 255, 255, 0.15) 50%,
    transparent 70%
  );
  transform: translateX(-100%);
  transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1);
}

.note-input-card__submit:hover:not(:disabled)::after {
  transform: translateX(100%);
}

.note-input-card__submit:hover:not(:disabled) {
  background: var(--n-primary-dark);
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 6px 20px var(--n-primary-glow);
}

.note-input-card__submit:active:not(:disabled) {
  transform: translateY(0) scale(0.97);
}

.note-input-card__submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.note-input-card__submit.loading {
  background: var(--n-primary-dark);
}

/* ── NOTE DOCUMENT ───────────────────────────────────────────── */
.sum-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sum-h1 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.01em;
  margin: 18px 0 6px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--n-primary-light);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: border-color var(--n-t-slow);
}

.sum-h1::before {
  content: "";
  display: inline-block;
  width: 4px;
  height: 18px;
  background: linear-gradient(
    135deg,
    var(--n-primary),
    var(--theme-purple-light)
  );
  border-radius: 99px;
  flex-shrink: 0;
  transition:
    height var(--n-t-spring),
    background var(--n-t-slow);
}

.sum-h1:hover::before {
  height: 22px;
}

.sum-h2 {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--n-primary);
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin: 16px 0 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.sum-h2::before {
  content: "◆";
  font-size: 0.55rem;
  opacity: 0.7;
  transition:
    transform var(--n-t-spring),
    opacity var(--n-t-fast);
}

.sum-h2:hover::before {
  transform: rotate(45deg) scale(1.3);
  opacity: 1;
}

.sum-h3 {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--n-text-secondary);
  margin: 12px 0 2px;
}

.sum-para {
  font-size: 0.93rem;
  color: var(--n-text-secondary);
  line-height: 1.85;
  margin: 0;
}

.sum-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 0;
  margin: 4px 0;
  list-style: none;
}

.sum-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.88rem;
  color: var(--n-text-secondary);
  line-height: 1.7;
  padding: 8px 12px;
  background: var(--n-surface-raised);
  border-radius: var(--n-r-md);
  border-left: 3px solid var(--n-primary);
  transition:
    background var(--n-t-fast),
    border-color var(--n-t-fast),
    transform var(--n-t-spring),
    padding-left var(--n-t-base);
}

.sum-list li:hover {
  background: var(--n-primary-light);
  border-color: var(--theme-purple-light);
  transform: translateX(4px);
  padding-left: 16px;
}

.sum-list li p {
  margin: 0;
}

.note-doc {
  max-width: 760px;
  margin: 0 auto;
  padding: 36px 32px 64px;
  animation: pageReveal 0.55s cubic-bezier(0.23, 1, 0.32, 1) both;
}

.note-doc__header {
  margin-bottom: 28px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--n-border);
  transition: border-color var(--n-t-slow);
}

.note-doc__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.note-doc__badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  background: var(--n-primary-light);
  color: var(--n-primary);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  border-radius: var(--n-r-full);
  border: 1px solid var(--theme-border);
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    transform var(--n-t-spring);
}

.note-doc__badge:hover {
  transform: scale(1.05);
}

.note-doc__badge--pinned {
  background: var(--theme-accent-dim);
  color: var(--n-pin);
  border-color: var(--theme-border-hover);
}

.note-doc__title {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--n-text-primary);
  letter-spacing: -0.02em;
  line-height: 1.25;
  margin-bottom: 20px;
  animation: fadeUpStagger 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.1s both;
}

.note-doc__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  animation: fadeUpStagger 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.2s both;
}

.note-doc__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--n-r-md);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    transform var(--n-t-spring),
    box-shadow var(--n-t-base),
    border-color var(--n-t-slow);
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

.note-doc__btn:hover {
  transform: translateY(-2px);
}

.note-doc__btn:active {
  transform: translateY(0) scale(0.96);
}

.note-doc__btn--ghost {
  background: var(--n-surface-raised);
  color: var(--n-text-secondary);
  border: 1px solid var(--n-border);
}

.note-doc__btn--ghost:hover {
  background: var(--n-primary-light);
  color: var(--n-primary);
  border-color: var(--n-primary);
  box-shadow: 0 4px 12px var(--n-primary-glow);
}

.note-doc__btn--primary {
  background: var(--n-primary);
  color: white;
  box-shadow: 0 2px 8px var(--n-primary-glow);
}

.note-doc__btn--primary::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(255, 255, 255, 0.15) 50%,
    transparent 70%
  );
  transform: translateX(-100%);
  transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1);
}

.note-doc__btn--primary:hover::after {
  transform: translateX(100%);
}

.note-doc__btn--primary:hover {
  background: var(--n-primary-dark);
  box-shadow: 0 6px 20px var(--n-primary-glow);
}

.note-doc__btn--danger {
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.note-doc__btn--danger:hover {
  background: var(--n-danger);
  color: var(--theme-bg);
  border-color: var(--n-danger);
  box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
}

.note-doc__body {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.note-doc__section {
  background: var(--n-surface);
  border: 1px solid var(--n-border);
  border-radius: var(--n-r-xl);
  padding: 24px 28px;
  box-shadow: var(--n-shadow-sm);
  transition:
    box-shadow var(--n-t-base),
    border-color var(--n-t-base),
    background var(--n-t-slow),
    transform var(--n-t-spring);
  animation: sectionReveal 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
}

.note-doc__section:nth-child(1) {
  animation-delay: 0.05s;
}

.note-doc__section:nth-child(2) {
  animation-delay: 0.12s;
}

.note-doc__section:nth-child(3) {
  animation-delay: 0.19s;
}

.note-doc__section:nth-child(n + 4) {
  animation-delay: 0.25s;
}

@keyframes sectionReveal {
  from {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(2px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

.note-doc__section:hover {
  box-shadow:
    var(--n-shadow-card),
    0 0 0 1px var(--n-primary-light);
  border-color: var(--n-border-subtle);
  transform: translateY(-1px);
}

.note-doc__section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--n-text-muted);
  margin-bottom: 16px;
  transition: color var(--n-t-fast);
}

.note-doc__section:hover .note-doc__section-title {
  color: var(--n-text-secondary);
}

.note-doc__section-icon {
  color: var(--n-primary);
  font-size: 1rem;
  transition: transform var(--n-t-spring);
}

.note-doc__section:hover .note-doc__section-icon {
  transform: scale(1.2) rotate(-8deg);
}

.note-doc__summary-text {
  font-size: 0.96rem;
  color: var(--n-text-secondary);
  line-height: 1.9;
  letter-spacing: 0.01em;
  padding: 4px 0;
}

.note-doc__keypoints {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.note-doc__keypoint {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 12px 16px;
  background: var(--n-surface-raised);
  border-radius: var(--n-r-md);
  border: 1px solid var(--n-border-subtle);
  transition:
    border-color var(--n-t-fast),
    background var(--n-t-fast),
    transform var(--n-t-spring),
    box-shadow var(--n-t-base);
  animation: keypointSlide 0.5s cubic-bezier(0.23, 1, 0.32, 1) both;
}

/* stagger keypoints */
.note-doc__keypoint:nth-child(1) {
  animation-delay: 0.08s;
}

.note-doc__keypoint:nth-child(2) {
  animation-delay: 0.14s;
}

.note-doc__keypoint:nth-child(3) {
  animation-delay: 0.2s;
}

.note-doc__keypoint:nth-child(4) {
  animation-delay: 0.26s;
}

.note-doc__keypoint:nth-child(n + 5) {
  animation-delay: 0.3s;
}

@keyframes keypointSlide {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.note-doc__keypoint:hover {
  border-color: var(--n-primary);
  background: var(--n-primary-light);
  transform: translateX(4px);
  box-shadow: -3px 0 0 0 var(--n-primary) inset;
}

.note-doc__keypoint-num {
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--n-primary);
  background: var(--n-primary-light);
  border-radius: var(--n-r-sm);
  padding: 2px 6px;
  flex-shrink: 0;
  margin-top: 1px;
  letter-spacing: 0.04em;
  min-width: 28px;
  text-align: center;
  transition:
    background var(--n-t-fast),
    color var(--n-t-fast),
    transform var(--n-t-spring);
}

.note-doc__keypoint:hover .note-doc__keypoint-num {
  background: var(--n-primary);
  color: var(--theme-text);
  transform: scale(1.1);
}

.note-doc__keypoint span:last-child {
  font-size: 0.88rem;
  color: var(--n-text-secondary);
  line-height: 1.65;
  transition: color var(--n-t-fast);
}

.note-doc__keypoint:hover span:last-child {
  color: var(--n-text-primary);
}

/* ── TOAST ───────────────────────────────────────────────────── */
.toast {
  position: fixed;
  top: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  border-radius: var(--n-r-lg);
  font-size: 0.85rem;
  font-weight: 500;
  box-shadow: var(--n-shadow-lift);
  z-index: 200;
  animation: toastIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  max-width: 340px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateX(30px) scale(0.9);
    filter: blur(4px);
  }

  to {
    opacity: 1;
    transform: translateX(0) scale(1);
    filter: blur(0);
  }
}

.toast--success {
  background: rgba(34, 197, 94, 0.12);
  color: var(--theme-green);
  border: 1px solid rgba(34, 197, 94, 0.25);
}

.toast--error {
  background: var(--n-danger-light);
  color: var(--n-danger);
  border: 1px solid rgba(239, 68, 68, 0.25);
}

.toast__icon {
  font-size: 0.9rem;
  flex-shrink: 0;
  animation: iconPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
}

@keyframes iconPop {
  from {
    transform: scale(0);
  }

  to {
    transform: scale(1);
  }
}

.toast__msg {
  flex: 1;
}

.toast__close {
  background: none;
  color: inherit;
  font-size: 0.85rem;
  opacity: 0.6;
  padding: 0 2px;
  transition:
    opacity var(--n-t-fast),
    transform var(--n-t-spring);
  flex-shrink: 0;
}

.toast__close:hover {
  opacity: 1;
  transform: scale(1.2) rotate(90deg);
}

/* ── SPINNER ─────────────────────────────────────────────────── */
.spinner {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: var(--theme-text);
  border-radius: 50%;
  animation: spin 0.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  flex-shrink: 0;
}

.spinner--sm {
  width: 12px;
  height: 12px;
  border-color: var(--theme-border);
  border-top-color: var(--n-text-muted);
}
.sidebarCloseBtn {
  display: none;
}
/* ── ANIMATIONS ──────────────────────────────────────────────── */
@keyframes errorBounceUp {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(24px) scale(0.9);
  }

  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ── FOCUS VISIBLE ────────────────────────────────────────────── */
.note-doc__btn:focus-visible,
.sidebarNewBtn:focus-visible,
.sidebarToggleBtn:focus-visible,
.welcome-panel__cta:focus-visible,
.note-input-card__submit:focus-visible {
  outline: 2px solid var(--n-primary);
  outline-offset: 2px;
  box-shadow: 0 0 0 4px var(--n-primary-light);
}

/* ── REDUCED MOTION ───────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  .note-doc {
    padding: 28px 20px 48px;
  }

  .welcome-panel__features {
    grid-template-columns: 1fr;
  }

  .welcome-panel__heading {
    font-size: 1.55rem;
  }
}

@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 85vw !important;
    max-width: 320px;
    z-index: 300;
    border-left: 1px solid var(--n-border);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    transition:
      transform var(--n-t-silk),
      background var(--n-t-slow),
      border-color var(--n-t-slow);
    display: flex;
    will-change: transform;
  }

  .sidebar.sidebarMobileOpen {
    transform: translateX(0);
  }

  .sidebarToggleBtn {
    display: none;
  }

  .sidebarContent {
    padding: 24px 16px;
    width: 100%;
  }

  .sidebarOverlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 299;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: overlayFadeIn 0.3s ease both;
  }

  @keyframes overlayFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .mobile-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--n-surface);
    border-bottom: 1px solid var(--n-border);
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background var(--n-t-slow),
      border-color var(--n-t-slow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .mobile-topbar__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--n-text-primary);
    letter-spacing: -0.01em;
  }

  .mobile-topbar__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mobile-topbar__btn {
    width: 36px;
    height: 36px;
    border-radius: var(--n-r-md);
    border: 1px solid var(--n-border);
    background: var(--n-surface-raised);
    color: var(--n-text-secondary);
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background var(--n-t-base),
      color var(--n-t-base),
      border-color var(--n-t-base),
      transform var(--n-t-spring);
  }

  .mobile-topbar__btn:hover,
  .mobile-topbar__btn:active {
    background: var(--n-primary-light);
    color: var(--n-primary);
    border-color: var(--n-primary);
    transform: scale(0.94);
  }

  .sidebarCloseBtn {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--n-border);
    background: var(--n-surface-raised);
    color: var(--n-text-muted);
    font-size: 14px;
    cursor: pointer;
    transition:
      background var(--n-t-fast),
      color var(--n-t-fast),
      transform var(--n-t-spring);
    flex-shrink: 0;
  }

  .sidebarCloseBtn:hover {
    background: var(--n-danger-light);
    color: var(--n-danger);
    border-color: var(--n-danger);
    transform: scale(1.1) rotate(90deg);
  }
}

@media (max-width: 640px) {
  .note-doc {
    padding: 20px 16px 48px;
  }

  .note-doc__title {
    font-size: 1.3rem;
  }

  .note-doc__actions {
    gap: 6px;
  }

  .note-doc__btn {
    padding: 6px 10px;
    font-size: 0.75rem;
  }

  .note-doc__section {
    padding: 18px 16px;
  }

  .note-doc__keypoint {
    gap: 10px;
    padding: 10px 12px;
  }

  .note-doc__keypoint-num {
    min-width: 24px;
    font-size: 0.65rem;
  }

  .welcome-panel {
    padding: 32px 16px;
  }

  .welcome-panel__heading {
    font-size: 1.35rem;
  }

  .welcome-panel__features {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .note-input-wrap {
    padding: 16px 12px;
  }

  .note-input-card {
    border-radius: var(--n-r-lg);
  }

  .note-input-card__footer {
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 14px;
  }

  .note-input-card__hint {
    width: 100%;
    order: 2;
  }

  .note-input-card__submit {
    order: 1;
    width: 100%;
    justify-content: center;
  }

  .toast {
    top: 12px;
    right: 12px;
    left: 12px;
    max-width: none;
  }
}

/* ── SAFE AREA (notch / home-bar) ────────────────────────────── */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  @media (max-width: 768px) {
    .notes-main {
      padding-bottom: env(safe-area-inset-bottom);
    }

    .sidebar {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
}
