  gap: 8px;
  transition: opacity 0.4s ease;
}

.tickerDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--theme-accent);
  box-shadow: 0 0 6px var(--theme-green);
  flex-shrink: 0;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {

  0%,
  100% {
    box-shadow: 0 0 6px var(--theme-accent);
  }

  50% {
    box-shadow: 0 0 14px var(--theme-accent);
  }
}

/* ── NAVBAR ──────────────────────────────────────────────────────────────── */
.navbar {
  position: fixed;
  top: 25px;
  left: 100px;
  right: 100px;
  z-index: 100;
  display: flex;
  height: var(--navbar-h);
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  transition:
    background var(--t-slow),
    backdrop-filter var(--t-slow),
    box-shadow var(--t-slow);
}
.ctaWrapper {
  display: flex;
  align-items: center;
  /* Vertical alignment */
  gap: 16px;
  /* Space between toggle and button */
}

.navbarScrolled {
  background: transparent;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1px 0 var(--theme-border);
}

.navInner {
  width: 100%;
  max-width: var(--max-w);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.navPill {
  background: var(--theme-navbar-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  height: 48px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 32px;
}

.navLogo {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--theme-text);
  text-decoration: none;
  white-space: nowrap;
}

.navLogo span {
  color: var(--theme-accent);
}

.navLinks {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.navLink {
  font-size: 14px;
  font-weight: 600;
  color: var(--theme-text-muted);
  text-decoration: none;
  transition: color var(--t-fast);
}

.navLink:hover {
  color: var(--theme-text);
}

.navCta {
  background: var(--theme-accent);
  color: var(--theme-bg);
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: var(--r-full);
  text-decoration: none;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast),
    background var(--t-fast);
  white-space: nowrap;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.navCta:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px var(--theme-accent-glow);
}

/* ── HERO ────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(var(--navbar-h) + 32px + 32px) 24px 80px;
  overflow: hidden;
  z-index: 1;
}

.beam1 {
  position: absolute;
  top: -20%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle,
      var(--beam-purple-strong, rgba(124, 95, 245, 0.4)) 0%,
      transparent 70%);
  filter: blur(80px);
  pointer-events: none;
}

.beam2 {
  position: absolute;
  top: 30%;
  left: -15%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,
      var(--beam-purple-light, rgba(192, 132, 252, 0.3)) 0%,
      transparent 70%);
  filter: blur(60px);
  pointer-events: none;
}

.beam3 {
  position: absolute;
  bottom: -10%;
  right: 20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle,
      var(--beam-accent, rgba(255, 209, 102, 0.15)) 0%,
      transparent 70%);
  filter: blur(80px);
  pointer-events: none;
}

.beam4 {
  position: absolute;
  top: 50%;
  left: 30%;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle,
      var(--beam-purple-soft, rgba(124, 95, 245, 0.2)) 0%,
      transparent 70%);
  filter: blur(40px);
  pointer-events: none;
}

/* beam vars — light mode tones them down */
:global([data-theme="light"]) .beam1 {
  --beam-purple-strong: rgba(124, 95, 245, 0.12);
}

:global([data-theme="light"]) .beam2 {
  --beam-purple-light: rgba(192, 132, 252, 0.1);
}

:global([data-theme="light"]) .beam3 {
  --beam-accent: rgba(196, 154, 0, 0.08);
}

:global([data-theme="light"]) .beam4 {
  --beam-purple-soft: rgba(124, 95, 245, 0.07);
}

.heroContent {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 780px;
  gap: 20px;
}

.heroBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 500;
  color: var(--theme-purple-light);
  animation: fadeDown 0.6s ease both;
}

.heroBadgeArrow {
  opacity: 0.7;
}

.heroH1 {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: var(--theme-text);
  margin: 0;
  animation: fadeDown 0.6s 0.1s ease both;
}

.heroSub {
  font-size: clamp(1rem, 2vw, 1.2rem);
  color: var(--theme-text-muted);
  max-width: 520px;
  margin: 0;
  animation: fadeDown 0.6s 0.2s ease both;
}

.heroActions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  animation: fadeDown 0.6s 0.3s ease both;
}

.heroCta {
  background: var(--theme-accent);
  color: var(--theme-bg);
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  padding: 14px 32px;
  border-radius: var(--r-full);
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition:
    transform var(--t-fast),
    box-shadow var(--t-fast);
}

.heroCta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px var(--theme-accent-glow);
}

.heroSubjectRow {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.subjectChip {
  background: var(--theme-navbar-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 13px;
  color: var(--theme-text-muted);
  cursor: pointer;
  transition:
    background var(--t-fast),
    border-color var(--t-fast),
    color var(--t-fast);
  font-family: var(--font-body);
}

.subjectChip:hover {
  background: var(--theme-accent-dim);
  border-color: var(--theme-accent-dim);
  color: var(--theme-accent);
}

.dropZone {
  position: relative;
  z-index: 2;
  margin-top: 32px;
  width: 100%;
  max-width: 480px;
  border: 2px dashed var(--theme-border-hover);
  border-radius: var(--r-xl);
  padding: 28px 24px;
  text-align: center;
  cursor: pointer;
  transition:
    border-color var(--t-base),
    background var(--t-base);
  animation: fadeDown 0.6s 0.4s ease both;
  background: var(--theme-input-bg);
}

.dropZone:hover {
  border-color: var(--theme-purple-dim);
  background: var(--theme-purple-dim);
}

.dropIcon {
  font-size: 2rem;
  margin-bottom: 8px;
  display: block;
}

.dropText {
  font-size: 15px;
  color: var(--theme-text-muted);
  margin: 0;
}

.dropSub {
  font-size: 12px;
  color: var(--theme-text-secondary);
  margin: 6px 0 0;
}

.sparkMeter {
  position: absolute;
  bottom: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--theme-accent-dim);
  border: 1px solid var(--theme-accent-glow);
  border-radius: var(--r-full);
  padding: 6px 14px;
  font-size: 12px;
  color: var(--theme-accent);
  font-weight: 600;
  z-index: 3;
}

/* ── MARQUEE ─────────────────────────────────────────────────────────────── */
.marqueeSection {
  position: relative;
  z-index: 1;
  padding: 20px 0 48px;
  overflow: hidden;
}

.marqueeLabel {
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--theme-text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.marqueeTrack {
  display: flex;
  width: max-content;
  animation: marqueeScroll 22s linear infinite;
}

.marqueeTrack:hover {
  animation-play-state: paused;
}

.marqueeList {
  display: flex;
  align-items: center;
  gap: 64px;
  list-style: none;
  margin: 0;
  padding: 0 32px;
}

.marqueeItem {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--theme-text-secondary);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: color var(--t-fast);
  opacity: 0.4;
}

.marqueeItem:hover {
  opacity: 1;
  color: var(--theme-text);
}

@keyframes marqueeScroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

/* ── SECTION COMMON ──────────────────────────────────────────────────────── */
.section {
  position: relative;
  z-index: 1;
  padding: 80px 24px;
}

.sectionInner {
  max-width: var(--max-w);
  margin: 0 auto;
}

.sectionBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-purple-light);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.sectionH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--theme-text);
  margin: 0 0 16px;
}

.sectionSub {
  font-size: 17px;
  color: var(--theme-text-muted);
  max-width: 540px;
  line-height: 1.65;
  margin: 0;
}

.centered {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── REVEAL ANIMATION ────────────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s ease-out,
    transform 0.6s ease-out;
}

.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* ── FEATURE TABS ────────────────────────────────────────────────────────── */
.tabsWrap {
  margin-top: 40px;
}

.tabNav {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--theme-border);
  margin-bottom: 0;
  list-style: none;
  padding: 0;
}

.tabBtn {
  position: relative;
  padding: 12px 28px;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--theme-text-muted);
  background: none;
  border: none;
  cursor: pointer;
  transition: color var(--t-fast);
}

.tabBtn::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--theme-accent);
  width: 0;
  transition: width 0.25s ease-out;
}

.tabBtnActive {
  color: var(--theme-text);
}

.tabBtnActive::after {
  width: 100%;
}

.tabPanel {
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-top: none;
  border-radius: 0 0 var(--r-lg) var(--r-lg);
  padding: 36px;
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
  pointer-events: none;
  position: absolute;
  width: 100%;
}

.tabPanelActive {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
  position: relative;
}

.tabPanelContainer {
  position: relative;
}

.tabPanelText {
  font-size: 16px;
  color: var(--theme-text-muted);
  line-height: 1.8;
  max-width: 640px;
  margin: 0;
}

.tabFeatureList {
  list-style: none;
  padding: 0;
  margin: 20px 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tabFeatureItem {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 15px;
  color: var(--theme-text-muted);
}

.tabCheckIcon {
  color: var(--theme-green);
  font-size: 16px;
  margin-top: 2px;
  flex-shrink: 0;
}

/* ── DEVICES MOCKUP ──────────────────────────────────────────────────────── */
.devicesWrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48px;
  margin-top: 48px;
  flex-wrap: wrap;
}

.deviceLaptop {
  position: relative;
}

.laptopScreen {
  width: 420px;
  height: 260px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.laptopScreenGlow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 40%,
      var(--theme-purple-dim) 0%,
      transparent 60%);
}

.laptopScreenContent {
  position: relative;
  z-index: 1;
  padding: 20px;
  width: 100%;
}

.mockNoteTitle {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--theme-text);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.mockNoteLine {
  height: 6px;
  border-radius: 3px;
  background: var(--theme-border-hover);
  margin-bottom: 6px;
}

.mockNoteLineShort {
  width: 55%;
}

.laptopBase {
  width: 460px;
  height: 12px;
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-top: none;
  border-radius: 0 0 4px 4px;
}

.laptopFoot {
  width: 200px;
  height: 6px;
  background: var(--theme-surface-2);
  border-radius: 0 0 var(--r-sm) var(--r-sm);
  margin: 0 auto;
  border: 1px solid var(--theme-border);
  border-top: none;
}

.devicePhone {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phoneFrame {
  width: 110px;
  height: 200px;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
  gap: 6px;
}

.phoneNotch {
  width: 40px;
  height: 8px;
  background: var(--theme-bg);
  border-radius: var(--r-full);
  flex-shrink: 0;
}

.phoneLine {
  height: 5px;
  border-radius: 3px;
  background: var(--theme-border-hover);
  width: 80%;
}

.phoneSyncBadge {
  position: absolute;
  bottom: 12px;
  background: var(--theme-green-dim, rgba(34, 197, 94, 0.15));
  border: 1px solid var(--theme-green-border, rgba(34, 197, 94, 0.3));
  border-radius: var(--r-full);
  padding: 3px 8px;
  font-size: 9px;
  color: var(--theme-green);
  font-weight: 600;
}

/* light mode green badge values */
:global([data-theme="light"]) .phoneSyncBadge {
  --theme-green-dim: rgba(22, 163, 74, 0.1);
  --theme-green-border: rgba(22, 163, 74, 0.25);
}

.devicesCaption {
  text-align: center;
  margin-top: 28px;
  font-size: 15px;
  color: var(--theme-text-muted);
}

/* ── COMPARISON ──────────────────────────────────────────────────────────── */
.comparisonSection {
  background: transparent;
  /* border-top: 1px solid var(--theme-border); */
  /* border-bottom: 1px solid var(--theme-border); */
}

.comparisonGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 40px;
}

.compCol {
  background: var(--theme-surface);
  border: 1px solid var(--theme-red);
  border-radius: var(--r-xl);
  padding: 28px 32px;
}

.compColLeft {
  border-color: var(--theme-green);
  box-shadow:
    0 0 0 1px var(--theme-purple-dim),
    0 4px 32px var(--theme-purple-dim);
  /* background: linear-gradient(160deg, #ff0000 0%, var(--theme-bg) 50%); */
}

.compHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.compLogo {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--theme-text);
}

.compLogoAccent {
  color: var(--theme-accent);
}

.compLogoMuted {
  color: var(--theme-text-muted);
  font-weight: 500;
  font-size: 0.9rem;
  letter-spacing: 0;
  text-transform: none;
}

.compList {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.compItem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--theme-border);
  font-size: 14px;
  line-height: 1.55;
}

.compItem:last-child {
  border-bottom: none;
}

.compDotGreen span {
  flex-shrink: 0;
  align-self: center;
  color: var(--theme-green);
}

.compDotRed span {
  flex-shrink: 0;
  color: var(--theme-red);
  align-self: center;
}

.compTextGood {
  color: var(--theme-text-muted);
}

.compTextBad {
  color: var(--theme-text-muted);
  font-style: italic;
}

.compFeatureLabel {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--theme-purple-light);
  display: block;
  margin-bottom: 2px;
}

/* ── TIMELINE ────────────────────────────────────────────────────────────── */
.timelineSection {
  background: transparent;
}

.timelineH2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--theme-text);
  margin: 0 0 16px;
  text-align: center;
}

.timelineSub {
  font-size: 16px;
  color: var(--theme-text-secondary);
  text-align: center;
  margin: 0 0 56px;
}

.timelineBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-purple);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.timelineWrap {
  position: relative;
  max-width: 680px;
  margin: 0 auto;
}

.timelineLine {
  position: absolute;
  left: 42px;
  top: 0;
  width: 2px;
  height: 0;
  background: linear-gradient(to bottom,
      var(--theme-purple),
      var(--theme-purple-light));
  z-index: 0;
}

.timelineLineGrown {
  height: 100%;
}

.timelineItem {
  display: flex;
  gap: 24px;
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s ease-out,
    transform 0.6s ease-out;
}

.timelineItemVisible {
  opacity: 1;
  transform: translateY(0);
}

.timelineLeft {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
}

.timelineNum {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--theme-bg);
  border: 2px solid var(--theme-purple-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 800;
  color: var(--theme-purple);
  flex-shrink: 0;
  box-shadow: 0 0 0 4px var(--theme-purple-dim);
  position: relative;
  z-index: 1;
}

.timelineRight {
  padding-top: 10px;
  padding-bottom: 8px;
}

.timelinePill {
  display: inline-flex;
  background: var(--theme-purple-dim);
  border: 1px solid var(--theme-purple-dim);
  border-radius: var(--r-full);
  padding: 3px 12px;
  font-size: 11px;
  font-weight: 700;
  color: var(--theme-purple);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
}

.timelineTitle {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--theme-text);
  line-height: 1.25;
  margin: 0 0 6px;
}

.timelineDesc {
  font-size: 15px;
  color: var(--theme-text-secondary);
  line-height: 1.65;
  margin: 0;
}

/* ── STATS BAR ───────────────────────────────────────────────────────────── */
.statsBar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  border-top: 1px solid var(--theme-border);
  border-bottom: 1px solid var(--theme-border);
  background: var(--theme-input-bg);
}

.statItem {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
