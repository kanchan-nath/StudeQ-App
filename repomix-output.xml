<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/* ============================================================
   Dashboard.module.css
   NO :root — all tokens consumed from global.css
   Theme switching: data-theme="dark"|"light" on &lt;html&gt;
   ============================================================ */
&nbsp;
/* ── Shell ───────────────────────────────────────────────── */
.appShell {
  display: flex;
  min-height: 100vh;
  width: 100%;
  background: var(--theme-bg);
  font-family: var(--font-body);
  color: var(--theme-text);
  overflow-x: hidden;
}
&nbsp;
/* ── Main ────────────────────────────────────────────────── */
.main {
  margin-left: 64px;
  flex: 1;
  min-height: 100vh;
  padding: 28px 28px 48px;
  display: flex;
  flex-direction: column;
  gap: 22px;
  background: var(--theme-bg);
  overflow-y: auto;
  scroll-behavior: smooth;
}
&nbsp;
/* ── Top bar ─────────────────────────────────────────────── */
.topBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
&nbsp;
.sessionIndicator {
  display: flex;
  align-items: center;
  gap: 12px;
}
&nbsp;
.pulseDot {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}
&nbsp;
.pulseDotCore {
  position: relative;
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--theme-purple);
}
&nbsp;
.pulseDotRing {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--theme-purple);
  opacity: 0.6;
  animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
}
&nbsp;
@keyframes ping {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
&nbsp;
  80% {
    transform: scale(2.2);
    opacity: 0;
  }
&nbsp;
  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}
&nbsp;
.sessionLabel {
  font-family: var(--font-display);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--theme-text-muted);
  margin: 0 0 2px;
}
&nbsp;
.welcomeHeading {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
  color: var(--theme-text);
  line-height: 1.2;
}
&nbsp;
.welcomeName {
  color: var(--theme-purple);
}
&nbsp;
/* Skeleton for loading state */
.skeletonHeading {
  height: 26px;
  width: 220px;
  border-radius: var(--r-sm);
  background: linear-gradient(90deg,
      var(--theme-surface-2) 25%,
      var(--theme-surface) 50%,
      var(--theme-surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
&nbsp;
.skeletonLine {
  height: 14px;
  width: 140px;
  border-radius: var(--r-sm);
  background: linear-gradient(90deg,
      var(--theme-surface-2) 25%,
      var(--theme-surface) 50%,
      var(--theme-surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-bottom: 4px;
}
&nbsp;
.skeletonLineSm {
  width: 90px;
  height: 11px;
}
&nbsp;
@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
&nbsp;
  100% {
    background-position: -200% 0;
  }
}
&nbsp;
.dateChip {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-display);
  font-size: 12px;
  color: var(--theme-text-secondary);
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 6px 12px;
}
&nbsp;
/* ── Quick strip ─────────────────────────────────────────── */
.quickStrip {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}
&nbsp;
.quickStrip::-webkit-scrollbar {
  display: none;
}
&nbsp;
.stripBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: var(--r-full);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  text-decoration: none;
  transition: opacity 0.15s, transform 0.15s;
  flex-shrink: 0;
}
&nbsp;
.stripBtn:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}
&nbsp;
.stripBtnPrimary {
  background: var(--theme-purple);
  color: #fff;
}
&nbsp;
.stripBtnSecondary {
  background: var(--theme-surface-2);
  color: var(--theme-text);
  border: 1px solid var(--theme-border);
}
&nbsp;
/* ── Dashboard grid ──────────────────────────────────────── */
.dashGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto auto;
  gap: 14px;
}
&nbsp;
/* ── Base card ───────────────────────────────────────────── */
.card {
  position: relative;
  background: var(--theme-surface-2);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-xl);
  padding: 22px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);;
}
&nbsp;
.card:hover {
  border-color: var(--theme-border-hover);
  transform: translateY(-2px);
  box-shadow: var(--theme-card-shadow);
}
&nbsp;
/* cardGlow kept in DOM but no visual effect */
.cardGlow {
  display: none;
}
&nbsp;
/* ── Tutor card — col 1, rows 1-2 ───────────────────────── */
.cardTutor {
  grid-column: 1;
  grid-row: 1 / 3;
}
&nbsp;
/* ── Quiz card — col 2-3, row 1 ─────────────────────────── */
.cardQuiz {
  grid-column: 2 / 4;
  grid-row: 1;
}
&nbsp;
/* ── Flashcard — col 2, row 2 ───────────────────────────── */
.cardFlash {
  grid-column: 2;
  grid-row: 2;
}
&nbsp;
/* ── Scheduler — col 3, row 2 ───────────────────────────── */
.cardScheduler {
  grid-column: 3;
  grid-row: 2;
}
&nbsp;
/* ── Profile card ────────────────────────────────────────── */
.cardProfile {
  border-color: var(--theme-border);
}
&nbsp;
/* ── Card shared components ──────────────────────────────── */
.cardIconWrap {
  width: 38px;
  height: 38px;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-surface);
  flex-shrink: 0;
}
&nbsp;
.cardTitle {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--theme-text);
  margin: 0;
}
&nbsp;
.cardTitleSm {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  color: var(--theme-text);
  margin: 0;
}
&nbsp;
.cardSubtitle {
  font-size: 11px;
  color: var(--theme-text-secondary);
  margin: 2px 0 0;
}
&nbsp;
.cardDesc {
  font-size: 13px;
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin: 0;
}
&nbsp;
.cardRowHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
&nbsp;
.cardIconGroup {
  display: flex;
  align-items: center;
  gap: 12px;
}
&nbsp;
.cardBadge {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-display);
  font-size: 10px;
  color: var(--theme-purple);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 3px 10px;
  width: fit-content;
}
&nbsp;
.cardCta {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-purple);
  text-decoration: none;
  transition: gap 0.15s;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
}
&nbsp;
.cardCta:hover {
  gap: 4px;
}
.cardCta svg {
  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}
&nbsp;
.cardCta:hover svg {
  transform: translateX(3px);
}
.cardCtaGreen {
  color: var(--theme-green);
}
&nbsp;
.cardCtaAmber {
  color: var(--theme-accent);
}
&nbsp;
.cardCtaPink {
  color: var(--clr-pink, #ec4899);
}
&nbsp;
.cardCtaRed {
  color: var(--theme-red);
}
&nbsp;
/* ── Chat preview ────────────────────────────────────────── */
.chatPreview {
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-lg);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
&nbsp;
.chatBubble {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
&nbsp;
.chatAvatar {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}
&nbsp;
.chatAvatarBot {
  background: var(--theme-surface);
  color: var(--theme-purple);
}
&nbsp;
.chatAvatarUser {
  background: var(--theme-surface);
  color: var(--theme-text-secondary);
}
&nbsp;
.chatText {
  font-size: 11px;
  color: var(--theme-text-secondary);
  line-height: 1.5;
  margin: 0;
}
&nbsp;
.chatTextUser {
  color: var(--theme-text);
}
&nbsp;
/* ── Quiz stats ──────────────────────────────────────────── */
.quizBadge {
  font-family: var(--font-display);
  font-size: 11px;
  color: var(--clr-teal, #0ea5e9);
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-full);
  padding: 4px 12px;
  white-space: nowrap;
}
&nbsp;
.quizStats {
  display: flex;
  align-items: center;
  gap: 12px;
}
&nbsp;
.statBox {
  flex: 1;
  background: var(--theme-bg);
  border: 1px solid var(--theme-border);
  border-radius: var(--r-md);
  padding: 10px 12px;
}
&nbsp;
.statBoxRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}
&nbsp;
.statLabel {
  font-family: var(--font-display);
  font-size: 10px;
