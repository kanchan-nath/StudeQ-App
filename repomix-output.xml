  flex-shrink: 0;
  /* will-change: sidebar slides via transform → promote to GPU layer */
  will-change: transform;
  animation: sidebarSlideIn var(--duration-slow) var(--ease-out-quart) both;
}

/* MOTION: entrance — translateX + opacity (both composited) */
@keyframes sidebarSlideIn {
  from {
    transform: translateX(-20px);
