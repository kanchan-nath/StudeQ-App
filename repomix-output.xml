));

const checkApiResponse = (res, { navigate, notifyError, setPageError }) => {
  if (res.status === 401) { notifyError("Session expired. Sign in again."); navigate("/login"); return false; }
  if (res.status === 403) { setPageError(ERROR_TYPES.FORBIDDEN); return false; }
  if (res.status >= 500) { setPageError(ERROR_TYPES.SERVER_ERROR); return false; }
  if (!res.ok) { setPageError(ERROR_TYPES.UNKNOWN); return false; }
  return true;
};

/* ═══════════════════════════════════════════════════════════════
  MAIN COMPONENT
═══════════════════════════════════════════════════════════════ */
const Notes = () => {
  const [isCopied, setIsCopied] = useState(false);
  const [editValue, setEditValue] = useState("");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [content, setContent] = useState("");
  const [summaryData, setSummaryData] = useState(null);
  const [notes, setNotes] = useState([]);
  const [fetchError, setFetchError] = useState("");
  const [fetching, setFetching] = useState(false);
  const [showInputForm, setShowInputForm] = useState(false);
  const [generatedIds, setGeneratedIds] = useState(new Set());
  const [toast, setToast] = useState(null);
  const [sidebarOpen, setSidebarOpen] = useState(false);

  // ── Error handler hook ───────────────────────────────────────────────────────
  const { notifyError, notifySuccess } = useErrorHandler();

  // ── Blocking error state — replaces the whole page ──────────────────────────
  // null = no error | ERROR_TYPES key = show full error page
  const [pageError, setPageError] = useState(null);

  // ── NEW: mobile drawer state ──
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  const noteDocRef = useRef(null);
  const inputRef = useRef(null);

  const location = useLocation();
  const { id } = useParams();
  const navigate = useNavigate();

  const activeNoteId = id || null;
  const panelView = location.pathname === "/notes/new"
    ? "form"
    : id && location.pathname.endsWith("/edit")
      ? "form"
      : id
        ? "note"
        : "welcome";

  const editId = location.pathname.endsWith("/edit") ? id : "";

  // ── NEW: lock body scroll when mobile drawer is open ──
  useEffect(() => {
    document.body.style.overflow = mobileSidebarOpen ? "hidden" : "";
    return () => {
      document.body.style.overflow = "";
    };
  }, [mobileSidebarOpen]);

  const handler = (data) => {
    const { title, summary, keyPoints, _id, isPinned } = data;
    setSummaryData({ title, summary, keyPoints, _id, isPinned });
    setGeneratedIds((prev) => new Set(prev).add(_id));
    showToast("Note created!");
    fetchNotes();
    navigate(`/notes/${_id}`);
  }
  useEffect(() => {
    connectSocket();
    const socket = getSocket();
    if (!socket) return;

    socket.on("ai-response", handler);

    return () => socket.off("ai-response", handler);
  }, []);

  const showToast = useCallback((message, type = "success") => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3500);
  }, []);

  const handleChange = (e) => setContent(e.target.value);

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);
    setError("");

    if (editId) {
      try {
        const res = await apiFetch(`/api/notes/${editId}`, {
          method: "PATCH",
          body: JSON.stringify({ content }),
        });

        if (!checkApiResponse(res, { navigate, notifyError, setPageError })) return;

        showToast("Note updated successfully!");
        setContent("");
        await fetchNotes();
        navigate(`/notes/${id}`);
      } catch (err) {
        showToast(err.message || "Update failed", "error");
      } finally {
        setLoading(false);
      }
    } else {
      try {
        const res = await apiFetch("/api/notes", {
          method: "POST",
          body: JSON.stringify({ content }),
        });

        if (!checkApiResponse(res, { navigate, notifyError, setPageError })) return;

        const data = await res.json();
        const { title, summary, keyPoints, _id, isPinned } = data.data;

        setSummaryData({ title, summary, keyPoints, _id, isPinned });
        setGeneratedIds((prev) => new Set(prev).add(_id));
        setContent("");
        showToast("Note created!");
        await fetchNotes();
        navigate(`/notes/${_id}`);
      } catch (err) {
        setError(err.message || "Content generation failed");
        showToast(err.message || "Something went wrong", "error");
      } finally {
        setLoading(false);
      }
    }
  };

  const fetchNotes = useCallback(async () => {
    setFetching(true);
    try {
      const res = await apiFetch("/api/notes");

      if (!checkApiResponse(res, { navigate, notifyError, setPageError })) return;

      const data = await res.json();
      setNotes(data.data);
    } catch (err) {
      const type = resolveErrorType(err);
      if (type === ERROR_TYPES.NETWORK) {
        setPageError(ERROR_TYPES.NETWORK);
      } else {
        setFetchError(err.message);
      }
    } finally {
      setFetching(false);
    }
  }, [navigate, notifyError]);

  const handleSubmitDelete = async (id) => {
    try {
      const res = await apiFetch(`/api/notes/${id}`, {
        method: "DELETE",
      });
      if (!checkApiResponse(res, { navigate, notifyError, setPageError })) return;

      showToast("Note deleted");
      if (activeNoteId === id) {
        setSummaryData(null);
        navigate("/notes");
      }
      await fetchNotes();
    } catch (err) {
      showToast(err.message || "Delete failed", "error");
    }
  };

  // Use useEffect watching editId:
  useEffect(() => {
    if (editId) inputRef.current?.focus();
  }, [editId]);
  // Remove setTimeout entirely

  const handleSubmitEdit = (note) => {
    setContent(note.summary);
    navigate(`/notes/${note._id}/edit`);
  };

  const handleCancelEdit = () => {
    setContent("");
    navigate(activeNoteId ? `/notes/${activeNoteId}` : "/notes");
  };

  const handleCopy = async (note) => {
    try {
      const stripMarkdown = (text) => {
        if (!text) return "";
        return text
          .replace(/#{1,6}\s+/g, "")
          .replace(/\*\*(.*?)\*\*/g, "$1")
          .replace(/\*(.*?)\*/g, "$1")
          .replace(/__(.*?)__/g, "$1")
          .replace(/_(.*?)_/g, "$1")
          .replace(/~~(.*?)~~/g, "$1")
          .replace(/`{1,3}[^`]*`{1,3}/g, "")
          .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
          .replace(/^[-*+]\s+/gm, "• ")
          .replace(/^\d+\.\s+/gm, "")
          .replace(/^>\s+/gm, "")
          .replace(/---+/g, "")
          .replace(/<[^>]+>/g, "")
          .replace(/\n{3,}/g, "\n\n")
          .trim();
      };

      const keyPointsText = Array.isArray(note.keyPoints)
        ? note.keyPoints
          .map((pt, i) => `${i + 1}. ${stripMarkdown(pt)}`)
          .join("\n")
        : stripMarkdown(note.keyPoints);

      const text = [
        stripMarkdown(note.title),
        "",
        "Summary:",
        stripMarkdown(note.summary),
        ...(keyPointsText ? ["\nKey Points:", keyPointsText] : []),
      ].join("\n");

      await navigator.clipboard.writeText(text);
      setIsCopied(true);
      showToast("Copied to clipboard!");
      setTimeout(() => setIsCopied(false), 2000);
    } catch (err) {
      showToast("Copy failed", "error");
    }
  };

  const handleDownload = async (note) => {
    const element = noteDocRef.current;
    if (!element) return showToast("Nothing to export", "error");

    const [{ default: html2canvas }, { jsPDF }] = await Promise.all([
      import("html2canvas"),
      import("jspdf"),
    ]);

    showToast("Generating PDF…");

    try {
      const canvas = await html2canvas(element, {
        scale: 2,
        useCORS: true,
        backgroundColor: null,
        windowWidth: element.scrollWidth,
        windowHeight: element.scrollHeight,
      });

      const imgData = canvas.toDataURL("image/png");

      const pdf = new jsPDF({
        orientation: "portrait",
        unit: "mm",
        format: "a4",
      });
      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const ratio = pageWidth / canvas.width;
      const imgHeightMm = canvas.height * ratio;

      let yOffset = 0;
      while (yOffset < imgHeightMm) {
        if (yOffset > 0) pdf.addPage();
        pdf.addImage(imgData, "PNG", 0, -yOffset, pageWidth, imgHeightMm);
        yOffset += pageHeight;
      }

      pdf.save(`${note.title.replace(/\*\*/g, "")}.pdf`);
      showToast("PDF downloaded!");
    } catch (err) {
      console.error(err);
      showToast("PDF export failed", "error");
    }
  };

  const tooglePin = async (note) => {
    const newPinned = !note.isPinned;
    try {
      const res = await apiFetch(`/api/notes/${note._id}/pin`, {
        method: "PATCH",
        body: JSON.stringify({ newPinned }),
      });
      if (!checkApiResponse(res, { navigate, notifyError, setPageError })) return;

      showToast(newPinned ? "Note pinned!" : "Note unpinned");
      if (summaryData && summaryData._id === note._id) {
        setSummaryData((prev) => ({ ...prev, isPinned: newPinned }));
      }
      fetchNotes();
    } catch (err) {
      showToast("Pin toggle failed", "error");
    }
  };

  const handleSidebarNoteClick = (note) => {
    setSummaryData(note);
    setContent("");
    navigate(`/notes/${note._id}`);
    setMobileSidebarOpen(false);
  };

  const handleNewNote = () => {
    setSummaryData(null);
    setContent("");
    navigate("/notes/new");
    setMobileSidebarOpen(false);
  };

  const activeNote = activeNoteId
    ? notes.find((n) => n._id === activeNoteId) || summaryData
    : summaryData;

  useEffect(() => {
    fetchNotes();
  }, []);

  const notesWithDate = useMemo(() =>
    notes.map(n => ({ ...n, dateLabel: new Date(n.createdAt).toLocaleDateString() })),
    [notes]
  );

  const { pinnedNotes, unpinnedNotes } = useMemo(() => ({
    pinnedNotes: notesWithDate.filter(n => n.isPinned),
    unpinnedNotes: notesWithDate.filter(n => !n.isPinned),
  }), [notes]);

  // ── Full-page error — replaces page entirely ─────────────────────────────────
  if (pageError) {
    return <ErrorPage type={pageError} onRetry={fetchNotes} />;
  }

  // ── Shared sidebar content — rendered in both desktop + mobile drawer ──

  return (
    <div className={styles["notes-page"]}>
      {toast && (
        <Toast
          message={toast.message}
          type={toast.type}
          onClose={() => setToast(null)}
        />
      )}

      {/* ── MAIN PANEL ── */}
      <main
        className={styles["notes-main"]}
        role="main"
        aria-label="Note content"
      >
        {/* ── NEW: mobile topbar — sticky, visible only on ≤768px via CSS ── */}
        <div className={styles["mobile-topbar"]}>
          <span className={styles["mobile-topbar__title"]}>📝 Notes</span>
          <div className={styles["mobile-topbar__right"]}>
            <button
              className={styles["mobile-topbar__btn"]}
              onClick={handleNewNote}
              aria-label="New note"
              title="New note"
            >
              ✏️
            </button>
            <button
              className={styles["mobile-topbar__btn"]}
              onClick={() => setMobileSidebarOpen(true)}
              aria-label="Open notes list"
              title="Your notes"
            >
              ☰
            </button>
          </div>
        </div>

        {panelView === "welcome" && (
          <WelcomePanel onStart={() => navigate("/notes/new")} />
        )}

        {panelView === "form" && (
          <NoteInputForm
            content={content}
            onChange={handleChange}
            onSubmit={handleSubmit}
            loading={loading}
            editId={editId}
            onCancelEdit={handleCancelEdit}
            inputRef={inputRef}
          />
        )}

        {panelView === "note" && activeNote && activeNote.title && (
          <NoteDocument
            note={activeNote}
            onEdit={handleSubmitEdit}
            onDelete={handleSubmitDelete}
            onDownload={handleDownload}
            onPin={tooglePin}
            onCopy={handleCopy}
            isCopied={isCopied}
            docRef={noteDocRef}
          />
        )}

        {error && (
          <div
            className={styles["notes-error"]}
            role="alert"
          >
            <span>⚠ {error}</span>
            <button
              onClick={() => setError("")}
              aria-label="Dismiss error"
            >
              ✕
            </button>
          </div>
        )}
      </main>

      {/* ── DESKTOP SIDEBAR (RIGHT) — hidden on mobile via CSS ── */}
      <div
        className={`${styles.sidebar} ${sidebarOpen ? styles.sidebarOpen : styles.sidebarClosed}`}
      >
        <button
          className={styles.sidebarToggleBtn}
          onClick={() => setSidebarOpen((prev) => !prev)}
          aria-label={sidebarOpen ? "Collapse sidebar" : "Expand sidebar"}
        >
          {sidebarOpen ? "→" : "←"}
        </button>

        {sidebarOpen && <SidebarContent fetching={fetching}
          fetchError={fetchError}
          notes={notes}
          pinnedNotes={pinnedNotes}
          unpinnedNotes={unpinnedNotes}
          activeNoteId={activeNoteId}
          handleSidebarNoteClick={handleSidebarNoteClick}
          handleNewNote={handleNewNote}
          setMobileSidebarOpen={setMobileSidebarOpen} />}
      </div>

      {/* ── MOBILE DRAWER + BACKDROP ── */}
      {mobileSidebarOpen && (
        <>
          {/* backdrop — tap to close */}
          <div
            className={styles.sidebarOverlay}
            onClick={() => setMobileSidebarOpen(false)}
            aria-hidden="true"
          />
          {/* drawer */}
          <div className={`${styles.sidebar} ${styles.sidebarMobileOpen}`}>
            <SidebarContent />
          </div>
        </>
      )}
    </div>
  );
};

export default Notes;
</file>

<file path="client/src/components/layouts/PublicLayout.module.css">
/* PublicLayout.module.css */

.layout {
    background: var(--theme-bg, rgba(10, 12, 20, 1));
    color: var(--theme-text);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
}

/* ── NAVBAR ── */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--navbar-h, 64px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    transition:
        background var(--t-slow),
        backdrop-filter var(--t-slow),
        box-shadow var(--t-slow);
}

.navbarScrolled {
    background: var(--theme-navbar-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--theme-border);
}

.navInner {
    width: 100%;
    max-width: var(--max-w, 1200px);
    margin: 0 auto;
    padding: 0 24px;
    height: var(--navbar-h, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.navLeft {
    display: flex;
    align-items: center;
    gap: 32px;
}

.navLogo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text);
    text-decoration: none;
    white-space: nowrap;
}

.navLogo span {
    color: var(--theme-accent);
}

.navLinks {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.navLink {
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    transition: color var(--t-fast);
    position: relative;
    padding-bottom: 2px;
}

.navLink::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--theme-accent);
    width: 0;
    transition: width 0.2s ease;
}

.navLink:hover {
    color: var(--theme-text);
}

.navLinkActive {
    color: var(--theme-text);
}

.navLinkActive::after {
    width: 100%;
}

.navRight {
    display: flex;
    align-items: center;
    gap: 12px;
}

.navLoginBtn {
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: var(--r-full);
    transition: color var(--t-fast);
}

.navLoginBtn:hover {
    color: var(--theme-text);
}

.navCta {
    background: var(--theme-accent);
    color: var(--theme-bg);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: var(--r-full);
    text-decoration: none;
    transition:
        transform var(--t-fast),
        box-shadow var(--t-fast);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
}

.navCta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--theme-accent-glow);
}

/* ── HAMBURGER ── */
.hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
}

.hamburgerLine {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--theme-text-muted);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
}

.hamburgerOpen1 {
    transform: translateY(7px) rotate(45deg);
}

.hamburgerOpen2 {
    opacity: 0;
}

.hamburgerOpen3 {
    transform: translateY(-7px) rotate(-45deg);
}

/* ── MOBILE MENU ── */
.mobileMenu {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--theme-border);
    padding: 16px 24px 24px;
    gap: 4px;
}

.mobileMenuLink {
    font-size: 15px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--theme-border);
    transition: color var(--t-fast);
}

.mobileMenuLink:hover {
    color: var(--theme-text);
}

.mobileMenuActions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
}

.mobileLoginBtn {
    flex: 1;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-text-muted);
    text-decoration: none;
    padding: 12px;
    border: 1px solid var(--theme-border);
    border-radius: var(--r-full);
}

.mobileCta {
    flex: 1;
    text-align: center;
    background: var(--theme-accent);
    color: var(--theme-bg);
    font-size: 14px;
    font-weight: 700;
    padding: 12px;
    border-radius: var(--r-full);
    text-decoration: none;
}

/* ── BREADCRUMB BAR ── */
.breadcrumbBar {
    position: sticky;
    top: var(--navbar-h, 64px);
    z-index: 90;
    background: var(--theme-bg, rgba(10, 12, 20, 1));;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--theme-border);
}

.breadcrumbInner {
    max-width: var(--max-w, 1200px);
    margin: 0 auto;
    padding: 10px 24px;
}

/* ── MAIN ── */
.main {
    flex: 1;
    padding-top: var(--navbar-h, 64px);
}

/* ── FOOTER ── */
.footer {
    position: relative;
    z-index: 1;
    background: transparent;
    overflow: hidden;
    border-top: 1px solid var(--theme-border);
}

.footerTop {
    max-width: var(--max-w, 1200px);
    margin: 0 auto;
    padding: 56px 24px 40px;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
}

.footerLogoBlock {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.footerLogo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text);
    text-decoration: none;
}

.footerLogo span {
    color: var(--theme-accent);
}

.footerTagline {
    font-size: 14px;
    color: var(--theme-text-muted);
    line-height: 1.55;
    margin: 0;
}

.footerCopyright {
    font-size: 13px;
    color: var(--theme-text-muted);
    margin: 0;
}

.footerSocials {
    display: flex;
    gap: 10px;
    margin-top: 4px;
}

.socialBtn {
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--theme-text-muted);
    font-size: 14px;
    text-decoration: none;
    transition:
        background var(--t-fast),
        color var(--t-fast),
        border-color var(--t-fast);
}

.socialBtn:hover {
    background: var(--theme-purple-dim);
    border-color: var(--theme-purple-light);
    color: var(--theme-purple-light);
}

.footerLinks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
}

.footerLinkCol {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.footerLinkHeading {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--theme-purple-light);
    margin-bottom: 4px;
}

.footerLink {
    font-size: 14px;
    color: var(--theme-text-muted);
    text-decoration: none;
    transition: color var(--t-fast);
}

.footerLink:hover {
    color: var(--theme-text);
}

.footerWordmark {
    text-align: center;
    padding: 0 24px 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    position: relative;
}

.footerWordmark::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to top, rgba(124, 95, 245, 0.4) 0%, transparent 100%);
    pointer-events: none;
}

.footerWordmarkText {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: linear-gradient(to bottom, var(--theme-purple-light) 0%, transparent 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    display: block;
    transform: perspective(400px) rotateX(20deg);
    transform-origin: bottom center;
}

.footerBottom {
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--theme-border);
}

.footerBottomText {
    font-size: 13px;
    color: var(--theme-text-muted);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
    .footerTop {
        grid-template-columns: 1fr;
        gap: 32px;
